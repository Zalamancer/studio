rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profile info
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time;
                       // Strict field checking can be problematic, ensure it matches your client code exactly if used.

      allow update: if isSignedIn() && request.auth.uid == userId &&
                       request.resource.data.uid == resource.data.uid && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email shouldn't change this way
                       request.resource.data.companyName == resource.data.companyName && // Company name set at signup
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName set at creation
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // ^
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt is immutable
                       request.resource.data.updatedAt == request.time; // updatedAt must be new server time
                       // diff().affectedKeys() is useful but can be complex; ensure it covers all valid update paths.

      allow delete: if false; // Users should not be able to delete their own user document directly
    }

    // --- Mutuals (Connections) Collection ---
    match /mutuals/{connectionId} {
      function isUserInConnection() {
        return isSignedIn() && request.auth.uid in resource.data.userIds;
      }
      function isRequester() {
        return isSignedIn() && request.auth.uid == request.resource.data.requesterId;
      }

      allow read: if isUserInConnection();
      allow list: if isSignedIn() && request.query.filters[0][2] == request.auth.uid; // Allows querying 'where("userIds", "array-contains", auth.uid)'

      allow create: if isSignedIn() && isRequester() &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.userIds.size() == 2 && // Only two users
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requesterId != request.resource.data.userIds.removeAll([request.auth.uid])[0] && // Requester isn't the other person
                       request.resource.data.requestedAt == request.time;

      allow update: if isSignedIn() && isUserInConnection() &&
                       request.resource.data.userIds == resource.data.userIds && // userIds cannot change
                       request.resource.data.requesterId == resource.data.requesterId && // requesterId cannot change
                       request.resource.data.updatedAt == request.time &&
                       ( // Case 1: Accepting a request
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'connected' &&
                         request.resource.data.connectedAt == request.time &&
                         request.auth.uid != resource.data.requesterId // Only recipient can accept
                       );

      allow delete: if isSignedIn() && isUserInConnection() &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected'); // Allow delete for pending (cancel/reject) or connected (remove)
    }

    // --- Posts Collection & Subcollections ---
    match /posts/{postId} {
      allow read: if true;
      allow list: if true;

      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() &&
                       (
                         ( // Case 1: Owner updating their post
                           request.auth.uid == resource.data.userId &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'requestType',
                             'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline', 'updatedAt'
                           ])
                         )
                         || // Case 2: Any authenticated user updating commentCount
                         (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt'])
                         )
                       );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update: if isSignedIn(); // Simplified for liking
        allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read, list: if true;
          allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
          allow update: if isSignedIn(); // Simplified for liking
          allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
          allow read, list: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.bidderId == request.auth.uid;
          allow update: if false;
          allow delete: if isSignedIn() && request.auth.uid == resource.data.bidderId;
      }
    }

    match /conversations/{conversationId} {
      allow read, get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.query.filters[0][2] == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, get: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
        allow list: if isSignedIn() && request.query.filters[0][2] == request.auth.uid;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && request.auth.uid == resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']);
        allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.reviewerId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.reviewerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.reviewerId;
    }

    match /collections/{collectionId} {
      function isCollectionOwner() { return isSignedIn() && request.auth.uid == resource.data.ownerId; }
      function isSharedWithUser() { return isSignedIn() && request.auth.uid in resource.data.sharedWithUserIds; }
      allow read, list: if isCollectionOwner() || isSharedWithUser();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isCollectionOwner();
      allow delete: if isCollectionOwner();
    }

    match /plans/{planId} {
      allow read: if resource.data.visibility in ['public', 'unlisted'] ||
                     (isSignedIn() && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.viewUserIds));
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.ownerId || (request.auth.uid in resource.data.editUserIds));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      match /versions/{versionId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.editorUid == request.auth.uid;
        allow update, delete: if false;
      }
      match /viewingUsers/{userId} {
        allow list, get: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /articleTags/{tagId} {
        allow read, list: if true;
        allow create: if isSignedIn();
       	allow update: if isSignedIn();
        allow delete: if false;
    }

    match /newsArticles/{articleId} {
      function isNewsArticleOwner() { return isSignedIn() && request.auth.uid == resource.data.userId; }
      allow read: if resource.data.status == 'published' || isNewsArticleOwner();
      allow list: if true;
      allow create: if isNewsArticleOwner();
      allow update: if isSignedIn(); // Simplified for now
      allow delete: if isNewsArticleOwner();

      match /newsComments/{commentId} {
          function isArticleCommentOwner() { return isSignedIn() && request.auth.uid == resource.data.userId; }
          function isParentArticleOwner() { return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId; }
          allow list: if true;
          allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleCommentOwner();
          allow create: if isSignedIn();
          allow update: if isSignedIn(); // Simplified
          allow delete: if isArticleCommentOwner();

          match /newsSubcomments/{subCommentId} {
              function isArticleSubCommentOwner() { return isSignedIn() && request.auth.uid == resource.data.userId; }
              allow list: if true;
              allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleSubCommentOwner();
              allow create: if isSignedIn();
              allow update: if isSignedIn(); // Simplified
              allow delete: if isArticleSubCommentOwner();
          }
      }
    }

    // --- Follows Collection ---
    // Document ID is the follower's UID.
    // Contains a map field 'following' where keys are the UIDs of users being followed.
    match /follows/{followerId} {
      function isFollower() {
        return isSignedIn() && request.auth.uid == followerId;
      }

      // A user can read their own follow document to see who they follow.
      allow get: if isFollower();
      
      // A user cannot list follow documents. They must get their own.
      allow list: if false;

      // A user can create their own follow document for the first time
      // OR update it to add/remove follows.
      // Combining create and update logic into a single write rule is often cleaner.
      allow write: if isFollower();
    }
  }
}