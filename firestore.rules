
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Plan helper functions
    function isPlanOwner(planId) {
      return request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId;
    }

    function canEditPlan(planId) {
      let plan = get(/databases/$(database)/documents/plans/$(planId)).data;
      return isPlanOwner(planId) ||
             (plan.editability == 'collaborators' && request.auth.uid in plan.editUserIds) ||
             (plan.editability == 'everyone' && canViewPlan(planId)); // Everyone who can view can edit
    }

    function canViewPlan(planId) {
      let plan = get(/databases/$(database)/documents/plans/$(planId)).data;
      return isAuthenticated() && ( // All plan visibility requires auth at a minimum
        plan.visibility == 'public' ||
        (plan.visibility == 'unlisted' && (request.auth.uid == plan.ownerId || request.auth.uid in plan.viewUserIds)) ||
        (plan.visibility == 'private' && (request.auth.uid == plan.ownerId || request.auth.uid in plan.viewUserIds))
      );
    }
    
    function isValidPlanVisibility(visibility) {
      return visibility == 'private' || visibility == 'unlisted' || visibility == 'public';
    }

    function isValidPlanEditability(editability) {
      return editability == 'owner_only' || editability == 'collaborators' || editability == 'everyone';
    }
    
    function isValidViewAndEditUserIds(planData, ownerId) {
      let validView = planData.viewUserIds is list && (planData.visibility == 'public' || ownerId in planData.viewUserIds);
      let validEdit = planData.editUserIds is list && (planData.editability == 'everyone' || ownerId in planData.editUserIds);
      // If editability is 'collaborators', all editors must also be viewers
      let editorsAreViewers = planData.editability != 'collaborators' || planData.editUserIds.hasAll(planData.viewUserIds);
      // If visibility is 'unlisted' and editability is 'everyone', it's invalid (handled by client but good to double check)
      let validEveryoneEdit = !(planData.visibility == 'unlisted' && planData.editability == 'everyone');
      // If visibility is 'private', editability must be 'owner_only'
      let validPrivateEdit = !(planData.visibility == 'private' && planData.editability != 'owner_only');

      return validView && validEdit && editorsAreViewers && validEveryoneEdit && validPrivateEdit;
    }


    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Anyone authenticated can read basic profiles
      allow create: if isUser(userId) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Required fields for initial profile creation
                       request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt']) &&
                       // Optional fields allowed at creation
                       request.resource.data.keys().hasOnly(['uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt']);
      allow update: if isUser(userId) &&
                       request.resource.data.uid == userId && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email cannot change post-creation by user
                       request.resource.data.companyName == resource.data.companyName && // Company name cannot change post-creation by user
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName is system-generated and shouldn't change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       // Allow only specific fields to be updated by the user
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'incomeRange', 'lastLoginAt', 'updatedAt'
                         // 'verified' and 'isBotAccount' should be admin-only if implemented
                       ]);
      allow delete: if false; // Generally users should not delete their own profiles directly for data integrity
    }

    // User Preferences Subcollection (or top-level collection)
    match /userPreferences/{userId} {
      allow read, write: if isUser(userId);
      // More granular write validation can be added here
      // Example: allow update if request.resource.data.keys().hasOnly(['field1', 'field2', 'updatedAt'])
      // Ensure only allowed fields are updated and updatedAt is set correctly
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      function isParticipant(connectionId) {
        return request.auth.uid in resource.data.userIds;
      }
      function isRequester(connectionId) {
        return request.auth.uid == resource.data.requesterId;
      }
      function isRecipient(connectionId) {
        return request.auth.uid != resource.data.requesterId && request.auth.uid in resource.data.userIds;
      }

      allow read: if isAuthenticated() && isParticipant(connectionId);
      allow list: if isAuthenticated() &&
                     request.query.limit <= 100 && // Limit query size
                     (request.query.filters.size() == 0 || // Allow listing all (client filters)
                       (request.query.filters.size() == 2 && // Specific query for connections/requests
                        request.query.filters[0].field == 'userIds' &&
                        request.query.filters[0].operator == 'array-contains' &&
                        request.query.filters[0].value == request.auth.uid &&
                        request.query.filters[1].field == 'status' &&
                        (request.query.filters[1].operator == '==' || request.query.filters[1].operator == 'in')
                       )
                     );

      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.requesterId &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds.size() == 2 && // Ensure it's a pair
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time && // Use requestedAt for creation
                       request.resource.data.updatedAt == request.time &&
                       !exists(/databases/$(database)/documents/mutuals/$(connectionId)); // Prevent overwriting

      allow update: if isAuthenticated() && isParticipant(connectionId) &&
                       request.resource.data.updatedAt == request.time &&
                       ( // Scenarios for update:
                         // 1. Recipient accepts: status changes from 'pending' to 'connected', connectedAt is set
                         (resource.data.status == 'pending' && request.resource.data.status == 'connected' && isRecipient(connectionId) && request.resource.data.connectedAt == request.time) ||
                         // (No other updates like changing status back to pending, or blocking, are defined here yet)
                         // (No updates to userIds or requesterId allowed post-creation)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']))
                       );

      allow delete: if isAuthenticated() && isParticipant(connectionId) &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected'); // Allow deleting pending or connected
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Publicly readable for now, adjust if needed
      allow list: if isAuthenticated(); // Any authenticated user can list posts (client filters further)
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.keys().hasOnly([
                            'userId', 'tags', 'question', 'requestType',
                            'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                            'maxBudget', 'deadline',
                            'sector', 'subSector', 'industry', 'ratingScore', 'createdAt',
                            'naicsCode', 'imageUrls', 'mentionedUserIds', 'commentCount'
                       ]);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.userId == resource.data.userId && // Cannot change owner
                       // Allow updating specific fields
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'tags', 'question', 'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                         'maxBudget', 'deadline', 'sector', 'subSector', 'industry', 'naicsCode',
                         'imageUrls', 'mentionedUserIds', 'commentCount' // commentCount is updated by server-side logic (e.g. functions or transactions)
                       ]);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // Comments Subcollection for Posts
      match /comments/{commentId} {
        allow read: if true; // Publicly readable
        allow list: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly(['userId', 'postId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
        allow update: if isAuthenticated() && // Only specific fields can be updated
                         request.auth.uid == resource.data.userId && // User can update their own comment text
                         request.resource.data.timestamp == resource.data.timestamp && // Original timestamp cannot change
                         request.resource.data.updatedAt == request.time && // Must set new update time
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) || // User edits their comment text
                         // Allow anyone authenticated to update likeCount and likedBy (for liking)
                         isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete their own comment

        // SubComments (Replies) Subcollection for Comments
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow list: if isAuthenticated();
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
            allow update: if isAuthenticated() &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time &&
                           (
                            (request.auth.uid == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds'])) || // User edits their own
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) // Anyone can like
                           );
            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }

      // Bids Subcollection for Posts
      match /bids/{bidId} {
        allow read: if isAuthenticated(); // Allow authenticated users to read bids
        allow list: if isAuthenticated(); // Allow authenticated users to list bids
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.bidderId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.postId == postId && // Ensure bid is for the correct post
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 && // Bid amount must be non-negative
                         request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
        // No updates or deletes allowed for bids to maintain integrity
        allow update, delete: if false;
      }
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
      function isArticleOwner(articleId) {
        return request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
      }
      allow read: if resource.data.status == 'published' || (isAuthenticated() && isArticleOwner(articleId));
      allow list: if request.query.limit <= 20; // Public listing of published articles
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.status == 'draft' || request.resource.data.status == 'published') &&
                       (request.resource.data.publishedAt == null || request.resource.data.publishedAt == request.time) &&
                       request.resource.data.likeCount == 0 &&
                       request.resource.data.likedBy == [] &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.keys().hasOnly([
                            'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt',
                            'likeCount', 'likedBy', 'commentCount',
                            // Fields from Post type that are relevant for NewsArticle
                            'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls',
                            'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                            'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                       ]);

      allow update: if isAuthenticated() && isArticleOwner(articleId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.publishedAt == resource.data.publishedAt || request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null) &&
                       // Allow likeCount/likedBy updates by any authenticated user (for liking)
                       (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) ||
                         // Owner can update content, status, etc.
                         (
                           request.auth.uid == resource.data.userId && // Double check for owner-specific fields
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 'publishedAt', 'updatedAt',
                                'commentCount', // Updated by server transaction
                                'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls',
                                'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                                'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                           ])
                         )
                       );
      allow delete: if isAuthenticated() && isArticleOwner(articleId);

      // News Comments Subcollection
      match /newsComments/{commentId} {
        function isNewsCommentOwner(commentId) {
          return request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)/newsComments/$(commentId)).data.userId;
        }
        allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && isArticleOwner(articleId)) || (isAuthenticated() && isNewsCommentOwner(commentId));
        allow list: if isAuthenticated(); // Let client filter shadow-banned if user is not author
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.isShadowBanned == false &&
                         request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
        allow update: if isAuthenticated() &&
                        (
                          // Owner of comment can edit text
                          (isNewsCommentOwner(commentId) && request.resource.data.timestamp == resource.data.timestamp && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds'])) ||
                          // Anyone authenticated can like
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) ||
                          // Article author can update isShadowBanned status
                          (isArticleOwner(articleId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']))
                        );
        allow delete: if isAuthenticated() && isNewsCommentOwner(commentId);

        // News SubComments (Replies) Subcollection
        match /newsSubcomments/{subCommentId} {
          function isNewsSubCommentOwner(subCommentId) {
            return request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)/newsComments/$(commentId)/newsSubcomments/$(subCommentId)).data.userId;
          }
          allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && isArticleOwner(articleId)) || (isAuthenticated() && isNewsSubCommentOwner(subCommentId));
          allow list: if isAuthenticated();
          allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
          allow update: if isAuthenticated() &&
                          (
                            (isNewsSubCommentOwner(subCommentId) && request.resource.data.timestamp == resource.data.timestamp && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds'])) ||
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) ||
                            (isArticleOwner(articleId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']))
                          );
          allow delete: if isAuthenticated() && isNewsSubCommentOwner(subCommentId);
        }
      }
    }

    // Article Tags Collection
    match /articleTags/{tagId} {
      allow read: if true; // Tags are public
      allow list: if isAuthenticated(); // Allow listing for search
      allow create: if isAuthenticated() &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                       request.resource.data.usageCount >= 0 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
      allow update: if isAuthenticated() && // Only allow incrementing/decrementing usageCount
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.nameLowercase == resource.data.nameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
      allow delete: if false; // Tags should not be deleted by users
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow list: if isAuthenticated(); // Allow listing for profile pages
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.reviewerId &&
                       request.resource.data.targetUserId != request.resource.data.reviewerId && // Cannot review self
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change original reviewer/target/creation
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt', 'reviewerName', 'reviewerAvatar']); // Allow reviewer name/avatar updates if their profile changes
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

    // Plans Collection
    match /plans/{planId} {
      allow read: if canViewPlan(planId);
    // SIMPLIFIED LIST RULE: Allows authenticated users to list plans with common constraints.
     // The `canViewPlan` in `allow read` will handle actual document visibility.
     allow list: if isAuthenticated() &&
                    request.query.limit <= 50 &&
                    (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt');



      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list && // roadmap must be a list (can be empty)
                       isValidPlanVisibility(request.resource.data.visibility) &&
                       isValidPlanEditability(request.resource.data.editability) &&
                       isValidViewAndEditUserIds(request.resource.data, request.auth.uid) &&
                       request.resource.data.keys().hasOnly(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']);

      allow update: if isAuthenticated() && canEditPlan(planId) && // Ensure user has edit permission for the plan
                       request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       // Main OR condition for type of update
                       (
                           ( // E1: Roadmap update path (user can edit plan, version increments)
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                               request.resource.data.version == resource.data.version + 1
                           ) ||
                           ( // E2: Settings update path (only owner can change settings, version does not change)
                               isPlanOwner(planId) && // Stricter check: only owner for these settings
                               // Using request.resource.data.keys() which are the keys in the incoming write
                               !request.resource.data.keys().hasAny(['roadmap', 'version']) && // Roadmap and version field itself must not be part of this update type
                               request.resource.data.keys().hasOnly([
                                   'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                   'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                               ]) &&
                               isValidPlanVisibility(request.resource.data.visibility) &&
                               isValidPlanEditability(request.resource.data.editability) &&
                               isValidViewAndEditUserIds(request.resource.data, request.auth.uid) &&
                               request.resource.data.version == resource.data.version // Version number value must remain same
                           )
                       );

      allow delete: if isAuthenticated() && isPlanOwner(planId);

      // Plan Versions Subcollection
      match /versions/{versionId} {
          allow read: if canViewPlan(planId); // Same read permission as parent plan
                   // CORRECTED LIST RULE for versions:
         // Allows listing if authenticated and the parent plan document path is valid.
         // `canViewPlan` in the `read` rule above will filter the results.
         allow list: if isAuthenticated() && exists(/databases/$(database)/documents/plans/$(planId));

          allow create: if isAuthenticated() && canEditPlan(planId) && // User who can edit the plan can create a version
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
          allow update, delete: if false; // Versions are immutable
      }
    }

    // Collections (for saved posts)
    match /collections/{collectionId} {
      function isCollectionOwner(collectionId) {
        return request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.ownerId;
      }
      function isSharedWithUser(collectionId) {
        // This function is tricky for list rules if used directly.
        // For read, it's fine.
        return request.auth.uid in get(/databases/$(database)/documents/collections/$(collectionId)).data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner(collectionId) || isSharedWithUser(collectionId));
      allow list: if isAuthenticated() &&
                     request.query.limit <= 100 &&
                     (request.query.orderBy == null || request.query.orderBy.path == 'createdAt') &&
                     (
                       (request.query.filters.size() == 1 && request.query.filters[0].field == 'ownerId' && request.query.filters[0].operator == '==' && request.query.filters[0].value == request.auth.uid) ||
                       (request.query.filters.size() == 1 && request.query.filters[0].field == 'sharedWithUserIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid)
                     );

      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.postIds is list && // Ensure postIds is a list (can be empty)
                       request.resource.data.sharedWithUserIds is list && // Ensure sharedWithUserIds is a list (can be empty)
                       request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']);

      allow update: if isAuthenticated() && isCollectionOwner(collectionId) &&
                       request.resource.data.ownerId == resource.data.ownerId && // ownerId cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);

      allow delete: if isAuthenticated() && isCollectionOwner(collectionId);
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      function isParticipant(conversationId) {
        return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
      function isGroupOwner(conversationId) {
          let conversationData = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return conversationData.type == 'group' && request.auth.uid == conversationData.ownerId;
      }
      function isGroupAdmin(conversationId) {
          let conversationData = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return conversationData.type == 'group' && request.auth.uid in conversationData.adminIds;
      }

      allow read: if isAuthenticated() && isParticipant(conversationId);
      allow list: if isAuthenticated() &&
                     request.query.limit <= 50 &&
                     request.query.filters.size() == 1 &&
                     request.query.filters[0].field == 'participants' &&
                     request.query.filters[0].operator == 'array-contains' &&
                     request.query.filters[0].value == request.auth.uid &&
                     (request.query.orderBy == null || request.query.orderBy.path == 'lastMessageTimestamp');

      allow create: if isAuthenticated() &&
                       request.resource.data.participants.hasAll([request.auth.uid]) && // Creator must be a participant
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       ( // Direct chat specific rules
                         (request.resource.data.type == 'direct' &&
                          request.resource.data.participants.size() == 2 &&
                          request.resource.data.ownerId == null && request.resource.data.adminIds == [] &&
                          request.resource.data.groupName == null && request.resource.data.groupAvatarUrl == null &&
                          request.resource.data.keys().hasOnly(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds'])
                         ) ||
                         // Group chat specific rules
                         (request.resource.data.type == 'group' &&
                          request.resource.data.participants.size() >= 2 &&
                          request.resource.data.ownerId == request.auth.uid && // Creator is owner
                          request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
                          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                          (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                          request.resource.data.postId == null && // postId should be null for groups (not related to a single post)
                          request.resource.data.keys().hasOnly(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'formerParticipants'])
                         )
                       );

      allow update: if isAuthenticated() && isParticipant(conversationId) &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.type == resource.data.type && // Cannot change conversation type
                       request.resource.data.postId == resource.data.postId && // PostId should be immutable for direct chats
                       ( // Different update scenarios
                         // Scenario 1: Updating last message details (any participant can do this by sending a message)
                         (
                           request.resource.data.participants == resource.data.participants && // Participants cannot change via this path
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])
                         ) ||
                         // Scenario 2: Group admin updates group details (name, avatar)
                         (
                           resource.data.type == 'group' && isGroupAdmin(conversationId) &&
                           request.resource.data.participants == resource.data.participants && // Participants not changed here
                           request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change via this path
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'])
                         ) ||
                         // Scenario 3: Group admin adds/removes members or admins (owner for promoting/demoting/transferring)
                         (
                           resource.data.type == 'group' &&
                           (
                             (isGroupAdmin(conversationId) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])) || // Admins can add/remove participants
                             (isGroupOwner(conversationId) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'ownerId'])) // Owner can manage admins/owner
                           ) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'ownerId', 'updatedAt', 'formerParticipants']) &&
                           (request.resource.data.ownerId == resource.data.ownerId || (isGroupOwner(conversationId) && request.resource.data.participants.hasAll([request.resource.data.ownerId]))) && // If owner changes, new owner must be participant
                           request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) // Owner must always be an admin
                         )
                       );

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isParticipant(conversationId);
        allow list: if isAuthenticated() && isParticipant(conversationId);
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.senderId &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.participants == null && // Messages don't store participants list
                         request.resource.data.timestamp == request.time && // Allow server timestamp for new messages
                         request.resource.data.text is string &&
                         request.resource.data.keys().hasOnly(['senderId', 'conversationId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet']);
        // No updates or deletes for messages by users to maintain chat history integrity
        allow update, delete: if false;
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
        allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow create: if isAuthenticated() &&
                         request.resource.data.userId is string && // Recipient
                         request.resource.data.senderId == request.auth.uid && // Sender is current user
                         request.resource.data.type is string &&
                         request.resource.data.isRead == false &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasOnly([
                             'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                             'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId', 'textSnippet',
                             'timestamp', 'isRead'
                         ]);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && // Only recipient can update
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.senderId == resource.data.senderId &&
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && // Only allow marking as read
                         request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete their own notifications
    }
  }
}

    