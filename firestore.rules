
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions (can be defined at this level or within specific match blocks if preferred for scoping)
    function isAuthUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Stripe rules (from user's last known good)
    match /customers/{uid} {
      allow read: if isAuthUser(uid);
      match /checkout_sessions/{id} {
        allow read, write: if isAuthUser(uid);
      }
      match /subscriptions/{id} {
        allow read: if isAuthUser(uid);
      }
      match /payments/{id} {
        allow read: if isAuthUser(uid);
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Posts and their subcollections
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                  && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && (
        // Option 1: Owner of the post can update it
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId && // userId cannot change
          request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
          request.resource.data.updatedAt == request.time &&
          // Owner should not directly update commentCount via this rule path unless explicitly sending it.
          // If commentCount is sent, it must be the same as existing (not part of owner's direct editable fields).
          (request.resource.data.keys().hasAny(['commentCount']) == false || request.resource.data.commentCount == resource.data.commentCount)
        ) ||
        // Option 2: Any authenticated user can update ONLY commentCount (increment/decrement) and updatedAt
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
          request.resource.data.updatedAt == request.time
        )
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                      && request.resource.data.timestamp == request.time; // timestamp for comments
        allow update: if request.auth != null && (
          // Option 1: Owner of the comment can update text and mentionedUserIds
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId && 
            request.resource.data.timestamp == resource.data.timestamp && 
            request.resource.data.updatedAt == request.time
          ) ||
          // Option 2: Any authenticated user can update likedBy and likeCount
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId && 
            request.resource.data.text == resource.data.text &&
            request.resource.data.timestamp == resource.data.timestamp &&
            (
              (request.resource.data.likedBy.hasAll(resource.data.likedBy.concat([request.auth.uid])) && 
               request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) || // Adding self
              (resource.data.likedBy.hasAll(request.resource.data.likedBy.concat([request.auth.uid])) &&
               resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1 && // This condition was duplicated, one removeAll
               request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && // Correcting logic for removing
               !request.resource.data.likedBy.hasAny([request.auth.uid])) // User removed
            ) &&
            (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
            request.resource.data.updatedAt == request.time
          )
        );
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                        && request.resource.data.timestamp == request.time;
          allow update: if request.auth != null && (
            (
              resource.data.userId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.updatedAt == request.time
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.text == resource.data.text &&
              request.resource.data.timestamp == resource.data.timestamp &&
              (
                (request.resource.data.likedBy.hasAll(resource.data.likedBy.concat([request.auth.uid])) && 
                 request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) ||
                (resource.data.likedBy.hasAll(request.resource.data.likedBy.concat([request.auth.uid])) &&
                 request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                 !request.resource.data.likedBy.hasAny([request.auth.uid]))
              ) &&
              (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
              request.resource.data.updatedAt == request.time
            )
          );
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }

      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid
                      && request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      // Helper functions specific to conversations for better readability and reuse
      function isAuthUserParticipant(authUid, convData) {
        return authUid != null && convData.participants is list && convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds is list && convData.adminIds.hasAny([authUid]);
      }

      allow get: if request.auth != null && isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if request.auth != null && request.query.limit <= 100; 

      allow create: if request.auth != null && (
        (
          request.resource.data.type == 'direct' &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == 2 &&
          request.resource.data.participants.hasAll([request.auth.uid]) &&
          request.resource.data.ownerId == null &&
          request.resource.data.adminIds is list && request.resource.data.adminIds.size() == 0 &&
          request.resource.data.groupName == null &&
          request.resource.data.groupAvatarUrl == null &&
          request.resource.data.postId == (request.resource.data.postId is string ? request.resource.data.postId : null) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl']) &&
          request.resource.data.keys().size() == 10
        ) ||
        (
          request.resource.data.type == 'group' &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() >= 2 &&
          request.resource.data.participants.hasAll([request.auth.uid]) && 
          request.resource.data.ownerId == request.auth.uid && 
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.hasAll([request.auth.uid]) && 
          request.resource.data.adminIds.size() >= 1 && 
          request.resource.data.participants.hasAll(request.resource.data.adminIds) && 
          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
          request.resource.data.groupAvatarUrl == (request.resource.data.groupAvatarUrl is string ? request.resource.data.groupAvatarUrl : null) &&
          request.resource.data.postId == null && 
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl']) &&
          request.resource.data.keys().size() == 10
        )
      );

      allow update: if request.auth != null && (
        // Branch A: Updating lastMessage, lastMessageSenderId, lastMessageTimestamp, updatedAt (for sending messages)
        // Any participant can do this for both direct and group chats.
        (
          isAuthUserParticipant(request.auth.uid, resource.data) &&
          // Check that the client is ONLY trying to write these specific fields for this action
          request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.writeFields.size() == 4 && // Exactly these four fields are being written
          // Validate the values being written
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time 
        ) ||

        // Branch B: Admin updating groupName or groupAvatarUrl for a 'group' chat
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          // Client can attempt to update groupName, groupAvatarUrl, or both, plus updatedAt
          request.writeFields.has('updatedAt') && 
          (
            (request.writeFields.has('groupName') && request.writeFields.size() == 2) || // Only groupName and updatedAt
            (request.writeFields.has('groupAvatarUrl') && request.writeFields.size() == 2) || // Only groupAvatarUrl and updatedAt
            (request.writeFields.hasAll(['groupName', 'groupAvatarUrl']) && request.writeFields.size() == 3) // Both and updatedAt
          ) &&
          (request.resource.data.groupName == null || (request.resource.data.groupName is string && request.resource.data.groupName.size() > 0)) &&
          (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
          request.resource.data.updatedAt == request.time
        ) ||

        // Branch C: Admin adding members to a 'group' chat
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.writeFields.hasAll(['participants', 'updatedAt']) && 
          request.writeFields.size() == 2 &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() > resource.data.participants.size() && 
          request.resource.data.participants.hasAll(resource.data.participants) && 
          request.resource.data.updatedAt == request.time
        ) ||

        // Branch D: Admin/Owner removing members from a 'group' chat
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) && 
          request.writeFields.hasAll(['participants', 'updatedAt']) &&
          (request.writeFields.size() == 2 || (request.writeFields.size() == 3 && request.writeFields.has('adminIds'))) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() < resource.data.participants.size() && 
          resource.data.participants.hasAll(request.resource.data.participants) && 
          let removedMembers = resource.data.participants.removeAll(request.resource.data.participants);
          removedMembers.size() == 1 && // Ensure only one member is removed at a time by this specific rule action
          let memberToRemove = removedMembers[0];
          (
            (isGroupOwner(request.auth.uid, resource.data) && memberToRemove != resource.data.ownerId) || // Owner can remove any non-owner
            (!isGroupOwner(request.auth.uid, resource.data) && memberToRemove != resource.data.ownerId && !resource.data.adminIds.hasAny([memberToRemove])) // Admin can remove non-owner, non-admin
          ) &&
          ( // If adminIds are being changed, it must be to remove the 'memberToRemove' if they were an admin (only if owner is acting or admin removing non-admin self)
            !request.writeFields.has('adminIds') ||
            (
              request.resource.data.adminIds is list &&
              request.resource.data.adminIds.hasAll(resource.data.adminIds.removeAll([memberToRemove])) &&
              request.resource.data.adminIds.size() == resource.data.adminIds.removeAll([memberToRemove]).size() && // Ensure only the specific member was removed if they were an admin
              (isGroupOwner(request.auth.uid, resource.data) || !resource.data.adminIds.hasAny([memberToRemove])) // Or if the member being removed wasn't an admin
            )
          ) &&
          request.resource.data.updatedAt == request.time
        ) ||

        // Branch E: Owner promoting/demoting an admin (who is not the owner) for a 'group' chat
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.writeFields.hasAll(['adminIds', 'updatedAt']) && 
          request.writeFields.size() == 2 &&
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.size() >= 1 && 
          request.resource.data.adminIds.hasAll([resource.data.ownerId]) && 
          resource.data.participants.hasAll(request.resource.data.adminIds) && 
          request.resource.data.updatedAt == request.time
        ) ||

        // Branch F: Participant leaving a 'group' chat
        (
          resource.data.type == 'group' &&
          isAuthUserParticipant(request.auth.uid, resource.data) && 
          request.writeFields.hasAll(['participants', 'updatedAt']) &&
          (request.writeFields.size() == 2 || (request.writeFields.size() == 3 && request.writeFields.has('adminIds'))) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == resource.data.participants.size() - 1 && 
          request.resource.data.participants.hasAll(resource.data.participants.removeAll([request.auth.uid])) == false && 
          resource.data.participants.removeAll([request.auth.uid]) == request.resource.data.participants && 
          ( 
            !request.writeFields.has('adminIds') ||
            (request.resource.data.adminIds is list && request.resource.data.adminIds == resource.data.adminIds.removeAll([request.auth.uid]))
          ) &&
          !( 
            isGroupOwner(request.auth.uid, resource.data) &&
            resource.data.adminIds.size() == 1 && resource.data.adminIds[0] == request.auth.uid &&
            request.resource.data.participants.size() > 0 
          ) &&
          request.resource.data.updatedAt == request.time
        )
      );

      match /messages/{messageId} {
        allow read: if request.auth != null && isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if request.auth != null
                    && isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.timestamp == request.time;
        allow update, delete: if false; // Messages are immutable once created
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds is list && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds is list
                    && request.resource.data.userIds.hasAll([request.auth.uid])
                    && request.resource.data.requestedAt == request.time;
      allow update: if request.auth != null && resource.data.userIds is list && resource.data.userIds.hasAny([request.auth.uid])
                    && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.userIds is list && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId // Ensure docId matches field for security
                   && request.resource.data.lastUpdatedBy == request.auth.uid
                   && request.resource.data.lastUpdatedAt == request.time;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null; 
      allow update: if request.auth != null && resource.data.userId == request.auth.uid; 
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid; 
    }

    // User profiles
    match /users/{userId} {
      allow get: if true; 
      allow list: if request.auth != null; 
      allow create: if request.auth != null && request.auth.uid == userId 
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == userId 
                  && request.resource.data.uid == resource.data.uid 
                  && request.resource.data.email == resource.data.email 
                  && request.resource.data.createdAt == resource.data.createdAt 
                  && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId; 
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; 
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && resource.data.reviewerId == request.auth.uid
                    && request.resource.data.reviewerId == resource.data.reviewerId 
                    && request.resource.data.targetUserId == resource.data.targetUserId 
                    && request.resource.data.createdAt == resource.data.createdAt 
                    && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }

    // Fallback rule: Deny by default for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    