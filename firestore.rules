
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner(docData) {
      return isAuthenticated() && request.auth.uid == docData.ownerId;
    }
    
    function isPostOwner(postId) {
      return isAuthenticated() && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
    }

    function isCommentOwner(postId, commentId) {
      return isAuthenticated() && get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId == request.auth.uid;
    }

    function isSubCommentOwner(postId, commentId, subCommentId) {
      return isAuthenticated() && get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/subcomments/$(subCommentId)).data.userId == request.auth.uid;
    }
    
    function isReviewer(reviewData) {
        return isAuthenticated() && request.auth.uid == reviewData.reviewerId;
    }
    
    function isCollectionOwner(collectionData) {
        return isAuthenticated() && request.auth.uid == collectionData.ownerId;
    }

    function isPlanOwner(planData) {
      return isAuthenticated() && request.auth.uid == planData.ownerId;
    }
    
    function isNewsArticleAuthor(articleData) {
        return isAuthenticated() && request.auth.uid == articleData.userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true; // Public profiles are generally readable
      allow create: if isSelf(userId) &&
                      request.resource.data.uid == userId &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.lastLoginAt == request.time &&
                      (request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0) &&
                      (request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase.size() > 0);
      allow update: if isSelf(userId) &&
                      request.resource.data.uid == userId &&
                      request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.email == resource.data.email && // Email shouldn't change via profile update typically
                      request.resource.data.mentionName == resource.data.mentionName && // Mention name is fixed
                      request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'tags',
                        'established', 'lastLoginAt', 'updatedAt', 'incomeRange',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode' // Allowed NAICS fields
                      ]);
    }

    // --- Posts Collection ---
    match /posts/{postId} {
      allow read: if true; // Posts are generally public
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.createdAt == request.time &&
                      (request.resource.data.commentCount == 0) &&
                      (request.resource.data.ratingScore is number);
                      // Add other required field checks if necessary
      allow update: if isAuthenticated() && (
                      (isPostOwner(postId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'requestType', 'maxBudget', 'deadline', 'imageUrls', 'mentionedUserIds', 'updatedAt'])) ||
                      (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt'])
                    );
      allow delete: if isPostOwner(postId);

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.postId == postId &&
                        request.resource.data.timestamp == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        (request.resource.data.likeCount == 0) &&
                        (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0);
        allow update: if isAuthenticated() && // For liking/unliking
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.timestamp == resource.data.timestamp &&
                        request.resource.data.text == resource.data.text && // Text cannot change
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                        (
                          (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy[request.resource.data.likedBy.size()-1] == request.auth.uid) || // Adding own like
                          (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]))    // Removing own like
                        ) &&
                        (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1);
        allow delete: if isCommentOwner(postId, commentId);

        // --- SubComments (Replies) Subcollection ---
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if isAuthenticated() &&
                          request.resource.data.userId == request.auth.uid &&
                          request.resource.data.timestamp == request.time &&
                          request.resource.data.updatedAt == request.time &&
                          (request.resource.data.likeCount == 0) &&
                          (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0);
          allow update: if isAuthenticated() && // For liking/unliking subcomments
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.text == resource.data.text && // Text cannot change
                          request.resource.data.updatedAt == request.time &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                           (
                            (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy[request.resource.data.likedBy.size()-1] == request.auth.uid) || // Adding own like
                            (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]))    // Removing own like
                          ) &&
                          (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1);
          allow delete: if isSubCommentOwner(postId, commentId, subCommentId);
        }
      }

      // --- Bids Subcollection ---
      match /bids/{bidId} {
        allow read: if isAuthenticated(); // Or more specific if needed
        allow create: if isAuthenticated() &&
                        request.resource.data.bidderId == request.auth.uid &&
                        request.resource.data.postId == postId &&
                        request.resource.data.timestamp == request.time &&
                        get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid; // Cannot bid on own post
        // allow update, delete if necessary (e.g., bidder can retract or update bid if post owner hasn't accepted)
      }
    }
    
    // --- News Articles Collection ---
    match /newsArticles/{articleId} {
      allow read: if resource.data.status == 'published' || 
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null) &&
                      (request.resource.data.commentCount == 0);
      allow update: if isAuthenticated() &&
                      isNewsArticleAuthor(resource.data) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time &&
                      // Only allow specific fields to be updated for articles
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title', 'content', 'status', 'coverImageUrl', 'tags', 'updatedAt', 'publishedAt', 
                        'draftContent', 'hasUnpublishedChanges',
                        'sector', 'subSector', 'industry', 'naicsCode', 'requestType', 'question',
                        'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline',
                        'imageUrls', 'mentionedUserIds'
                        // commentCount and ratingScore typically updated by backend or other triggers
                      ]);
      allow delete: if isAuthenticated() && isNewsArticleAuthor(resource.data);
    }

    // --- Article Tags Collection ---
    match /articleTags/{tagId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
                        request.resource.data.createdBy == request.auth.uid &&
                        request.resource.data.createdAt == request.time &&
                        (request.resource.data.usageCount == 1 || request.resource.data.usageCount == 0); // initial create or reset
        allow update: if isAuthenticated() && // Allow incrementing/decrementing usageCount
                        request.resource.data.createdBy == resource.data.createdBy &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.name == resource.data.name &&
                        request.resource.data.nameLowercase == resource.data.nameLowercase &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
                        (request.resource.data.usageCount == resource.data.usageCount + 1 || request.resource.data.usageCount == resource.data.usageCount - 1 || request.resource.data.usageCount == 0);
        // Delete might not be needed for tags, or restricted to admins
    }
    
    // --- Reviews Collection ---
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        allow create: if isAuthenticated() && 
                        request.resource.data.reviewerId == request.auth.uid &&
                        request.resource.data.targetUserId != request.auth.uid && // Can't review self
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time;
        allow update: if isAuthenticated() && 
                        isReviewer(resource.data) &&
                        request.resource.data.reviewerId == resource.data.reviewerId &&
                        request.resource.data.targetUserId == resource.data.targetUserId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
        allow delete: if isAuthenticated() && isReviewer(resource.data);
    }

    // --- Mutuals (Connections) Collection ---
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() && 
                      request.resource.data.requesterId == request.auth.uid &&
                      request.auth.uid in request.resource.data.userIds &&
                      request.resource.data.userIds.size() == 2 &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.requestedAt == request.time &&
                      request.resource.data.updatedAt == request.time; // Ensure updatedAt on create
      allow update: if isAuthenticated() && 
                      request.auth.uid in resource.data.userIds &&
                      request.resource.data.userIds == resource.data.userIds && // userIds array cannot change
                      request.resource.data.requesterId == resource.data.requesterId && // requester cannot change
                      request.resource.data.requestedAt == resource.data.requestedAt && // requestedAt cannot change
                      request.resource.data.updatedAt == request.time && // Ensure updatedAt is set by server
                      (
                        // Accepting a request
                        (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                         request.resource.data.requesterId != request.auth.uid && // Acceptor is not original requester
                         request.resource.data.connectedAt == request.time && // Ensure connectedAt on accept
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])) ||
                        // A hypothetical block action (not fully implemented in app yet)
                        (request.resource.data.status == 'blocked' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                      );
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Both users can cancel/remove
    }

    // --- User Preferences Collection ---
    match /userPreferences/{userId} {
      allow read, write: if isSelf(userId);
      // More granular create/update if needed:
      // allow create: if isSelf(userId) && request.resource.data.userId == userId && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // allow update: if isSelf(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
    }
    
    // --- Conversations Collection ---
    match /conversations/{conversationId} {
        allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
        allow create: if isAuthenticated() && 
                        request.auth.uid in request.resource.data.participants &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        (
                          (request.resource.data.type == 'direct' && request.resource.data.participants.size() == 2 && request.resource.data.ownerId == null && request.resource.data.adminIds.size() == 0 && request.resource.data.groupName == null && request.resource.data.groupAvatarUrl == null) ||
                          (request.resource.data.type == 'group' && request.resource.data.participants.size() >= 2 && request.resource.data.ownerId == request.auth.uid && request.resource.data.adminIds.hasAll([request.auth.uid]) && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0)
                        );
        allow update: if isAuthenticated() && 
                        request.auth.uid in resource.data.participants &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.participants.hasAll(resource.data.participants) && // Participants can only be added to, or current user removed
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        (
                            // Updating last message details
                            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                            // Group admin updating group details (name, avatar)
                            (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds &&
                             request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'ownerId', 'updatedAt'])) ||
                            // User leaving a group (only 'participants' and 'updatedAt' changes)
                            (resource.data.type == 'group' && 
                             !request.resource.data.participants.hasAny([request.auth.uid]) && // current user is removed
                             resource.data.participants.size() == request.resource.data.participants.size() + 1 && // only one user removed
                             request.resource.data.adminIds == resource.data.adminIds && // admins cannot change unless owner
                             request.resource.data.ownerId == resource.data.ownerId && // owner cannot change
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']))
                        );

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && 
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                        request.resource.data.senderId == request.auth.uid &&
                        request.resource.data.conversationId == conversationId &&
                        request.resource.data.timestamp == request.time;
        // Messages are typically immutable once created, no updates/deletes unless for moderation
      }
    }
    
    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.userId); // User can read their own notifications
      allow create: if isAuthenticated(); // Any authenticated user can trigger creation of a notification for another user (e.g., by liking, commenting, etc.)
                                        // Service function should ensure senderId is request.auth.uid
      allow update: if isSelf(resource.data.userId) && // User can mark their own notification as read
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) &&
                      request.resource.data.updatedAt == request.time;
      // allow delete: if isSelf(resource.data.userId); // Optionally allow users to delete their notifications
    }

    // --- Collections ---
    match /collections/{collectionId} {
        allow read: if isAuthenticated() && (isCollectionOwner(resource.data) || request.auth.uid in resource.data.sharedWithUserIds);
        allow create: if isAuthenticated() && 
                        isCollectionOwner(request.resource.data) && 
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.postIds is list && // Must be a list
                        request.resource.data.sharedWithUserIds is list; // Must be a list
        allow update: if isAuthenticated() &&
                        isCollectionOwner(resource.data) &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
        allow delete: if isAuthenticated() && isCollectionOwner(resource.data);
    }

    // --- Plans Collection ---
    match /plans/{planDocId} { // Renamed to planDocId to avoid conflict
      function canViewPlan(plan) {
        return plan.visibility == 'public' ||
               plan.visibility == 'unlisted' || // Unlisted implies anyone with link (auth user) can see
               (plan.visibility == 'private' && request.auth.uid in plan.viewUserIds);
      }
      function canEditPlan(plan) {
        return request.auth.uid == plan.ownerId ||
               (plan.editability == 'collaborators' && request.auth.uid in plan.editUserIds) ||
               (plan.editability == 'everyone' && canViewPlan(plan)); // 'everyone' implies anyone who can view can edit
      }

      allow read: if isAuthenticated() && canViewPlan(resource.data);
      allow create: if isAuthenticated() && 
                      request.resource.data.ownerId == request.auth.uid &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.version == 1 &&
                      (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public') &&
                      (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone');
      allow update: if isAuthenticated() &&
                      canEditPlan(resource.data) && // Roadmap can be edited by those with edit permission
                      request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                      request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                      request.resource.data.updatedAt == request.time &&
                      (
                        // General roadmap update
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) && 
                         request.resource.data.version == resource.data.version + 1) ||
                        // Owner updating settings (name, description, visibility, editability, view/editUserIds)
                        (isPlanOwner(resource.data) && request.resource.data.version == resource.data.version && // Version doesn't change for settings update
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt']))
                      );
      // allow delete: if isPlanOwner(resource.data); // Consider adding delete rule

      match /versions/{versionId} {
        allow read: if isAuthenticated() && canViewPlan(get(/databases/$(database)/documents/plans/$(planDocId)).data); // Users who can view plan can view its history
        allow create: if isAuthenticated() && // Only when updating main plan roadmap
                        request.resource.data.editorUid == request.auth.uid &&
                        request.resource.data.timestamp == request.time &&
                        request.resource.data.planId == planDocId &&
                        canEditPlan(get(/databases/$(database)/documents/plans/$(planDocId)).data);
        // Versions are immutable
        allow update, delete: if false;
      }
    }
  }
}

    