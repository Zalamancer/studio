
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions (if any, otherwise scope them)
    function isAuthUser() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthUser();
      allow create: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       (request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0) &&
                       (request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase.size() > 0);
      allow update: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId && // uid cannot change
                       request.resource.data.email == resource.data.email && // email cannot change via this
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt immutable
                       request.resource.data.updatedAt == request.time; // updatedAt must be server time
      // Add rules for userPreferences subcollection if needed later
      match /userPreferences/{prefId} {
        allow read, write: if isAuthUser() && request.auth.uid == userId && prefId == userId;
      }
    }

    match /posts/{postId} {
      allow read: if true; // Publicly readable for now
      allow list: if true; // Publicly listable for now
      allow create: if isAuthUser() && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       // Ensure required fields are present
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.tags is list &&
                       request.resource.data.sector is string &&
                       request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request');
      allow update: if isAuthUser() && request.auth.uid == resource.data.userId &&
                       // Allow updating only specific fields if needed, e.g., commentCount
                       request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount -1;
      allow delete: if isAuthUser() && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow list: if true; // Or restrict if needed
        allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0;
        allow update: if isAuthUser() && request.auth.uid == resource.data.userId &&
                         // Only allow liking/unliking or specific edits by owner
                         (
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt'])) ||
                           (request.resource.data.text != resource.data.text && request.resource.data.updatedAt == request.time)
                         ) &&
                         request.resource.data.timestamp == resource.data.timestamp; // Original timestamp immutable

        allow delete: if isAuthUser() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0;
          allow update: if isAuthUser() && request.auth.uid == resource.data.userId &&
                           (
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']))
                           ) &&
                           request.resource.data.timestamp == resource.data.timestamp;
          allow delete: if isAuthUser() && request.auth.uid == resource.data.userId;
        }
      }
       match /bids/{bidId} {
          allow read: if isAuthUser() && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid || request.resource.data.bidderId == request.auth.uid;
          allow list: if isAuthUser() && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
          allow create: if isAuthUser() &&
                           request.resource.data.bidderId == request.auth.uid &&
                           request.resource.data.postId == postId &&
                           get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid && // Can't bid on own post
                           request.resource.data.timestamp == request.time;
          allow update, delete: if false; // Bids are typically not updated or deleted by client
       }
    }

    match /mutuals/{connectionId} {
      function getOtherUserId(userIds) {
        return userIds[0] == request.auth.uid ? userIds[1] : userIds[0];
      }
      function isValidMutualDocId(docId) {
        let parts = docId.split('_');
        return parts.size() == 2 && parts[0] < parts[1]; // Enforce sorted UIDs in doc ID
      }
      allow read: if isAuthUser() && request.auth.uid in resource.data.userIds && isValidMutualDocId(connectionId);
      allow create: if isAuthUser() &&
                       isValidMutualDocId(connectionId) &&
                       request.resource.data.userIds[0] < request.resource.data.userIds[1] && // Ensure sorted in data too
                       request.auth.uid in request.resource.data.userIds &&
                       request.resource.data.requesterId == request.auth.uid &&
                       getOtherUserId(request.resource.data.userIds) != request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                       request.resource.data.keys().size() == 5 && // Exact fields for initial request
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      allow update: if isAuthUser() &&
                       isValidMutualDocId(connectionId) &&
                       request.auth.uid in resource.data.userIds && // Original user must be part of connection
                       request.auth.uid in request.resource.data.userIds && // User must remain part of connection
                       request.resource.data.userIds == resource.data.userIds && // userIds array cannot change
                       request.resource.data.requesterId == resource.data.requesterId && // requesterId cannot change
                       request.resource.data.requestedAt == resource.data.requestedAt && // requestedAt cannot change
                       request.resource.data.updatedAt == request.time &&
                       (
                         // Accepting a request
                         (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                          resource.data.requesterId != request.auth.uid && // Acceptor is not the original requester
                          request.resource.data.connectedAt == request.time &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']))
                       );
      allow delete: if isAuthUser() &&
                       isValidMutualDocId(connectionId) &&
                       request.auth.uid in resource.data.userIds &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected'); // Allow delete if pending (cancel/reject) or connected (remove)
    }

    match /conversations/{conversationId} {
      // Helper functions scoped to /conversations path
      function isAuthUser() { // Re-define locally or use global if defined once
        return request.auth != null;
      }
      function isAuthUserParticipant(authUid, convData) {
        // Ensure convData and convData.participants are not null before accessing hasAny
        return convData != null && convData.participants != null && convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }
      function isDirectChatCreate() {
        return request.resource.data.type == 'direct' &&
               request.resource.data.participants.size() == 2 &&
               request.resource.data.participants.hasAll([request.auth.uid]) &&
               // For direct chats, these group-specific fields must be null or not present
               request.resource.data.groupName == null &&
               request.resource.data.groupAvatarUrl == null &&
               request.resource.data.ownerId == null &&
               request.resource.data.adminIds.size() == 0 &&
               // postId can be null (general chat) or a string (post-related chat)
               (request.resource.data.postId == null || request.resource.data.postId is string) &&
               request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time &&
               request.resource.data.lastMessageTimestamp == request.time &&
               request.resource.data.formerParticipants == {} && // Must be empty on create
               request.resource.data.keys().hasOnly([
                 'participants', 'type', 'postId',
                 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt',
                 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'formerParticipants' // List all possible fields
               ]);
      }
      function isGroupChatCreate() {
        return request.resource.data.type == 'group' &&
               request.resource.data.ownerId == request.auth.uid &&
               request.resource.data.adminIds.hasAll([request.auth.uid]) &&
               request.resource.data.adminIds.size() == 1 &&
               request.resource.data.participants.hasAll([request.auth.uid]) &&
               request.resource.data.participants.size() >= 2 &&
               request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
               (!('groupAvatarUrl' in request.resource.data) || request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
               request.resource.data.postId == null && // New groups usually not tied to a post initially via this rule
               request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time &&
               request.resource.data.lastMessageTimestamp == request.time &&
               request.resource.data.formerParticipants == {} && // Must be empty on create
               request.resource.data.keys().hasOnly([
                 'participants', 'type', 'groupName', 'groupAvatarUrl',
                 'ownerId', 'adminIds', 'postId',
                 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'formerParticipants'
               ]);
      }

      allow read: if isAuthUser() && isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if isAuthUser() && request.query.limit <= 50;

      allow create: if isAuthUser() && (
        (isDirectChatCreate()) ||
        (isGroupChatCreate())
      );

      allow update: if isAuthUser() && (
        // Branch A: Sending a message (for any active participant, direct or group)
        (
          isAuthUserParticipant(request.auth.uid, resource.data) &&
          // User must not be in formerParticipants (or formerParticipants must not contain user's UID as a key)
          (resource.data.formerParticipants == null || !resource.data.formerParticipants.keys().hasAny([request.auth.uid])) &&
          request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.writeFields.size() == 4 &&
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          // Ensure other essential fields are NOT being modified by this specific "send message" operation
          request.resource.data.type == resource.data.type &&
          request.resource.data.participants == resource.data.participants && // Participants list must not change here
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.formerParticipants == resource.data.formerParticipants // formerParticipants map should not be changed by send message op
        ) ||
        // Branch B: Changing group name or avatar (only by group admin who is an active participant)
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          (resource.data.formerParticipants == null || !resource.data.formerParticipants.keys().hasAny([request.auth.uid])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
          // Validate groupName if changed
          (request.resource.data.groupName == resource.data.groupName || (request.resource.data.groupName is string && request.resource.data.groupName.size() > 0)) &&
          // Validate groupAvatarUrl if changed (can be null or string)
          (request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl || request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
          // Protect immutable and other fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds && // adminIds list itself not changed here
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastMessage == resource.data.lastMessage &&
          request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
          request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
          request.resource.data.formerParticipants == resource.data.formerParticipants &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch C: Adding members to a group (only by group admin who is an active participant)
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          (resource.data.formerParticipants == null || !resource.data.formerParticipants.keys().hasAny([request.auth.uid])) &&
          request.resource.data.participants.size() > resource.data.participants.size() && // New members are added
          request.resource.data.participants.hasAll(resource.data.participants) && // All old members must still be present
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          // Protect immutable and other fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds && // Admin list not changed by this action
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastMessage == resource.data.lastMessage &&
          request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
          request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
          request.resource.data.formerParticipants == resource.data.formerParticipants &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch D: Promoting/Demoting Admin (only by group owner who is an active participant)
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) && // Only owner can change admin list
          (resource.data.formerParticipants == null || !resource.data.formerParticipants.keys().hasAny([request.auth.uid])) &&
          request.resource.data.adminIds != resource.data.adminIds && // Admin list must change
          request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain an admin
          // Ensure all new admins are existing participants
          request.resource.data.adminIds.size() == 0 || request.resource.data.participants.hasAll(request.resource.data.adminIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          // Protect immutable and other fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastMessage == resource.data.lastMessage &&
          request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
          request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
          request.resource.data.formerParticipants == resource.data.formerParticipants &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch E: Removing a member from group (only by group admin who is an active participant, cannot remove owner)
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          (resource.data.formerParticipants == null || !resource.data.formerParticipants.keys().hasAny([request.auth.uid])) &&
          request.resource.data.participants.size() < resource.data.participants.size() && // Members are removed
          // Ensure the user being removed is not the owner
          (!resource.data.participants.hasAny(request.resource.data.participants) || resource.data.participants.removeAll(request.resource.data.participants).hasAny([resource.data.ownerId]) == false) &&
          request.resource.data.adminIds.hasAll(request.resource.data.adminIds.removeAll(resource.data.participants.removeAll(request.resource.data.participants))) && // If removed user was admin, they are also removed from adminIds
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          // Protect immutable and other fields (similar to Branch C)
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastMessage == resource.data.lastMessage &&
          request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
          request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
          request.resource.data.formerParticipants == resource.data.formerParticipants &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch F: Participant leaving (USER'S DIFF APPLIED HERE)
        (
          resource.data.type == 'group' &&
          isAuthUserParticipant(request.auth.uid, resource.data) && // Current user must be a participant to leave
          // Ensure user is NOT ALREADY in formerParticipants (cannot leave twice without rejoining)
          (resource.data.formerParticipants == null || !resource.data.formerParticipants.keys().hasAny([request.auth.uid])) &&
          // Check that the client is ONLY trying to modify these specific fields related to leaving
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'formerParticipants', 'updatedAt']) &&
          // Participants list must change (current user removed)
          request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
          !request.resource.data.participants.hasAny([request.auth.uid]) &&
          // AdminIds list might change (if leaving user was admin)
          (request.resource.data.adminIds.size() == resource.data.adminIds.size() || request.resource.data.adminIds.size() == resource.data.adminIds.size() - 1) &&
          !request.resource.data.adminIds.hasAny([request.auth.uid]) && // User is removed from adminIds if they were one
          // Owner safeguard: if owner is leaving, they must still be in participants after this update (means they cannot leave if group has other members unless logic is changed)
          // This rule is complex: an owner leaving generally means deleting the group or transferring ownership, which is not handled here.
          // For now, let's assume owner cannot leave if other participants exist, UNLESS this rule is specifically for removing self from participants list while remaining owner (which is odd).
          // The client-side `leaveGroup` provided removes from participants. If owner calls it, `isGroupOwner` check below fails.
          // A simple owner leaving:
          (resource.data.ownerId != request.auth.uid || (resource.data.participants.size() == 1 && request.resource.data.participants.size() == 0)) &&
          // Ensure other fields are not changed
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastMessage == resource.data.lastMessage &&
          request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
          request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
          // Ensure only this user's entry is added/updated in formerParticipants
          request.resource.data.formerParticipants.affectedKeys().hasOnly([request.auth.uid]) &&
          // Record leave time & update timestamp
          request.resource.data.formerParticipants[request.auth.uid] == request.time &&
          request.resource.data.updatedAt == request.time
        )
      ); // Semicolon terminates the allow update rule.

      allow delete: if false; // Or define specific deletion rules if needed (e.g., owner deletes empty group)

      match /messages/{messageId} {
        // Helper function specific to messages subcollection
        function canViewMessage() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          // 1️⃣ Still a participant → full access
          // Check if participants exists and is a list before calling hasAny
          if (conv.participants != null && conv.participants is list && conv.participants.hasAny([request.auth.uid]))   { return true; }
          // 2️⃣ Former participant → only up to leave-time
          // Check if formerParticipants exists and is a map, and then if keys() exists and is a list
          if (conv.formerParticipants != null && conv.formerParticipants is map &&
              conv.formerParticipants.keys() != null && conv.formerParticipants.keys() is list &&
              conv.formerParticipants.keys().hasAny([request.auth.uid])) {
            // Ensure resource.data.timestamp is a Timestamp before comparing
            return resource.data.timestamp is timestamp && conv.formerParticipants[request.auth.uid] is timestamp &&
                   resource.data.timestamp <= conv.formerParticipants[request.auth.uid];
          }
          return false; // Default if not active and not valid former participant
        } // END OF canViewMessage FUNCTION

        // Local helper for message creation
        function isMessageSender() {
          return request.resource.data.senderId == request.auth.uid;
        }
        function isMessageCreateValid() {
          // Check that the sender is an active participant of the conversation
          let convData = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return convData.participants.hasAny([request.auth.uid]) &&
                 (convData.formerParticipants == null || !convData.formerParticipants.keys().hasAny([request.auth.uid])) &&
                 request.resource.data.timestamp == request.time &&
                 request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                 request.resource.data.read == false &&
                 request.resource.data.conversationId == conversationId &&
                 // Ensure only allowed fields are present
                 request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId']);
        }

        allow read: if isAuthUser() && canViewMessage();
        allow list: if isAuthUser() && canViewMessage(); // Apply same logic for listing
        allow create: if isAuthUser() && isMessageSender() && isMessageCreateValid();
        allow update: if false; // Generally messages are not updated by client
        allow delete: if false; // Generally messages are not deleted by client
      } // End of messages match
    } // End of conversations match

    match /notifications/{notificationId} {
      allow read, list: if isAuthUser() && resource.data.userId == request.auth.uid;
      allow create: if isAuthUser() && request.resource.data.userId != request.auth.uid && // Cannot create for self directly via rule
                       request.resource.data.senderId == request.auth.uid && // Sender must be authenticated user
                       request.resource.data.timestamp == request.time;
      allow update: if isAuthUser() && resource.data.userId == request.auth.uid &&
                       request.resource.data.isRead == true && // Only allow marking as read
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid; // User can delete their own notifications
    }

    match /whiteboardAnnotations/{docId} {
      allow read: if true; // Publicly readable for now
      allow write: if isAuthUser() &&
                      request.resource.data.naicsCode == docId &&
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time;
    }

  } // End of match /databases/{database}/documents
} // End of service cloud.firestore

    