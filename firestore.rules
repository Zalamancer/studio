rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthUser() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profile info
      allow create: if isAuthUser() &&
                       isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.mentionName != null &&
                       request.resource.data.mentionNameLowercase != null &&
                       // Ensure initial required fields are present if any
                       (!('companyName' in request.resource.data) || request.resource.data.companyName is string || request.resource.data.companyName == null) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time;
      allow update: if isAuthUser() &&
                       isOwner(userId) &&
                       request.resource.data.uid == resource.data.uid && // Cannot change UID
                       request.resource.data.email == resource.data.email && // Cannot change email
                       request.resource.data.mentionName == resource.data.mentionName && // Cannot change mentionName
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // Cannot change mentionNameLowercase
                       request.resource.data.companyName == resource.data.companyName && // Cannot change companyName through this
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                       request.resource.data.updatedAt == request.time && // updatedAt must be server timestamp
                       // Allow specific fields to be updated
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                       (!('description' in request.resource.data) || request.resource.data.description is string || request.resource.data.description == null) &&
                       (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                       (!('established' in request.resource.data) || request.resource.data.established is string || request.resource.data.established == null) &&
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange is string || request.resource.data.incomeRange == null) &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName is string || request.resource.data.sectorName == null) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName is string || request.resource.data.subSectorName == null) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName is string || request.resource.data.industryName == null) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                       request.writeFields.hasAny(['avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established', 'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'lastLoginAt', 'updatedAt']);
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if isAuthUser() && isOwner(userId);
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true; // Or restrict as needed, e.g., if request.auth != null;
      allow write: if isAuthUser() &&
                      request.resource.data.naicsCode == naicsCode && // Ensure correct doc ID relation
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time;
                      // Add further validation for shapes array content if necessary
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if isAuthUser() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       // Ensure all required fields are present
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() > 0 &&
                       request.resource.data.tags is list &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       request.resource.data.requestType in ['post', 'help_request'] &&
                       request.resource.data.commentCount == 0;

      allow update: if isAuthUser() &&
                      // Branch A: Post owner updating their post (excluding commentCount)
                      (
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.userId == resource.data.userId && // Cannot change owner
                        request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                        // Allow updating specific fields by owner
                        request.writeFields.hasAny(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'maxBudget', 'deadline', 'updatedAt', 'requestType']) &&
                        // Ensure other fields are not illicitly changed by ensuring they match resource.data if not in writeFields
                        (request.writeFields.has('commentCount') == false || request.resource.data.commentCount == resource.data.commentCount) &&
                        request.resource.data.updatedAt == request.time // Optional: Enforce updatedAt only by server for owner edits too
                      ) ||
                      // Branch B: Any authenticated user updating commentCount (and only commentCount + updatedAt)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                        request.resource.data.updatedAt == request.time &&
                        // Ensure all other fields are unchanged
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.question == resource.data.question &&
                        request.resource.data.tags == resource.data.tags &&
                        request.resource.data.sector == resource.data.sector &&
                        request.resource.data.subSector == resource.data.subSector &&
                        request.resource.data.industry == resource.data.industry &&
                        request.resource.data.naicsCode == resource.data.naicsCode &&
                        request.resource.data.ratingScore == resource.data.ratingScore &&
                        request.resource.data.imageUrls == resource.data.imageUrls &&
                        request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                        request.resource.data.requestType == resource.data.requestType &&
                        request.resource.data.descriptionDetails == resource.data.descriptionDetails &&
                        request.resource.data.descriptionTried == resource.data.descriptionTried &&
                        request.resource.data.descriptionOutcome == resource.data.descriptionOutcome &&
                        request.resource.data.maxBudget == resource.data.maxBudget &&
                        request.resource.data.deadline == resource.data.deadline &&
                        request.resource.data.createdAt == resource.data.createdAt
                      );
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true; // Comments are public if post is public
        allow create: if isAuthUser() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time && // Add updatedAt for comments
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0;
        allow update: if isAuthUser() &&
                        // Branch A: Owner updating their comment text or mentions
                        (
                          resource.data.userId == request.auth.uid &&
                          request.writeFields.hasAny(['text', 'mentionedUserIds', 'updatedAt']) &&
                          !request.writeFields.hasAny(['userId', 'timestamp', 'likeCount', 'likedBy']) && // Cannot change owner, timestamp, or likes here
                          request.resource.data.updatedAt == request.time
                        ) ||
                        // Branch B: Any authenticated user liking/unliking (only likeCount, likedBy, updatedAt can change)
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                          (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                          request.resource.data.updatedAt == request.time &&
                           // Ensure core comment fields are unchanged
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.text == resource.data.text &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.mentionedUserIds == resource.data.mentionedUserIds
                        );
        allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

        // SubComments (Replies to Comments)
        match /subcomments/{subCommentId} {
            allow read: if true; // Publicly readable
            allow create: if isAuthUser() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0;
            allow update: if isAuthUser() &&
                            // Branch A: Owner updating their subcomment text or mentions
                            (
                              resource.data.userId == request.auth.uid &&
                              request.writeFields.hasAny(['text', 'mentionedUserIds', 'updatedAt']) &&
                              !request.writeFields.hasAny(['userId', 'timestamp', 'likeCount', 'likedBy']) &&
                              request.resource.data.updatedAt == request.time
                            ) ||
                            // Branch B: Any authenticated user liking/unliking subcomment
                            (
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                              (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                              request.resource.data.updatedAt == request.time &&
                              // Ensure core subcomment fields are unchanged
                              request.resource.data.userId == resource.data.userId &&
                              request.resource.data.text == resource.data.text &&
                              request.resource.data.timestamp == resource.data.timestamp &&
                              request.resource.data.mentionedUserIds == resource.data.mentionedUserIds
                            );
            allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;
        }
      }
      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if isAuthUser() &&
                      get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid; // Only post owner can read bids
        allow create: if isAuthUser() &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                         // Post owner cannot bid on their own post
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        // No updates or deletes for bids for now to keep it simple
        allow update, delete: if false;
      }
    }

    // Connections / Mutuals
    match /mutuals/{connectionId} {
      function isUserInMutualConnection(authUid, mutualData) {
        return authUid != null &&
               mutualData != null &&
               mutualData.userIds != null &&
               mutualData.userIds is list && // Corrected type check
               mutualData.userIds.hasAny([authUid]);
      }

      allow get: if isAuthUser() && isUserInMutualConnection(request.auth.uid, resource.data);
      allow list: if isAuthUser(); // Query then filtered by 'get' rule
      allow create: if isAuthUser() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isAuthUser() &&
                       isUserInMutualConnection(request.auth.uid, resource.data) &&
                       // Scenario 1: Accepting a request (recipient updates)
                       (
                         resource.data.status == 'pending' &&
                         resource.data.requesterId != request.auth.uid && // Recipient is acting
                         request.resource.data.status == 'connected' &&
                         request.resource.data.connectedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.userIds == resource.data.userIds && // userIds cannot change
                         request.resource.data.requesterId == resource.data.requesterId // requesterId cannot change
                       );
      allow delete: if isAuthUser() &&
                       isUserInMutualConnection(request.auth.uid, resource.data) &&
                       // Allow deletion if:
                       // 1. Request is pending and acting user is part of it
                       // 2. Connection is established and acting user is part of it
                       (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, list, update: if isAuthUser() && resource.data.userId == request.auth.uid;
      allow create: if isAuthUser() &&
                       request.resource.data.userId != request.auth.uid && // Cannot create for self
                       request.resource.data.senderId == request.auth.uid &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false;
      // No direct delete for now, notifications might be cleared via a function or TTL
      allow delete: if false;
    }

    // Conversations
    match /conversations/{conversationId} {
      // --- Helper Functions for Conversations ---
      function isAuthUserParticipant(authUid, convData) {
        return authUid != null &&
               convData != null &&
               convData.participants != null &&
               convData.participants is list &&
               convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }

      // --- Rules for Conversations ---
      allow get, list: if isAuthUser() && isAuthUserParticipant(request.auth.uid, resource.data);

      allow create: if isAuthUser() &&
                      // Direct Chat Creation
                      (
                        request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.participants.hasAny([request.auth.uid]) &&
                        // Ensure no group-specific fields are set for direct chats
                        !('groupName' in request.resource.data) &&
                        !('groupAvatarUrl' in request.resource.data) &&
                        !('ownerId' in request.resource.data) &&
                        (!('adminIds' in request.resource.data) || request.resource.data.adminIds.size() == 0) &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Group Chat Creation
                      (
                        request.resource.data.type == 'group' &&
                        request.resource.data.ownerId == request.auth.uid &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                        request.resource.data.participants.hasAll([request.auth.uid]) &&
                        request.resource.data.participants.size() >= 2 &&
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time
                      );

      allow update: if isAuthUser() &&
                      // Branch A: Sending a message (for any participant, direct or group)
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                        request.writeFields.size() == 4 &&
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        // Ensure other essential fields are NOT being modified by this specific "send message" operation
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      ) ||
                      // Branch B: Admin updating group name or avatar
                      (
                        isGroupAdmin(request.auth.uid, resource.data) && // Must be an admin
                        resource.data.type == 'group' &&
                        request.resource.data.type == resource.data.type &&
                        request.writeFields.hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                        (!request.writeFields.has('groupName') || request.resource.data.groupName is string && request.resource.data.groupName.size() > 0) &&
                        (!request.writeFields.has('groupAvatarUrl') || request.resource.data.groupAvatarUrl is string || request.resource.data.groupAvatarUrl == null) &&
                        request.resource.data.updatedAt == request.time &&
                        // Immutable fields check for this branch
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      ) ||
                      // Branch C: Admin adding/removing members
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == resource.data.type &&
                        request.writeFields.hasAll(['participants', 'updatedAt']) && // Simplification: adding/removing only affects participants and updatedAt
                        request.writeFields.size() == 2 && // Can be expanded if adminIds are also managed here directly
                        request.resource.data.participants is list && request.resource.data.participants.size() >= 1 && // Must have at least one participant (owner)
                        request.resource.data.participants.hasAll(request.resource.data.adminIds) && // All admins must be participants
                        (resource.data.ownerId == null || request.resource.data.participants.hasAll([resource.data.ownerId])) && // Owner cannot be removed from participants
                        request.resource.data.updatedAt == request.time &&
                        // Immutable fields
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.adminIds == resource.data.adminIds && // Assuming adminIds not changed here
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      ) ||
                      // Branch D: Owner promoting/demoting admins
                      (
                        isGroupOwner(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == resource.data.type &&
                        request.writeFields.hasAll(['adminIds', 'updatedAt']) &&
                        request.writeFields.size() == 2 &&
                        request.resource.data.adminIds is list &&
                        request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain admin
                        request.resource.data.participants.hasAll(request.resource.data.adminIds) && // All admins must be participants
                        request.resource.data.updatedAt == request.time &&
                        // Immutable fields
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      ) ||
                      // Branch E: Participant leaving a group
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == resource.data.type &&
                        request.writeFields.hasAll(['participants', 'adminIds', 'updatedAt']) &&
                        request.writeFields.size() == 3 &&
                        !request.resource.data.participants.hasAny([request.auth.uid]) && // User is removed from participants
                        (!resource.data.adminIds.hasAny([request.auth.uid]) || !request.resource.data.adminIds.hasAny([request.auth.uid])) && // If was admin, is removed from admins
                        // Owner safeguard: if owner is leaving, and they are the only admin, and other participants remain, this write is denied.
                        // Client/function must handle promoting another admin first.
                        !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && resource.data.adminIds[0] == request.auth.uid && request.resource.data.participants.size() >= 1 && resource.data.participants.size() > request.resource.data.participants.size()) &&
                        request.resource.data.updatedAt == request.time &&
                        // Immutable fields
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      );
      // No direct delete for conversations; manage through 'leaving' or specific archival functions
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthUser() &&
                       get(/databases/$(database)/documents/conversations/$(conversationId))
                           .data.participants.hasAny([request.auth.uid]);
        allow create: if isAuthUser() &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         // User must be a current participant of the conversation
                         get(/databases/$(database)/documents/conversations/$(conversationId))
                             .data.participants.hasAny([request.auth.uid]);
        allow update, delete: if isAuthUser() && resource.data.senderId == request.auth.uid; // Only message owner
      }
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow create: if isAuthUser() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isAuthUser() &&
                       resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.writeFields.hasAll(['rating', 'comment', 'updatedAt']); // Only these fields can be updated
      allow delete: if isAuthUser() && resource.data.reviewerId == request.auth.uid;
    }
  }
}
