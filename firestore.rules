
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    function isNotEmpty(value) {
      return value != null && value != '';
    }
    // --- End Helper Functions ---

    // COLLECTIONS collection
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return request.auth.uid == resource.data.ownerId;
      }
      function isSharedWithUser() {
        // Ensure sharedWithUserIds exists and is a list before checking
        return resource.data.sharedWithUserIds is list && request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && isNotEmpty(request.resource.data.name)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.postIds is list
                    && request.resource.data.postIds.size() <= 1 // Can start empty or with one post
                    && request.resource.data.sharedWithUserIds is list
                    && request.resource.data.sharedWithUserIds.size() == 0 // Must start empty
                    // Whitelist allowed fields for creation
                    && request.resource.data.keys().hasOnly([
                         'name', 'description', 'ownerId', 
                         'postIds', 'sharedWithUserIds', 
                         'createdAt', 'updatedAt'
                       ]);
      allow update: if isAuthenticated() && isCollectionOwner()
                    && request.resource.data.ownerId == resource.data.ownerId // owner cannot change
                    && request.resource.data.createdAt == resource.data.createdAt // createdAt cannot change
                    && request.resource.data.updatedAt == request.time
                    // Whitelist allowed fields for update
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'description', 
                         'postIds', 'sharedWithUserIds', 'updatedAt'
                       ]);
      allow delete: if isAuthenticated() && isCollectionOwner();
    }

    // Rule for the 'collections' collection path itself to enable list operations
    // This allows queries filtered by ownerId or sharedWithUserIds to proceed,
    // while individual document access is still governed by the rule above.
    match /collections/{document=**} {
        allow list: if isAuthenticated();
    }

    // USERS collection
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profiles
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId
                    // Whitelist fields that can be updated by the user
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'established', 'incomeRange', 'updatedAt',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode', // Add NAICS fields
                        'mentionName', 'mentionNameLowercase', // Allow if server logic handles uniqueness
                        'companyName', 'email', 'photoURL', 'actualDisplayName', // Other potentially updatable fields
                        'lastLoginAt' // Typically server-set, but allow if client updates on login
                        // 'tags', 'verified', 'isBotAccount' might be admin-only or server-logic controlled
                    ])
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.uid == resource.data.uid // UID cannot change
                    && request.resource.data.createdAt == resource.data.createdAt; // createdAt cannot change
      // No delete rule for users by default, usually handled by admin or specific processes
    }

    // POSTS collection and its subcollections
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId // userId cannot change
                    && request.resource.data.createdAt == resource.data.createdAt; // createdAt cannot change
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId; // e.g., for likes
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
            allow read: if true;
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
            allow update: if isAuthenticated() && request.auth.uid == resource.data.userId; // e.g., for likes
            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
        allow read: if true; // Or if needed: if isAuthenticated() && (request.auth.uid == resource.data.bidderId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId);
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.bidderId
                       && request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Cannot bid on own post
        // No update/delete for bids typically, handle via specific logic if needed
      }
    }

    // MUTUALS (Connections) collection
    match /mutuals/{connectionId} {
      function isUserInConnection() {
        return request.auth.uid in resource.data.userIds;
      }
      allow read: if isAuthenticated() && isUserInConnection();
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.auth.uid in request.resource.data.userIds;
      allow update: if isAuthenticated() && isUserInConnection()
                    && request.resource.data.status == 'connected'
                    && resource.data.status == 'pending'; // Only from pending to connected
      allow delete: if isAuthenticated() && isUserInConnection();
    }

    // REVIEWS collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are generally public
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.reviewerId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.reviewerId
                    && request.resource.data.reviewerId == resource.data.reviewerId
                    && request.resource.data.targetUserId == resource.data.targetUserId
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId;
    }
    
    // NOTIFICATIONS collection
    match /notifications/{notificationId} {
        allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow create: if isAuthenticated(); // Sender can be different from recipient
        allow update(markAsRead): if isAuthenticated() && request.auth.uid == resource.data.userId
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        // No direct delete by users usually
    }
    
    // USER PREFERENCES collection
    match /userPreferences/{userId} {
        allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
        // No delete rule by default
    }

    // WHITEBOARD ANNOTATIONS collection
    match /whiteboardAnnotations/{naicsCode} {
        allow read: if true; // Publicly readable for now
        allow create, update: if isAuthenticated() 
                              && request.resource.data.lastUpdatedBy == request.auth.uid
                              && request.resource.data.naicsCode == naicsCode; // Ensure document ID matches field
        // No delete for now, could be admin only or by lastUpdatedBy with time constraint
    }
    
    // CONVERSATIONS collection and MESSAGES subcollection
    match /conversations/{conversationId} {
        function isParticipant() {
            return request.auth.uid in resource.data.participants;
        }
        function isFormerParticipant() {
            // Checks if the user's ID is a key in the formerParticipants map and has a valid timestamp value
            return resource.data.keys().hasAny(['formerParticipants']) && 
                   resource.data.formerParticipants[request.auth.uid] is timestamp;
        }
        function isGroupAdmin() {
            return resource.data.type == 'group' && request.auth.uid in resource.data.adminIds;
        }
        function isGroupOwner() {
            return resource.data.type == 'group' && request.auth.uid == resource.data.ownerId;
        }

        allow read: if isAuthenticated() && (isParticipant() || isFormerParticipant());
        allow list: if isAuthenticated() && request.query.filters.find(f => f[0] == 'participants' && f[1] == 'array-contains' && f[2] == request.auth.uid) != null;
        
        allow create: if isAuthenticated() &&
                       request.resource.data.participants.hasAll([request.auth.uid]) && // Creator must be a participant
                       ( // Direct Chat Rules
                        (request.resource.data.type == 'direct' && 
                         request.resource.data.participants.size() == 2 &&
                         // Whitelist fields for direct chat creation
                         request.resource.data.keys().hasOnly([
                            'participants', 'type', 'createdAt', 'lastMessage', 'lastMessageTimestamp',
                            'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'updatedAt'
                         ]) && 
                         request.resource.data.groupName == null && // groupName must be null for direct
                         request.resource.data.groupAvatarUrl == null && // groupAvatarUrl must be null for direct
                         request.resource.data.ownerId == null && // ownerId must be null for direct
                         request.resource.data.adminIds.size() == 0 // adminIds must be empty for direct
                        ) ||
                        // Group Chat Rules
                        (request.resource.data.type == 'group' &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                         request.resource.data.participants.size() >= 2 &&
                         isNotEmpty(request.resource.data.groupName) &&
                         (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                         request.resource.data.postId == null && // postId must be null for group creation
                         // Whitelist fields for group chat creation (including updatedAt)
                         request.resource.data.keys().hasOnly([
                            'participants', 'type', 'createdAt', 'lastMessage', 'lastMessageTimestamp',
                            'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'updatedAt'
                         ])
                        )
                       ) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time; // Ensure updatedAt on create
                        
        allow update: if isAuthenticated() && isParticipant() &&
                       request.resource.data.updatedAt == request.time && // Common requirement for all updates
                       request.resource.data.participants.size() >= (request.resource.data.type == 'group' ? (request.resource.data.ownerId == null ? 1 : 0) : 2) &&
                       ( // Sending a message
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                        // Group detail updates (by admin)
                        (request.resource.data.type == 'group' && isGroupAdmin() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'])) ||
                        // Adding members (by admin) - also allow removing admins if they are removed from participants
                        (request.resource.data.type == 'group' && isGroupAdmin() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'adminIds', 'updatedAt'])) ||
                        // Updating admins/owner (by owner)
                        (request.resource.data.type == 'group' && isGroupOwner() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'ownerId', 'participants', 'updatedAt'])) ||
                        // Leaving a group
                        (request.resource.data.type == 'group' &&
                         !request.resource.data.participants.hasAny([request.auth.uid]) && // User is being removed from participants
                         resource.data.participants.hasAll([request.auth.uid]) &&         // User was previously a participant
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants']) &&
                         request.resource.data.formerParticipants[request.auth.uid] == request.time // User's leave time is set
                        )
                       );

        match /messages/{messageId} {
            allow read, list: if isAuthenticated() && (isParticipant() || isFormerParticipant()); // Current or former participants can read/list messages
            allow create: if isAuthenticated() && isParticipant() && request.auth.uid == request.resource.data.senderId
                           && request.resource.data.timestamp == request.time; // Message timestamp must be server time
            // Messages are generally immutable after creation (no updates/deletes by users)
        }
    }
  }
}

    