
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getPlanData(planId) {
      return get(/databases/$(database)/documents/plans/$(planId)).data;
    }

    function isPlanOwner(planId) {
      let planData = getPlanData(planId);
      return planData != null && planData.ownerId == request.auth.uid;
    }

    function canViewPlan(planId) {
      if (!isAuthenticated()) {
        return false;
      }
      let planData = getPlanData(planId);
      return planData != null &&
             (planData.visibility == 'public' ||
              planData.visibility == 'unlisted' || // Unlisted implies viewable with link, so read should be allowed if queried
              planData.ownerId == request.auth.uid ||
              (planData.viewUserIds is list && request.auth.uid in planData.viewUserIds));
    }

    function canEditPlan(planId) {
      if (!isAuthenticated()) {
        return false;
      }
      let planData = getPlanData(planId);
      return planData != null &&
             (planData.ownerId == request.auth.uid ||
              (planData.editability == 'collaborators' && planData.editUserIds is list && request.auth.uid in planData.editUserIds) ||
              (planData.editability == 'everyone' && canViewPlan(planId)) // If everyone can edit, they must also be able to view
             );
    }

    function isValidPlanVisibility(visibility) {
      return visibility == 'private' || visibility == 'unlisted' || visibility == 'public';
    }

    function isValidPlanEditability(editability) {
      return editability == 'owner_only' || editability == 'collaborators' || editability == 'everyone';
    }

    function isValidViewAndEditUserIds(planResourceData, authUid) {
      let visibility = planResourceData.visibility;
      let editability = planResourceData.editability;
      let viewUserIds = planResourceData.viewUserIds;
      let editUserIds = planResourceData.editUserIds;
      let ownerId = planResourceData.ownerId;

      // Ensure owner is always in viewUserIds and editUserIds if those lists are used
      let ownerInViewers = viewUserIds is list && ownerId in viewUserIds;
      let ownerInEditors = editUserIds is list && ownerId in editUserIds;

      // If private, only owner can view and edit.
      if (visibility == 'private') {
        return editability == 'owner_only' &&
               viewUserIds is list && viewUserIds.size() == 1 && ownerInViewers &&
               editUserIds is list && editUserIds.size() == 1 && ownerInEditors;
      }
      // If unlisted or public
      if (editability == 'owner_only') {
        return editUserIds is list && editUserIds.size() == 1 && ownerInEditors &&
               (visibility == 'public' || (viewUserIds is list && ownerInViewers)); // For unlisted, owner must be in viewers
      }
      if (editability == 'collaborators') {
        return editUserIds is list && ownerInEditors &&
               (visibility == 'public' || (viewUserIds is list && ownerInViewers && editUserIds.hasAny(viewUserIds))); // Editors must be a subset of viewers for unlisted
      }
      if (editability == 'everyone') {
        return visibility == 'public' && // 'everyone' editability only makes sense for public plans
               editUserIds is list && editUserIds.size() == 0 && // editUserIds should be empty if 'everyone'
               viewUserIds is list && viewUserIds.size() == 0; // viewUserIds should be empty if 'everyone' (public handles view)
      }
      return false; // Should not happen if visibility/editability are valid
    }

    function isNotEmpty(value) {
      return value != null && value.size() > 0;
    }


    // Plans Collection
    match /plans/{planId} {
      allow read: if canViewPlan(planId);
      allow list: if isAuthenticated() &&
                     request.query.limit <= 50 &&
                     (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt') &&
                     (
                       request.query.filters.size() == 0 ||
                       (
                         request.query.filters.size() == 1 &&
                         (
                           (request.query.filters[0].field == 'visibility' && request.query.filters[0].operator == 'in') ||
                           (request.query.filters[0].field == 'ownerId' && request.query.filters[0].operator == '==')
                         )
                       )
                     );


      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list &&
                       isValidPlanVisibility(request.resource.data.visibility) &&
                       isValidPlanEditability(request.resource.data.editability) &&
                       isValidViewAndEditUserIds(request.resource.data, request.auth.uid) &&
                       request.resource.data.keys().hasOnly(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']);

      allow update: if isAuthenticated() && canEditPlan(planId) &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       (
                           ( // E1: Roadmap update path
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                               request.resource.data.version == resource.data.version + 1
                           ) ||
                           ( // E2: Settings update path
                               isPlanOwner(planId) &&
                               !request.resource.data.keys().hasAny(['roadmap', 'version']) && // Roadmap and version field itself must not be part of this update type
                               request.resource.data.keys().hasOnly([
                                   'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                   'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                               ]) &&
                               isValidPlanVisibility(request.resource.data.visibility) &&
                               isValidPlanEditability(request.resource.data.editability) &&
                               isValidViewAndEditUserIds(request.resource.data, request.auth.uid) &&
                               request.resource.data.version == resource.data.version
                           )
                       );

      allow delete: if isAuthenticated() && isPlanOwner(planId);

      // Plan Versions Subcollection
      match /versions/{versionId} {
          allow read: if canViewPlan(planId);
          allow list: if canViewPlan(planId);
          allow create: if isAuthenticated() && canEditPlan(planId) &&
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
          allow update, delete: if false;
      }
    }

    // Other collections below...
    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() || (get(/databases/$(database)/documents/users/$(userId)).data.descriptionVisibility == 'everyone');
      allow list: if isAuthenticated(); // Allow listing/searching users if authenticated
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                     request.resource.data.uid == userId &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                        'createdAt', 'lastLoginAt', 'updatedAt'
                     ]); // Ensure only allowed fields are written
      allow update: if isAuthenticated() && request.auth.uid == userId &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.mentionName == resource.data.mentionName &&
                      request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                      request.resource.data.companyName == resource.data.companyName && // Company name can be set at signup but not changed by user via settings
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time &&
                       // Allow only specific fields to be updated by user
                      request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                        'createdAt', 'lastLoginAt', 'updatedAt' // Allow these to be updated, others are restricted
                      ]);
      allow delete: if false; // Users should not be able to delete their profiles directly
    }

    // Mutuals Collection (Connections)
    match /mutuals/{connectionId} {
      // Anyone in userIds list can read their own connection document
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      // Only specific queries allowed for listing
      allow list: if isAuthenticated() &&
                     (
                       ( // For getPendingRequests or getConnections
                         request.query.filters.size() == 2 &&
                         request.query.filters[0].field == 'userIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid &&
                         request.query.filters[1].field == 'status' && request.query.filters[1].operator == '==' && (request.query.filters[1].value == 'pending' || request.query.filters[1].value == 'connected') &&
                         request.query.limit <= 100 &&
                         (request.query.orderBy.path == 'requestedAt' || request.query.orderBy.path == 'connectedAt')
                       )
                     );
      allow create: if isAuthenticated() &&
                      request.resource.data.requesterId == request.auth.uid &&
                      request.resource.data.userIds.hasAll([request.auth.uid]) && // Make sure auth user is one of the participants
                      request.resource.data.userIds.size() == 2 &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.requestedAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      // Ensure only these fields are present on create
                      request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']);

      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // Must be part of the connection
                       resource.data.status == 'pending' && // Can only update pending requests (to accept)
                       request.resource.data.status == 'connected' && // New status must be 'connected'
                       request.resource.data.requesterId == resource.data.requesterId && // Requester cannot change
                       request.resource.data.userIds == resource.data.userIds && // Participants cannot change
                       request.resource.data.connectedAt == request.time && // Must set connectedAt to server time
                       request.resource.data.updatedAt == request.time &&
                       // Only allow status and connectedAt to change from a pending state to connected
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds &&
                      (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    // Posts Collection and Subcollections
    match /posts/{postId} {
        allow read: if true; // Publicly readable
        allow list: if true; // Publicly listable
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.createdAt == request.time &&
                         // Add all expected fields for a new post
                         request.resource.data.keys().hasOnly([
                           'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                           'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType', 'createdAt',
                           'commentCount', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                           'maxBudget', 'deadline'
                         ]);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                        // Allow updating only specific fields by the owner, e.g., question, description, tags, etc.
                        // Forbid changing userId, createdAt.
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        // Whitelist updatable fields if needed, or allow all if owner can edit everything
                        // Example: only allow tags and description to be updated
                        // request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'description']);
                        // For now, allow owner to update most fields
                        true;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        // Comments Subcollection
        match /comments/{commentId} {
            allow read: if true; // Publicly readable
            allow list: if true; // Publicly listable
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned']);
            allow update: if isAuthenticated() && request.auth.uid == request.resource.data.userId && // User can update their own comment
                             request.resource.data.userId == resource.data.userId && // Cannot change author
                             request.resource.data.timestamp == resource.data.timestamp && // Cannot change original timestamp
                             request.resource.data.updatedAt == request.time && // Must set updatedAt
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt']);
            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete their own comment

             // SubComments (Replies to comments) Subcollection
            match /subcomments/{subCommentId} {
                allow read: if true;
                allow list: if true;
                allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                                 request.resource.data.timestamp == request.time &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned']);
                allow update: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt']);
                allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
            }
        }

        // Bids Subcollection
        match /bids/{bidId} {
            allow read: if isAuthenticated(); // Only authenticated users can read bids, potentially owner or bidder
            allow list: if isAuthenticated();
            allow create: if isAuthenticated() &&
                             request.auth.uid == request.resource.data.bidderId && // Bidder ID must be the authenticated user
                             request.resource.data.postId == postId && // Bid must belong to this post
                             request.resource.data.timestamp == request.time &&
                             get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid && // Cannot bid on own post
                             request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
            allow update, delete: if false; // Bids are immutable once placed
        }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can read their own notifications
      allow create: if isAuthenticated() && // Typically created by server or trusted client acting on behalf of a user action
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false &&
                       request.resource.data.keys().hasOnly(['userId', 'type', 'senderId', 'senderName', 'senderAvatar', 'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId', 'textSnippet', 'timestamp', 'isRead']);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && // User can update their own notification (e.g., mark as read)
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && // Only isRead and updatedAt can be changed
                       request.resource.data.updatedAt == request.time;
      allow delete: if false; // Users should not delete notifications directly
    }

    // UserPreferences Collection
    match /userPreferences/{userId} {
      allow read, update: if isAuthenticated() && request.auth.uid == userId; // User can manage their own preferences
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                     request.resource.data.userId == userId && // Ensure userId in doc matches path
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     // Define expected fields, ensure this is comprehensive
                     request.resource.data.keys().hasOnly([
                        'userId', 'notifyOnReply', 'notifyOnMention',
                        'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted',
                        'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                        'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                        'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                        'paymentMethods', 'createdAt', 'updatedAt'
                     ]);
      allow list, delete: if false;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow list: if true; // Reviews are listable
      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid && // Reviewer must be the authenticated user
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review oneself
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.reviewerId && // Only the original reviewer can update
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt', 'reviewerHistoricalAvgRating']); // Only allow these fields to be updated
    allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only original reviewer can delete
    }

    // Conversations Collection and Messages Subcollection
    match /conversations/{conversationId} {
      // Users can read conversations they are part of.
      // Users can list conversations where their UID is in the 'participants' array.
      // This rule is crucial for loading the conversation list.
      allow read, list: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() &&
                     request.auth.uid in request.resource.data.participants &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     (
                       ( // Direct Chat Rules
                         request.resource.data.type == 'direct' &&
                         request.resource.data.participants.size() == 2 &&
                         (request.resource.data.postId == null || request.resource.data.postId is string) && // postId can be null or a string
                         request.resource.data.keys().hasOnly(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds'])
                       ) ||
                       ( // Group Chat Rules
                         request.resource.data.type == 'group' &&
                         request.resource.data.participants.size() >= 2 &&
                         request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                         (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                         request.resource.data.ownerId == request.auth.uid && // Creator must be owner
                         request.resource.data.adminIds is list && request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator must be an admin
                         request.resource.data.postId == null && // postId must be null for groups
                         request.resource.data.keys().hasOnly(['participants', 'type', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'formerParticipants'])
                       )
                     );


      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants && // Must be a current participant
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                       request.resource.data.updatedAt == request.time && // Must set updatedAt
                       ( // OR condition for different types of updates
                         ( // U1: Updating last message details (typically done by sendMessage)
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'lastMessageSenderId', 'updatedAt']) &&
                           request.resource.data.participants == resource.data.participants && // Participants cannot change during message send
                           request.resource.data.type == resource.data.type // Type cannot change
                         ) ||
                         ( // U2: Updating group details (name, avatar) by an admin
                           resource.data.type == 'group' &&
                           request.auth.uid in resource.data.adminIds && // Only admin can update group details
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                           request.resource.data.participants == resource.data.participants && // Participants cannot change here
                           request.resource.data.ownerId == resource.data.ownerId // Owner cannot change here
                         ) ||
                         ( // U3: Adding members to a group by an admin
                           resource.data.type == 'group' &&
                           request.auth.uid in resource.data.adminIds &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
                           request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change here
                           request.resource.data.adminIds == resource.data.adminIds // Admins list cannot change here
                         ) ||
                         ( // U4: Removing members from a group by an admin (non-owner)
                           resource.data.type == 'group' &&
                           request.auth.uid in resource.data.adminIds &&
                           request.auth.uid != resource.data.ownerId && // This rule part applies if admin is not owner
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) && // Can affect both lists
                           request.resource.data.ownerId == resource.data.ownerId &&
                           // Check that only specified user is removed, and not the owner.
                           resource.data.participants.removeAll(request.resource.data.participants).size() == 1 && // Only one user removed from participants
                           !request.resource.data.participants.hasAny([resource.data.ownerId]) // Ensure owner is not in the list of people being removed (implicitly, owner is not removed)
                         ) ||
                         ( // U4.1: Removing members from a group by the owner
                           resource.data.type == 'group' &&
                           request.auth.uid == resource.data.ownerId && // Owner specific
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
                           request.resource.data.ownerId == resource.data.ownerId &&
                           // Owner can remove anyone except themselves IF they are not the last participant or last admin
                           (
                             (resource.data.participants.removeAll(request.resource.data.participants).size() >= 1 &&
                              !request.resource.data.participants.hasAny([resource.data.ownerId])) || // Not removing self
                             (request.resource.data.participants.size() >= 1 && // If removing self, ensure others remain
                              request.resource.data.ownerId == request.auth.uid && // Is owner
                              request.resource.data.participants.hasAny([request.auth.uid]) == false && // Is removing self
                              request.resource.data.participants.size() >= 1 // At least one other participant remains
                             )
                           ) &&
                           // If owner is removed, admin list should also remove owner
                           (!(request.auth.uid in request.resource.data.adminIds) || request.resource.data.adminIds.hasAll(resource.data.adminIds.removeAll([request.auth.uid])))
                         ) ||
                         ( // U5: Leaving a group (self-removal, including owner if conditions met)
                           resource.data.type == 'group' &&
                           request.auth.uid in resource.data.participants && // User must be participant
                           request.resource.data.participants.size() == resource.data.participants.size() - 1 && // Exactly one person removed
                           request.resource.data.participants.hasAll(resource.data.participants.removeAll([request.auth.uid])) && // The removed person is the auth user
                           // If user was admin, they are also removed from adminIds
                           (!(request.auth.uid in resource.data.adminIds) || request.resource.data.adminIds.hasAll(resource.data.adminIds.removeAll([request.auth.uid]))) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants']) &&
                           // formerParticipants handling for leaving
                           (request.resource.data.formerParticipants == resource.data.formerParticipants ||
                            (request.resource.data.formerParticipants[request.auth.uid] == request.time &&
                             request.resource.data.formerParticipants.affectedKeys().hasOnly([request.auth.uid])
                            )
                           ) &&
                           // Owner cannot change, unless they are leaving and conditions met
                           (request.resource.data.ownerId == resource.data.ownerId || (request.resource.data.ownerId == null && request.auth.uid == resource.data.ownerId && request.resource.data.participants.size() == 0))
                         ) ||
                         ( // U6: Admin Management by Owner (promote/demote non-owner admins)
                           resource.data.type == 'group' &&
                           request.auth.uid == resource.data.ownerId &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
                           request.resource.data.participants == resource.data.participants && // Participants list doesn't change
                           request.resource.data.ownerId == resource.data.ownerId // Owner doesn't change
                           // New adminIds must contain owner, and any other new admins must be participants
                           && request.resource.data.adminIds.hasAll([resource.data.ownerId])
                           && request.resource.data.adminIds.removeAll([resource.data.ownerId]).hasOnly(resource.data.participants)
                         ) ||
                         ( // U7: Ownership Transfer by current Owner
                           resource.data.type == 'group' &&
                           request.auth.uid == resource.data.ownerId && // Current user must be owner
                           request.resource.data.ownerId != resource.data.ownerId && // Owner ID must change
                           request.resource.data.ownerId in resource.data.participants && // New owner must be a participant
                           request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) && // New owner must be an admin
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt']) &&
                           request.resource.data.participants == resource.data.participants // Participants don't change
                         )
                       );

      allow delete: if false; // Do not allow direct deletion for now; use "leave group" or admin actions


      // Messages Subcollection
      match /messages/{messageId} {
        allow read, list: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId']);
        allow update: if false; // Messages are immutable
        allow delete: if false; // For now, no direct deletion by users
      }
    }

    // newsArticles Collection
    match /newsArticles/{articleId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow list: if true; // Public listing for published, rules on read will filter
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure all fields are present and correct types
                       request.resource.data.keys().hasOnly([
                         'userId', 'title', 'tags', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt',
                         'likeCount', 'likedBy', 'commentCount',
                         'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline',
                         'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry',
                         'draftContent', 'hasUnpublishedChanges'
                       ]);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       // Allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'title', 'tags', 'content', 'status', 'coverImageUrl', 'publishedAt', 'updatedAt',
                         'likeCount', 'likedBy', // likeCount/likedBy managed by specific transaction
                         'draftContent', 'hasUnpublishedChanges',
                         'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline',
                         'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                       ]);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // News Comments Subcollection
      match /newsComments/{commentId} {
        allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId);
        allow list: if true; // Actual filtering done by read rule
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned']);
        allow update: if isAuthenticated() &&
                         ( (request.auth.uid == resource.data.userId && // User can update their own comment (text, likes)
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt'])
                           ) ||
                           (request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId && // Article author can update ban status
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                           )
                         ) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete own

        // News SubComments (Replies) Subcollection
        match /newsSubcomments/{subCommentId} {
          allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId);
          allow list: if true; // Filtering by read rule
          allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned']);
          allow update: if isAuthenticated() &&
                           ( (request.auth.uid == resource.data.userId &&
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt'])
                             ) ||
                             (request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId &&
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                             )
                           ) &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
    }

    // Article Tags Collection
    match /articleTags/{tagId} {
        allow read: if true; // Tags are public
        allow list: if true; // Tags are listable
        // Create and update handled by transaction in getOrCreateTagsAndUpdateUsage
        // which implies it's done by an authenticated user (checked in service).
        // Rules here should permit the transactional write if conditions match.
        allow create: if isAuthenticated() &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
        allow update: if isAuthenticated() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
                         // Only usageCount can be updated this way. Name changes would require new doc.
        allow delete: if false; // Tags are not directly deleted by users.
    }

    // Collections (User's saved posts)
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return resource.data.ownerId == request.auth.uid;
      }
      function isSharedWithUser() {
        return request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      allow list: if isAuthenticated() &&
                     (
                       (request.query.filters.size() == 1 && request.query.filters[0].field == 'ownerId' && request.query.filters[0].value == request.auth.uid) ||
                       (request.query.filters.size() == 1 && request.query.filters[0].field == 'sharedWithUserIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid)
                     ) && request.query.limit <= 100 && request.query.orderBy.path == 'createdAt';

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.postIds is list && // Ensure postIds is a list
                       request.resource.data.sharedWithUserIds is list && // Ensure sharedWithUserIds is a list
                       // Allow description to be string or null.
                       (request.resource.data.description == null || request.resource.data.description is string) &&
                       request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']);

      allow update: if isAuthenticated() && isCollectionOwner() &&
                       request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                       request.resource.data.updatedAt == request.time &&
                       // Allow only these fields to be updated by the owner
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);

      allow delete: if isAuthenticated() && isCollectionOwner();
    }
  }
}

    