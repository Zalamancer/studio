rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    // Helper to check for non-empty string, useful for names, titles etc.
    function isNotEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // COLLECTIONS collection
    match /collections/{collectionId} {
      function isCollectionOwner() {
        // Check if ownerId exists before accessing
        return resource.data.keys().hasAny(['ownerId']) && request.auth.uid == resource.data.ownerId;
      }
      function isSharedWithUser() {
        // Ensure sharedWithUserIds exists and is a list before checking
        return resource.data.keys().hasAny(['sharedWithUserIds']) &&
               resource.data.sharedWithUserIds is list &&
               request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && isNotEmptyString(request.resource.data.name) // Using isNotEmptyString
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.postIds is list
                    && request.resource.data.postIds.size() <= 1
                    && request.resource.data.sharedWithUserIds is list
                    && request.resource.data.sharedWithUserIds.size() == 0
                    && request.resource.data.keys().hasOnly([
                         'name', 'description', 'ownerId',
                         'postIds', 'sharedWithUserIds',
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isAuthenticated() && isCollectionOwner()
                    && request.resource.data.ownerId == resource.data.ownerId // owner cannot change
                    && request.resource.data.createdAt == resource.data.createdAt // createdAt cannot change
                    && request.resource.data.updatedAt == request.time
                    // Whitelist fields that can be changed by owner
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'description', 
                         'postIds', 'sharedWithUserIds', 'updatedAt'
                       ]);

      allow delete: if isAuthenticated() && isCollectionOwner();
    }

    // Rule for LISTING collections (needed for getUserCollections queries)
    match /collections/{document=**} { // This applies to the collection path for list operations
      allow list: if isAuthenticated() &&
                     (
                       (request.query.filters.size() > 0 && // Ensure there's at least one filter
                        request.query.filters.find(f => f[0] == 'ownerId' && f[1] == '==' && f[2] == request.auth.uid) != null)
                        ||
                       (request.query.filters.size() > 0 &&
                        request.query.filters.find(f => f[0] == 'sharedWithUserIds' && f[1] == 'array-contains' && f[2] == request.auth.uid) != null)
                     );
    }


    // USERS collection
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profiles
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'established', 'incomeRange', 'updatedAt',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode', // NAICS fields
                        'paymentMethods', // For payment settings
                        'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', // Stripe fields
                        'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd',
                        'stripeSubscriptionWillCancelAtPeriodEnd',
                        'favoriteSectorCodes', // Favorite sectors
                        'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest', // Notification prefs
                        'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates'
                    ])
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    // POSTS collection and subcollections
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt', 'ratingScore']); // Added ratingScore
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']); // Only allow likes/unlikes
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
            allow read: if true;
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
            allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']);
            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.bidderId
                       && request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId;
      }
    }

    // MUTUALS collection
    match /mutuals/{connectionId} {
      function isUserInConnection() {
        // Ensure userIds exists and is a list before checking
        return resource.data.keys().hasAny(['userIds']) &&
               resource.data.userIds is list &&
               request.auth.uid in resource.data.userIds;
      }
      allow read: if isAuthenticated() && isUserInConnection();
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds is list // Ensure userIds is a list
                    && request.resource.data.userIds.size() == 2 // Ensure userIds has exactly two elements
                    && request.auth.uid in request.resource.data.userIds;
      allow update: if isAuthenticated() && isUserInConnection()
                    && request.resource.data.status == 'connected'
                    && resource.data.status == 'pending';
      allow delete: if isAuthenticated() && isUserInConnection();
    }

    // REVIEWS collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are generally public
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.reviewerId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.reviewerId
                    && request.resource.data.reviewerId == resource.data.reviewerId
                    && request.resource.data.targetUserId == resource.data.targetUserId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time // ensure server timestamp on update
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']); // only allow rating and comment updates
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId;
    }
    
    // NOTIFICATIONS collection
    match /notifications/{notificationId} {
        allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow create: if isAuthenticated(); // Sender can be system or another user
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId // Changed from markAsRead to generic update
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
                                  && request.resource.data.updatedAt == request.time;
    }
    
    // USERPREFERENCES collection
    match /userPreferences/{userId} {
        allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // WHITEBOARD ANNOTATIONS collection
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.lastUpdatedBy == request.auth.uid
                    && request.resource.data.naicsCode == naicsCode;
      allow update: if isAuthenticated()
                    && request.resource.data.lastUpdatedBy == request.auth.uid
                    && request.resource.data.naicsCode == naicsCode;
    }
    
    // CONVERSATIONS and MESSAGES
    match /conversations/{conversationId} {
        function isParticipant() {
            return request.auth.uid in resource.data.participants;
        }
        function isFormerParticipant() {
            return resource.data.keys().hasAny(['formerParticipants']) &&
                   resource.data.formerParticipants != null && request.auth.uid in resource.data.formerParticipants;
        }
        function isGroupAdmin() {
            return resource.data.type == 'group' && request.auth.uid in resource.data.adminIds;
        }
        function isGroupOwner() {
            return resource.data.type == 'group' && request.auth.uid == resource.data.ownerId;
        }

        allow read: if isAuthenticated() && (isParticipant() || isFormerParticipant());
        allow list: if isAuthenticated() && request.query.filters.find(f => f[0] == 'participants' && f[1] == 'array-contains' && f[2] == request.auth.uid) != null;
        
        allow create: if isAuthenticated() &&
                       request.resource.data.participants.hasAny([request.auth.uid]) &&
                       request.resource.data.createdAt == request.time && // Ensure server timestamps
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastMessageTimestamp == request.time &&
                       ((request.resource.data.type == 'direct' && 
                         request.resource.data.participants.size() == 2 &&
                         request.resource.data.keys().hasOnly([
                            'participants', 'type', 'postId', 
                            'createdAt', 'updatedAt', 
                            'lastMessage', 'lastMessageTimestamp',
                            'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds' // Ensure all possible fields are listed
                         ]) &&
                         request.resource.data.groupName == null &&
                         request.resource.data.groupAvatarUrl == null &&
                         request.resource.data.ownerId == null &&
                         request.resource.data.adminIds.size() == 0
                        ) ||
                        (request.resource.data.type == 'group' &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                         request.resource.data.participants.size() >= 2 && 
                         isNotEmptyString(request.resource.data.groupName) &&
                         (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                         request.resource.data.postId == null &&
                         request.resource.data.keys().hasOnly([ 
                            'participants', 'type', 'createdAt', 'lastMessage', 'lastMessageTimestamp',
                            'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'updatedAt'
                         ])
                        ));
                        
        allow update: if isAuthenticated() && isParticipant() && request.resource.data.updatedAt == request.time &&
                       resource.data.type == request.resource.data.type &&
                       resource.data.createdAt == request.resource.data.createdAt &&
                       (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                         (resource.data.type == 'group' && isGroupAdmin() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                          (request.resource.data.groupName == null || isNotEmptyString(request.resource.data.groupName)) &&
                          (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) 
                         ) ||
                         (resource.data.type == 'group' && isGroupAdmin() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
                          request.resource.data.participants.size() >= 1 
                         ) ||
                         (resource.data.type == 'group' && isGroupOwner() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'ownerId', 'updatedAt']) &&
                          request.resource.data.ownerId != null && 
                          request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) 
                         ) ||
                         (resource.data.type == 'group' &&
                          !request.resource.data.participants.hasAny([request.auth.uid]) && 
                          resource.data.participants.hasAll([request.auth.uid]) &&         
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants']) &&
                          request.resource.data.formerParticipants[request.auth.uid] == request.time && 
                           (resource.data.ownerId != request.auth.uid || ( 
                               request.resource.data.ownerId == null && request.resource.data.adminIds.size() == 0 && resource.data.adminIds.size() == 1 
                           ))
                         )
                       );
                       
        match /messages/{messageId} {
            allow read, list: if isAuthenticated() && (isParticipant() || isFormerParticipant());
            allow create: if isAuthenticated() && isParticipant() && request.auth.uid == request.resource.data.senderId
                          && request.resource.data.timestamp == request.time
                          && request.resource.data.keys().hasOnly([
                              'senderId', 'text', 'timestamp', 'isBotMessage',
                              'replyToMessageId', 'repliedToTextSnippet', 'read', 'conversationId'
                          ]);
        }
    }

    // --- START: Rules for Collections (appended as per request) ---
    match /collections/{collectionId} {
      // Helper functions specific to this collections block
      function isUserAuthenticatedForCollections() { // Renamed to avoid conflict if global isAuthenticated exists
        return request.auth != null && request.auth.uid != null;
      }
      function isCollectionOwnerForThisCollection() { // Renamed
        return resource.data.keys().hasAny(['ownerId']) && request.auth.uid == resource.data.ownerId;
      }
      function isSharedWithUserForThisCollection() { // Renamed
        return resource.data.keys().hasAny(['sharedWithUserIds']) &&
               resource.data.sharedWithUserIds is list &&
               request.auth.uid in resource.data.sharedWithUserIds;
      }
      function isNonEmptyStringValueForCollections(value) { // Renamed
        return value is string && value.size() > 0;
      }

      allow read: if isUserAuthenticatedForCollections() && (isCollectionOwnerForThisCollection() || isSharedWithUserForThisCollection());

      allow create: if isUserAuthenticatedForCollections()
                    && request.resource.data.ownerId == request.auth.uid
                    && isNonEmptyStringValueForCollections(request.resource.data.name)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.postIds is list
                    && request.resource.data.postIds.size() <= 1
                    && request.resource.data.sharedWithUserIds is list
                    && request.resource.data.sharedWithUserIds.size() == 0
                    && request.resource.data.keys().hasOnly([
                         'name', 'description', 'ownerId', 
                         'postIds', 'sharedWithUserIds', 
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isUserAuthenticatedForCollections() && isCollectionOwnerForThisCollection()
                    && request.resource.data.ownerId == resource.data.ownerId 
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'description', 
                         'postIds', 'sharedWithUserIds', 'updatedAt'
                       ]);

      allow delete: if isUserAuthenticatedForCollections() && isCollectionOwnerForThisCollection();
    }

    match /collections/{document=**} {
      allow list: if request.auth != null && request.auth.uid != null &&
                     (
                       (request.query.filters.size() > 0 &&
                        request.query.filters.find(f => f[0] == 'ownerId' && f[1] == '==' && f[2] == request.auth.uid) != null)
                        ||
                       (request.query.filters.size() > 0 &&
                        request.query.filters.find(f => f[0] == 'sharedWithUserIds' && f[1] == 'array-contains' && f[2] == request.auth.uid) != null)
                     );
    }
    // --- END: Rules for Collections ---
  }
}
