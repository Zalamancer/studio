
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
    }
    
    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isOwner(resource.data.userId);

        // SubComments (Replies) Sub-Subcollection
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow create: if isSignedIn();
            allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
        }
      }

      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if isSignedIn(); // Allow any signed-in user to see bids on a post.
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.bidderId; // You can only create your own bid.
        allow update, delete: if false; // Bids are immutable for now.
      }
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.auth.uid in request.resource.data.userIds;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.userIds
                    && !(request.auth.uid == request.resource.data.requesterId && request.resource.data.status == 'pending');
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, update, delete, list: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn();
    }

    // Collections (Saved Posts)
    match /collections/{collectionId} {
        allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWithUserIds);
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Plans Collection (for Roadmaps)
    match /plans/{planId} {
      // READ: Check visibility settings
      allow read: if resource.data.visibility == 'public'
                   || (resource.data.visibility == 'unlisted' && isSignedIn())
                   || (resource.data.visibility == 'private' && isSignedIn() && request.auth.uid in resource.data.viewUserIds);

      // CREATE: Any signed-in user can create a plan, must be owner
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      // UPDATE: Check editability settings
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.ownerId) ||
        (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
        (resource.data.editability == 'everyone' && resource.data.visibility == 'public') ||
        (resource.data.editability == 'everyone' && resource.data.visibility == 'unlisted' && request.auth.uid in resource.data.viewUserIds)
      );
      
      // DELETE: Only the owner can delete
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // VERSIONS Subcollection
      match /versions/{versionId} {
        // Can read versions if you can read the parent plan
        allow read: if get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public'
                   || (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted' && isSignedIn())
                   || (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'private' && isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds);
        
        // Only the owner of the main plan can create new versions
        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId;
        
        // Versions are immutable
        allow update, delete: if false;
      }
       // VIEWING_USERS Subcollection
      match /viewingUsers/{userId} {
        // A user can only write/delete their own presence document
        allow write, delete: if isSignedIn() && request.auth.uid == userId;
        // Anyone who can view the plan can see who else is viewing
        allow list: if get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public'
                   || (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted' && isSignedIn())
                   || (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'private' && isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds);
         allow read: if true; // To allow onSnapshot to work without complex queries
      }
    }
     // Reviews Collection
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        // User must be signed in, can't review themself, and must be the reviewer in the doc
        allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid && request.resource.data.reviewerId != request.resource.data.targetUserId;
        // Only the reviewer can update or delete their own review
        allow update, delete: if isSignedIn() && resource.data.reviewerId == request.auth.uid;
    }
     // Article Tags Collection
    match /articleTags/{tagId} {
        allow read: if true; // Tags are public to read/query
        // Creating/updating handled by secure cloud function or tightly controlled service logic
        allow write: if isSignedIn(); // Allow signed-in users to potentially create/update usage counts
    }
    // News Articles Collection
    match /newsArticles/{articleId} {
      // Anyone can read published articles.
      // The owner can read their own drafts.
      allow read: if resource.data.status == 'published'
                  || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Any signed-in user can create an article for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Only the author can update their own article.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Only the author can delete their own article.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Comments on News Articles
      match /newsComments/{commentId} {
        allow read: if true; // Comments on news are public
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isOwner(resource.data.userId);

        // Sub-comments on News Comments
        match /newsSubcomments/{subCommentId} {
          allow read: if true;
          allow create: if isSignedIn();
          allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
        }
      }
    }
    
    // Follows Collection
    match /follows/{followId} {
      // A user can read a follow document if they are the follower.
      // This allows a user to get their own list of who they follow, and to check if they follow someone.
      allow read, list: if isSignedIn() && request.auth.uid == resource.data.followerId;
      
      // A user can create a follow relationship for themselves.
      // Also validates that the document ID matches the content.
      allow create: if isSignedIn() 
                     && request.auth.uid == request.resource.data.followerId
                     && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      
      // A user can only delete their own follow relationships (unfollow).
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
      
      // Updates are not allowed; unfollow is a delete, follow is a create.
      allow update: if false;
    }
  }
}
