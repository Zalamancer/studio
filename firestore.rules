
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions defined at the top level for reusability
    function isAuthUser(auth) {
      return auth != null;
    }

    function isOwner(authUid, resourceOwnerUid) {
      return authUid == resourceOwnerUid;
    }

    // Conversation specific helper functions
    // It's often better to pass resource.data to these if they need to inspect it
    function isParticipant(authUid, participantsList) {
      return authUid in participantsList;
    }

    function isGroupAdmin(authUid, adminIdsList) {
      return authUid in adminIdsList;
    }

    function isGroupOwner(authUid, ownerId) {
      return authUid == ownerId;
    }

    // --- Stripe Data (Maintain user's rules) ---
    match /customers/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /customers/{userId}/subscriptions/{subscriptionId} {
      allow read, write: if request.auth.uid == userId;
    }
    match /products/{productId} {
      allow read: if true; // Or restrict as needed
      allow write: if false; // Typically managed via Stripe Dashboard or backend
    }
    match /products/{productId}/prices/{priceId} {
      allow read: if true;
      allow write: if false;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profile info
      allow create: if request.auth != null && request.auth.uid == userId &&
                     request.resource.data.uid == userId &&
                     request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0 &&
                     request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower() &&
                     (!('companyName' in request.resource.data) || request.resource.data.companyName is string || request.resource.data.companyName == null) &&
                     (!('email' in request.resource.data) || request.resource.data.email is string || request.resource.data.email == null) &&
                     (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.lastLoginAt == request.time &&
                     (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                     (!('description' in request.resource.data) || request.resource.data.description is string || request.resource.data.description == null) &&
                     (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                     (!('established' in request.resource.data) || request.resource.data.established is string || request.resource.data.established == null) &&
                     (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange is string || request.resource.data.incomeRange == null) &&
                     (!('sectorName' in request.resource.data) || request.resource.data.sectorName is string || request.resource.data.sectorName == null) &&
                     (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName is string || request.resource.data.subSectorName == null) &&
                     (!('industryName' in request.resource.data) || request.resource.data.industryName is string || request.resource.data.industryName == null) &&
                     (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                     (!('tags' in request.resource.data) || request.resource.data.tags is list) &&
                     (!('verified' in request.resource.data) || request.resource.data.verified is bool) &&
                     (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount is bool) &&
                     request.resource.data.keys().hasOnly([
                       'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                       'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                       'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                       'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                       'createdAt', 'lastLoginAt', 'updatedAt'
                     ]);

      allow update: if request.auth != null && request.auth.uid == userId &&
                       // User cannot change their own UID, mentionName, mentionNameLowercase, email, companyName, isBotAccount, createdAt via this rule.
                       // They can change: avatarUrl, industry, description, descriptionVisibility, sector/sub/ind names, naics, tags, established, incomeRange
                       // lastLoginAt should be updated by a separate mechanism or on user sign-in trigger by backend.
                       (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
                       (!('mentionName' in request.resource.data) || request.resource.data.mentionName == resource.data.mentionName) &&
                       (!('mentionNameLowercase' in request.resource.data) || request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase) &&
                       (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) && // Usually emails are not changed by user directly
                       (!('companyName' in request.resource.data) || request.resource.data.companyName == resource.data.companyName) && // Company name set at signup usually
                       (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount == resource.data.isBotAccount) &&
                       (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure only allowed fields are present in the update request if they are not part of immutable checks above
                       request.resource.data.keys().hasAny([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'incomeRange', 'updatedAt'
                       ]) &&
                       !request.resource.data.keys().hasAny(['uid', 'mentionName', 'mentionNameLowercase', 'email', 'companyName', 'isBotAccount', 'createdAt', 'lastLoginAt']);
    }

    // --- User Preferences ---
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid; // User can read/update (mark as read) their own notifications
      allow create: if request.auth != null && // Authenticated user can create
                      request.resource.data.senderId == request.auth.uid && // Sender must be self
                      request.resource.data.userId != request.auth.uid && // Cannot send to self (unless specifically allowed for system messages, but this rule handles user-sent)
                      request.resource.data.isRead == false &&
                      request.resource.data.timestamp == request.time;
      allow delete: if false; // Notifications are typically not deleted by users
    }

    // --- Posts ---
    match /posts/{postId} {
      allow read: if true; // Posts are publicly readable

      allow create: if request.auth != null &&
                     request.resource.data.userId == request.auth.uid &&
                     request.resource.data.createdAt == request.time &&
                     // Ensure other required fields are present and of correct type
                     request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                     request.resource.data.tags is list &&
                     request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                     request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                     request.resource.data.descriptionDetails is string &&
                     // Help request specific fields (can be null or their type)
                     (request.resource.data.requestType == 'post' || (
                       (request.resource.data.maxBudget is number || request.resource.data.maxBudget == null) &&
                       (request.resource.data.deadline is timestamp || request.resource.data.deadline == null)
                     )) &&
                     // Optional fields must be correct type if present
                     (!('subSector' in request.resource.data) || request.resource.data.subSector is string || request.resource.data.subSector == null) &&
                     (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                     (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                     (!('imageUrls' in request.resource.data) || request.resource.data.imageUrls is list) &&
                     (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list) &&
                     request.resource.data.commentCount == 0 && // Initial comment count
                     request.resource.data.ratingScore is number; // Initial rating score

      allow update: if request.auth != null && (
                      // Branch 1: Post owner can update specific fields of their own post.
                      (
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'maxBudget', 'deadline', 'updatedAt']) &&
                        // Immutable fields check for owner update
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.requestType == resource.data.requestType && // requestType should not change
                        request.resource.data.ratingScore == resource.data.ratingScore && // ratingScore set at creation
                        request.resource.data.commentCount == resource.data.commentCount && // commentCount managed by specific rule
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt).
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                        request.resource.data.updatedAt == request.time
                        // No need to check other fields here, hasOnly ensures they aren't part of the write
                      )
                    );

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // --- Comments on Posts ---
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.likeCount == 0 &&
                       request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                       request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                       (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list);

        allow update: if request.auth != null && (
                        // Branch 1: Comment owner can edit their comment text or mentions
                        (
                          resource.data.userId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                          request.resource.data.userId == resource.data.userId && // Cannot change owner
                          request.resource.data.timestamp == resource.data.timestamp && // Cannot change original timestamp
                          request.resource.data.likeCount == resource.data.likeCount && // Likes handled by different rule
                          request.resource.data.likedBy == resource.data.likedBy &&     // Likes handled by different rule
                          request.resource.data.updatedAt == request.time
                        ) ||
                        // Branch 2: Any authenticated user can like/unlike (modifies likedBy and likeCount)
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                          request.resource.data.userId == resource.data.userId && // Cannot change owner
                          request.resource.data.text == resource.data.text &&         // Cannot change text
                          request.resource.data.timestamp == resource.data.timestamp && // Cannot change original timestamp
                          request.resource.data.mentionedUserIds == resource.data.mentionedUserIds && // Cannot change mentions
                          (
                            (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount + 1) || // Like
                            (request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount - 1)    // Unlike
                          ) &&
                          request.resource.data.updatedAt == request.time
                        )
                      );
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only comment owner can delete

        // --- SubComments (Replies) on Comments ---
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list);

          allow update: if request.auth != null && (
                          // Branch 1: SubComment owner can edit their subcomment text or mentions
                          (
                            resource.data.userId == request.auth.uid &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.likeCount == resource.data.likeCount &&
                            request.resource.data.likedBy == resource.data.likedBy &&
                            request.resource.data.updatedAt == request.time
                          ) ||
                          // Branch 2: Any authenticated user can like/unlike a subcomment
                          (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.text == resource.data.text &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                            (
                              (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount + 1) || // Like
                              (request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount - 1)    // Unlike
                            ) &&
                            request.resource.data.updatedAt == request.time
                          )
                        );
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only subcomment owner can delete
        }
      }
      // --- Bids on Posts ---
      match /bids/{bidId} {
          allow read: if true; // Allow reading bids (e.g., by post owner or public)
          allow create: if request.auth != null &&
                           request.resource.data.bidderId == request.auth.uid &&
                           request.resource.data.postId is string &&
                           // Ensure bidder is not the post owner
                           get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.userId != request.auth.uid &&
                           request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                           request.resource.data.timestamp == request.time;
          allow update, delete: if false; // Bids are typically not updatable/deletable by users once placed
      }
    }

    // --- Mutual Connections ---
    match /mutuals/{connectionId} {
        allow read: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.resource.data.requesterId == request.auth.uid &&
                         request.resource.data.userIds.hasAll([request.auth.uid]) && // Ensures auth user is in the list
                         request.resource.data.userIds.size() == 2 &&
                         request.resource.data.userIds[0] != request.resource.data.userIds[1] && // Ensure not self-request
                         request.resource.data.status == 'pending' &&
                         request.resource.data.requestedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         !('connectedAt' in request.resource.data); // Not connected at creation

        allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]) &&
                       ( // Case 1: Accepting a request (recipient is doing this)
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'connected' &&
                         resource.data.requesterId != request.auth.uid && // Acceptor is not original requester
                         request.resource.data.connectedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Check immutable fields
                         request.resource.data.userIds == resource.data.userIds &&
                         request.resource.data.requesterId == resource.data.requesterId &&
                         request.resource.data.requestedAt == resource.data.requestedAt
                       );
                       // Other update cases like blocking would go here
        allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]); // Allow deleting (canceling pending, removing connection)
    }

    // --- Whiteboard Annotations ---
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true; // Whiteboard data is publicly readable
      allow write: if request.auth != null &&
                      request.resource.data.naicsCode == naicsCode && // Ensure docId matches naicsCode field
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time;
    }

    // --- Conversations & Messages ---
    match /conversations/{conversationId} {
      // Helper functions scoped to this match block
      function isConversationParticipant(authUid) {
        return authUid in resource.data.participants;
      }
      function isConversationGroupOwner(authUid) {
        return resource.data.type == 'group' && authUid == resource.data.ownerId;
      }
      function isConversationGroupAdmin(authUid) {
        return resource.data.type == 'group' && authUid in resource.data.adminIds;
      }

      allow get: if isAuthUser(request.auth) && isConversationParticipant(request.auth.uid);
      allow list: if isAuthUser(request.auth) && request.query.limit <= 100; // Further filtering by rules on 'get'

      allow create: if isAuthUser(request.auth) &&
                      // Branch 1: Direct Chat Creation
                      (
                        request.resource.data.type == 'direct' &&
                        request.resource.data.participants is list &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.participants.hasAny([request.auth.uid]) &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds is list && request.resource.data.adminIds.size() == 0 &&
                        request.resource.data.groupName == null &&
                        request.resource.data.groupAvatarUrl == null &&
                        (!('postId' in request.resource.data) || request.resource.data.postId is string || request.resource.data.postId == null) &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl', 'createdAt', 'lastMessage', 'lastMessageTimestamp']) &&
                        request.resource.data.keys().size() == 10 // Ensure only expected fields are present
                      ) ||
                      // Branch 2: Group Chat Creation (Simplified for now)
                      (
                        request.resource.data.type == 'group' &&
                        request.resource.data.participants is list &&
                        request.resource.data.participants.size() >= 2 &&
                        request.resource.data.participants.hasAny([request.auth.uid]) && // Creator must be a participant
                        request.resource.data.ownerId == request.auth.uid &&             // Creator is owner
                        request.resource.data.adminIds is list &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) &&   // Creator is admin
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        (!('groupAvatarUrl' in request.resource.data) || request.resource.data.groupAvatarUrl is string || request.resource.data.groupAvatarUrl == null) &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        // Ensure only expected fields for group creation
                        request.resource.data.keys().hasAll(['participants', 'type', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp']) &&
                        request.resource.data.keys().size() == 10
                      );

      allow update: if isAuthUser(request.auth) && isConversationParticipant(request.auth.uid) &&
                      // Branch A: Updating lastMessage, lastMessageSenderId, lastMessageTimestamp, updatedAt (for sending messages)
                      // Any participant can do this.
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time && // Also ensure this for consistency
                        // Ensure other core fields are not changed during message sending
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      );
                      // TODO: Add back other branches (group name/avatar update, add/remove members, promote/demote admin, leave group) one by one after confirming message sending works.

      match /messages/{messageId} {
        allow read: if isAuthUser(request.auth) &&
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if isAuthUser(request.auth) &&
                       request.resource.data.senderId == request.auth.uid &&
                       request.resource.data.conversationId == conversationId &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                       // Ensure only expected fields are present
                       request.resource.data.keys().hasAll(['conversationId', 'senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet']) &&
                       request.resource.data.read == false &&
                       request.resource.data.isBotMessage is bool &&
                       (request.resource.data.replyToMessageId is string || request.resource.data.replyToMessageId == null) &&
                       (request.resource.data.repliedToTextSnippet is string || request.resource.data.repliedToTextSnippet == null);
        allow update, delete: if false; // Messages are typically not updated or deleted by users
      }
    }
  }
}

    