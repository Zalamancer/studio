
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stripe rules

    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }

      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }

      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }

      match /tax_rates/{id} {
        allow read: if true;
      }
    }
    
    // Collections rules
    match /collections/{collectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Posts and their comments
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null; // Consider more specific write rules, e.g., owner can update/delete.

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null; // Should check if user is part of a community or can comment
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }

      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if false; // Bids are typically not updatable/deletable by users directly
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      allow get: if request.auth != null && (resource == null || (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])));
      allow list: if request.auth != null && request.query.limit <= 100; // Add reasonable limit for list queries
      allow create: if request.auth != null &&
                      // Common fields for all conversations
                      request.resource.data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.lastMessage == null &&
                      request.resource.data.lastMessageTimestamp == request.time &&
                      // Direct chat specific rules
                      (
                        request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.groupName == null &&
                        request.resource.data.groupAvatarUrl == null &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds.size() == 0 &&
                        (request.resource.data.postId == null || request.resource.data.postId is string) // postId can be null or a string for direct chats
                      ) ||
                      // Group chat specific rules
                      (
                        request.resource.data.type == 'group' &&
                        request.resource.data.participants.size() >= 2 && // At least two participants for a group
                        request.resource.data.ownerId == request.auth.uid && // Creator must be owner
                        request.resource.data.adminIds.hasAny([request.auth.uid]) && // Creator must be an admin
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                        request.resource.data.postId == null // New groups are not tied to posts
                      );

      allow update: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]) &&
                       // Allow updating last message details by a participant
                       (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'lastMessageSenderId']) &&
                         request.resource.data.lastMessageSenderId == request.auth.uid &&
                         request.resource.data.participants == resource.data.participants && // participants cannot change via this path
                         request.resource.data.type == resource.data.type // type cannot change
                       ) ||
                       // Allow group admins to update group details
                       (
                         resource.data.type == 'group' &&
                         resource.data.adminIds.hasAny([request.auth.uid]) &&
                         request.resource.data.diff(resource.data).hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds']) &&
                         // Ensure critical fields like ownerId, type, postId (for groups) are not changed here
                         request.resource.data.ownerId == resource.data.ownerId &&
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.postId == resource.data.postId &&
                         // Add validation for participant/admin updates if necessary
                         (request.resource.data.participants.size() >= 2 || request.resource.data.participants.hasAll(request.resource.data.adminIds))
                       );

      // Messages subcollection rules
      match /messages/{messageId} {
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        // Further restrict create to only allow sender to be auth.uid
        // allow create: if request.auth != null
        //             && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
        //             && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // Typically messages are not updated/deleted by clients
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null; 
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      // Only authenticated users can write, and the naicsCode field in the document must match the document ID
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId
                   && request.resource.data.lastUpdatedBy == request.auth.uid;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Creation can be done by server (e.g. Cloud Functions) or by a user if senderId matches auth.uid
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      // Only allow user to update their own notifications (e.g., isRead status)
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null; // Allow any authenticated user to list/query user profiles
      allow create, update: if request.auth != null && request.auth.uid == userId; // Only user can create/update their own profile
      allow delete: if request.auth != null && request.auth.uid == userId; // Only user can delete their own profile
    }
    // Note: "list" on users/{document=**} is very broad. Consider if specific queries need to be secured.

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if request.auth != null; // Any authenticated user can read reviews
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid; // Only authenticated user can create a review as themselves
      allow update, delete: if request.auth != null
                            && resource.data.reviewerId == request.auth.uid; // Only the original reviewer can update/delete their review
    }

    // Fallback rule: Deny by default for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    