// do not change or update any rule that is not relavant to your prompt
// do not remove rules that is used by other tasks
// only add rules that you need.
// don't change or remove the rules that you have no business with.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthUser() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAuthenticatedUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isResourceOwner(docResource) {
      return request.auth != null && docResource.data.userId == request.auth.uid;
    }

    // Stripe rules (from user)
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Collections rules (from user)
    match /collections/{collectionId} {
      // Helper functions for collections
      function isCollectionOwner() {
        return request.auth.uid == resource.data.ownerId;
      }
      function isSharedWithUser() {
        return request.auth.uid in (resource.data.sharedWithUserIds || []);
      }
      function hasValidCollectionFields() {
        return request.resource.data.keys().hasAll(['name', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
               request.resource.data.name is string &&
               request.resource.data.name.size() > 0 &&
               request.resource.data.ownerId is string &&
               request.resource.data.postIds is list &&
               request.resource.data.sharedWithUserIds is list;
      }

      // List rules - Separate owned and shared cases more explicitly
      allow list: if isAuthUser() && (
        // Case 1: Owned collections
        (request.query.filters.size() > 0 && 
         request.query.filters[0].field == 'ownerId' && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].value == request.auth.uid) ||
        // Case 2: Shared collections - more explicit check
        (request.query.filters.size() > 0 && 
         request.query.filters[0].field == 'sharedWithUserIds' && 
         request.query.filters[0].op == 'array-contains' && 
         request.query.filters[0].value == request.auth.uid &&
         // Additional check to ensure the user is actually in the array
         resource.data.sharedWithUserIds.hasAny([request.auth.uid]))
      );

      // Read rules
      allow read: if isAuthUser() && (
        isCollectionOwner() || 
        isSharedWithUser()
      );

      // Create rules
      allow create: if isAuthUser() && 
                   request.resource.data.ownerId == request.auth.uid &&
                   hasValidCollectionFields() &&
                   request.resource.data.createdAt == request.time &&
                   request.resource.data.updatedAt == request.time;

      // Update rules
      allow update: if isAuthUser() && (
        // Owner can update collection details
        (isCollectionOwner() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']) &&
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.createdAt == resource.data.createdAt &&
         request.resource.data.updatedAt == request.time) ||
        // Shared users can only read
        isSharedWithUser()
      );

      // Delete rules
      allow delete: if isAuthUser() && isCollectionOwner();
    }

    // Posts, their comments, and bids
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.createdAt == request.time;

      allow update: if isAuthUser() && (
        // Branch 1: Owner can update their post
        (
          resource.data.userId == request.auth.uid &&
          // Owner cannot change userId or createdAt
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          // Ensure other fields are also not maliciously changed if we aren't using hasOnly for owner edits
          // For simplicity, allow most fields to be updated by owner except commentCount here.
          // A more robust rule would list all allowed mutable fields by owner.
          // This rule implies owner CANNOT directly set commentCount (it's handled by Branch 2)
          // unless they send all fields and the specific count.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
          request.resource.data.updatedAt == request.time
          // No need to check other fields like userId == resource.data.userId here,
          // because hasOnly ensures they are not part of the request.resource.data if not listed.
        )
      );
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthUser();
        allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid
                      && request.resource.data.timestamp == request.time;
        allow update: if isAuthUser() && (
          // Rule 1: Owner can edit their comment text and mentions
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId && // userId cannot change
            request.resource.data.timestamp == resource.data.timestamp && // timestamp cannot change
            request.resource.data.updatedAt == request.time
          ) ||
          // Rule 2: Any authenticated user can like/unlike (update likedBy and likeCount)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
            // Ensure other core fields are not being changed during a like operation
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.timestamp == resource.data.timestamp &&
            // Validate likedBy array modification
            (
              request.resource.data.likedBy.hasAll(resource.data.likedBy) &&
              request.resource.data.likedBy.hasAny([request.auth.uid]) &&
              request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 // Added a like
            ) || (
              resource.data.likedBy.hasAll(request.resource.data.likedBy) &&
              !request.resource.data.likedBy.hasAny([request.auth.uid]) &&
              request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 // Removed a like
            ) &&
            // Validate likeCount
            (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
            request.resource.data.updatedAt == request.time
          )
        );
        allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

        match /subcomments/{subCommentId} {
          allow read: if isAuthUser();
          allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid
                        && request.resource.data.timestamp == request.time;
          allow update: if isAuthUser() && ( // Similar OR logic for sub-comment likes vs edits
            ( // Owner edit
              resource.data.userId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.updatedAt == request.time
            ) ||
            ( // Like/Unlike
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.text == resource.data.text &&
              request.resource.data.timestamp == resource.data.timestamp &&
              ((request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) || (resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)) &&
              (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
              request.resource.data.updatedAt == request.time
            )
          );
          allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;
        }
      }

      match /bids/{bidId} {
        allow read: if isAuthUser();
        allow create: if isAuthUser()
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if false; // Bids are typically immutable once placed
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      // Helper functions scoped to conversations
      function isAuthUserParticipant() {
        return resource.data.participants.hasAny([request.auth.uid]);
      }
      function wasAuthUserParticipant() {
        return resource.data.formerParticipants != null && 
               resource.data.formerParticipants[request.auth.uid] != null;
      }
      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }

      allow get: if isAuthUser() && (isAuthUserParticipant() || wasAuthUserParticipant());
      allow list: if isAuthUser() && request.query.limit <= 100;

      allow create: if isAuthUser() && (
        // Branch 1: Creating a 'direct' chat
        (
          request.resource.data.type == 'direct' &&
          request.resource.data.participants.size() == 2 &&
          request.resource.data.participants.hasAny([request.auth.uid]) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time
        ) ||
        // Branch 2: Creating a 'group' chat - SIMPLIFIED
        (
          request.resource.data.type == 'group' &&
          request.resource.data.participants.hasAny([request.auth.uid]) && // Creator must be a participant
          request.resource.data.participants.size() >= 2 && // At least 2 participants
          request.resource.data.ownerId == request.auth.uid && // Creator must be owner
          request.resource.data.adminIds.hasAny([request.auth.uid]) && // Creator must be admin
          request.resource.data.groupName is string && 
          request.resource.data.groupName.size() > 0 && // Group name required
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time
        )
      );

      allow update: if isAuthUser() && isAuthUserParticipant() && (
        // Branch A: Any participant updating last message details (sending a message)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch B: Group Admin updating groupName or groupAvatarUrl
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
          (request.resource.data.containsKey('groupName') ? request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 : true) &&
          (request.resource.data.containsKey('groupAvatarUrl') ? (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) : true) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch C: Group Admin adding participants
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() > resource.data.participants.size() &&
          request.resource.data.participants.hasAll(resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch D: Owner removing a participant
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          request.resource.data.participants is list &&
          resource.data.participants.size() > request.resource.data.participants.size() &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch E: Admin removing a non-admin participant
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants is list &&
          resource.data.participants.size() > request.resource.data.participants.size() &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch F: Participant leaving group - SIMPLIFIED
        (
          resource.data.type == 'group' &&
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
          !request.resource.data.participants.hasAny([request.auth.uid]) &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch G: Owner transferring ownership
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt']) &&
          request.resource.data.ownerId != request.auth.uid &&
          resource.data.participants.hasAny([request.resource.data.ownerId]) &&
          request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) &&
          request.resource.data.adminIds.hasAll([request.auth.uid]) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch H: Owner promoting to admin - SIMPLIFIED
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.hasAll(resource.data.adminIds) && // Ensure no existing admins are removed
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch I: Owner demoting an admin - FURTHER SIMPLIFIED
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.hasAll([request.auth.uid]) && // Owner must remain an admin
          request.resource.data.updatedAt == request.time
      );

      match /messages/{messageId} {
        allow read: if isAuthUser() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) ||
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group' && 
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants != null &&
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants[request.auth.uid] != null)
        );
        allow create: if isAuthUser() &&
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.timestamp == request.time; // Message timestamp must be server time
        allow update, delete: if false; // Messages are immutable
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      allow get: if isAuthUser() && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if isAuthUser();
      allow create: if isAuthUser() &&
                    request.resource.data.requesterId == request.auth.uid &&
                    request.resource.data.userIds.hasAll([request.auth.uid]) &&
                    request.resource.data.requestedAt == request.time;
      allow update: if isAuthUser() && resource.data.userIds.hasAny([request.auth.uid]) &&
                    // Specific update for accepting a request
                    resource.data.status == 'pending' &&
                    request.resource.data.status == 'connected' &&
                    request.resource.data.requesterId == resource.data.requesterId && // Requester cannot change
                    !resource.data.userIds.hasAny([request.resource.data.requesterId]) && // Acceptor cannot be the original requester
                    request.resource.data.userIds == resource.data.userIds && // UserIds array cannot change
                    request.resource.data.connectedAt == request.time &&
                    request.resource.data.updatedAt == request.time;
      allow delete: if isAuthUser() && resource.data.userIds.hasAny([request.auth.uid]); // For cancelling/rejecting pending or removing connected
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if isAuthUser() && request.auth.uid == userId;
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if isAuthUser();
      allow write: if isAuthUser() &&
                   request.resource.data.naicsCode == naicsDocId && // Ensure doc ID matches field
                   request.resource.data.lastUpdatedBy == request.auth.uid &&
                   request.resource.data.lastUpdatedAt == request.time;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthUser() && resource.data.userId == request.auth.uid;
      allow create: if isAuthUser() && request.resource.data.timestamp == request.time; // Sender can create for recipient
      allow update: if isAuthUser() && resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']); // Only allow marking as read
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isAuthUser(); // Any authenticated user can get any profile for now
      allow list: if isAuthUser(); // Any authenticated user can list users (queries should be secured client-side or via functions)
      allow create: if isAuthUser() && request.auth.uid == userId &&
                    request.resource.data.uid == userId &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.lastLoginAt == request.time &&
                    request.resource.data.updatedAt == request.time;
      allow update: if isAuthUser() && request.auth.uid == userId &&
                    request.resource.data.uid == resource.data.uid && // UID cannot change
                    request.resource.data.email == resource.data.email && // Email typically shouldn't change here (managed by auth)
                    request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                    request.resource.data.updatedAt == request.time;
      allow delete: if isAuthUser() && request.auth.uid == userId;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if isAuthUser();
      allow create: if isAuthUser() &&
                    request.resource.data.reviewerId == request.auth.uid &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.updatedAt == request.time;
      allow update, delete: if isAuthUser() &&
                            resource.data.reviewerId == request.auth.uid &&
                            (request.method == 'delete' || request.resource.data.updatedAt == request.time);
    }
    
    match /plans/{planId} {
      // Rule for creating plans (owner-only)
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly([
                         'name', 'ownerId', 'sector', 'subSector',
                         'industry', 'naicsCode', 'createdAt', 'updatedAt'
                       ]);

      // Rule to allow ANY AUTHENTICATED USER to read/list plans
      // This will allow getRecentPlans() to work for logged-in users.
      allow read: if request.auth != null;

      // If you want recent plans to be visible to unauthenticated users too:
      allow read: if true;

      // Add owner-based update and delete rules as needed
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId;
    	allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Fallback rule (already present in your rules)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
