
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (globally accessible if defined at this level)
    // However, for rules involving resource.data, it's often better to define them
    // within the match block where they are used if they need 'resource.data'.

    // Stripe Customers: Allow user to read their own customer data and create it.
    // Admin (backend) would handle other operations.
    match /stripe_customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // allow create: if request.auth != null && request.auth.uid == userId; // Covered by write
      // allow update, delete: if false; // Typically only by admin/backend
    }

    // Stripe Subscriptions: User can read their own, backend handles writes.
    match /stripe_customers/{userId}/subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // allow write: if false; // Backend handles subscription changes
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profile info display
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower() &&
                       !(exists(/databases/$(database)/documents/users/$(userId))) &&
                       !existsAfter(/databases/$(database)/documents/users/{otherUser}
                                    .where("mentionNameLowercase", "==", request.resource.data.mentionNameLowercase));
      allow update: if request.auth != null && request.auth.uid == userId &&
                       // Protect immutable or server-managed fields
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.mentionName == resource.data.mentionName &&
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.isBotAccount == resource.data.isBotAccount &&
                       request.resource.data.updatedAt == request.time;
    }

    // User Preferences (includes notification settings and favorite sectors)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // allow create, update: if request.auth != null && request.auth.uid == userId &&
      //                          request.resource.data.userId == userId;
    }

    // Notifications: User can read their own, create is typically server-side, update for 'isRead'
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId &&
                              (request.method == 'update' ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) : true);
      allow create, delete: if false; // Usually server-side or more specific logic
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (
                      // Branch 1: Owner can update their post
                      ( resource.data.userId == request.auth.uid &&
                        request.resource.data.userId == resource.data.userId && // Cannot change owner
                        request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                        request.resource.data.updatedAt == request.time &&
                        // Owner should not directly manipulate commentCount if we have a separate rule for it
                        (request.resource.data.keys().hasAll(['commentCount']) ? request.resource.data.commentCount == resource.data.commentCount : true)
                      ) ||
                      // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                        request.resource.data.updatedAt == request.time
                        // No need to check other fields like userId == original userId for *this specific action*
                        // because hasOnly() guarantees only commentCount & updatedAt are in the write request.
                      )
                    );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Comments are public
        allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time; // Ensure updatedAt is also set on create

        allow update: if request.auth != null && (
                        // Branch 1: Comment owner can update text and mentions
                        ( resource.data.userId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'mentionedUserIds', 'updatedAt']) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) && // Ensure ONLY these can change
                          request.resource.data.userId == resource.data.userId && // Cannot change owner
                          request.resource.data.postId == resource.data.postId && // Cannot change postID
                          request.resource.data.timestamp == resource.data.timestamp && // Cannot change original timestamp
                          request.resource.data.likeCount == resource.data.likeCount && // Cannot change likes here
                          request.resource.data.likedBy == resource.data.likedBy &&     // Cannot change likes here
                          request.resource.data.updatedAt == request.time // Ensure updatedAt is correctly set
                        ) ||
                        // Branch 2: Any authenticated user can update likeCount and likedBy
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasAll(['likedBy', 'likeCount', 'updatedAt']) &&
                          request.resource.data.diff(resource.data).affectedKeys().size() == 3 && // Ensure only these 3 fields
                          request.resource.data.userId == resource.data.userId && // Cannot change owner
                          request.resource.data.postId == resource.data.postId && // Cannot change postID
                          request.resource.data.text == resource.data.text &&         // Text cannot change here
                          request.resource.data.timestamp == resource.data.timestamp && // Original timestamp cannot change
                          request.resource.data.updatedAt == request.time && // Ensure updatedAt is correctly set
                          // Validate likeCount and likedBy consistency
                          (
                            (request.resource.data.likedBy.hasAll(resource.data.likedBy) && // Adding a like
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                             request.resource.data.likeCount == resource.data.likeCount + 1 &&
                             request.resource.data.likedBy.hasAny([request.auth.uid]) // User is adding themselves
                            ) ||
                            (!request.resource.data.likedBy.hasAll([request.auth.uid]) && // Removing a like
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                             request.resource.data.likeCount == resource.data.likeCount - 1 &&
                             !resource.data.likedBy.hasAll([request.auth.uid]) == false // User was previously in list
                            )
                          )
                        )
                      );
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

        // SubComments (Replies to comments)
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if request.auth != null &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time;
          allow update: if request.auth != null && (
                          // Branch 1: SubComment owner can update text and mentions
                          ( resource.data.userId == request.auth.uid &&
                            request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'mentionedUserIds', 'updatedAt']) &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.likeCount == resource.data.likeCount &&
                            request.resource.data.likedBy == resource.data.likedBy &&
                            request.resource.data.updatedAt == request.time
                          ) ||
                          // Branch 2: Any authenticated user can update likeCount and likedBy for subcomments
                          (
                            request.resource.data.diff(resource.data).affectedKeys().hasAll(['likedBy', 'likeCount', 'updatedAt']) &&
                            request.resource.data.diff(resource.data).affectedKeys().size() == 3 &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.text == resource.data.text &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.updatedAt == request.time &&
                            (
                              (request.resource.data.likedBy.hasAll(resource.data.likedBy) &&
                               request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                               request.resource.data.likeCount == resource.data.likeCount + 1 &&
                               request.resource.data.likedBy.hasAny([request.auth.uid])
                              ) ||
                              (!request.resource.data.likedBy.hasAll([request.auth.uid]) &&
                               request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                               request.resource.data.likeCount == resource.data.likeCount - 1 &&
                               !resource.data.likedBy.hasAll([request.auth.uid]) == false
                              )
                            )
                          )
                        );
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }

      // Bids subcollection
      match /bids/{bidId} {
        allow read: if request.auth != null; // Allow authenticated users to read bids
        allow create: if request.auth != null &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         // Ensure user is not bidding on their own post
                         get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.userId != request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.bidderId == request.auth.uid; // Bidder can update/delete their own bid
      }
    }

    // Mutual Connections
    match /mutuals/{connectionId} {
      // Helper function specific to this match block
      function isUserInMutualConnection(authUid, mutualData) {
        return authUid != null &&
               mutualData != null &&
               mutualData.userIds != null &&
               mutualData.userIds is list && // Corrected type check
               mutualData.userIds.hasAny([authUid]);
      }

      allow read: if request.auth != null && isUserInMutualConnection(request.auth.uid, resource.data);
      allow list: if request.auth != null; // Query will be filtered by 'array-contains' then refined by 'get' rule

      allow create: if request.auth != null &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.userIds.size() == 2 && // Must have exactly two UIDs
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure connectionId is correctly formed by sorting UIDs and joining with '_'
                       connectionId == (request.resource.data.userIds[0] < request.resource.data.userIds[1] ?
                                        request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1] :
                                        request.resource.data.userIds[1] + '_' + request.resource.data.userIds[0]);

      allow update: if request.auth != null && isUserInMutualConnection(request.auth.uid, resource.data) &&
                       // Scenario 1: Accepting a request
                       ( resource.data.status == 'pending' &&
                         request.resource.data.status == 'connected' &&
                         resource.data.requesterId != request.auth.uid && // Accepter is not the original requester
                         request.resource.data.connectedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Ensure no other fields are changed when accepting
                         request.resource.data.keys().hasAll(['status', 'connectedAt', 'updatedAt']) &&
                         request.resource.data.requesterId == resource.data.requesterId &&
                         request.resource.data.userIds == resource.data.userIds &&
                         request.resource.data.requestedAt == resource.data.requestedAt
                       );
                       // Note: Blocking logic might be handled by deleting the 'pending' doc and creating a new 'blocked' doc,
                       // or by updating status to 'blocked' by an authorized user (more complex rules needed).

      allow delete: if request.auth != null && isUserInMutualConnection(request.auth.uid, resource.data) &&
                       // Allow deletion if pending (cancelling/rejecting) or connected (removing connection)
                       (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    // Conversations and Messages
    match /conversations/{conversationId} {
      // Helper functions specific to this match block
      function isAuthUserParticipant(authUid, convData) {
        return authUid != null &&
               convData != null &&
               convData.participants != null &&
               convData.participants is list && // Corrected type check
               convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return authUid != null && convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return authUid != null && convData.type == 'group' &&
               convData.adminIds != null && convData.adminIds is list &&
               convData.adminIds.hasAny([authUid]);
      }

      allow get: if request.auth != null && isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if request.auth != null; // Queries will be filtered by 'array-contains request.auth.uid'

      allow create: if request.auth != null && (
                      // Branch 1: Creating a direct chat
                      ( request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.participants.hasAny([request.auth.uid]) &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds.size() == 0 &&
                        request.resource.data.groupName == null &&
                        request.resource.data.groupAvatarUrl == null &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        // Ensure client sends exactly these fields for a direct chat
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                        request.resource.data.keys().size() == 10 // PostId can be null
                      ) ||
                      // Branch 2: Creating a group chat
                      ( request.resource.data.type == 'group' &&
                        request.resource.data.ownerId == request.auth.uid &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                        request.resource.data.participants.hasAll([request.auth.uid]) &&
                        request.resource.data.participants.size() >= 2 &&
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        // Ensure client sends exactly these fields for a group chat
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'lastMessage', 'lastMessageTimestamp', 'createdAt']) &&
                        request.resource.data.keys().size() == 10 // PostId can be null
                      )
                    );

      allow update: if request.auth != null && (
                      // Branch A: Sending a message (for any participant, direct or group)
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        // Client is ONLY attempting to write these exact fields
                        request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                        request.writeFields.size() == 4 &&
                        // Validate the values being written
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time && // serverTimestamp() from client becomes request.time
                        // Ensure other essential fields are NOT being modified by this specific "send message" operation
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt
                      ) ||
                      // Branch B: Admin updating group name or avatar
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        // Only groupName, groupAvatarUrl, updatedAt can be in writeFields for this action
                        request.writeFields.hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                        (request.writeFields.hasOnly(['groupName', 'updatedAt']) ||
                         request.writeFields.hasOnly(['groupAvatarUrl', 'updatedAt']) ||
                         request.writeFields.hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'])) &&
                        (request.resource.data.groupName == null || request.resource.data.groupName is string) &&
                        (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                        request.resource.data.updatedAt == request.time &&
                        // Protect immutable or unrelated fields
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      ) ||
                      // Branch C: Admin adding/removing members (can also affect adminIds if removed user was admin)
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.writeFields.hasAll(['participants', 'updatedAt']) && // Simplest case: only participants and updatedAt
                        (!request.writeFields.hasAny(['adminIds']) || request.writeFields.hasOnly(['participants', 'adminIds', 'updatedAt'])) && // Allow adminIds to also change
                        request.resource.data.participants is list &&
                        (request.resource.data.adminIds == resource.data.adminIds || (request.resource.data.adminIds is list && !request.resource.data.adminIds.hasAny([resource.data.ownerId]) == false) ) && // Owner cannot be removed from admins by another admin
                        request.resource.data.updatedAt == request.time &&
                        // Protect immutable or unrelated fields
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
                        // Rule for removing a member (cannot remove owner via this, admin must be self if removing self as admin)
                        (request.resource.data.participants.size() < resource.data.participants.size() ?
                            !request.resource.data.participants.hasAny([resource.data.ownerId]) && // Cannot remove owner this way
                            (request.auth.uid == resource.data.ownerId || !request.resource.data.adminIds.hasAny([resource.data.ownerId])) // Non-owner admin cannot remove owner from admins
                            : true // Adding members or other admin list changes
                        ) &&
                        // If participants list is changed, it must remain >= 2 (or be deleting self from a 2-person group)
                        (request.resource.data.participants.size() >= 1 || resource.data.participants.size() == 1)
                      ) ||
                      // Branch D: Owner promoting/demoting admins (only adminIds and updatedAt change)
                      (
                        isGroupOwner(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.writeFields.hasOnly(['adminIds', 'updatedAt']) &&
                        request.resource.data.adminIds is list &&
                        request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain an admin
                        request.resource.data.updatedAt == request.time &&
                        // Protect immutable or unrelated fields
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      ) ||
                      // Branch E: Participant leaving a group (can affect participants and adminIds)
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        // WriteFields must contain 'participants' and 'updatedAt', may contain 'adminIds'
                        request.writeFields.hasAll(['participants', 'updatedAt']) &&
                        (!request.writeFields.hasAny(['adminIds']) || request.writeFields.hasOnly(['participants', 'adminIds', 'updatedAt'])) &&
                        // User is removed from participants list
                        !request.resource.data.participants.hasAny([request.auth.uid]) &&
                        // If user was admin, they are also removed from adminIds list
                        (resource.data.adminIds.hasAny([request.auth.uid]) ? !request.resource.data.adminIds.hasAny([request.auth.uid]) : request.resource.data.adminIds == resource.data.adminIds) &&
                        request.resource.data.updatedAt == request.time &&
                        // Safeguard: Owner cannot leave if they are the sole admin AND other participants remain.
                        // Client should handle promoting another admin first, or this rule will block.
                        !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && resource.data.adminIds[0] == request.auth.uid && request.resource.data.participants.size() >= 1 && resource.data.participants.size() > request.resource.data.participants.size() ) &&
                        // Protect immutable or unrelated fields
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.ownerId == resource.data.ownerId && // Cannot change owner when leaving
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      )
                    );

      allow delete: if false; // Deleting conversations typically not allowed or handled by special logic

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if request.auth != null &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time &&
                         isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid; // Only message sender can edit/delete
      }
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public once created
      allow create: if request.auth != null &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
                       // reviewerHistoricalAvgRating is calculated and set by backend/service, not client
      allow update: if request.auth != null &&
                       resource.data.reviewerId == request.auth.uid && // Only reviewer can update
                       // Protect immutable fields
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating &&
                       // Allow updating rating and comment
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.reviewerId == request.auth.uid; // Only reviewer can delete
    }

    // Whiteboard Annotations (scoped by NAICS code as document ID)
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true; // Whiteboard content can be public for collaboration context
      allow create, update: if request.auth != null &&
                               request.resource.data.naicsCode == naicsCode && // Ensure consistency
                               request.resource.data.lastUpdatedBy == request.auth.uid &&
                               request.resource.data.lastUpdatedAt == request.time;
      // No specific delete rule, updates can clear shapes array.
      // Or allow delete if (request.auth != null && isUserAllowedToManageWhiteboard(request.auth.uid, naicsCode));
    }

  }
}

    