
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts and their comments
    match /posts/{postId} {
      allow read, write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Only the user who created the comment can update or delete it
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      // Users can get a specific conversation or list conversations if they are a participant.
      // Note: For 'list', the query must be constrained in the client-side/backend (e.g., where('participants', 'array-contains', request.auth.uid))
      // This rule then applies to each document returned by such a constrained query.
      allow get, list: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]);

      // Users can create conversations if authenticated, it involves exactly 2 participants, and they are one of them.
      allow create: if request.auth != null
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants.hasAll([request.auth.uid]);

      // Users can update conversations (e.g., lastMessage) if they are a participant.
      // Participants array should not be changed after creation.
      allow update: if request.auth != null
                    && resource.data.participants.hasAny([request.auth.uid])
                    && request.resource.data.participants == resource.data.participants; // Prevent changing participants

      match /messages/{messageId} {
        // Users can read messages if they are part of the parent conversation
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        // Users can create messages if they are part of the parent conversation and are the sender
        allow create: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid;
        // Make message updates/deletes more restrictive (e.g., only by sender or not at all)
        // Changing from 'if true;' to 'if false;' for better security.
        // If you need edit/delete, define specific conditions (e.g., if request.auth.uid == resource.data.senderId)
        allow update, delete: if false;
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      // Users can read connection documents if their UID is in the userIds array
      allow read: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      // Authenticated users can create connection requests
      // - Requester must be the current user.
      // - Current user must be one of the two in userIds.
      // - Exactly two user IDs must be present.
      // - userIds must contain the requesterId and the recipientId.
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid])
                    && request.resource.data.userIds.size() == 2;
      // Users can update connection documents (e.g., accept/reject) if they are one of the userIds
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      // Users can delete connection documents (e.g., cancel/remove) if they are one of the userIds
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences (for favorite sectors)
    match /userPreferences/{userId} {
      // A user can only read and write their own preferences document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (for shared whiteboards per NAICS code)
    match /whiteboardAnnotations/{naicsCode} {
      // Any authenticated user can read shapes for any NAICS context
      allow read: if request.auth != null;
      // Any authenticated user can write (create/update/delete) shapes
      // for any NAICS context, as long as the data is consistent with the document ID.
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsCode;
    }

    // Fallback rule: Deny all reads and writes to any other paths by default.
    // This is much safer than 'if true;'.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
