
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin of a group
    function isGroupAdmin(conversationId, userId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds.hasAny([userId]);
    }
    // Helper function to check if a user is the owner of a group
    function isGroupOwner(conversationId, userId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == userId;
    }

    // Stripe rules
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} { allow read, write: if request.auth.uid == uid; }
      match /subscriptions/{id} { allow read: if request.auth.uid == uid; }
      match /payments/{id} { allow read: if request.auth.uid == uid; }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} { allow read: if true; }
      match /tax_rates/{id} { allow read: if true; }
    }
    match /collections/{collectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /conversations/{conversationId} {
      allow get: if request.auth != null && (resource == null || (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])));
      allow list: if request.auth != null && query.limit <= 100; // Added default limit for security
      allow create: if request.auth != null &&
                      request.resource.data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.lastMessageTimestamp == request.time &&
                      (
                        // Direct chat creation
                        (
                          request.resource.data.type == 'direct' &&
                          request.resource.data.participants.size() == 2 &&
                          request.resource.data.groupName == null &&
                          request.resource.data.groupAvatarUrl == null &&
                          request.resource.data.ownerId == null &&
                          request.resource.data.adminIds.size() == 0 &&
                          (request.resource.data.lastMessage == null || request.resource.data.lastMessage is string)
                        ) ||
                        // Group chat creation
                        (
                          request.resource.data.type == 'group' &&
                          request.resource.data.ownerId == request.auth.uid &&
                          request.resource.data.adminIds.hasAll([request.auth.uid]) && 
                          request.resource.data.participants.size() >= 2 &&
                          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                          (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                          request.resource.data.postId == null &&
                          request.resource.data.lastMessage is string
                        )
                      );

      allow update: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]) &&
                       // Allow updating last message details by any participant
                       (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                         request.resource.data.lastMessageSenderId == request.auth.uid &&
                         request.resource.data.participants == resource.data.participants // Ensure participants list itself isn't changed here
                       ) ||
                       // Allow group admins/owner to update group-specific fields
                       (
                         resource.data.type == 'group' &&
                         isGroupAdmin(conversationId, request.auth.uid) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'updatedAt']) &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot be changed by admins this way
                         request.resource.data.type == resource.data.type && // Type cannot change
                         request.resource.data.postId == resource.data.postId && // PostId cannot change
                         request.resource.data.participants.hasAll(request.resource.data.adminIds) && // All admins must be participants
                         request.resource.data.participants.hasAny([resource.data.ownerId]) && // Owner must remain a participant
                         // Validate adminIds updates: only owner can change adminIds, owner cannot be removed from adminIds by anyone
                         (
                           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds']) || // if adminIds is not changed
                           (
                             isGroupOwner(conversationId, request.auth.uid) && // Only owner can change adminIds
                             request.resource.data.adminIds.hasAny([resource.data.ownerId]) // Owner must remain an admin
                           )
                         ) &&
                         // Validate participants updates: admins can add/remove, user can remove self
                         (
                           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) || // if participants not changed
                           ( // Admin adding/removing others (not self)
                             isGroupAdmin(conversationId, request.auth.uid) &&
                             // Check if elements were added or removed, but not both simultaneously in a complex way here for simplicity
                             (request.resource.data.participants.size() > resource.data.participants.size() || request.resource.data.participants.size() < resource.data.participants.size())
                           ) ||
                           ( // User leaving the group (removing self)
                             request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
                             !request.resource.data.participants.hasAny([request.auth.uid]) && // User is actually removed
                             resource.data.participants.hasAll(request.resource.data.participants) && // No other participants were removed
                             // Prevent owner from leaving if they are the sole admin and other members exist
                             !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.participants.size() > 0)
                           )
                         )
                       );

      match /messages/{messageId} {
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        // Add allow update, delete as needed with appropriate checks (e.g., senderId == request.auth.uid)
      }
    }
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId;
    }
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} {
        allow list: if request.auth != null;
    }
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
