rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts and their comments
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow write: if request.auth != null; // Only authenticated users can write posts

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }

      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      allow get: if request.auth != null && (resource == null || (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])));
      allow list: if request.auth != null; // Relies on client query constraints for security
      allow create: if request.auth != null
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if request.auth != null
                    && resource.data.participants.hasAll([request.auth.uid])
                    && request.resource.data.participants == resource.data.participants; // Prevent changing participants

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null; // Relies on client query constraints for security
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences (for favorite sectors)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (for shared whiteboards per NAICS code)
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} { // For getSuggestibleUsers (list query)
        allow list: if request.auth != null;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.reviewerId == request.auth.uid;
    }

    // Fallback rule: Deny by default for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
