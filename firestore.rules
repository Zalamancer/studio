
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (Global or to be defined within specific match blocks if they use resource/request)
    function isAuthUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // ======= Users Collection =======
    match /users/{userId} {
      allow read: if true; // Public profiles are readable
      allow create: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0 &&
                       request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase.size() > 0 &&
                       (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string) &&
                       (!('companyName' in request.resource.data) || request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description is string) &&
                       (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility == 'everyone' || request.resource.data.descriptionVisibility == 'connected' || request.resource.data.descriptionVisibility == 'only_me') &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags == null || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established == null || request.resource.data.established is string) &&
                       (!('verified' in request.resource.data) || request.resource.data.verified == false || request.resource.data.verified == true) &&
                       (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount == false || request.resource.data.isBotAccount == true) &&
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange == null || request.resource.data.incomeRange is string) &&
                       request.resource.data.keys().hasOnly([
                         'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl',
                         'industry', 'description', 'descriptionVisibility',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                         'createdAt', 'updatedAt', 'lastLoginAt'
                       ]);
      allow update: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email cannot change via this update
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // derived, so should also not change
                       request.resource.data.companyName == resource.data.companyName && // companyName cannot change here (set at signup)
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be server timestamp
                       // Allow lastLoginAt to be updated or remain same
                       (request.resource.data.lastLoginAt == request.time || request.resource.data.lastLoginAt == resource.data.lastLoginAt) &&
                       // Check types for updatable fields
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description is string) &&
                       (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility == 'everyone' || request.resource.data.descriptionVisibility == 'connected' || request.resource.data.descriptionVisibility == 'only_me') &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags == null || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established == null || request.resource.data.established is string) &&
                       (!('verified' in request.resource.data) || request.resource.data.verified == resource.data.verified) && // verified is admin-only or specific flow
                       (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount == resource.data.isBotAccount) && // isBotAccount is admin-only
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange == null || request.resource.data.incomeRange is string) &&
                       // Ensure only allowed fields are part of the update request
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'incomeRange', 'lastLoginAt', 'updatedAt'
                       ]);
      allow delete: if isAuthUser() && request.auth.uid == userId; // User can delete their own account data
    }

    // ======= Posts Collection =======
    match /posts/{postId} {
      allow read: if true; // Posts are public by default

      function isPostOwner() {
        return request.auth.uid == resource.data.userId;
      }
      function isPostDataValid_Create() {
        let data = request.resource.data;
        return data.userId == request.auth.uid &&
               data.question is string && data.question.size() > 0 && data.question.size() <= 200 &&
               data.tags is list && data.tags.size() > 0 &&
               data.sector is string && data.sector.size() > 0 &&
               (data.subSector == null || data.subSector is string) &&
               (data.industry == null || data.industry is string) &&
               (data.naicsCode == null || data.naicsCode is string) &&
               (data.ratingScore is number && data.ratingScore >= 0 && data.ratingScore <= 5) &&
               (data.imageUrls == null || data.imageUrls is list) &&
               (data.mentionedUserIds == null || data.mentionedUserIds is list) &&
               (data.requestType == 'post' || data.requestType == 'help_request') &&
               (data.descriptionDetails is string && data.descriptionDetails.size() >= 0) && // allow empty for now, client can enforce min
               (data.descriptionTried == null || data.descriptionTried is string) &&
               (data.descriptionOutcome == null || data.descriptionOutcome is string) &&
               (data.maxBudget == null || data.maxBudget is number && data.maxBudget >= 0) &&
               (data.deadline == null || data.deadline is timestamp) &&
               data.commentCount == 0 && // commentCount should be 0 on create
               data.createdAt == request.time &&
               data.keys().hasOnly([
                 'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                 'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType',
                 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                 'maxBudget', 'deadline', 'commentCount', 'createdAt'
               ]);
      }

      allow create: if isAuthUser() && isPostDataValid_Create();
      allow update: if isAuthUser() && isPostOwner() &&
                       request.resource.data.userId == resource.data.userId && // Cannot change owner
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       // Allow other fields to be updated, add type checks if needed
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       // Ensure commentCount is only changed via specific operations (like adding a comment)
                       // This basic update rule assumes commentCount is NOT directly updatable here
                       // A dedicated rule for commentCount increment/decrement is better.
                       // For now, if it's present in the update, it must be the same (or handled by transactions)
                       (!('commentCount' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.commentCount == resource.data.commentCount) &&
                       (!('updatedAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.updatedAt == request.time);


      allow delete: if isAuthUser() && isPostOwner();

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        allow read: if true; // Comments are public

        function isCommentOwner() {
          return request.auth.uid == resource.data.userId;
        }
        function isCommentDataValid_Create() {
          let data = request.resource.data;
          return data.userId == request.auth.uid &&
                 data.text is string && data.text.size() > 0 &&
                 data.timestamp == request.time &&
                 data.updatedAt == request.time &&
                 (data.likeCount == 0) &&
                 (data.likedBy is list && data.likedBy.size() == 0) &&
                 (data.mentionedUserIds == null || data.mentionedUserIds is list);
        }
        function isCommentDataValid_Update() {
            let diff = request.resource.data.diff(resource.data);
            return diff.affectedKeys().hasOnly(['text', 'likeCount', 'likedBy', 'updatedAt', 'mentionedUserIds']) &&
                   request.resource.data.userId == resource.data.userId && // Cannot change owner
                   request.resource.data.timestamp == resource.data.timestamp && // Cannot change creation time
                   request.resource.data.updatedAt == request.time && // updatedAt must be server timestamp
                   request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                   request.resource.data.likeCount is number && request.resource.data.likeCount >= 0 &&
                   request.resource.data.likedBy is list &&
                   (request.resource.data.mentionedUserIds == null || request.resource.data.mentionedUserIds is list);
        }

        allow create: if isAuthUser() && isCommentDataValid_Create();
        allow update: if isAuthUser() && (isCommentOwner() && isCommentDataValid_Update() || isLikingComment()); // Allow owner to edit text, or any user to like
        allow delete: if isAuthUser() && isCommentOwner();

        function isLikingComment() {
            let diff = request.resource.data.diff(resource.data);
            return diff.affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) && // Only these fields can change for a like
                   request.resource.data.userId == resource.data.userId &&
                   request.resource.data.text == resource.data.text &&
                   request.resource.data.timestamp == resource.data.timestamp &&
                   request.resource.data.updatedAt == request.time &&
                   request.resource.data.likeCount is number &&
                   request.resource.data.likedBy is list &&
                   (  // Liking
                       (!resource.data.likedBy.hasAny([request.auth.uid]) &&
                        request.resource.data.likedBy.hasAll([request.auth.uid]) &&
                        request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                        request.resource.data.likeCount == resource.data.likeCount + 1) ||
                       // Unliking
                       (resource.data.likedBy.hasAny([request.auth.uid]) &&
                        !request.resource.data.likedBy.hasAny([request.auth.uid]) &&
                        request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                        request.resource.data.likeCount == resource.data.likeCount - 1)
                   );
        }

        // --- SubComments Subcollection ---
        match /subcomments/{subCommentId} {
            allow read: if true;

            function isSubCommentOwner() {
                return request.auth.uid == resource.data.userId;
            }
            function isSubCommentDataValid_Create() {
                let data = request.resource.data;
                return data.userId == request.auth.uid &&
                       data.text is string && data.text.size() > 0 &&
                       data.timestamp == request.time &&
                       data.updatedAt == request.time &&
                       (data.likeCount == 0) &&
                       (data.likedBy is list && data.likedBy.size() == 0) &&
                       (data.mentionedUserIds == null || data.mentionedUserIds is list);
            }
            function isSubCommentDataValid_Update() {
                let diff = request.resource.data.diff(resource.data);
                return diff.affectedKeys().hasOnly(['text', 'likeCount', 'likedBy', 'updatedAt', 'mentionedUserIds']) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.timestamp == resource.data.timestamp &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                       request.resource.data.likeCount is number && request.resource.data.likeCount >=0 &&
                       request.resource.data.likedBy is list &&
                       (request.resource.data.mentionedUserIds == null || request.resource.data.mentionedUserIds is list);
            }
            function isLikingSubComment() {
                let diff = request.resource.data.diff(resource.data);
                return diff.affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.text == resource.data.text &&
                       request.resource.data.timestamp == resource.data.timestamp &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.likeCount is number &&
                       request.resource.data.likedBy is list &&
                       (
                           (!resource.data.likedBy.hasAny([request.auth.uid]) &&
                            request.resource.data.likedBy.hasAll([request.auth.uid]) &&
                            request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                            request.resource.data.likeCount == resource.data.likeCount + 1) ||
                           (resource.data.likedBy.hasAny([request.auth.uid]) &&
                            !request.resource.data.likedBy.hasAny([request.auth.uid]) &&
                            request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                            request.resource.data.likeCount == resource.data.likeCount - 1)
                       );
            }

            allow create: if isAuthUser() && isSubCommentDataValid_Create();
            allow update: if isAuthUser() && (isSubCommentOwner() && isSubCommentDataValid_Update() || isLikingSubComment());
            allow delete: if isAuthUser() && isSubCommentOwner();
        } // END of match /subcomments/{subCommentId}
      } // END of match /comments/{commentId}

      // --- Bids Subcollection ---
      match /bids/{bidId} {
        allow read: if isAuthUser() && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid; // Only post owner can read bids for their post
        allow create: if isAuthUser() && request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId && // Cannot bid on own post
                       request.resource.data.bidderId == request.auth.uid &&
                       request.resource.data.postId == postId &&
                       request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                       (request.resource.data.bidMessage == null || request.resource.data.bidMessage is string) &&
                       request.resource.data.timestamp == request.time;
        allow update: if false; // Bids are immutable
        allow delete: if false; // Bids cannot be deleted (or add specific logic if needed)
      } // END of match /bids/{bidId}
    } // END of match /posts/{postId}


    // ======= Mutuals Collection (Connections) =======
    match /mutuals/{connectionId} {
      function isUserInConnection(uid, connectionData) {
        return uid in connectionData.userIds;
      }
      function isValidConnectionId(uid1, uid2, connId) {
        return (uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1) == connId;
      }

      allow read: if isAuthUser() && isUserInConnection(request.auth.uid, resource.data);
      allow create: if isAuthUser() &&
                       isValidConnectionId(request.resource.data.requesterId, request.resource.data.userIds.removeAll([request.resource.data.requesterId])[0], connectionId) &&
                       request.auth.uid == request.resource.data.requesterId &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be one of the UIDs
                       request.resource.data.userIds.size() == 2 && // Must be between two users
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time && // Added updatedAt
                       !exists(/databases/$(database)/documents/mutuals/$(connectionId)); // Ensure it doesn't exist

      allow update: if isAuthUser() && isUserInConnection(request.auth.uid, resource.data) &&
                       request.resource.data.userIds == resource.data.userIds && // userIds cannot change
                       request.resource.data.requesterId == resource.data.requesterId && // requesterId cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be updated
                       ( // Accepting a request
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'connected' &&
                         request.auth.uid != resource.data.requesterId && // Accepter cannot be original requester
                         request.resource.data.connectedAt == request.time // Set connectedAt on accept
                       );
                       // No explicit delete permission, handled by specific actions in service or more complex rules
      allow delete: if isAuthUser() && isUserInConnection(request.auth.uid, resource.data) &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected'); // Allow deleting pending or connected states
    }

    // ======= Conversations Collection =======
    match /conversations/{conversationId} {
      // Helper functions specific to conversations
      function isAuthUserParticipant(authUid, convData) {
        return convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }

      // Creation rules
      function isConversationCreate_Direct(convData, authUid, requestTime) {
        return convData.type == 'direct' &&
               convData.participants.size() == 2 &&
               convData.participants.hasAll([authUid]) && // Creator must be a participant
               convData.postId == null && // For general direct chat, or validated if postId is present
               convData.groupName == null && convData.groupAvatarUrl == null && convData.ownerId == null && convData.adminIds.size() == 0 &&
               convData.lastMessage == null && // New direct chats start with no message
               convData.createdAt == requestTime && convData.updatedAt == requestTime && convData.lastMessageTimestamp == requestTime &&
               (!('formerParticipants' in convData) || convData.formerParticipants.keys().size() == 0) &&
               convData.keys().hasOnly(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'formerParticipants']);
      }
      function isConversationCreate_Group(convData, authUid, requestTime) {
        return convData.type == 'group' &&
               convData.ownerId == authUid &&
               convData.adminIds.hasAll([authUid]) && convData.adminIds.size() == 1 &&
               convData.participants.hasAll([authUid]) && convData.participants.size() >= 2 &&
               convData.groupName is string && convData.groupName.size() > 0 &&
               (convData.groupAvatarUrl == null || convData.groupAvatarUrl is string) &&
               convData.postId == null &&
               convData.lastMessage is string && // Group creation has an initial "created" message
               convData.createdAt == requestTime && convData.updatedAt == requestTime && convData.lastMessageTimestamp == requestTime &&
               (!('formerParticipants' in convData) || convData.formerParticipants.keys().size() == 0) &&
               convData.keys().hasOnly(['participants', 'type', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'formerParticipants']);
      }

      allow get: if isAuthUser() && isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if isAuthUser(); // Query will be filtered by 'array-contains' current user's UID

      allow create: if isAuthUser() &&
                      ( isConversationCreate_Direct(request.resource.data, request.auth.uid, request.time) ||
                        isConversationCreate_Group(request.resource.data, request.auth.uid, request.time)
                      );

      // Update rules for conversations (complex due to different actions)
      allow update: if isAuthUser() &&
        (
          // Branch A: Sending a message (for any participant, direct or group)
          (
            isAuthUserParticipant(request.auth.uid, resource.data) &&
            request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
            request.writeFields.size() == 4 &&
            request.resource.data.lastMessageSenderId == request.auth.uid &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.lastMessageTimestamp == request.time &&
            // Ensure other fields are NOT being modified by this "send message" operation
            request.resource.data.type == resource.data.type &&
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.adminIds == resource.data.adminIds &&
            request.resource.data.groupName == resource.data.groupName &&
            request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.formerParticipants == resource.data.formerParticipants // formerParticipants should not change when sending a message
          )
          ||
          // Branch B: Admin changing group name or avatar
          (
            isGroupAdmin(request.auth.uid, resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.adminIds == resource.data.adminIds && // Admins list doesn't change here
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage &&
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
            request.resource.data.formerParticipants == resource.data.formerParticipants &&
            (request.resource.data.groupName is string && request.resource.data.groupName.size() > 0) &&
            (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
            request.resource.data.updatedAt == request.time
          )
          ||
          // Branch C: Admin adding members
          (
            isGroupAdmin(request.auth.uid, resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.adminIds == resource.data.adminIds &&
            request.resource.data.participants.hasAll(resource.data.participants) && // New participants must be a superset
            request.resource.data.participants.size() > resource.data.participants.size() &&
            // Ensure new members are not already former participants being re-added this way (re-joining is a different flow)
            request.resource.data.participants.removeAll(resource.data.participants).filter(uid => uid in resource.data.formerParticipants).size() == 0 &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time
          )
          ||
          // Branch D: Admin removing members (non-owner)
          (
            isGroupAdmin(request.auth.uid, resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) && // adminIds might change if removed admin
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            resource.data.participants.hasAll(request.resource.data.participants) && // Current participants must be a superset
            resource.data.participants.size() > request.resource.data.participants.size() &&
            // Ensure the owner is not removed
            request.resource.data.participants.hasAll([resource.data.ownerId]) &&
            // Ensure removed users are not the current user themselves (they should use "leave group")
            !resource.data.participants.removeAll(request.resource.data.participants).hasAny([request.auth.uid]) &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time
          )
          ||
          // Branch E: Owner promoting/demoting admins (cannot demote self if owner)
          (
            isGroupOwner(request.auth.uid, resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
            request.resource.data.adminIds.hasAll([request.auth.uid]) && // Owner must remain admin
            // Ensure new admins are existing participants
            request.resource.data.adminIds.filter(adminUid => !request.resource.data.participants.hasAny([adminUid])).size() == 0 &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time
          )
          ||
          // Branch F: Participant leaving group
          (
            resource.data.type == 'group' &&
            resource.data.participants.hasAny([request.auth.uid]) && // User must be current participant
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'formerParticipants', 'updatedAt']) &&
            // Participant is removed from 'participants'
            !request.resource.data.participants.hasAny([request.auth.uid]) &&
            resource.data.participants.removeAll(request.resource.data.participants).size() == 1 &&
            resource.data.participants.removeAll(request.resource.data.participants)[0] == request.auth.uid &&
            // Participant is removed from 'adminIds' if they were an admin
            ( (resource.data.adminIds.hasAny([request.auth.uid]) && !request.resource.data.adminIds.hasAny([request.auth.uid]) && resource.data.adminIds.removeAll(request.resource.data.adminIds).size() == 1 && resource.data.adminIds.removeAll(request.resource.data.adminIds)[0] == request.auth.uid) ||
              (!resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.adminIds.size() == resource.data.adminIds.size()) // or adminIds unchanged if user wasn't admin
            ) &&
            // Owner safeguard: owner cannot leave if they are the sole admin AND other participants remain
            !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && request.resource.data.participants.size() > 0 && request.resource.data.adminIds.hasAll([request.auth.uid])) &&
            // Record leave time in formerParticipants
            request.resource.data.formerParticipants[request.auth.uid] == request.time &&
            // Other fields must be immutable for this specific "leave" operation
            request.resource.data.type == resource.data.type &&
            request.resource.data.groupName == resource.data.groupName &&
            request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
            request.resource.data.ownerId == resource.data.ownerId && // Owner ID must not change
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage && // lastMessage fields are not part of "leave"
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
            // Timestamp update for this operation
            request.resource.data.updatedAt == request.time
          )
        ); // End of allow update OR conditions

      allow delete: if false; // Deleting conversations should be a specific, controlled process, not general delete

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        // Helper function for message read logic
        function canViewMessage() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          // 1. Still a participant -> full access
          // Ensure conv.participants is not null before calling hasAny
          if (conv.participants != null && conv.participants.hasAny([request.auth.uid])) {
            return true;
          }
          // 2. Former participant -> only up to leave-time
          // Ensure conv.formerParticipants and its keys are not null before accessing
          if (conv.formerParticipants != null && conv.formerParticipants.keys() != null && conv.formerParticipants.keys().hasAny([request.auth.uid])) {
            // Ensure resource.data.timestamp and conv.formerParticipants[request.auth.uid] are valid timestamps for comparison
            return resource.data.timestamp is timestamp &&
                   conv.formerParticipants[request.auth.uid] is timestamp &&
                   resource.data.timestamp <= conv.formerParticipants[request.auth.uid];
          }
          return false; // Default: if not current participant and not former with valid leave time
        }

        allow read: if isAuthUser() && canViewMessage();

        function isMessageSender() {
          return request.auth.uid == request.resource.data.senderId;
        }
        function isMessageDataValid_Create() {
          let data = request.resource.data;
          return data.senderId == request.auth.uid &&
                 data.text is string && data.text.size() > 0 &&
                 data.timestamp == request.time &&
                 (data.isBotMessage == null || data.isBotMessage == false) && // User cannot send bot message
                 (data.replyToMessageId == null || data.replyToMessageId is string) &&
                 (data.repliedToTextSnippet == null || data.repliedToTextSnippet is string) &&
                 data.read == false && // New messages are unread
                 data.conversationId == conversationId &&
                 data.keys().hasOnly(['senderId', 'text', 'timestamp', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'read', 'conversationId']);
        }

        allow create: if isAuthUser() && isMessageSender() && isMessageDataValid_Create() &&
                         // User must be an active participant of the conversation to send a message
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) &&
                         // And not in formerParticipants (meaning they haven't left)
                         (get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants == null ||
                          !get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants.keys().hasAny([request.auth.uid]));

        allow update: if false; // Messages are generally immutable, or specific fields like 'read' handled differently
        allow delete: if false; // Or specific logic
      } // END of match /messages/{messageId}
    } // END of match /conversations/{conversationId}

    // ======= User Preferences =======
    match /userPreferences/{userId} {
        allow read, write: if isAuthUser() && request.auth.uid == userId;
        // For write (create/update), ensure only known fields are written
        allow create: if isAuthUser() && request.auth.uid == userId &&
                         request.resource.data.userId == userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'favoriteSectorCodes',
                            'notifyOnReply', 'notifyOnMention',
                            'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted',
                            'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                            'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                            'paymentMethods',
                            'createdAt', 'updatedAt'
                         ]);
        allow update: if isAuthUser() && request.auth.uid == userId &&
                         request.resource.data.userId == userId && // Cannot change userId
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'favoriteSectorCodes',
                            'notifyOnReply', 'notifyOnMention',
                            'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted',
                            'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                            'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                            'paymentMethods',
                            'updatedAt' // Only allow updatedAt to be changed by serverTimestamp
                         ]);
    }

    // ======= Notifications Collection =======
    match /notifications/{notificationId} {
        // User can read their own notifications
        allow read: if isAuthUser() && resource.data.userId == request.auth.uid;
        // Notifications are created by the system (server-side or Cloud Functions ideally),
        // or by a user triggering an action that results in a notification for another user.
        // Direct client creation of notifications for *other* users should be restricted.
        // Direct client creation for *self* (e.g., reminders) might be allowed if use case exists.
        allow create: if isAuthUser() &&
                         request.resource.data.senderId == request.auth.uid && // Sender must be the authenticated user
                         request.resource.data.userId != request.auth.uid &&   // Recipient cannot be self (prevents self-spamming via this rule)
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.isRead == false;
        // User can update 'isRead' status of their own notifications
        allow update: if isAuthUser() && resource.data.userId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if false; // Or allow user to delete their own notifications
    }

    // ======= Reviews Collection =======
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        function isReviewOwner() {
            return request.auth.uid == resource.data.reviewerId;
        }
        function isValidReviewData_Create() {
            let data = request.resource.data;
            return data.reviewerId == request.auth.uid &&
                   data.targetUserId != request.auth.uid && // Cannot review self
                   data.rating is number && data.rating >= 1 && data.rating <= 5 &&
                   data.comment is string &&
                   (data.reviewerName is string && data.reviewerName.size() > 0) &&
                   (data.reviewerAvatar == null || data.reviewerAvatar is string) &&
                   (data.reviewerHistoricalAvgRating == null || data.reviewerHistoricalAvgRating is number) &&
                   data.createdAt == request.time &&
                   data.updatedAt == request.time;
        }
        function isValidReviewData_Update() {
            let data = request.resource.data;
            return data.reviewerId == request.auth.uid &&
                   data.targetUserId == resource.data.targetUserId && // Cannot change target
                   data.reviewerId == resource.data.reviewerId &&     // Cannot change reviewer
                   data.createdAt == resource.data.createdAt &&       // Cannot change creation time
                   data.rating is number && data.rating >= 1 && data.rating <= 5 &&
                   data.comment is string &&
                   // reviewerName, reviewerAvatar, reviewerHistoricalAvgRating are set at creation and not updatable by user
                   data.reviewerName == resource.data.reviewerName &&
                   data.reviewerAvatar == resource.data.reviewerAvatar &&
                   data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating &&
                   data.updatedAt == request.time;
        }
        allow create: if isAuthUser() && isValidReviewData_Create();
        allow update: if isAuthUser() && isReviewOwner() && isValidReviewData_Update() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
        allow delete: if isAuthUser() && isReviewOwner();
    }

    // ======= Whiteboard Annotations =======
    match /whiteboardAnnotations/{naicsCode} {
        allow read: if true; // Whiteboard content is public for now
        // Only authenticated users can save whiteboard shapes.
        // Rule ensures that the document ID (naicsCode) matches a field within the document itself.
        // This helps prevent users from writing to arbitrary document IDs if they can guess them.
        // And, the 'lastUpdatedBy' field must be the authenticated user.
        allow write: if isAuthUser() &&
                        request.resource.data.naicsCode == naicsCode &&
                        request.resource.data.lastUpdatedBy == request.auth.uid &&
                        (request.resource.data.lastUpdatedAt == request.time || request.resource.data.shapes is list); // Allow initial create or update
    }

  } // END of match /databases/{database}/documents
}     // END of service cloud.firestore

    