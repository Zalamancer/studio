
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (globally or locally scoped as needed)
    // Note: Functions must be defined before they are used if defined globally,
    // or within the match block where they are intended to be used.

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true; // Public profiles are generally readable
      allow create: if request.auth != null && request.auth.uid == userId &&
                      request.resource.data.uid == userId &&
                      request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0 &&
                      request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower() &&
                      (!('email' in request.resource.data) || request.resource.data.email == request.auth.email || request.resource.data.email == null) &&
                      (!('companyName' in request.resource.data) || request.resource.data.companyName is string || request.resource.data.companyName == null) &&
                      (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                      request.resource.data.keys().hasOnly(['uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'industry', 'avatarUrl', 'descriptionVisibility', 'createdAt', 'updatedAt', 'lastLoginAt', 'isBotAccount']) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.lastLoginAt == request.time;

      allow update: if request.auth != null && request.auth.uid == userId &&
                       // Fields that can be updated by the user
                       request.resource.data.keys().hasAny(['avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established', 'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'lastLoginAt', 'updatedAt']) &&
                       // Fields that CANNOT be changed by user after creation
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email && // Email shouldn't change via profile update usually
                       request.resource.data.companyName == resource.data.companyName && // Company name set at signup
                       request.resource.data.mentionName == resource.data.mentionName &&
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure no other fields are being snuck in
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established', 'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'lastLoginAt', 'updatedAt']);
    }

    // --- User Preferences Collection ---
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Add specific field validations for write if needed (e.g., notifyOn... are booleans)
      // Example for create (can be merged with write using resource.data for existing checks)
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time;
    }

    // --- Posts Collection ---
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0;
                       // Add other field validations as necessary
      allow update: if request.auth != null &&
                      ( // Branch 1: Owner of the post can update specific fields
                        (
                          resource.data.userId == request.auth.uid &&
                          // Ensure only allowed fields are being modified by the owner
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                            'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                            'imageUrls', 'mentionedUserIds', 'requestType',
                            'maxBudget', 'deadline', 'updatedAt'
                            // 'ratingScore' is set at creation, 'commentCount' is system-managed
                          ]) &&
                          request.resource.data.userId == resource.data.userId &&       // Cannot change owner
                          request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                          request.resource.data.ratingScore == resource.data.ratingScore && // Cannot change rating score via direct edit
                          request.resource.data.commentCount == resource.data.commentCount && // Owner doesn't directly edit comment count
                          request.resource.data.updatedAt == request.time                 // Must set update time
                        ) ||
                        // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt)
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                          // Ensure immutable fields are not part of the request if it's just a commentCount update
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.createdAt == resource.data.createdAt &&
                          request.resource.data.question == resource.data.question && // Ensure question is the same
                          request.resource.data.updatedAt == request.time
                        )
                      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        allow read: if true; // Comments are public
        allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0;
        allow update: if request.auth != null &&
                        ( // Branch 1: Owner can edit their comment text and mentions
                          (
                            resource.data.userId == request.auth.uid &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.postId == resource.data.postId &&
                            request.resource.data.timestamp == resource.data.timestamp && // original timestamp immutable
                            request.resource.data.likeCount == resource.data.likeCount &&   // likeCount not directly editable
                            request.resource.data.likedBy == resource.data.likedBy &&     // likedBy not directly editable
                            request.resource.data.updatedAt == request.time                 // must update timestamp
                          ) ||
                          // Branch 2: Any authenticated user can like/unlike (update likedBy and likeCount)
                          (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                            // Ensure other critical fields are not changed during a like operation
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.postId == resource.data.postId &&
                            request.resource.data.text == resource.data.text &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.updatedAt == request.time &&
                            // Validate likedBy array modification: add self or remove self
                            (
                              (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAll([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) || // Adding like
                              (!request.resource.data.likedBy.hasAll([request.auth.uid]) && resource.data.likedBy.hasAll(request.resource.data.likedBy) && request.resource.data.likedBy.size() == resource.data.likedBy.size() -1)      // Removing like
                            ) &&
                            // Validate likeCount change
                            (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1)
                          )
                        );
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

        // --- SubComments Sub-Subcollection ---
        match /subcomments/{subCommentId} {
            allow read: if true; // SubComments are public
            allow create: if request.auth != null &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy.size() == 0;
            allow update: if request.auth != null &&
                            ( // Branch 1: Owner can edit their subcomment text and mentions
                              (
                                resource.data.userId == request.auth.uid &&
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                                request.resource.data.userId == resource.data.userId &&
                                request.resource.data.timestamp == resource.data.timestamp &&
                                request.resource.data.likeCount == resource.data.likeCount &&
                                request.resource.data.likedBy == resource.data.likedBy &&
                                request.resource.data.updatedAt == request.time
                              ) ||
                              // Branch 2: Any authenticated user can like/unlike subcomment
                              (
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                request.resource.data.userId == resource.data.userId &&
                                request.resource.data.text == resource.data.text &&
                                request.resource.data.timestamp == resource.data.timestamp &&
                                request.resource.data.updatedAt == request.time &&
                                (
                                  (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAll([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) ||
                                  (!request.resource.data.likedBy.hasAll([request.auth.uid]) && resource.data.likedBy.hasAll(request.resource.data.likedBy) && request.resource.data.likedBy.size() == resource.data.likedBy.size() -1)
                                ) &&
                                (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1)
                              )
                            );
            allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }

      // --- Bids Subcollection ---
      match /bids/{bidId} {
        allow read: if request.auth != null && (
                       // Post owner can read bids on their post
                       get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
                       // Bidder can read their own bid
                       resource.data.bidderId == request.auth.uid
                     );
        allow create: if request.auth != null &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         // Ensure bidder is not the post owner
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.bidderId == request.auth.uid;
      }
    }

    // --- Mutuals Collection (Connections) ---
    match /mutuals/{connectionId} {
      // Helper function correctly scoped for mutuals
      function isUserInMutualConnection(authUid, mutualData) {
        return authUid != null &&
               mutualData != null &&
               mutualData.userIds != null &&
               mutualData.userIds is list && // Corrected to 'is list'
               mutualData.userIds.hasAny([authUid]);
      }

      allow get: if request.auth != null &&
                    isUserInMutualConnection(request.auth.uid, resource.data);
      allow list: if request.auth != null; // Firestore implicitly checks 'get' for each listed doc

      allow create: if request.auth != null &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure no other fields are being snuck in
                       request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']);

      allow update: if request.auth != null && isUserInMutualConnection(request.auth.uid, resource.data) &&
                      ( // Branch A: Accepting a request
                        (
                          resource.data.status == 'pending' &&
                          request.resource.data.status == 'connected' &&
                          resource.data.requesterId != request.auth.uid && // Only recipient can accept
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']) &&
                          request.resource.data.connectedAt == request.time &&
                          request.resource.data.updatedAt == request.time &&
                          request.resource.data.userIds == resource.data.userIds &&
                          request.resource.data.requesterId == resource.data.requesterId &&
                          request.resource.data.requestedAt == resource.data.requestedAt
                        )
                        // No other updates allowed on mutuals docs, they are either created pending, accepted, or deleted.
                      );
      allow delete: if request.auth != null && isUserInMutualConnection(request.auth.uid, resource.data) &&
                       ( // Branch A: Rejecting/Cancelling a PENDING request
                         (resource.data.status == 'pending') ||
                         // Branch B: Removing an ESTABLISHED connection
                         (resource.data.status == 'connected')
                       );
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
        allow create: if request.auth != null &&
                         request.resource.data.senderId == request.auth.uid && // Sender must be the authenticated user
                         request.resource.data.userId != request.auth.uid &&   // Cannot send notification to oneself this way
                         request.resource.data.isRead == false &&
                         request.resource.data.timestamp == request.time;
    }

    // --- Conversations Collection ---
    match /conversations/{conversationId} {
      // Helper functions specific to conversations
      function isAuthUserParticipant(authUid, convData) {
        return authUid != null &&
               convData != null &&
               convData.participants != null &&
               convData.participants is list &&
               convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return authUid != null && convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return authUid != null && convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }

      allow get: if request.auth != null &&
                    isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if request.auth != null; // Firestore implicitly checks 'get' for each listed doc

      allow create: if request.auth != null &&
                      ( // Branch A: Create Direct Chat
                        (
                          request.resource.data.type == 'direct' &&
                          request.resource.data.participants.size() == 2 &&
                          request.resource.data.participants.hasAll([request.auth.uid]) &&
                          request.resource.data.ownerId == null &&
                          request.resource.data.adminIds.size() == 0 &&
                          request.resource.data.groupName == null &&
                          request.resource.data.groupAvatarUrl == null &&
                          request.resource.data.createdAt == request.time &&
                          request.resource.data.lastMessageTimestamp == request.time &&
                          // Ensure only expected fields are present for direct chat creation
                          request.resource.data.keys().hasOnly(['participants', 'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl']) &&
                          request.resource.data.keys().size() == 10 // Adjust if default null fields are not sent by client
                        ) ||
                        // Branch B: Create Group Chat
                        (
                          request.resource.data.type == 'group' &&
                          isAuthUserParticipant(request.auth.uid, request.resource.data) && // Creator must be a participant
                          request.resource.data.ownerId == request.auth.uid && // Creator is owner
                          request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
                          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                          request.resource.data.createdAt == request.time &&
                          request.resource.data.lastMessageTimestamp == request.time &&
                          // Validate participant list integrity (e.g., owner is in participants)
                          request.resource.data.participants.hasAll([request.resource.data.ownerId]) &&
                          // Ensure only expected fields for group chat creation
                          request.resource.data.keys().hasOnly(['participants', 'type', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp']) &&
                          request.resource.data.keys().size() == 10
                        )
                      );

      allow update: if request.auth != null && isAuthUserParticipant(request.auth.uid, resource.data) &&
                      ( // Branch A: Updating lastMessage, lastMessageSenderId, lastMessageTimestamp, updatedAt (ANY participant can do this)
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                          request.resource.data.lastMessageSenderId == request.auth.uid &&
                          request.resource.data.updatedAt == request.time &&
                          // Ensure other core fields are not changed during this specific update
                          request.resource.data.type == resource.data.type &&
                          request.resource.data.ownerId == resource.data.ownerId &&
                          request.resource.data.createdAt == resource.data.createdAt &&
                          request.resource.data.participants == resource.data.participants && // Participants list must remain same for THIS action
                          request.resource.data.adminIds == resource.data.adminIds && // Admin list must remain same for THIS action
                          request.resource.data.groupName == resource.data.groupName && // Group name must remain same for THIS action
                          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl && // Group avatar must remain same for THIS action
                          request.resource.data.postId == resource.data.postId // PostId must remain same
                        ) ||
                        // Branch B: Group Admin updating groupName or groupAvatarUrl
                        (
                          resource.data.type == 'group' && isGroupAdmin(request.auth.uid, resource.data) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) && // Can update one or both + updatedAt
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) && // But ONLY these
                          request.resource.data.updatedAt == request.time &&
                          // Protect immutable/other fields
                          request.resource.data.type == resource.data.type &&
                          request.resource.data.ownerId == resource.data.ownerId &&
                          request.resource.data.createdAt == resource.data.createdAt &&
                          request.resource.data.participants == resource.data.participants && // Participants list not changed by this action
                          request.resource.data.adminIds == resource.data.adminIds && // Admin list not changed by this action
                          request.resource.data.postId == resource.data.postId
                        ) ||
                        // Branch C: Group Admin adding/removing members (participants list changes)
                        (
                          resource.data.type == 'group' && isGroupAdmin(request.auth.uid, resource.data) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) && // adminIds might change if removed user was admin
                          request.resource.data.updatedAt == request.time &&
                          // Validate participant changes (only add/remove, not replace all)
                          (
                            (request.resource.data.participants.size() > resource.data.participants.size() && request.resource.data.participants.hasAll(resource.data.participants)) || // Adding members
                            (request.resource.data.participants.size() < resource.data.participants.size() && resource.data.participants.hasAll(request.resource.data.participants))    // Removing members
                          ) &&
                          // Ensure owner is not removed by a non-owner admin
                          (resource.data.ownerId == request.auth.uid || request.resource.data.participants.hasAll([resource.data.ownerId])) &&
                          // Protect immutable/other fields
                          request.resource.data.type == resource.data.type &&
                          request.resource.data.ownerId == resource.data.ownerId &&
                          request.resource.data.createdAt == resource.data.createdAt &&
                          request.resource.data.groupName == resource.data.groupName &&
                          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                          request.resource.data.postId == resource.data.postId
                        ) ||
                        // Branch D: Group Owner promoting/demoting admins (adminIds list changes)
                        (
                          resource.data.type == 'group' && isGroupOwner(request.auth.uid, resource.data) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
                          request.resource.data.updatedAt == request.time &&
                          // Validate adminIds changes (new admins must be participants, owner remains admin)
                          request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain admin
                          request.resource.data.adminIds.removeAll(request.resource.data.participants).size() == 0 && // All admins must be participants
                          // Protect immutable/other fields
                          request.resource.data.type == resource.data.type &&
                          request.resource.data.ownerId == resource.data.ownerId &&
                          request.resource.data.createdAt == resource.data.createdAt &&
                          request.resource.data.participants == resource.data.participants && // Participants list not changed by this action
                          request.resource.data.groupName == resource.data.groupName &&
                          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                          request.resource.data.postId == resource.data.postId
                        ) ||
                        // Branch E: Participant leaving a group (their own UID removed from participants and potentially adminIds)
                        (
                          resource.data.type == 'group' &&
                          isAuthUserParticipant(request.auth.uid, resource.data) && // User is currently a participant
                          !request.resource.data.participants.hasAll([request.auth.uid]) && // User is NOT in the NEW participants list
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) && // adminIds might change if leaver was admin
                          request.resource.data.updatedAt == request.time &&
                          // Protect against owner leaving if they are the sole admin and other participants remain
                          !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && resource.data.adminIds[0] == request.auth.uid && request.resource.data.participants.size() > 0 && resource.data.participants.size() > request.resource.data.participants.size()) &&
                          // Protect immutable/other fields
                          request.resource.data.type == resource.data.type &&
                          request.resource.data.ownerId == resource.data.ownerId &&
                          request.resource.data.createdAt == resource.data.createdAt &&
                          request.resource.data.groupName == resource.data.groupName &&
                          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                          request.resource.data.postId == resource.data.postId
                        )
                      );
      // No general delete rule for conversations, handled by specific logic if needed (e.g., Cloud Function for cleanup)

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        allow read: if request.auth != null &&
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.conversationId == conversationId &&
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) && // Sender must be participant of parent conversation
                         request.resource.data.timestamp == request.time;
                         // Add other field validations for message creation if needed
        allow update: if request.auth != null && resource.data.senderId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'read']); // Example: allow editing text or marking as read
        allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }

    // --- Whiteboard Annotations Collection ---
    match /whiteboardAnnotations/{docId} { // docId is typically the NAICS code or some context identifier
      allow read: if true; // Whiteboard data can be public for collaboration context

      allow write: if request.auth != null &&
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time &&
                      request.resource.data.naicsCode == docId; // Ensures the docId matches the field inside the doc
    }

    // --- Stripe Customers and Subscriptions (Handled by backend/webhooks usually) ---
    // These are examples if you were to manage Stripe data directly in Firestore via client.
    // Typically, this is locked down and managed by a trusted server environment.
    match /stripe_customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /subscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /payment_methods/{paymentMethodId} {
         allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are generally public
        allow create: if request.auth != null &&
                         request.resource.data.reviewerId == request.auth.uid && // User can only write reviews as themselves
                         request.resource.data.targetUserId != request.auth.uid && // Cannot review oneself
                         request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null &&
                         resource.data.reviewerId == request.auth.uid && // Only reviewer can update their review
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
                         request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.reviewerId == resource.data.reviewerId && // Cannot change reviewer
                         request.resource.data.targetUserId == resource.data.targetUserId && // Cannot change target
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                         request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null && resource.data.reviewerId == request.auth.uid; // Only reviewer can delete
    }

  }
}

    