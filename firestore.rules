
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for conversation rules
    function isGroupOwner(authUid, resourceData) {
      return resourceData.type == 'group' && resourceData.ownerId == authUid;
    }

    function isGroupAdmin(authUid, resourceData) {
      return resourceData.type == 'group' && resourceData.adminIds.hasAny([authUid]);
    }

    // Stripe rules
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }
    
    // Collections rules (Assuming this is a user-specific collection feature)
    match /collections/{collectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Posts and their subcollections
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid; // Only owner can update
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only owner can delete

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && resource.data.userId == request.auth.uid; // Only comment owner can update
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only comment owner can delete

        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
          allow update: if request.auth != null && resource.data.userId == request.auth.uid; // Only subcomment owner can update
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only subcomment owner can delete
        }
      }

      match /bids/{bidId} {
        allow read: if request.auth != null; // Authenticated users can read bids
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid; // Cannot bid on own post
        allow update, delete: if false; // Bids are immutable by clients
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      allow get: if request.auth != null &&
                    resource.data.participants is list && 
                    resource.data.participants.hasAny([request.auth.uid]);
      allow list: if request.auth != null && request.query.limit <= 100; 

      allow create: if request.auth != null &&
                      request.resource.data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.lastMessage == null && // Initial lastMessage is null
                      request.resource.data.lastMessageTimestamp == request.time && // Can be set to request.time or serverTimestamp initially
                      ( // Direct chat specific rules
                        request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.groupName == null &&
                        request.resource.data.groupAvatarUrl == null &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds.size() == 0 &&
                        (request.resource.data.postId == null || request.resource.data.postId is string)
                      ) ||
                      ( // Group chat specific rules
                        request.resource.data.type == 'group' &&
                        request.resource.data.participants.size() >= 2 &&
                        request.resource.data.ownerId == request.auth.uid &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator must be an admin
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                        request.resource.data.postId == null // New groups aren't tied to posts by default
                      );

      allow update: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]) && (
                      // Rule for updating last message details by any participant
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'lastMessageSenderId', 'updatedAt']) &&
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.participants == resource.data.participants && 
                        request.resource.data.type == resource.data.type && 
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Rule A: Group admin updating groupName or groupAvatarUrl
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        (request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 || request.resource.data.groupName == resource.data.groupName) &&
                        (request.resource.data.groupAvatarUrl is string || request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl) &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Rule B: Group admin adding participants
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
                        request.resource.data.participants.hasAll(resource.data.participants) && 
                        request.resource.data.participants.size() > resource.data.participants.size() && 
                        request.resource.data.participants.size() >= 2 && 
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.adminIds == resource.data.adminIds &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Rule C: Group admin removing participants (who are not the owner)
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
                        resource.data.participants.hasAll(request.resource.data.participants) && 
                        request.resource.data.participants.size() < resource.data.participants.size() && 
                        request.resource.data.participants.size() >= 1 && 
                        request.resource.data.participants.hasAll([resource.data.ownerId]) && // Owner must remain participant
                        // AdminIds correctly updated: if removed user was admin, they are removed from adminIds. Else adminIds is same.
                        (
                          (resource.data.adminIds.hasAny(resource.data.participants.removedKeys(request.resource.data.participants)) &&
                           request.resource.data.adminIds == resource.data.adminIds.removeAll(resource.data.participants.removedKeys(request.resource.data.participants))) ||
                          (!resource.data.adminIds.hasAny(resource.data.participants.removedKeys(request.resource.data.participants)) &&
                           request.resource.data.adminIds == resource.data.adminIds)
                        ) &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Rule D: Group owner promoting an admin
                      (
                        isGroupOwner(request.auth.uid, resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
                        request.resource.data.adminIds.hasAll(resource.data.adminIds) && 
                        request.resource.data.adminIds.size() > resource.data.adminIds.size() && 
                        request.resource.data.adminIds.hasAll([resource.data.ownerId]) && 
                        request.resource.data.participants.hasAll(request.resource.data.adminIds) && 
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Rule E: Group owner demoting an admin (but not themselves)
                      (
                        isGroupOwner(request.auth.uid, resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
                        resource.data.adminIds.hasAll(request.resource.data.adminIds) && 
                        request.resource.data.adminIds.size() < resource.data.adminIds.size() && 
                        request.resource.data.adminIds.hasAll([resource.data.ownerId]) && 
                        // Ensure the demoted admin is not the owner (owner cannot demote self from admin list)
                        !resource.data.adminIds.removedKeys(request.resource.data.adminIds).hasAny([resource.data.ownerId]) &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.participants == resource.data.participants &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Rule F: Participant leaving a group (simplified and focused)
                      (
                        resource.data.type == 'group' &&
                        resource.data.participants.hasAny([request.auth.uid]) && // User is currently a participant
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
                        request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]) &&
                        ( // Check adminIds update: if user was admin, they are removed; otherwise adminIds is unchanged.
                          (resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.adminIds == resource.data.adminIds.removeAll([request.auth.uid])) ||
                          (!resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.adminIds == resource.data.adminIds)
                        ) &&
                        !( // Owner Safeguard: owner cannot leave if they are the sole admin AND other participants would remain
                          resource.data.ownerId == request.auth.uid &&
                          resource.data.adminIds.size() == 1 && resource.data.adminIds[0] == request.auth.uid &&
                          request.resource.data.participants.size() > 0 // Check remaining participants after proposed removal
                        ) &&
                        request.resource.data.updatedAt == request.time
                      )
                    );

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; 
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && 
                    resource.data.userIds is list && 
                    resource.data.userIds.hasAny([request.auth.uid]);
      allow list: if request.auth != null; 
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId
                   && request.resource.data.lastUpdatedBy == request.auth.uid;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null; 
      allow create, update: if request.auth != null && request.auth.uid == userId; 
      allow delete: if request.auth != null && request.auth.uid == userId; 
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if request.auth != null; 
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid; 
      allow update, delete: if request.auth != null
                            && resource.data.reviewerId == request.auth.uid; 
    }

    // Fallback rule: Deny by default for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    