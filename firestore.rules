
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions (assuming these are defined correctly by the user elsewhere or inline)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlanOwner(planId) {
      return isAuthenticated() && get(/databases/$(database)/documents/plans/$(planId)).data.ownerId == request.auth.uid;
    }

    function canViewPlan(planId) {
      let planDoc = get(/databases/$(database)/documents/plans/$(planId)).data;
      return isAuthenticated() &&
             (planDoc.visibility == 'public' ||
              planDoc.visibility == 'unlisted' || // Unlisted plans are viewable by any authenticated user if they have the link
              (planDoc.visibility == 'private' && request.auth.uid == planDoc.ownerId) ||
              (planDoc.viewUserIds is list && request.auth.uid in planDoc.viewUserIds) // User is explicitly in viewUserIds
             );
    }

    function canEditPlan(planId) {
      let planDoc = get(/databases/$(database)/documents/plans/$(planId)).data;
      return isAuthenticated() &&
             (request.auth.uid == planDoc.ownerId ||
              (planDoc.editability == 'collaborators' && planDoc.editUserIds is list && request.auth.uid in planDoc.editUserIds) ||
              (planDoc.editability == 'everyone' && // If 'everyone' can edit, they still must be able to view
                (planDoc.visibility == 'public' || planDoc.visibility == 'unlisted' || (planDoc.viewUserIds is list && request.auth.uid in planDoc.viewUserIds))
              )
             );
    }

    function isValidPlanVisibility(vis) {
      return vis in ['private', 'unlisted', 'public'];
    }
    function isValidPlanEditability(edit) {
      return edit in ['owner_only', 'collaborators', 'everyone'];
    }

    function isValidViewAndEditUserIds(data, authUid) {
      let ownerMustBeViewer = data.visibility == 'public' || (data.viewUserIds is list && authUid in data.viewUserIds);
      let ownerMustBeEditor = (data.editability == 'owner_only' && data.editUserIds is list && data.editUserIds.size() == 1 && authUid in data.editUserIds) ||
                              (data.editability == 'collaborators' && data.editUserIds is list && authUid in data.editUserIds) ||
                              (data.editability == 'everyone' && data.visibility == 'public'); // If everyone can edit a public plan

      let editorsAreViewers = data.visibility == 'public' ||
                              (data.viewUserIds is list && data.editUserIds is list && data.editUserIds.toSet().subsetOf(data.viewUserIds.toSet()));

      return data.viewUserIds is list && data.editUserIds is list &&
             ownerMustBeViewer && ownerMustBeEditor && editorsAreViewers;
    }


    // Plans Collection
    match /plans/{planId} {
      allow read: if canViewPlan(planId);

      // SIMPLIFIED LIST RULE: Allows authenticated users to list plans with common constraints.
      // The `canViewPlan` in `allow read` will handle actual document visibility.
      allow list: if isAuthenticated() &&
                     request.query.limit <= 50 &&
                     (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt');


      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list && // roadmap must be a list (can be empty)
                       isValidPlanVisibility(request.resource.data.visibility) &&
                       isValidPlanEditability(request.resource.data.editability) &&
                       isValidViewAndEditUserIds(request.resource.data, request.auth.uid) &&
                       request.resource.data.keys().hasOnly(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']);

      allow update: if isAuthenticated() && canEditPlan(planId) && // Ensure user has edit permission for the plan
                       request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       // Main OR condition for type of update
                       (
                           ( // E1: Roadmap update path (user can edit plan, version increments)
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                               request.resource.data.version == resource.data.version + 1
                           ) ||
                           ( // E2: Settings update path (only owner can change settings, version does not change)
                               isPlanOwner(planId) && // Stricter check: only owner for these settings
                               // Using request.resource.data.keys() which are the keys in the incoming write
                               !request.resource.data.keys().hasAny(['roadmap', 'version']) && // Roadmap and version field itself must not be part of this update type
                               request.resource.data.keys().hasOnly([
                                   'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                   'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                               ]) &&
                               isValidPlanVisibility(request.resource.data.visibility) &&
                               isValidPlanEditability(request.resource.data.editability) &&
                               isValidViewAndEditUserIds(request.resource.data, request.auth.uid) &&
                               request.resource.data.version == resource.data.version // Version number value must remain same
                           )
                       );

      allow delete: if isAuthenticated() && isPlanOwner(planId);

      // Plan Versions Subcollection
      match /versions/{versionId} {
          allow read: if canViewPlan(planId); // Fine for read, planId is bound

          // CORRECTED LIST RULE for versions:
          // Allows listing if authenticated and the parent plan document path is valid.
          // `canViewPlan` in the `read` rule above will filter the results.
          allow list: if isAuthenticated() && exists(/databases/$(database)/documents/plans/$(planId));

          allow create: if isAuthenticated() && canEditPlan(planId) && // User who can edit the plan can create a version
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
          allow update, delete: if false; // Versions are immutable
      }
    }
    // Placeholder for other collections (users, notifications, etc.)
    // These would have their own specific rules.
    // It's crucial that these are defined by the user and are correct.

    match /users/{userId} {
        allow read: if isAuthenticated(); // Allow any authenticated user to read basic profiles
        allow create: if request.auth != null && request.auth.uid == userId &&
                        // Ensure required fields are present and types are correct
                        request.resource.data.uid == userId &&
                        (request.resource.data.email == request.auth.token.email || request.resource.data.email == null) &&
                        request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0 &&
                        request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower() &&
                        (request.resource.data.companyName is string || request.resource.data.companyName == null) &&
                        (request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                        (request.resource.data.industry is string || request.resource.data.industry == null) &&
                        (request.resource.data.description is string || request.resource.data.description == null) &&
                        request.resource.data.descriptionVisibility is string && request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me'] &&
                        (request.resource.data.sectorName is string || request.resource.data.sectorName == null) &&
                        (request.resource.data.subSectorName is string || request.resource.data.subSectorName == null) &&
                        (request.resource.data.industryName is string || request.resource.data.industryName == null) &&
                        (request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                        request.resource.data.tags is list &&
                        (request.resource.data.established is string || request.resource.data.established == null) &&
                        request.resource.data.verified is bool &&
                        request.resource.data.isBotAccount is bool &&
                        (request.resource.data.incomeRange is string || request.resource.data.incomeRange == null) &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.lastLoginAt == request.time &&
                        // Ensure no extra fields are being written
                        request.resource.data.keys().hasOnly([
                            'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry',
                            'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                            'tags', 'established', 'verified', 'isBotAccount', 'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt'
                        ]);

        allow update: if request.auth != null && request.auth.uid == userId &&
                        // Prevent changing immutable fields
                        request.resource.data.uid == resource.data.uid &&
                        request.resource.data.email == resource.data.email &&
                        request.resource.data.mentionName == resource.data.mentionName &&
                        request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                        request.resource.data.companyName == resource.data.companyName && // Assuming company name is set at signup and not editable this way
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.isBotAccount == resource.data.isBotAccount &&
                        // Validate types of updatable fields
                        (request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                        (request.resource.data.industry is string || request.resource.data.industry == null) &&
                        (request.resource.data.description is string || request.resource.data.description == null) &&
                        request.resource.data.descriptionVisibility is string && request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me'] &&
                        (request.resource.data.sectorName is string || request.resource.data.sectorName == null) &&
                        (request.resource.data.subSectorName is string || request.resource.data.subSectorName == null) &&
                        (request.resource.data.industryName is string || request.resource.data.industryName == null) &&
                        (request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                        request.resource.data.tags is list &&
                        (request.resource.data.established is string || request.resource.data.established == null) &&
                        request.resource.data.verified is bool &&
                        (request.resource.data.incomeRange is string || request.resource.data.incomeRange == null) &&
                        request.resource.data.updatedAt == request.time &&
                        (request.resource.data.lastLoginAt == request.time || request.resource.data.lastLoginAt == resource.data.lastLoginAt) && // Allow lastLoginAt to be updated or remain same
                        // Ensure only allowed fields are being updated
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                            'tags', 'established', 'verified', 'incomeRange', 'lastLoginAt', 'updatedAt'
                        ]);
    }

    match /mutuals/{connectionId} {
        // Helper function to check if user is part of the connection
        function isUserInConnection() {
            return request.auth.uid in resource.data.userIds;
        }
        // Helper function to check if the connection involves the authenticated user
        function requestInvolvesAuthUser() {
            return request.resource.data.userIds.hasAny([request.auth.uid]);
        }
        // Allow read if user is part of the connection
        allow read: if isAuthenticated() && isUserInConnection();
        // Allow list for queries like fetching user's connections or pending requests
        allow list: if isAuthenticated() &&
                       request.query.filters.size() > 0 && // Must have at least one filter
                       request.query.filters[0].field == 'userIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid &&
                       request.query.limit <= 100; // Limit the query size

        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.requesterId &&
                         requestInvolvesAuthUser() &&
                         request.resource.data.userIds.size() == 2 &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.requestedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         !exists(/databases/$(database)/documents/mutuals/$(connectionId)); // Ensure it doesn't already exist

        allow update: if isAuthenticated() && isUserInConnection() &&
                         // Ensure core fields are not changed
                         request.resource.data.userIds == resource.data.userIds &&
                         request.resource.data.requesterId == resource.data.requesterId &&
                         request.resource.data.requestedAt == resource.data.requestedAt &&
                         request.resource.data.updatedAt == request.time &&
                         // Allow status change from pending to connected (by recipient)
                         ( (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                            request.auth.uid != resource.data.requesterId && // Recipient accepts
                            request.resource.data.connectedAt == request.time &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']))
                         );
        allow delete: if isAuthenticated() && isUserInConnection() &&
                         (resource.data.status == 'pending' || resource.data.status == 'connected'); // Allow deleting pending requests or existing connections
    }

    match /posts/{postId} {
        allow read: if true; // Anyone can read posts
        allow list: if true; // Anyone can list posts (with client-side limits)
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.imageUrls is list &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                            'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType',
                            'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                            'maxBudget', 'deadline', 'createdAt', 'commentCount'
                         ]);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                         // Only allow updating commentCount or specific fields like miroBoardEmbedUrl if it were still present
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                         request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /comments/{commentId} {
            allow read: if true;
            allow list: if true;
            allow create: if isAuthenticated() &&
                             request.auth.uid == request.resource.data.userId &&
                             request.resource.data.postId == postId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasOnly(['userId', 'postId', 'text', 'mentionName', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']);

            allow update: if isAuthenticated() &&
                             (request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId) && // Comment owner or post owner
                             request.resource.data.postId == resource.data.postId &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt', 'isShadowBanned', 'mentionName', 'mentionedUserIds']); // Allow shadowban by post owner

            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only comment owner can delete

            match /subcomments/{subCommentId} {
                allow read: if true;
                allow list: if true;
                allow create: if isAuthenticated() &&
                                 request.auth.uid == request.resource.data.userId &&
                                 request.resource.data.timestamp == request.time &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.likeCount == 0 &&
                                 request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                                 request.resource.data.mentionedUserIds is list &&
                                 request.resource.data.isShadowBanned == false &&
                                 request.resource.data.keys().hasOnly(['userId', 'text', 'mentionName', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']);
                allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt', 'isShadowBanned', 'mentionName', 'mentionedUserIds']);
                allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
            }
        }
        match /bids/{bidId} {
            allow read: if true; // Anyone can read bids
            allow list: if true; // Anyone can list bids
            allow create: if isAuthenticated() &&
                             request.auth.uid == request.resource.data.bidderId &&
                             request.resource.data.postId == postId &&
                             request.resource.data.timestamp == request.time &&
                             // Ensure user is not bidding on their own post
                             get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid &&
                             request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
            allow update, delete: if false; // Bids are immutable
        }
    }

    match /notifications/{notificationId} {
        allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.senderId && // Sender creates it
                         request.resource.data.userId != request.resource.data.senderId && // Cannot notify self
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.isRead == false &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                            'postId', 'postQuestion', 'commentId', 'subCommentId',
                            'conversationId', 'textSnippet', 'timestamp', 'isRead'
                         ]);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && // Receiver can update
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) &&
                         request.resource.data.updatedAt == request.time;
        allow delete: if false; // Notifications are not user-deletable for now
    }

    match /userPreferences/{userId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId &&
                        request.resource.data.userId == userId &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.paymentMethods is list &&
                        // Verify all other fields are of correct type or null for optional ones
                        (request.resource.data.stripeCustomerId is string || request.resource.data.stripeCustomerId == null) &&
                        (request.resource.data.stripeSubscriptionId is string || request.resource.data.stripeSubscriptionId == null) &&
                        (request.resource.data.activeStripePriceId is string || request.resource.data.activeStripePriceId == null) &&
                        (request.resource.data.stripeSubscriptionStatus is string || request.resource.data.stripeSubscriptionStatus == null) &&
                        (request.resource.data.stripeSubscriptionCurrentPeriodEnd is number || request.resource.data.stripeSubscriptionCurrentPeriodEnd == null) &&
                        (request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd is bool || request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd == null) &&
                        request.resource.data.keys().hasOnly([
                            'userId', 'paymentMethods',
                            'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                            'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                            'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                            'createdAt', 'updatedAt'
                        ]);
        allow update: if isAuthenticated() && request.auth.uid == userId &&
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.paymentMethods is list &&
                        (request.resource.data.stripeCustomerId is string || request.resource.data.stripeCustomerId == null) &&
                        (request.resource.data.stripeSubscriptionId is string || request.resource.data.stripeSubscriptionId == null) &&
                        (request.resource.data.activeStripePriceId is string || request.resource.data.activeStripePriceId == null) &&
                        (request.resource.data.stripeSubscriptionStatus is string || request.resource.data.stripeSubscriptionStatus == null) &&
                        (request.resource.data.stripeSubscriptionCurrentPeriodEnd is number || request.resource.data.stripeSubscriptionCurrentPeriodEnd == null) &&
                        (request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd is bool || request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd == null) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'paymentMethods',
                            'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                            'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                            'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                            'updatedAt'
                        ]);
    }

    match /conversations/{conversationId} {
        // Helper to check if current user is a participant
        function isParticipant() {
          return request.auth.uid in resource.data.participants;
        }
        // Helper to check if current user is owner or admin of a group
        function isGroupAdminOrOwner() {
            return resource.data.type == 'group' &&
                   (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.adminIds);
        }

        allow read: if isAuthenticated() && isParticipant();
        allow list: if isAuthenticated() &&
                       request.query.filters.size() == 1 &&
                       request.query.filters[0].field == 'participants' &&
                       request.query.filters[0].operator == 'array-contains' &&
                       request.query.filters[0].value == request.auth.uid &&
                       request.query.limit <= 50 &&
                       (request.query.orderBy == null || request.query.orderBy.path == 'lastMessageTimestamp');

        allow create: if isAuthenticated() &&
                        request.resource.data.participants.hasAny([request.auth.uid]) && // Creator must be a participant
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        // Direct Chat specific rules
                        ((request.resource.data.type == 'direct' &&
                          request.resource.data.participants.size() == 2 &&
                          request.resource.data.groupName == null &&
                          request.resource.data.groupAvatarUrl == null &&
                          request.resource.data.ownerId == null &&
                          request.resource.data.adminIds.size() == 0
                         ) ||
                        // Group Chat specific rules
                         (request.resource.data.type == 'group' &&
                          request.resource.data.participants.size() >= 2 &&
                          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                          (request.resource.data.groupAvatarUrl is string || request.resource.data.groupAvatarUrl == null) &&
                          request.resource.data.ownerId == request.auth.uid &&
                          request.resource.data.adminIds.hasAll([request.auth.uid]) // Creator is admin
                         )) &&
                         request.resource.data.keys().hasOnly([
                           'participants', 'type', 'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds',
                           'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt'
                         ]);

        allow update: if isAuthenticated() && isParticipant() &&
                         request.resource.data.updatedAt == request.time &&
                         // Fields common to both direct and group that can be updated by any participant
                         ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                         // Fields specific to group updates, only by admin/owner
                          (isGroupAdminOrOwner() &&
                           request.resource.data.type == 'group' &&
                           request.resource.data.createdAt == resource.data.createdAt && // Cannot change type or creation time
                           request.resource.data.postId == resource.data.postId && // Cannot change related post
                           request.resource.data.ownerId == resource.data.ownerId && // Standard admin cannot change owner directly
                           // Allow updates to participants (add/remove), groupName, groupAvatarUrl, adminIds
                           request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'groupName', 'groupAvatarUrl', 'adminIds', 'updatedAt', 'lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp'])) ||
                           // Owner transferring ownership
                           (resource.data.type == 'group' && request.auth.uid == resource.data.ownerId && // Current user is owner
                            request.resource.data.ownerId != resource.data.ownerId && // Owner ID is changing
                            request.resource.data.ownerId in resource.data.participants && // New owner is a participant
                            request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) && // New owner becomes an admin
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt'])
                           ) ||
                           // Leaving a group (updating formerParticipants)
                           (
                               !request.resource.data.participants.hasAny([request.auth.uid]) && // User is no longer in participants
                               resource.data.participants.hasAny([request.auth.uid]) && // User was in participants
                               request.resource.data.formerParticipants[request.auth.uid] == request.time && // Setting leave time for user
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'formerParticipants', 'updatedAt', 'adminIds']) &&
                               // If owner leaves and is last admin, special handling might be needed (e.g. promote someone or delete group - complex for rules)
                               // For simplicity, let's assume client logic handles admin promotion if owner leaves.
                               // Admin list should also remove the leaving user if they were an admin
                               (request.resource.data.adminIds.hasAll(resource.data.adminIds.removeAll([request.auth.uid])) || request.resource.data.adminIds.size() == resource.data.adminIds.removeAll([request.auth.uid]).size())
                           )
                         );


        match /messages/{messageId} {
            allow read, list: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
            allow create: if isAuthenticated() &&
                             request.auth.uid == request.resource.data.senderId &&
                             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                             request.resource.data.conversationId == conversationId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.read == false &&
                             (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true) &&
                             request.resource.data.keys().hasOnly(['senderId', 'conversationId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet']);
            allow update, delete: if false; // Messages are immutable
        }
    }
    // News Articles Collection (new)
    match /newsArticles/{articleId} {
        // Helper: Is user the author of this article?
        function isNewsArticleAuthor() {
          return isAuthenticated() && resource.data.userId == request.auth.uid;
        }
        // Helper: Can the current authenticated user view this article?
        function canViewNewsArticle() {
          return (resource.data.status == 'published') || // Published articles are public
                 (resource.data.status == 'draft' && isNewsArticleAuthor()); // Drafts only by author
        }

        allow read: if canViewNewsArticle();
        allow list: if isAuthenticated() && // Anyone authenticated can list (results filtered by read)
                       request.query.limit <= 100 &&
                       (request.query.orderBy == null || request.query.orderBy.path == 'publishedAt' || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt');


        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null) &&
                        request.resource.data.likeCount == 0 &&
                        request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                        request.resource.data.commentCount == 0 &&
                        request.resource.data.status in ['draft', 'published'] &&
                        // Check all expected fields for news articles from your 'NewsArticle' type
                        request.resource.data.keys().hasOnly([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount',
                           // Fields from Post type that might be relevant if NewsArticle extends/mirrors it
                           'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls',
                           'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                           'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                        ]);

        allow update: if isAuthenticated() && isNewsArticleAuthor() && // Only author can update
                        request.resource.data.userId == resource.data.userId && // Cannot change author
                        request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                        request.resource.data.updatedAt == request.time && // Must set update time
                        request.resource.data.status in ['draft', 'published'] &&
                        // Allow updating specific fields
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'publishedAt', 'updatedAt', 'likeCount', 'likedBy', // likeCount/likedBy for author actions if any (or remove if only users can like)
                           // Other potentially updatable fields if NewsArticle has them:
                           'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls',
                           'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                           'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                        ]);
        allow delete: if isAuthenticated() && isNewsArticleAuthor(); // Only author can delete

        // Subcollection for News Comments
        match /newsComments/{commentId} {
            function isCommentOwner() {
              return isAuthenticated() && resource.data.userId == request.auth.uid;
            }
            // Article author can also manage comments (e.g., shadow ban)
            function isArticleAuthorForComment() {
                return isAuthenticated() && get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId == request.auth.uid;
            }

            allow read: if resource.data.isShadowBanned == false || isArticleAuthorForComment() || isCommentOwner();
            allow list: if true; // Public list, read rule filters based on shadowBan

            allow create: if isAuthenticated() &&
                             request.auth.uid == request.resource.data.userId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false && // New comments are not shadow banned by default
                             request.resource.data.keys().hasOnly(['userId', 'text', 'mentionName', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']);

            allow update: if isAuthenticated() &&
                             request.resource.data.userId == resource.data.userId && // Cannot change author
                             request.resource.data.timestamp == resource.data.timestamp && // Cannot change creation time
                             request.resource.data.updatedAt == request.time &&
                             ( // Option 1: User updating their own like/text
                               (request.auth.uid == resource.data.userId &&
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt', 'mentionName', 'mentionedUserIds'])) ||
                               // Option 2: Article author shadow banning
                               (isArticleAuthorForComment() &&
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']))
                             );

            allow delete: if isAuthenticated() && isCommentOwner(); // Only comment owner can delete

            // Subcollection for News SubComments (Replies to News Comments)
            match /newsSubcomments/{subCommentId} {
                function isSubCommentOwner() {
                  return isAuthenticated() && resource.data.userId == request.auth.uid;
                }

                allow read: if resource.data.isShadowBanned == false || isArticleAuthorForComment() || isSubCommentOwner();
                allow list: if true; // Public list, read rule filters

                allow create: if isAuthenticated() &&
                                 request.auth.uid == request.resource.data.userId &&
                                 request.resource.data.timestamp == request.time &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.likeCount == 0 &&
                                 request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                                 request.resource.data.mentionedUserIds is list &&
                                 request.resource.data.isShadowBanned == false &&
                                 request.resource.data.keys().hasOnly(['userId', 'text', 'mentionName', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']);

                allow update: if isAuthenticated() &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.updatedAt == request.time &&
                                 ( // Option 1: User updating their own like/text
                                   (request.auth.uid == resource.data.userId &&
                                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt', 'mentionName', 'mentionedUserIds'])) ||
                                   // Option 2: Article author shadow banning
                                   (isArticleAuthorForComment() &&
                                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']))
                                 );
                allow delete: if isAuthenticated() && isSubCommentOwner();
            }
        }
    }

    match /articleTags/{tagId} {
        allow read: if true; // Tags are public
        allow list: if true; // Allow listing/searching tags
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.createdBy &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.usageCount >= 0 && // Can be 0 or more
                         request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
        allow update: if isAuthenticated() && // Allow authenticated users to increment/decrement usageCount
                         request.resource.data.name == resource.data.name &&
                         request.resource.data.nameLowercase == resource.data.nameLowercase &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
        allow delete: if false; // Tags are not user-deletable for now
    }

    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        allow list: if isAuthenticated(); // Allow fetching reviews (e.g., for a profile or by a user)

        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.reviewerId && // User can only create review as themselves
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.rating is number && request.resource.data.rating >=1 && request.resource.data.rating <=5 &&
                         request.resource.data.comment is string &&
                         // reviewerHistoricalAvgRating can be number or null
                         (request.resource.data.reviewerHistoricalAvgRating is number || request.resource.data.reviewerHistoricalAvgRating == null) &&
                         request.resource.data.keys().hasOnly([
                            'targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar',
                            'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt'
                         ]);
        allow update: if isAuthenticated() &&
                         request.auth.uid == resource.data.reviewerId && // Only the reviewer can update their review
                         request.resource.data.targetUserId == resource.data.targetUserId &&
                         request.resource.data.reviewerId == resource.data.reviewerId &&
                         request.resource.data.reviewerName == resource.data.reviewerName &&
                         request.resource.data.reviewerAvatar == resource.data.reviewerAvatar &&
                         request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && // Cannot change this on update
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.rating is number && request.resource.data.rating >=1 && request.resource.data.rating <=5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

    match /collections/{collectionId} {
        // Helper: Is the user the owner of this collection?
        function isCollectionOwner() {
          return isAuthenticated() && resource.data.ownerId == request.auth.uid;
        }
        // Helper: Is the user shared on this collection?
        function isSharedWithUser() {
          return isAuthenticated() && resource.data.sharedWithUserIds.hasAny([request.auth.uid]);
        }

        allow read: if isCollectionOwner() || isSharedWithUser();
        allow list: if isAuthenticated() &&
                       request.query.filters.size() > 0 && // Must have at least one filter
                       (
                         (request.query.filters[0].field == 'ownerId' && request.query.filters[0].operator == '==' && request.query.filters[0].value == request.auth.uid) ||
                         (request.query.filters[0].field == 'sharedWithUserIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid)
                       ) &&
                       request.query.limit <= 100 && // Reasonable limit
                       (request.query.orderBy == null || request.query.orderBy.path == 'createdAt'); // Common ordering

        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.description is string &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list &&
                         request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']);

        allow update: if isAuthenticated() && isCollectionOwner() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.name is string && (request.resource.data.name.size() == 0 || request.resource.data.name.size() > 0) && // Allow empty or non-empty name if present
                         request.resource.data.description is string &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);

        allow delete: if isAuthenticated() && isCollectionOwner();
    }


  }
}

    