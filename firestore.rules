
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isAuthUser() {
      return request.auth != null;
    }

    // USER PROFILES (/users/{userId})
    match /users/{userId} {
      allow read: if isAuthUser();
      allow create: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       (!('companyName' in request.resource.data) || request.resource.data.companyName is string || request.resource.data.companyName == null) &&
                       request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0 &&
                       request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower() &&
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                       (!('description' in request.resource.data) || request.resource.data.description is string || request.resource.data.description == null) &&
                       (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName is string || request.resource.data.sectorName == null) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName is string || request.resource.data.subSectorName == null) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName is string || request.resource.data.industryName == null) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established is string || request.resource.data.established == null) &&
                       (!('verified' in request.resource.data) || request.resource.data.verified is bool) &&
                       (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount is bool) &&
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange is string || request.resource.data.incomeRange == null) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time;

      allow update: if isAuthUser() && request.auth.uid == userId &&
                       // Fields that CAN be updated by the user
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'lastLoginAt', 'updatedAt', 'incomeRange'
                       ]) &&
                       // Validate types of updatable fields
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry is string || request.resource.data.industry == null) &&
                       (!('description' in request.resource.data) || request.resource.data.description is string || request.resource.data.description == null) &&
                       (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName is string || request.resource.data.sectorName == null) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName is string || request.resource.data.subSectorName == null) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName is string || request.resource.data.industryName == null) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode is string || request.resource.data.naicsCode == null) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established is string || request.resource.data.established == null) &&
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange is string || request.resource.data.incomeRange == null) &&
                       // Fields that should NOT be updated by the user directly
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.companyName == resource.data.companyName &&
                       request.resource.data.mentionName == resource.data.mentionName &&
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.verified == resource.data.verified &&
                       request.resource.data.isBotAccount == resource.data.isBotAccount &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time;
      allow delete: if false; // Generally, users don't delete their own profiles directly
    }

    // POSTS (/posts/{postId})
    match /posts/{postId} {
      allow read: if isAuthUser();
      allow create: if isAuthUser() && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() > 0 &&
                       (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                       // Ensure only allowed fields are present during creation
                       request.resource.data.keys().hasOnly([
                         'userId', 'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                         'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                         'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType',
                         'maxBudget', 'deadline', 'createdAt', 'commentCount'
                       ]);

      allow update: if isAuthUser() &&
                       // Branch 1: Owner updating their post (excluding commentCount & ratingScore)
                       ( isPostOwner(request.auth.uid, resource.data) &&
                         request.resource.data.userId == resource.data.userId && // Cannot change owner
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation date
                         request.resource.data.commentCount == resource.data.commentCount && // Owner cannot directly change commentCount
                         request.resource.data.ratingScore == resource.data.ratingScore && // Owner cannot directly change ratingScore
                         request.resource.data.keys().hasOnly(resource.data.keys()) && // No new fields added by owner
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                            'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                            'imageUrls', 'mentionedUserIds', 'requestType',
                            'maxBudget', 'deadline', 'updatedAt' // Allow updatedAt for general updates
                         ]) &&
                         request.resource.data.updatedAt == request.time // If owner updates, it's request.time
                       ) ||
                       // Branch 2: System (or any auth user) updating commentCount or ratingScore (e.g., via transaction)
                       // This branch allows only commentCount or ratingScore to be updated, plus updatedAt.
                       ( request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount', 'ratingScore']) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'ratingScore', 'updatedAt']) &&
                         request.resource.data.userId == resource.data.userId && // Protect other fields
                         request.resource.data.question == resource.data.question &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time // Timestamp for this specific update
                       );

      allow delete: if isAuthUser() && isPostOwner(request.auth.uid, resource.data);

      function isPostOwner(authUid, postData) {
        return authUid == postData.userId;
      }

      // COMMENTS (/posts/{postId}/comments/{commentId})
      match /comments/{commentId} {
        allow read: if isAuthUser();
        allow create: if isAuthUser() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.postId == postId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list);
        allow update: if isAuthUser() && isCommentLikeToggleValid(request.auth.uid, resource.data, request.resource.data);
        allow delete: if isAuthUser() && isCommentOwner(request.auth.uid, resource.data);

        function isCommentOwner(authUid, commentData) {
          return authUid == commentData.userId;
        }

        function isCommentLikeToggleValid(authUid, oldData, newData) {
          return oldData.userId == newData.userId &&
                 oldData.postId == newData.postId &&
                 oldData.text == newData.text &&
                 oldData.timestamp == newData.timestamp &&
                 newData.updatedAt == request.time &&
                 // Only likeCount and likedBy can change
                 newData.diff(oldData).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                 // Validate likeCount increment/decrement
                 ( (newData.likeCount == oldData.likeCount + 1 && newData.likedBy.hasAll(oldData.likedBy) && newData.likedBy.hasOnly(oldData.likedBy.concat([authUid]))) ||
                   (newData.likeCount == oldData.likeCount - 1 && oldData.likedBy.hasAll(newData.likedBy) && oldData.likedBy.hasOnly(newData.likedBy.removeAll([authUid])))
                 );
        }

        // SUBCOMMENTS (/posts/{postId}/comments/{commentId}/subcomments/{subCommentId})
        match /subcomments/{subCommentId} {
          allow read: if isAuthUser();
          allow create: if isAuthUser() && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list);
          allow update: if isAuthUser() && isSubCommentLikeToggleValid(request.auth.uid, resource.data, request.resource.data);
          allow delete: if isAuthUser() && isSubCommentOwner(request.auth.uid, resource.data);

          function isSubCommentOwner(authUid, subCommentData) {
            return authUid == subCommentData.userId;
          }

          function isSubCommentLikeToggleValid(authUid, oldData, newData) {
            return oldData.userId == newData.userId &&
                   oldData.text == newData.text &&
                   oldData.timestamp == newData.timestamp &&
                   newData.updatedAt == request.time &&
                   newData.diff(oldData).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                   ( (newData.likeCount == oldData.likeCount + 1 && newData.likedBy.hasAll(oldData.likedBy) && newData.likedBy.hasOnly(oldData.likedBy.concat([authUid]))) ||
                     (newData.likeCount == oldData.likeCount - 1 && oldData.likedBy.hasAll(newData.likedBy) && oldData.likedBy.hasOnly(newData.likedBy.removeAll([authUid])))
                   );
          }
        }
      }

      // BIDS (/posts/{postId}/bids/{bidId})
      match /bids/{bidId} {
        allow read: if isAuthUser() && (isPostOwner(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data) || isBidder(request.auth.uid, resource.data));
        allow create: if isAuthUser() &&
                         request.auth.uid == request.resource.data.bidderId &&
                         request.resource.data.postId == postId &&
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                         (!('bidMessage' in request.resource.data) || request.resource.data.bidMessage is string) &&
                         request.resource.data.timestamp == request.time &&
                         request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Cannot bid on own post
        allow update, delete: if false; // Bids are immutable or only soft-deleted through app logic if needed

        function isBidder(authUid, bidData) {
          return authUid == bidData.bidderId;
        }
      }
    }

    // NOTIFICATIONS (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if isAuthUser() && request.auth.uid == resource.data.userId;
      allow create: if isAuthUser() &&
                       request.resource.data.userId != request.auth.uid && // Cannot create notification for oneself
                       request.resource.data.senderId == request.auth.uid && // Sender must be the authenticated user
                       request.resource.data.type is string &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false;
      allow update: if isAuthUser() && request.auth.uid == resource.data.userId &&
                       // Only 'isRead' can be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
                       request.resource.data.isRead == true; // Can only mark as read
      allow delete: if isAuthUser() && request.auth.uid == resource.data.userId; // User can delete their own notifications
    }

    // USER PREFERENCES (/userPreferences/{userId})
    match /userPreferences/{userId} {
      allow read, write: if isAuthUser() && request.auth.uid == userId;
      // More granular write rules can be added if needed (e.g. for server-side only updates)
    }

    // WHITEBOARD ANNOTATIONS (/whiteboardAnnotations/{docId}) - NaicsCode or general ID
    match /whiteboardAnnotations/{docId} {
      allow read: if isAuthUser();
      allow write: if isAuthUser() &&
                       request.resource.data.naicsCode == docId &&
                       request.resource.data.lastUpdatedBy == request.auth.uid &&
                       request.resource.data.lastUpdatedAt == request.time;
    }


    // CONVERSATIONS (/conversations/{conversationId})
    match /conversations/{conversationId} {

      function isAuthUserParticipant(authUid, convData) {
        return authUid != null &&
               convData != null &&
               convData.participants != null &&
               convData.participants is list &&
               convData.participants.hasAny([authUid]);
      }

      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }

      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }

      function isActiveParticipant(authUid, convData) {
        return isAuthUserParticipant(authUid, convData) &&
               (convData.formerParticipants == null || !(authUid in convData.formerParticipants));
      }

      // Rules for creating direct and group conversations
      function isGroupCreate_Direct() {
        return request.resource.data.type == 'direct' &&
               request.resource.data.participants.size() == 2 &&
               request.resource.data.participants.hasAll([request.auth.uid]) && // Creator must be one of the two participants
               request.resource.data.ownerId == null &&
               request.resource.data.adminIds.size() == 0 &&
               request.resource.data.groupName == null &&
               request.resource.data.groupAvatarUrl == null &&
               // postId can be null (general chat) or a string (chat related to a post)
               (request.resource.data.postId == null || request.resource.data.postId is string) &&
               request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time &&
               request.resource.data.lastMessageTimestamp == request.time &&
               request.resource.data.formerParticipants == {} &&
               request.resource.data.keys().hasOnly([
                 'participants', 'type', 'postId',
                 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt',
                 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'formerParticipants'
               ]);
      }

      function isGroupCreate_Group() {
        return request.resource.data.type == 'group' &&
               request.resource.data.ownerId == request.auth.uid &&
               request.resource.data.adminIds.hasAll([request.auth.uid]) &&
               request.resource.data.adminIds.size() == 1 &&
               request.resource.data.participants.hasAll([request.auth.uid]) &&
               request.resource.data.participants.size() >= 2 &&
               request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
               (!('groupAvatarUrl' in request.resource.data) || request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
               request.resource.data.postId == null &&
               request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time &&
               request.resource.data.lastMessageTimestamp == request.time &&
               request.resource.data.formerParticipants == {} &&
               request.resource.data.keys().hasOnly([
                 'participants', 'type', 'groupName', 'groupAvatarUrl',
                 'ownerId', 'adminIds', 'postId',
                 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'formerParticipants'
               ]);
      }

      allow create: if isAuthUser() && (isGroupCreate_Direct() || isGroupCreate_Group());

      allow get, list: if isAuthUser() && isActiveParticipant(request.auth.uid, resource.data);

      // Helper functions for update validation
      function areCoreFieldsUnchanged(requestData, resourceData) {
        return requestData.type == resourceData.type &&
               requestData.postId == resourceData.postId &&
               requestData.createdAt == resourceData.createdAt &&
               requestData.ownerId == resourceData.ownerId; // ownerId is immutable for groups
      }

      // Branch A: Sending a message (for any active participant, direct or group)
      function isMessageUpdateValid() {
        return isActiveParticipant(request.auth.uid, resource.data) &&
               request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
               request.writeFields.size() == 4 &&
               request.resource.data.lastMessageSenderId == request.auth.uid &&
               request.resource.data.updatedAt == request.time &&
               request.resource.data.lastMessageTimestamp == request.time &&
               areCoreFieldsUnchanged(request.resource.data, resource.data) &&
               request.resource.data.participants == resource.data.participants && // Participants don't change when sending a message
               request.resource.data.adminIds == resource.data.adminIds && // Admins don't change
               request.resource.data.groupName == resource.data.groupName && // Group name doesn't change
               request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl && // Group avatar doesn't change
               request.resource.data.formerParticipants == resource.data.formerParticipants; // Former participants don't change
      }

      // Branch B: Editing group info (name, avatar) - Admin only
      function isGroupInfoUpdateValid() {
        return resource.data.type == 'group' &&
               isActiveParticipant(request.auth.uid, resource.data) && isGroupAdmin(request.auth.uid, resource.data) &&
               request.writeFields.hasAny(['groupName', 'groupAvatarUrl']) && // Must change at least one
               request.writeFields.hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
               (!('groupName' in request.writeFields) || (request.resource.data.groupName is string && request.resource.data.groupName.size() > 0)) &&
               (!('groupAvatarUrl' in request.writeFields) || request.resource.data.groupAvatarUrl is string || request.resource.data.groupAvatarUrl == null) &&
               request.resource.data.updatedAt == request.time &&
               areCoreFieldsUnchanged(request.resource.data, resource.data) &&
               request.resource.data.participants == resource.data.participants &&
               request.resource.data.adminIds == resource.data.adminIds &&
               request.resource.data.formerParticipants == resource.data.formerParticipants;
      }

      // Branch C: Adding members to a group - Admin only
      function isGroupAddMembersValid() {
        return resource.data.type == 'group' &&
               isActiveParticipant(request.auth.uid, resource.data) && isGroupAdmin(request.auth.uid, resource.data) &&
               request.writeFields.hasOnly(['participants', 'updatedAt']) &&
               request.resource.data.participants.size() > resource.data.participants.size() && // Must add members
               request.resource.data.participants.hasAll(resource.data.participants) && // Old members must still be present
               request.resource.data.updatedAt == request.time &&
               areCoreFieldsUnchanged(request.resource.data, resource.data) &&
               request.resource.data.adminIds == resource.data.adminIds && // Admins list not changed here
               request.resource.data.groupName == resource.data.groupName &&
               request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
               request.resource.data.formerParticipants == resource.data.formerParticipants;
      }

      // Branch D: Removing members from a group - Admin only
      function isGroupRemoveMembersValid() {
        return resource.data.type == 'group' &&
               isActiveParticipant(request.auth.uid, resource.data) && isGroupAdmin(request.auth.uid, resource.data) &&
               request.writeFields.hasOnly(['participants', 'adminIds', 'updatedAt']) && // Can also affect adminIds if removed user was admin
               request.resource.data.participants.size() < resource.data.participants.size() && // Must remove members
               resource.data.participants.hasAll(request.resource.data.participants) && // Remaining members were present before
               // Cannot remove owner via this mechanism
               (resource.data.ownerId in request.resource.data.participants) &&
               // If admin is removed, they must be removed from adminIds too
               request.resource.data.adminIds.hasOnly(resource.data.adminIds.removeAll(resource.data.participants.removedKeys(request.resource.data.participants))) &&
               request.resource.data.updatedAt == request.time &&
               areCoreFieldsUnchanged(request.resource.data, resource.data) &&
               request.resource.data.groupName == resource.data.groupName &&
               request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
               request.resource.data.formerParticipants == resource.data.formerParticipants;
      }

      // Branch E: Promoting/Demoting admins - Owner only
      function isGroupManageAdminsValid() {
        return resource.data.type == 'group' &&
               isActiveParticipant(request.auth.uid, resource.data) && isGroupOwner(request.auth.uid, resource.data) &&
               request.writeFields.hasOnly(['adminIds', 'updatedAt']) &&
               request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain admin
               request.resource.data.updatedAt == request.time &&
               areCoreFieldsUnchanged(request.resource.data, resource.data) &&
               request.resource.data.participants == resource.data.participants &&
               request.resource.data.groupName == resource.data.groupName &&
               request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
               request.resource.data.formerParticipants == resource.data.formerParticipants;
      }

      // Branch F: Participant leaving group (soft leave)
      function isGroupLeaveValid() {
        let leavingUid = request.auth.uid;
        return resource.data.type == 'group' &&
               resource.data.participants.hasAny([leavingUid]) && // User must be a current participant to leave
               // Only these fields can change for a leave operation
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'formerParticipants', 'updatedAt']) &&
               // User is removed from participants
               !request.resource.data.participants.hasAny([leavingUid]) &&
               resource.data.participants.hasAll(request.resource.data.participants) && // No other participants added/removed
               // If leaving user was an admin, they must be removed from adminIds
               ( !resource.data.adminIds.hasAny([leavingUid]) || !request.resource.data.adminIds.hasAny([leavingUid]) ) &&
               // Ensure other admins are not changed if leaver wasn't owner
               ( resource.data.ownerId == leavingUid || request.resource.data.adminIds.hasOnly(resource.data.adminIds.removeAll([leavingUid])) ) &&
               // Owner safeguard: If owner leaves and is the ONLY admin, group must have only owner left (effectively deleting it by leaving),
               // OR if other admins exist, owner can leave. If owner is sole admin AND others remain, owner cannot leave via this.
               ( resource.data.ownerId != leavingUid || // Not the owner leaving
                 (resource.data.adminIds.size() > 1 || resource.data.participants.size() == 1 ) || // Owner not sole admin, or owner is the only one left
                 (resource.data.adminIds.size() == 1 && request.resource.data.participants.size() == 0) // Owner is sole admin, and no one left after they leave
               ) &&
               // Record the leave time in formerParticipants
               request.resource.data.formerParticipants[leavingUid] == request.time &&
               request.resource.data.updatedAt == request.time &&
               // Core fields must not change
               areCoreFieldsUnchanged(request.resource.data, resource.data) &&
               request.resource.data.groupName == resource.data.groupName &&
               request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
               // Ensure only the leaving user's entry is added/updated in formerParticipants
               request.resource.data.formerParticipants.affectedKeys().hasOnly([leavingUid]) &&
               resource.data.formerParticipants.keys().hasOnly(request.resource.data.formerParticipants.keys().removeAll([leavingUid]));
      }

      allow update: if isAuthUser() && (
        isMessageUpdateValid() ||
        isGroupInfoUpdateValid() ||
        isGroupAddMembersValid() ||
        isGroupRemoveMembersValid() ||
        isGroupManageAdminsValid() ||
        isGroupLeaveValid()
      );
      allow delete: if false; // Conversations are not directly deleted by clients

      // MESSAGES (/conversations/{conversationId}/messages/{messageId})
      match /messages/{messageId} {
        function canViewMessage() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          // User must have been a participant at some point
          if (conv == null || conv.participants == null || !(conv.participants is list) || !conv.participants.hasAny([request.auth.uid])) {
            return false;
          }
          // If user is NOT in formerParticipants (or formerParticipants is null/empty), they are active.
          if (conv.formerParticipants == null || !(request.auth.uid in conv.formerParticipants)) {
            return true;
          }
          // If user IS in formerParticipants, check message timestamp against their leave timestamp
          return request.auth.uid in conv.formerParticipants &&
                 resource.data.timestamp <= conv.formerParticipants[request.auth.uid];
        }

        allow read: if isAuthUser() && canViewMessage();

        function isMessageSender() {
          return request.auth.uid == request.resource.data.senderId;
        }
        function isMessageCreateValid() {
            return request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                   request.resource.data.timestamp == request.time &&
                   request.resource.data.isBotMessage == (request.resource.data.senderId == "BOT_RESERVED_UID_IF_ANY" ? true : false) && // Example for bot
                   (!('replyToMessageId' in request.resource.data) || request.resource.data.replyToMessageId is string || request.resource.data.replyToMessageId == null) &&
                   (!('repliedToTextSnippet' in request.resource.data) || request.resource.data.repliedToTextSnippet is string || request.resource.data.repliedToTextSnippet == null) &&
                   request.resource.data.read == false &&
                   request.resource.data.conversationId == conversationId &&
                   // Ensure only allowed fields are part of the message creation
                   request.resource.data.keys().hasOnly([
                     'senderId', 'text', 'timestamp', 'isBotMessage',
                     'replyToMessageId', 'repliedToTextSnippet', 'read', 'conversationId'
                   ]);
        }

        allow create: if isAuthUser() &&
                         isActiveParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         isMessageSender() && isMessageCreateValid();
        allow update, delete: if false; // Messages are immutable or only soft-deleted
      }
    }

    // MUTUALS (/mutuals/{connectionId}) - For connection requests and status
    match /mutuals/{connectionId} {
      function isUserInMutualConnection(authUid, mutualData) {
        return authUid != null &&
               mutualData != null &&
               mutualData.userIds != null &&
               mutualData.userIds is list && // Corrected syntax
               mutualData.userIds.hasAny([authUid]);
      }

      allow get: if isAuthUser() && isUserInMutualConnection(request.auth.uid, resource.data);
      allow list: if isAuthUser(); // Listing needs to be open, 'get' will filter per-document

      // Create: Sending a connection request
      allow create: if isAuthUser() &&
                       request.auth.uid == request.resource.data.requesterId &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      // Update: Accepting a connection request
      allow update: if isAuthUser() &&
                       // User accepting must be one of the participants and NOT the original requester
                       isUserInMutualConnection(request.auth.uid, resource.data) &&
                       request.auth.uid != resource.data.requesterId &&
                       // Transitioning from 'pending' to 'connected'
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'connected' &&
                       // Only status, connectedAt, and updatedAt can change
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']) &&
                       request.resource.data.connectedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Other fields must remain unchanged
                       request.resource.data.userIds == resource.data.userIds &&
                       request.resource.data.requesterId == resource.data.requesterId &&
                       request.resource.data.requestedAt == resource.data.requestedAt;

      // Delete: Rejecting/cancelling a PENDING request, or removing an ESTABLISHED connection
      allow delete: if isAuthUser() && isUserInMutualConnection(request.auth.uid, resource.data) &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

     // REVIEWS (/reviews/{reviewId})
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow create: if isAuthUser() &&
                       request.auth.uid == request.resource.data.reviewerId && // Reviewer must be the authenticated user
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review oneself
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // reviewerHistoricalAvgRating is set by service, client sends null or it's not present
                       (!('reviewerHistoricalAvgRating' in request.resource.data) || request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number);

      allow update: if isAuthUser() &&
                       request.auth.uid == resource.data.reviewerId && // Only the reviewer can update their review
                       request.resource.data.targetUserId == resource.data.targetUserId && // Cannot change who is being reviewed
                       request.resource.data.reviewerId == resource.data.reviewerId && // Cannot change the reviewer
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation date
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && // Cannot change historical avg
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

      allow delete: if isAuthUser() && request.auth.uid == resource.data.reviewerId; // Only the reviewer can delete their review
    }
  }
}

    