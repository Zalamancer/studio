
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthUser() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAuthenticatedUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isResourceOwner(docResource) {
      return request.auth != null && docResource.data.userId == request.auth.uid;
    }

    // Stripe rules (from user)
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Posts, their comments, and bids
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.createdAt == request.time;

      allow update: if isAuthUser() && (
        // Branch 1: Owner can update their post
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) &&
          request.resource.data.updatedAt == request.time
        ) ||
        // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
          request.resource.data.updatedAt == request.time
        )
      );
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthUser();
        allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid
                      && request.resource.data.timestamp == request.time;
        allow update: if isAuthUser() && (
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId && 
            request.resource.data.timestamp == resource.data.timestamp && 
            request.resource.data.updatedAt == request.time
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.timestamp == resource.data.timestamp &&
            (
              (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) ||
              (resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)
            ) &&
            (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
            request.resource.data.updatedAt == request.time
          )
        );
        allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

        match /subcomments/{subCommentId} {
          allow read: if isAuthUser();
          allow create: if isAuthUser() && request.resource.data.userId == request.auth.uid
                        && request.resource.data.timestamp == request.time;
          allow update: if isAuthUser() && ( 
            ( 
              resource.data.userId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.updatedAt == request.time
            ) ||
            ( 
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.text == resource.data.text &&
              request.resource.data.timestamp == resource.data.timestamp &&
              ((request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) || (resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)) &&
              (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
              request.resource.data.updatedAt == request.time
            )
          );
          allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;
        }
      }

      match /bids/{bidId} {
        allow read: if isAuthUser();
        allow create: if isAuthUser()
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if false; 
      }
    }

    match /conversations/{conversationId} {
      function isAuthUserParticipant() {
        return resource.data.participants.hasAny([request.auth.uid]);
      }
      function wasAuthUserParticipant() {
        return resource.data.formerParticipants != null &&
               resource.data.formerParticipants[request.auth.uid] != null;
      }
      function isGroupOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
      }

      allow get: if isAuthUser() && (isAuthUserParticipant() || wasAuthUserParticipant());
      allow list: if isAuthUser() && request.query.limit <= 100;

      allow create: if isAuthUser() && (
        (
          request.resource.data.type == 'direct' &&
          request.resource.data.participants.size() == 2 &&
          request.resource.data.participants.hasAny([request.auth.uid]) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time
        ) ||
        (
          request.resource.data.type == 'group' &&
          request.resource.data.participants.hasAny([request.auth.uid]) && 
          request.resource.data.participants.size() >= 2 && 
          request.resource.data.ownerId == request.auth.uid && 
          request.resource.data.adminIds.hasAny([request.auth.uid]) && 
          request.resource.data.groupName is string &&
          request.resource.data.groupName.size() > 0 && 
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time
        )
      );

      allow update: if isAuthUser() && isAuthUserParticipant() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
          (request.resource.data.containsKey('groupName') ? request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 : true) &&
          (request.resource.data.containsKey('groupAvatarUrl') ? (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) : true) &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() > resource.data.participants.size() &&
          request.resource.data.participants.hasAll(resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          request.resource.data.participants is list &&
          resource.data.participants.size() > request.resource.data.participants.size() &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants is list &&
          resource.data.participants.size() > request.resource.data.participants.size() &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
          !request.resource.data.participants.hasAny([request.auth.uid]) &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt']) &&
          request.resource.data.ownerId != request.auth.uid &&
          resource.data.participants.hasAny([request.resource.data.ownerId]) &&
          request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) &&
          request.resource.data.adminIds.hasAll([request.auth.uid]) &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.hasAll(resource.data.adminIds) && 
          request.resource.data.updatedAt == request.time
        ) ||
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.hasAll([request.auth.uid]) && 
          request.resource.data.updatedAt == request.time
      );

      match /messages/{messageId} {
        allow read: if isAuthUser() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) ||
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group' &&
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants != null &&
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants[request.auth.uid] != null)
        );
        allow create: if isAuthUser() &&
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.timestamp == request.time; 
        allow update, delete: if false; 
      }
    }

    match /mutuals/{connectionDocId} {
      allow get: if isAuthUser() && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if isAuthUser();
      allow create: if isAuthUser() &&
                    request.resource.data.requesterId == request.auth.uid &&
                    request.resource.data.userIds.hasAll([request.auth.uid]) &&
                    request.resource.data.requestedAt == request.time;
      allow update: if isAuthUser() && resource.data.userIds.hasAny([request.auth.uid]) &&
                    resource.data.status == 'pending' &&
                    request.resource.data.status == 'connected' &&
                    request.resource.data.requesterId == resource.data.requesterId && 
                    !resource.data.userIds.hasAny([request.resource.data.requesterId]) && 
                    request.resource.data.userIds == resource.data.userIds && 
                    request.resource.data.connectedAt == request.time &&
                    request.resource.data.updatedAt == request.time;
      allow delete: if isAuthUser() && resource.data.userIds.hasAny([request.auth.uid]); 
    }

    match /userPreferences/{userId} {
      allow read, write: if isAuthUser() && request.auth.uid == userId;
    }

    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if isAuthUser();
      allow write: if isAuthUser() &&
                   request.resource.data.naicsCode == naicsDocId && 
                   request.resource.data.lastUpdatedBy == request.auth.uid &&
                   request.resource.data.lastUpdatedAt == request.time;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthUser() && resource.data.userId == request.auth.uid;
      allow create: if isAuthUser() && request.resource.data.timestamp == request.time; 
      allow update: if isAuthUser() && resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']); 
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isAuthUser(); 
      allow list: if isAuthUser(); 
      allow create: if isAuthUser() && request.auth.uid == userId &&
                    request.resource.data.uid == userId &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.lastLoginAt == request.time &&
                    request.resource.data.updatedAt == request.time;
      allow update: if isAuthUser() && request.auth.uid == userId &&
                    request.resource.data.uid == resource.data.uid && 
                    request.resource.data.email == resource.data.email && 
                    request.resource.data.createdAt == resource.data.createdAt && 
                    request.resource.data.updatedAt == request.time;
      allow delete: if isAuthUser() && request.auth.uid == userId;
    }

    match /reviews/{reviewId} {
      allow read: if isAuthUser();
      allow create: if isAuthUser() &&
                    request.resource.data.reviewerId == request.auth.uid &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.updatedAt == request.time;
      allow update, delete: if isAuthUser() &&
                            resource.data.reviewerId == request.auth.uid &&
                            (request.method == 'delete' || request.resource.data.updatedAt == request.time);
    }

    match /plans/{planId} {
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                       request.resource.data.ownerId is string && request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.description == null || request.resource.data.description is string) &&
                       request.resource.data.visibility is string && request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                       request.resource.data.editability is string && request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                       request.resource.data.viewUserIds is list && (request.resource.data.visibility == 'public' ? request.resource.data.viewUserIds.size() == 0 : request.resource.data.viewUserIds.hasAny([request.auth.uid])) &&
                       request.resource.data.editUserIds is list && ((request.resource.data.editability in ['owner_only', 'collaborators'] && request.resource.data.editUserIds.hasAny([request.auth.uid])) || (request.resource.data.editability == 'everyone' && request.resource.data.editUserIds.size() == 0)) &&
                       request.resource.data.keys().hasAll([
                         'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                         'createdAt', 'updatedAt', 'version', 'roadmap',
                         'visibility', 'editability', 'viewUserIds', 'editUserIds'
                       ]) &&
                       request.resource.data.size() == 15; 

      allow list: if (request.query.filters.size() > 0 &&
                 request.query.filters[0].field == 'visibility' &&
                 request.query.filters[0].operator == 'in' &&
                 (request.query.filters[0].value.hasAny(['public', 'unlisted'])) &&
                 (request.query.limit == null || request.query.limit <= 20)
                ) || request.auth != null;

			allow get: if resource.data.visibility in ['public', 'unlisted'] ||
              (request.auth != null && request.auth.uid == resource.data.ownerId) ||
              (request.auth != null && resource.data.viewUserIds.hasAny([request.auth.uid]));

      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }
      function isPlanEditor() {
        return request.auth.uid == resource.data.ownerId ||
               (resource.data.editability == 'collaborators' && resource.data.editUserIds.hasAny([request.auth.uid])) ||
               (resource.data.editability == 'everyone' && request.auth != null); 
      }
      function isValidSettingsUpdate(requestData, resourceData) {
        let allowedKeys = ['name', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'];
        let changedKeys = requestData.diff(resourceData).affectedKeys();
        return changedKeys.hasOnly(allowedKeys) &&
               (!('roadmap' in changedKeys)) &&
               (!('version' in changedKeys)) &&
               (requestData.name == null || (requestData.name is string && requestData.name.size() > 0 && requestData.name.size() <= 100)) &&
               (requestData.description == null || requestData.description is string) &&
               (requestData.sector == null || (requestData.sector is string && requestData.sector.size() > 0)) &&
               (requestData.subSector == null || requestData.subSector is string) &&
               (requestData.industry == null || requestData.industry is string) &&
               (requestData.naicsCode == null || requestData.naicsCode is string) &&
               (requestData.visibility == null || (requestData.visibility is string && requestData.visibility in ['private', 'unlisted', 'public'])) &&
               (requestData.editability == null || (requestData.editability is string && requestData.editability in ['owner_only', 'collaborators', 'everyone'])) &&
               (requestData.viewUserIds == null || requestData.viewUserIds is list) &&
               (requestData.editUserIds == null || requestData.editUserIds is list);
      }
      function isValidRoadmapUpdate(requestData, resourceData) {
        let allowedKeys = ['roadmap', 'version', 'updatedAt'];
        let changedKeys = requestData.diff(resourceData).affectedKeys();
        return changedKeys.hasOnly(allowedKeys) &&
               requestData.roadmap is list;
      }

      allow update: if request.auth != null &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       (
                         (isOwner() && isValidSettingsUpdate(request.resource.data, resource.data))
                         ||
                         (isPlanEditor() && isValidRoadmapUpdate(request.resource.data, resource.data))
                       );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /versions/{versionId} {
        allow create: if request.auth != null &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.planId == planId &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['planId', 'editorUid', 'roadmap', 'versionNumber', 'timestamp']) &&
                         request.resource.data.size() == 5;
        allow list, get: if request.auth != null;
        allow update, delete: if false;
      }
    }
    
    match /newsArticles/{articleId} {
      allow read: if resource.data.status == 'published';
      allow get: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.status == 'published');
      
      // CORRECTED RULE FOR NEWS ARTICLES LISTING
      allow list: if request.auth != null && (
          // Case 1: User is fetching their own articles (can be any status, or specific status)
          (
            request.query.limit <= 20 &&
            request.query.orderBy.path.string() == 'updatedAt' && request.query.orderBy.direction == 'desc' &&
            (
              // Scenario 1.1: Query is `where('userId', '==', auth.uid)` (status: any)
              (
                request.query.filters.size() == 1 &&
                request.query.filters[0][0] == 'userId' && request.query.filters[0][1] == '==' && request.query.filters[0][2] == request.auth.uid
              ) ||
              // Scenario 1.2: Query is `where('userId', '==', auth.uid)` AND `where('status', '==', 'draft' OR 'published')`
              (
                request.query.filters.size() == 2 &&
                (
                  ( // userId filter first, then status filter
                    request.query.filters[0][0] == 'userId' && request.query.filters[0][1] == '==' && request.query.filters[0][2] == request.auth.uid &&
                    request.query.filters[1][0] == 'status' && request.query.filters[1][1] == '==' && (request.query.filters[1][2] == 'draft' || request.query.filters[1][2] == 'published')
                  ) ||
                  ( // status filter first, then userId filter (Firestore might reorder)
                    request.query.filters[0][0] == 'status' && request.query.filters[0][1] == '==' && (request.query.filters[0][2] == 'draft' || request.query.filters[0][2] == 'published') &&
                    request.query.filters[1][0] == 'userId' && request.query.filters[1][1] == '==' && request.query.filters[1][2] == request.auth.uid
                  )
                )
              )
            )
          ) ||
          // Case 2: Fetching all published articles for the general news feed
          (
            request.query.limit <= 15 && // Enforce client-side limit for public feed
            request.query.orderBy.path.string() == 'publishedAt' && request.query.orderBy.direction == 'desc' &&
            request.query.filters.size() == 1 &&
            request.query.filters[0][0] == 'status' &&
            request.query.filters[0][1] == '==' &&
            request.query.filters[0][2] == 'published'
          )
        );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
                      && request.resource.data.title is string && request.resource.data.title.size() > 0
                      && request.resource.data.category is string && request.resource.data.category.size() > 0
                      && request.resource.data.content is string 
                      && request.resource.data.status is string && (request.resource.data.status == 'draft' || request.resource.data.status == 'published')
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time
                      && (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null)
                      && request.resource.data.keys().hasAll(['userId', 'title', 'category', 'content', 'status', 'createdAt', 'updatedAt', 'publishedAt', 'coverImageUrl']) 
                      && request.resource.data.size() == 9; 

      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                      && request.resource.data.userId == resource.data.userId 
                      && request.resource.data.createdAt == resource.data.createdAt 
                      && request.resource.data.updatedAt == request.time 
                      && (request.resource.data.title is string || request.resource.data.title == resource.data.title)
                      && (request.resource.data.category is string || request.resource.data.category == resource.data.category)
                      && (request.resource.data.content is string || request.resource.data.content == resource.data.content)
                      && (request.resource.data.status is string || request.resource.data.status == resource.data.status)
                      && (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null || request.resource.data.publishedAt == resource.data.publishedAt)
                      && (request.resource.data.coverImageUrl is string || request.resource.data.coverImageUrl == null || request.resource.data.coverImageUrl == resource.data.coverImageUrl)
                      && request.resource.data.keys().hasOnly(['userId', 'title', 'category', 'content', 'status', 'createdAt', 'updatedAt', 'publishedAt', 'coverImageUrl'])
                      && request.resource.data.size() == 9;

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    