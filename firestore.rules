rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    match /users/{userId} {
      // Helper function to check if the requesting user is the profile owner
      function isOwner() {
        return request.auth.uid == userId;
      }
      
      // Anyone can read a user's basic profile info
      allow read: if true;
      
      // Users can only create their own profile document
      allow create: if isOwner() &&
                       // Ensure required fields for a new profile are present
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.lastLoginAt == request.time;

      // Users can only update their own profile document
      allow update: if isOwner() &&
                       // Ensure certain fields are not changed after creation
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.createdAt == resource.data.createdAt;
      
      // Users cannot delete their own profile document through client requests
      allow delete: if false;
    }

    // --- Mutuals (Connections) Collection ---
    match /mutuals/{connectionId} {
        // Helper function to check if the requesting user is part of the connection
        function isParticipant() {
            return request.auth.uid in resource.data.userIds;
        }

        // Allow read only if the requesting user is one of the participants
        allow read: if isAuthenticated() && isParticipant();

        // Allow create only if user is authenticated and is the requester
        allow create: if isAuthenticated() &&
                         request.resource.data.requesterId == request.auth.uid &&
                         request.resource.data.userIds.hasAll([request.auth.uid]) && // Ensure requester is in the list
                         request.resource.data.status == 'pending'; // Initial status must be pending

        // Allow update (e.g., accepting a request) if user is a participant
        allow update: if isAuthenticated() && isParticipant();

        // Allow delete (e.g., removing a connection) if user is a participant
        allow delete: if isAuthenticated() && isParticipant();
    }

    // --- Posts Collection ---
    match /posts/{postId} {
        // Helper function to check if the requesting user is the post owner
        function isPostOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        // Anyone can read any post
        allow read: if true;
        allow list: if true;

        // Allow create if user is authenticated and is the owner of the new post
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.createdAt == request.time;
                         
        // Allow update only by the post owner
        // This is simplified; you might want more granular control
        allow update: if isPostOwner();

        // Allow delete only by the post owner
        allow delete: if isPostOwner();

        // --- Comments Subcollection (for 'posts') ---
        match /comments/{commentId} {
            // Helper function to check if the requesting user is the comment owner
            function isCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }

            // Allow anyone to read comments
            allow read: if true;
            allow list: if true; // Allow querying comments for a post

            // Allow create if user is authenticated
            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.timestamp == request.time;

            // Allow update only by the comment owner (e.g., for editing text)
            // Or by any user if it's just for liking
            allow update: if isAuthenticated() && (
                            (isCommentOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
                            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']))
                          );

            // Allow delete only by the comment owner
            allow delete: if isCommentOwner();

            // --- SubComments Subcollection ---
            match /subcomments/{subCommentId} {
                function isSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }
                allow read: if true;
                allow list: if true;
                allow create: if isAuthenticated() &&
                                 request.resource.data.userId == request.auth.uid &&
                                 request.resource.data.timestamp == request.time;
                allow update: if isAuthenticated() && (
                                (isSubCommentOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
                                (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']))
                              );
                allow delete: if isSubCommentOwner();
            }
        }
    }

    // --- Article Tags Collection ---
    match /articleTags/{tagId} {
        allow read: if true; 
        allow list: if true;

        allow create: if isAuthenticated() &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount >= 0 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy', 'updatedAt']) &&
                         request.resource.data.size() == 6;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'updatedAt']);
                         
        allow delete: if false;
    }

    // --- News Articles Collection ---
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read: if resource.data.status == 'published' || isNewsArticleOwner();
        allow list: if true;

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.content is string &&
                         request.resource.data.status in ['draft', 'published'] &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.status == 'draft' || request.resource.data.publishedAt == request.time) &&
                         (request.resource.data.status == 'published' || request.resource.data.publishedAt == null) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.keys().hasAll([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount'
                         ]) &&
                         request.resource.data.size() == 14;

        allow update: if isAuthenticated() &&
                       request.resource.data.updatedAt == request.time &&
                       ( // Case 1: Owner updating their article
                         isNewsArticleOwner() &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.commentCount == resource.data.commentCount &&
                         request.resource.data.likeCount == resource.data.likeCount &&
                         request.resource.data.likedBy == resource.data.likedBy &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'content', 'tags', 'status', 'coverImageUrl',
                           'draftContent', 'hasUnpublishedChanges', 'publishedAt', 'updatedAt'
                         ]) &&
                         (request.resource.data.status == 'published' ? request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == resource.data.publishedAt : true) &&
                         (request.resource.data.status == 'draft' ? request.resource.data.publishedAt == null : true)
                       ) ||
                       ( // Case 2: Any authenticated user liking/unliking (but not the author)
                         request.auth.uid != resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                           (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid])) ||
                           (request.resource.data.likedBy == resource.data.likedBy.removed(request.auth.uid))
                         )
                       ) ||
                       ( // Case 3: System (or trusted function) updating commentCount
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                         (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1)
                       );

        allow delete: if isNewsArticleOwner();

        // --- News Comments Subcollection (for 'newsArticles') ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true;
            allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleCommentOwner();

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9;

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             // Immutable fields check
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                             request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                             request.resource.data.get('isShadowBanned', false) == resource.data.get('isShadowBanned', false) &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                              request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                             request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                             request.resource.data.likeCount == resource.data.likeCount &&
                             request.resource.data.likedBy == resource.data.likedBy
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true;
                allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleSubCommentOwner();

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.isShadowBanned == false &&
                               request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                               request.resource.data.size() == 9;

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                                 request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                                 request.resource.data.get('isShadowBanned', false) == resource.data.get('isShadowBanned', false) &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                                  request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                                 request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                                 request.resource.data.likeCount == resource.data.likeCount &&
                                 request.resource.data.likedBy == resource.data.likedBy
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }
     // --- User Preferences Collection ---
    match /userPreferences/{userId} {
        function isOwner() {
            return request.auth.uid == userId;
        }

        // Allow user to read and write to their own preferences document
        allow read, write: if isAuthenticated() && isOwner();
    }
  }
}