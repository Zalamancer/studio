
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (Global or to be scoped if needed)
    function isAuthUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // ========== USERS Collection ==========
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profile info
      allow create: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       request.resource.data.keys().hasAll(['uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'industry', 'avatarUrl', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange', 'createdAt', 'updatedAt', 'lastLoginAt']) &&
                       (!('companyName' in request.resource.data) || request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                       (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description is string) &&
                       (!('descriptionVisibility'in request.resource.data) || request.resource.data.descriptionVisibility == 'everyone' || request.resource.data.descriptionVisibility == 'connected' || request.resource.data.descriptionVisibility == 'only_me') &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags == null || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established == null || request.resource.data.established is string) &&
                       (!('verified' in request.resource.data) || request.resource.data.verified == false || request.resource.data.verified == true) &&
                       (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount == false || request.resource.data.isBotAccount == true) &&
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange == null || request.resource.data.incomeRange is string);

      allow update: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == resource.data.uid && // uid cannot change
                       request.resource.data.email == resource.data.email && // email cannot change
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // this cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       // Optional fields that can be updated
                       (!('companyName' in request.resource.data) || request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                       (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description is string) &&
                       (!('descriptionVisibility'in request.resource.data) || request.resource.data.descriptionVisibility == 'everyone' || request.resource.data.descriptionVisibility == 'connected' || request.resource.data.descriptionVisibility == 'only_me') &&
                       (!('sectorName' in request.resource.data) || request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                       (!('subSectorName' in request.resource.data) || request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                       (!('industryName' in request.resource.data) || request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags == null || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established == null || request.resource.data.established is string) &&
                       (!('verified' in request.resource.data) || request.resource.data.verified == false || request.resource.data.verified == true) &&
                       (!('isBotAccount' in request.resource.data) || request.resource.data.isBotAccount == false || request.resource.data.isBotAccount == true) &&
                       (!('incomeRange' in request.resource.data) || request.resource.data.incomeRange == null || request.resource.data.incomeRange is string) &&
                       (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt == request.time || request.resource.data.lastLoginAt == resource.data.lastLoginAt); // lastLogin can be updated to server time OR remain unchanged
      allow delete: if false; // Generally users should not delete their own profiles directly
    }

    // ========== USER PREFERENCES Collection ==========
    match /userPreferences/{userId} {
      allow read, write: if isAuthUser() && request.auth.uid == userId;
      // Write validation (optional, but good for data integrity):
      // allow write: if isAuthUser() && request.auth.uid == userId &&
      //                 request.resource.data.userId == userId &&
      //                 (!('favoriteSectorCodes' in request.resource.data) || request.resource.data.favoriteSectorCodes is list) &&
      //                 (!('notifyOnReply' in request.resource.data) || request.resource.data.notifyOnReply is bool) &&
      //                 ... (other boolean checks for notifications)
      //                 (!('stripeCustomerId' in request.resource.data) || request.resource.data.stripeCustomerId == null || request.resource.data.stripeCustomerId is string) &&
      //                 ... (other stripe fields);
    }

    // ========== POSTS Collection ==========
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if isAuthUser() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time && // Ensure server timestamp
                       request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 200 &&
                       request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() > 0 &&
                       (!('descriptionTried' in request.resource.data) || request.resource.data.descriptionTried == null || request.resource.data.descriptionTried is string) &&
                       (!('descriptionOutcome' in request.resource.data) || request.resource.data.descriptionOutcome == null || request.resource.data.descriptionOutcome is string) &&
                       request.resource.data.tags is list && request.resource.data.tags.size() >= 1 &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (!('subSector' in request.resource.data) || request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.ratingScore is number &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.imageUrls is list &&
                       request.resource.data.mentionedUserIds is list &&
                       (request.resource.data.requestType == 'post' || (
                         (!('maxBudget' in request.resource.data) || request.resource.data.maxBudget == null || request.resource.data.maxBudget is number) &&
                         (!('deadline' in request.resource.data) || request.resource.data.deadline == null || request.resource.data.deadline is timestamp)
                       )) &&
                       // Ensure only allowed fields are present
                       request.resource.data.keys().hasOnly([
                         'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'ratingScore', 'createdAt',
                         'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline',
                         'imageUrls', 'mentionedUserIds', 'commentCount'
                       ]);

      allow update: if isAuthUser() && resource.data.userId == request.auth.uid &&
                       // Allow only specific fields to be updated, e.g., question, description, tags
                       request.resource.data.diff(resource.data).affectedKeys().hasAny(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls']) &&
                       // Immutable fields
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.ratingScore == resource.data.ratingScore && // Rating score shouldn't change on edit
                       request.resource.data.commentCount == resource.data.commentCount && // Comment count updated by comment service
                       request.resource.data.requestType == resource.data.requestType; // Request type should not change

      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;

      // --- Bids Subcollection ---
      match /bids/{bidId} {
        function isBidder() {
          return request.auth.uid == request.resource.data.bidderId;
        }
        function isPostOwner() {
          return request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId;
        }
        allow read: if true; // Bids are public on a post
        allow create: if isAuthUser() && isBidder() &&
                         request.resource.data.postId == postId &&
                         request.resource.data.bidAmount is number &&
                         request.resource.data.bidAmount >= 0 &&
                         request.resource.data.timestamp == request.time &&
                         // Ensure user is not bidding on their own post
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid &&
                         // Help request specific validation
                         get(/databases/$(database)/documents/posts/$(postId)).data.requestType == 'help_request' &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.maxBudget != null &&
                         request.resource.data.bidAmount <= get(/databases/$(database)/documents/posts/$(postId)).data.maxBudget &&
                         request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
        allow update, delete: if isAuthUser() && isBidder(); // Only bidder can update/delete their bid
      }

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        function isCommenter() {
          return request.auth.uid == request.resource.data.userId;
        }
        allow read: if true;
        allow create: if isAuthUser() && isCommenter() &&
                         request.resource.data.postId == postId && // Ensure comment is for this post
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.keys().hasOnly(['userId', 'postId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'userAvatar']); // userAvatar & mentionName are optional for writes

        allow update: if isAuthUser() && resource.data.userId == request.auth.uid && // Original commenter
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) && // Only allow text and mentions to be updated
                       request.resource.data.updatedAt == request.time &&
                       // Immutable fields
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.postId == resource.data.postId &&
                       request.resource.data.timestamp == resource.data.timestamp &&
                       request.resource.data.likeCount == resource.data.likeCount &&
                       request.resource.data.likedBy == resource.data.likedBy;
                     // Or for liking/unliking
                     // (Separate rule for liking is cleaner or use a more complex OR condition)
                     // Example for liking:
                     // if isAuthUser() &&
                     //    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                     //    request.resource.data.updatedAt == request.time &&
                     //    ( (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) || // Liking
                     //      (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1)    // Unliking
                     //    ) &&
                     //    // Immutable fields
                     //    request.resource.data.userId == resource.data.userId &&
                     //    request.resource.data.postId == resource.data.postId &&
                     //    request.resource.data.text == resource.data.text &&
                     //    request.resource.data.timestamp == resource.data.timestamp;


        // More granular update for likes
        allow update (toggleLike): if isAuthUser() &&
                                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                      request.resource.data.updatedAt == request.time &&
                                      (
                                        (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) || // Liking
                                        (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1)    // Unliking
                                      ) &&
                                      // Immutable fields for this specific operation
                                      request.resource.data.userId == resource.data.userId &&
                                      request.resource.data.postId == resource.data.postId &&
                                      request.resource.data.text == resource.data.text &&
                                      request.resource.data.timestamp == resource.data.timestamp &&
                                      request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                      request.resource.data.mentionName == resource.data.mentionName &&
                                      request.resource.data.userAvatar == resource.data.userAvatar;



        allow delete: if isAuthUser() && resource.data.userId == request.auth.uid; // Only original commenter can delete

        // --- SubComments Subcollection (replies to comments) ---
        match /subcomments/{subCommentId} {
            function isSubCommenter() {
              return request.auth.uid == request.resource.data.userId;
            }
            allow read: if true;
            allow create: if isAuthUser() && isSubCommenter() &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'userAvatar']);

            allow update (toggleLike): if isAuthUser() &&
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                request.resource.data.updatedAt == request.time &&
                                (
                                (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) || // Liking
                                (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1)    // Unliking
                                ) &&
                                // Immutable fields
                                request.resource.data.userId == resource.data.userId &&
                                request.resource.data.text == resource.data.text &&
                                request.resource.data.timestamp == resource.data.timestamp &&
                                request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                request.resource.data.mentionName == resource.data.mentionName &&
                                request.resource.data.userAvatar == resource.data.userAvatar;

            allow delete: if isAuthUser() && resource.data.userId == request.auth.uid;
        }
      }
    }

    // ========== MUTUALS (Connections) Collection ==========
    match /mutuals/{connectionId} {
      function isAuthUserParticipant() {
        return resource.data.userIds.hasAny([request.auth.uid]);
      }
      function isRequester() {
        return resource.data.requesterId == request.auth.uid;
      }
      function isRecipient() {
        return resource.data.userIds.hasAny([request.auth.uid]) && resource.data.requesterId != request.auth.uid;
      }
      allow read: if isAuthUser() && isAuthUserParticipant();
      allow create: if isAuthUser() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.userIds.size() == 2 && // Only two users in a connection
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       !exists(/databases/$(database)/documents/mutuals/$(connectionId)); // Prevent overwriting existing by create

      allow update: if isAuthUser() && isAuthUserParticipant() &&
                       // Accepting a request
                       (resource.data.status == 'pending' && isRecipient() &&
                        request.resource.data.status == 'connected' &&
                        request.resource.data.connectedAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.userIds == resource.data.userIds &&
                        request.resource.data.requesterId == resource.data.requesterId) ||
                       // Blocking a connection (can be done by either party)
                       (request.resource.data.status == 'blocked' &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.userIds == resource.data.userIds &&
                        request.resource.data.requesterId == resource.data.requesterId // Or this could also change if blocker becomes "requester" of block
                        );
      allow delete: if isAuthUser() && isAuthUserParticipant() &&
                       // Rejecting/Cancelling a PENDING request or Removing a CONNECTED relationship
                       (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    // ========== CONVERSATIONS Collection ==========
    match /conversations/{conversationId} {
      // Helper: Is the authenticated user a current participant in this conversation?
      function isAuthUserParticipant() {
        return resource.data.participants.hasAny([request.auth.uid]);
      }
      // Helper: Is the authenticated user an active participant (not in formerParticipants)?
      function isActiveAuthUserParticipant() {
        return resource.data.participants.hasAny([request.auth.uid]) &&
               (resource.data.formerParticipants == null || !(request.auth.uid in resource.data.formerParticipants.keys()));
      }
      // Helper: Is the authenticated user an admin of this group conversation?
      function isGroupAdmin() {
        return resource.data.type == 'group' && resource.data.adminIds.hasAny([request.auth.uid]);
      }
      // Helper: Is the authenticated user the owner of this group conversation?
      function isGroupOwner() {
        return resource.data.type == 'group' && resource.data.ownerId == request.auth.uid;
      }

      // Helper: Validates common fields for conversation creation
      function hasValidTimestampsForCreate() {
        return request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time &&
               request.resource.data.lastMessageTimestamp == request.time;
      }
      function hasValidInitialLastMessage() {
         // For new groups, a system message is set. For direct, it's null.
        return (request.resource.data.type == 'group' && request.resource.data.lastMessage is string) ||
               (request.resource.data.type == 'direct' && request.resource.data.lastMessage == null);
      }
      // Helper: Validates expected keys for creating ANY conversation type
      function hasExpectedKeysForCreate() {
         let expectedKeys = ['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'formerParticipants'];
         if (request.resource.data.type == 'group') {
           expectedKeys.add(['groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']);
         }
         return request.resource.data.keys().hasOnly(expectedKeys);
      }

      // CREATE Rule
      allow create: if isAuthUser() &&
                       request.resource.data.participants.hasAll([request.auth.uid]) &&
                       hasValidTimestampsForCreate() &&
                       hasValidInitialLastMessage() &&
                       request.resource.data.formerParticipants == {} && // Must be initialized as empty map
                       hasExpectedKeysForCreate() &&
                       // Branch for DIRECT conversation
                       (
                         request.resource.data.type == 'direct' &&
                         request.resource.data.participants.size() == 2 &&
                         // Optional: validate postId for direct chat if needed (e.g., must be string or null)
                         (!('postId' in request.resource.data) || request.resource.data.postId == null || request.resource.data.postId is string) &&
                         // Direct chats don't have group-specific fields set
                         request.resource.data.groupName == null &&
                         request.resource.data.groupAvatarUrl == null &&
                         request.resource.data.ownerId == null &&
                         request.resource.data.adminIds.size() == 0
                       ) ||
                       // Branch for GROUP conversation
                       (
                         request.resource.data.type == 'group' &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                         request.resource.data.adminIds.size() >= 1 && // At least owner is admin
                         request.resource.data.participants.size() >= 2 &&
                         request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                         (!('groupAvatarUrl' in request.resource.data) || request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                         request.resource.data.postId == null // Group chats are not directly tied to posts
                       );

      // READ Rule (Get specific conversation document)
      // Modified to allow former participants to read (message read rules will control what they see)
      allow get: if isAuthUser() &&
                    (resource.data.participants.hasAny([request.auth.uid]) ||
                     (resource.data.formerParticipants != null && resource.data.formerParticipants.keys().hasAny([request.auth.uid]))
                    );

      // LIST Rule (Querying conversations)
      // Client query must include where('participants', 'array-contains', request.auth.uid)
      // If also filtering out "left" groups at query time: where('formerParticipants.' + request.auth.uid, '==', null)
      allow list: if isAuthUser();


      // UPDATE Rule - Multiple branches for different operations
      allow update: if isAuthUser() && isActiveAuthUserParticipant() && (
          // Branch A: Sending a new message (Simplified with request.writeFields for testing)
          (
            request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
            request.writeFields.size() == 4 && // Strict check for only these 4 fields
            request.resource.data.lastMessage is string &&
            request.resource.data.lastMessageSenderId == request.auth.uid &&
            request.resource.data.lastMessageTimestamp == request.time &&
            request.resource.data.updatedAt == request.time &&
            // Ensure other fields are immutable
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.adminIds == resource.data.adminIds &&
            request.resource.data.groupName == resource.data.groupName &&
            request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
            request.resource.data.formerParticipants == resource.data.formerParticipants
          ) ||
          // Branch B: Updating group details (name, avatar) by an admin
          (
            resource.data.type == 'group' && isGroupAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
            request.resource.data.updatedAt == request.time &&
            // Immutable fields check
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.adminIds == resource.data.adminIds && // Admins list not changed here
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage &&
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
            request.resource.data.formerParticipants == resource.data.formerParticipants
          ) ||
          // Branch C: Admin adding members to a group
          (
            resource.data.type == 'group' && isGroupAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasAll(['participants', 'updatedAt']) &&
            request.resource.data.participants.hasAll(resource.data.participants) && // New list must contain all old members
            request.resource.data.participants.size() > resource.data.participants.size() && // Must be adding
            request.resource.data.updatedAt == request.time &&
            // Immutable fields check
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.adminIds == resource.data.adminIds &&
            request.resource.data.groupName == resource.data.groupName &&
            request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage &&
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
            request.resource.data.formerParticipants == resource.data.formerParticipants
          ) ||
          // Branch D: Admin removing members from a group (cannot remove owner)
          (
            resource.data.type == 'group' && isGroupAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasAll(['participants', 'adminIds', 'updatedAt']) && // adminIds might change if removed user was admin
            resource.data.participants.hasAll(request.resource.data.participants) && // Old list must contain all new members
            request.resource.data.participants.size() < resource.data.participants.size() && // Must be removing
            !request.resource.data.participants.hasAny([resource.data.ownerId]) && // Cannot remove owner this way
            request.resource.data.updatedAt == request.time &&
            // Immutable fields (except participants, adminIds)
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.groupName == resource.data.groupName &&
            request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage &&
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
            request.resource.data.formerParticipants == resource.data.formerParticipants
          ) ||
          // Branch E: Owner promoting/demoting admins (cannot demote self if owner)
          (
            resource.data.type == 'group' && isGroupOwner() &&
            request.resource.data.diff(resource.data).affectedKeys().hasAll(['adminIds', 'updatedAt']) &&
            request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain admin
            request.resource.data.updatedAt == request.time &&
            // Immutable fields (except adminIds)
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.groupName == resource.data.groupName &&
            request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage &&
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
            request.resource.data.formerParticipants == resource.data.formerParticipants
          ) ||
          // Branch F: Participant leaving a group
          (
            resource.data.type == 'group' &&
            resource.data.participants.hasAny([request.auth.uid]) && // User was a participant
            !request.resource.data.participants.hasAny([request.auth.uid]) && // User is now removed from active participants
            request.resource.data.participants.size() == resource.data.participants.size() - 1 && // Exactly one user removed

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'participants', 'adminIds', 'formerParticipants', 'updatedAt'
            ]) &&

            // User being removed is also removed from adminIds if they were an admin
            (
                (resource.data.adminIds.hasAny([request.auth.uid]) && !request.resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.adminIds.size() == resource.data.adminIds.size() - 1) ||
                (!resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.adminIds.size() == resource.data.adminIds.size())
            ) &&

            // Owner safeguard: owner cannot leave if they are the sole admin AND other participants would remain
            !(resource.data.ownerId == request.auth.uid &&
              resource.data.adminIds.size() == 1 && resource.data.adminIds.hasAll([request.auth.uid]) &&
              request.resource.data.participants.size() > 0 // After removal, if >0 participants remain
            ) &&

            // Timestamp checks for the leave operation
            request.resource.data.formerParticipants[request.auth.uid] == request.time &&
            request.resource.data.updatedAt == request.time &&

            // Ensure other critical fields are immutable during this specific "leave" operation
            request.resource.data.type == resource.data.type &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.groupName == resource.data.groupName &&
            (request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl || (request.resource.data.groupAvatarUrl == null && resource.data.groupAvatarUrl == null)) &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.lastMessage == resource.data.lastMessage &&
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
            request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
          )
      );

      // DELETE Rule (Not typically allowed for conversations, manage via 'leave' or archiving)
      allow delete: if false;


      // --- MESSAGES Subcollection ---
      match /messages/{messageId} {
        function isMessageSender() {
          return request.auth.uid == request.resource.data.senderId;
        }
        function isMessageUpdateValid() {
          // Example: Allow only 'read' status update by participants, or text edit by sender
          // For now, keep it simple: only sender can edit text, no other updates allowed by client.
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) &&
                 request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                 request.resource.data.updatedAt == request.time;
        }
        function canViewMessage() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          // 1. Still an active participant -> full access
          if (conv.participants.hasAny([request.auth.uid]) && (conv.formerParticipants == null || !(request.auth.uid in conv.formerParticipants.keys()) ) ) {
             return true;
          }
          // 2. Former participant -> only up to leave-time
          if (conv.formerParticipants != null && conv.formerParticipants.keys().hasAny([request.auth.uid])) {
            return resource.data.timestamp <= conv.formerParticipants[request.auth.uid];
          }
          return false; // Default: if not current participant and not former with valid leave time
        }

        allow read: if isAuthUser() && canViewMessage();

        allow create: if isAuthUser() &&
                         isActiveAuthUserParticipant() && // Use helper from parent conversation scope
                         isMessageSender() &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.read == false &&
                         (!('isBotMessage' in request.resource.data) || request.resource.data.isBotMessage == false) && // User client cannot send bot messages
                         (!('replyToMessageId' in request.resource.data) || request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                         (!('repliedToTextSnippet' in request.resource.data) || request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                         request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId']);

        allow update: if isAuthUser() && resource.data.senderId == request.auth.uid && isMessageUpdateValid();
        allow delete: if false; // Generally, messages are not deleted by clients
      }
    }

    // ========== NOTIFICATIONS Collection ==========
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthUser() && resource.data.userId == request.auth.uid;
      allow create: if isAuthUser() &&
                       request.resource.data.userId != request.auth.uid && // User cannot create notification for themselves
                       request.resource.data.senderId == request.auth.uid && // Sender must be the authenticated user
                       request.resource.data.isRead == false &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.type is string &&
                       // Validate other fields based on type if necessary
                       request.resource.data.keys().hasOnly([
                           'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                           'postId', 'postQuestion', 'commentId', 'subCommentId',
                           'conversationId', 'textSnippet', 'timestamp', 'isRead'
                       ]);
    }

    // ========== WHITEBOARD ANNOTATIONS Collection ==========
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true; // Whiteboard annotations are public for now
      allow write: if isAuthUser() &&
                      request.resource.data.naicsCode == naicsCode && // Ensure NAICS code in doc matches doc ID
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time &&
                      request.resource.data.shapes is list;
                      // Further validation for shape structure can be added if needed
                      // e.g., request.resource.data.shapes.size() < 100
                      // every shape in request.resource.data.shapes must have id, type, x, y, width, height, etc.
    }

    // ========== REVIEWS Collection ==========
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        allow create: if isAuthUser() &&
                         request.resource.data.reviewerId == request.auth.uid && // Reviewer must be auth user
                         request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                         request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // reviewerHistoricalAvgRating can be number or null
                         (request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number) &&
                         request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);
        allow update: if isAuthUser() && resource.data.reviewerId == request.auth.uid && // Only original reviewer can update
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
                         request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.updatedAt == request.time &&
                         // Immutable fields
                         request.resource.data.targetUserId == resource.data.targetUserId &&
                         request.resource.data.reviewerId == resource.data.reviewerId &&
                         request.resource.data.reviewerName == resource.data.reviewerName &&
                         request.resource.data.reviewerAvatar == resource.data.reviewerAvatar &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating; // Historical average is a snapshot, should not change on edit
        allow delete: if isAuthUser() && resource.data.reviewerId == request.auth.uid; // Only original reviewer can delete
    }
  }
}

    