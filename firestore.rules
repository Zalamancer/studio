
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function getPost(postId) {
      return get(/databases/$(database)/documents/posts/$(postId));
    }
    function getPostData(postId) {
      return getPost(postId).data;
    }
    function isPostOwner(postId) {
      return isAuthenticated() && request.auth.uid == getPostData(postId).userId;
    }
     function isCollectionOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
    function isSharedWithUser() {
      return isAuthenticated() && request.auth.uid in resource.data.sharedWithUserIds;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true; // Publicly readable basic profile info
      allow create: if isUser(userId) &&
                     request.resource.data.uid == userId &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.lastLoginAt == request.time &&
                     request.resource.data.keys().hasAll(['uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry', 'descriptionVisibility', 'createdAt', 'updatedAt', 'lastLoginAt', 'tags', 'established', 'verified', 'isBotAccount', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'incomeRange']) &&
                     request.resource.data.size() == 22; // Number of fields in UserProfileData + timestamps
      allow update: if isUser(userId) &&
                       request.resource.data.uid == resource.data.uid && // Cannot change uid
                       request.resource.data.email == resource.data.email && // Email should not change via this rule
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName should not change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.companyName == resource.data.companyName && // Cannot change company name here
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.isBotAccount == resource.data.isBotAccount &&
                       request.resource.data.verified == resource.data.verified &&
                       request.resource.data.updatedAt == request.time &&
                       // Allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'tags', 'established', 'lastLoginAt', 'updatedAt',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'incomeRange'
                       ]);
      allow delete: if false; // Users cannot delete their own profiles directly for data integrity
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow list: if true; // Allow listing posts (e.g., on homepage)

      allow create: if isAuthenticated() &&
                     request.resource.data.userId == request.auth.uid &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.commentCount == 0 &&
                     // Add other required fields checks if necessary based on NewPostData
                     request.resource.data.keys().hasAll(['userId', 'question', 'requestType', 'descriptionDetails', 'tags', 'sector', 'ratingScore', 'createdAt', 'commentCount', 'imageUrls', 'mentionedUserIds', 'maxBudget', 'deadline', 'subSector', 'industry', 'naicsCode', 'descriptionTried', 'descriptionOutcome']) &&
                     request.resource.data.size() == 18; // Ensure only expected fields are set

      allow update: if isAuthenticated() &&
                       request.resource.data.userId == resource.data.userId && // userId cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be new server time
                       (
                         // Case 1: Only author can update most fields
                         (request.auth.uid == resource.data.userId &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'maxBudget', 'deadline', 'updatedAt', 'requestType', 'mentionedUserIds'/*, 'miroBoardEmbedUrl' removed*/])) ||
                         // Case 2: Authenticated user can update commentCount (e.g., after adding/deleting a comment)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1)
                         )
                       );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only post owner can delete


      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow list: if true; // Allow listing comments

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.isShadowBanned == false && // Assume false for regular post comments
                         request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                         request.resource.data.size() == 9;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) && // Only these fields can be changed for a like
                         request.resource.data.userId == resource.data.userId && // Ensure other fields are immutable
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.mentionName == resource.data.mentionName &&
                         request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                         request.resource.data.isShadowBanned == resource.data.isShadowBanned && // isShadowBanned must remain false unless specific rules are made
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                          request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)));

        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        // SubComments Subcollection
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list &&
                           request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']) &&
                           request.resource.data.size() == 8; // No mentionName for subcomments by default

          allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) && // Only for likes
                           request.resource.data.userId == resource.data.userId && // Immutable
                           request.resource.data.text == resource.data.text &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                           request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                            request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)));

          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }

      // Bids Subcollection
      match /bids/{bidId} {
          allow read: if isAuthenticated(); // Allow any authenticated user to read bids
          allow list: if isAuthenticated(); // Allow any authenticated user to list bids

          allow create: if isAuthenticated() &&
                           request.resource.data.bidderId == request.auth.uid &&
                           getPostData(postId).get('userId', '') != request.auth.uid && // Cannot bid on own post, safer get
                           request.resource.data.postId == postId &&
                           request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.bidMessage is string &&
                           request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                           request.resource.data.size() == 5;
          allow update: if false;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.bidderId;
      }
    }

    // Mutuals Collection (Connections)
    match /mutuals/{connectionId} {
        allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.requesterId &&
                         request.auth.uid in request.resource.data.userIds &&
                         request.resource.data.userIds.size() == 2 &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                         request.resource.data.size() == 5 &&
                         request.resource.data.requestedAt == request.time &&
                         request.resource.data.updatedAt == request.time;
        allow update: if isAuthenticated() && // For accepting a request
                         request.auth.uid in resource.data.userIds &&
                         request.auth.uid != resource.data.requesterId && // Accepter is not the original requester
                         resource.data.status == 'pending' && // Can only accept pending requests
                         request.resource.data.status == 'connected' &&
                         request.resource.data.connectedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly(['status', 'connectedAt', 'updatedAt']) &&
                         request.resource.data.size() == 3; // Only status and connectedAt and updatedAt change
        allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Either user can cancel pending or remove connected
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function isGroupAdmin() {
        return resource.data.type == 'group' && request.auth.uid in resource.data.adminIds;
      }
      function isGroupOwner() {
        return resource.data.type == 'group' && request.auth.uid == resource.data.ownerId;
      }
      function isCreatingDirectChat() {
        return request.resource.data.type == 'direct' &&
               request.resource.data.participants.size() == 2 &&
               request.auth.uid in request.resource.data.participants &&
               request.resource.data.keys().hasOnly(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
               request.resource.data.groupName == null && request.resource.data.groupAvatarUrl == null && request.resource.data.ownerId == null && request.resource.data.adminIds.size() == 0 &&
               request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time;
      }
      function isCreatingGroupChat() {
        return request.resource.data.type == 'group' &&
               request.resource.data.participants.size() >= 2 &&
               request.auth.uid in request.resource.data.participants &&
               request.resource.data.ownerId == request.auth.uid && // Creator is owner
               request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
               request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
               (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
               request.resource.data.postId == null &&
               request.resource.data.keys().hasAll(['participants', 'type', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt']) &&
               request.resource.data.size() == 11 &&
               request.resource.data.createdAt == request.time &&
               request.resource.data.updatedAt == request.time;
      }
      function isUpdatingLastMessage() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
               request.resource.data.updatedAt == request.time;
      }
      function isUpdatingGroupDetails() {
        return isGroupAdmin() &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
               request.resource.data.updatedAt == request.time;
      }
      function isModifyingParticipants() { // For add/remove/leave
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'adminIds', 'ownerId', 'formerParticipants', 'updatedAt']) && // Added ownerId and formerParticipants
               request.resource.data.updatedAt == request.time;
      }

      allow read, list: if isAuthenticated() && isParticipant();
      allow create: if isAuthenticated() && (isCreatingDirectChat() || isCreatingGroupChat());
      allow update: if isAuthenticated() && isParticipant() &&
                       (isUpdatingLastMessage() ||
                        (resource.data.type == 'group' && (isUpdatingGroupDetails() || isModifyingParticipants()))
                       ) &&
                       // Immutable fields check
                       request.resource.data.type == resource.data.type &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.participants.hasAll(resource.data.participants.added()) && // Can only add participants
                       request.resource.data.participants.hasAll(resource.data.participants.removed()) && // Can only remove participants
                       // If ownerId is being changed, it must be by the current owner
                       (request.resource.data.ownerId == resource.data.ownerId || resource.data.ownerId == request.auth.uid);


      match /messages/{messageId} {
        allow read, list: if isAuthenticated() && isParticipant(); // isParticipant here refers to parent conversation
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.senderId &&
                         isParticipant() && // Sender must be a participant of the conversation
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'read', 'conversationId']) &&
                         request.resource.data.size() == 8; // Ensure only expected fields
        allow update: if false; // Messages are immutable once created
        allow delete: if false; // Messages cannot be deleted for now
      }
    }

    // User Preferences Collection
    match /userPreferences/{userId} {
      allow read, write: if isUser(userId); // User can read and write their own preferences
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // All reviews are public
      allow list: if true; // Allow listing reviews (e.g., for a profile)
      allow create: if isAuthenticated() &&
                     request.resource.data.reviewerId == request.auth.uid &&
                     request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                     request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                     request.resource.data.comment is string &&
                     (request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number) &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.keys().hasAll(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']) &&
                     request.resource.data.size() == 9;
      allow update: if isAuthenticated() &&
                     request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                     request.resource.data.reviewerId == resource.data.reviewerId && // Cannot change who reviewed
                     request.resource.data.targetUserId == resource.data.targetUserId && // Cannot change who is reviewed
                     request.resource.data.reviewerName == resource.data.reviewerName &&
                     request.resource.data.reviewerAvatar == resource.data.reviewerAvatar &&
                     request.resource.data.createdAt == resource.data.createdAt &&
                     request.resource.data.updatedAt == request.time && // Must set new update time
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']); // Only these can change
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

     // Collections (user-created post collections)
    match /collections/{collectionId} {
        function isOwner() {
            return request.auth.uid == resource.data.ownerId;
        }
        function isSharedUser() {
            return request.auth.uid in resource.data.sharedWithUserIds;
        }
        allow read: if isAuthenticated() && (isOwner() || isSharedUser());
        allow list: if isAuthenticated(); // Query rules will filter based on ownerId or sharedWithUserIds
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.ownerId &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                         request.resource.data.size() == 7;
        allow update: if isAuthenticated() &&
                         isOwner() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
        allow delete: if isAuthenticated() && isOwner();
    }

    // Plans Collection
    match /plans/{planId} {
        function isPlanOwner() { return request.auth.uid == resource.data.ownerId; }
        function isPlanViewer() { return resource.data.visibility == 'public' || (resource.data.visibility == 'unlisted' && isAuthenticated()) || (resource.data.visibility == 'private' && request.auth.uid in resource.data.viewUserIds); }
        function isPlanEditor() { return (isPlanOwner()) || (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) || (resource.data.editability == 'everyone' && isPlanViewer()); }
        function isValidRoadmap(roadmap) { return roadmap is list && (roadmap.size() == 0 || roadmap[0].keys().hasAll(['id', 'title', 'x', 'y', 'description', 'childrenData', 'peerConnections'])); }

        allow read: if isPlanViewer();
        allow list: if isAuthenticated(); // client queries and filters discoverable plans

        allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                       request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                       request.resource.data.viewUserIds is list &&
                       request.resource.data.editUserIds is list &&
                       isValidRoadmap(request.resource.data.roadmap) &&
                       request.resource.data.version == 1 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']) &&
                       request.resource.data.size() == 15;

        allow update: if isAuthenticated() &&
                        isPlanEditor() && // General check: user must have some form of edit access
                        request.resource.data.ownerId == resource.data.ownerId && // Owner immutable
                        request.resource.data.createdAt == resource.data.createdAt && // CreatedAt immutable
                        request.resource.data.updatedAt == request.time &&
                        ( // Either updating settings (only by owner) OR roadmap (by any editor)
                            (isPlanOwner() && // Owner can update settings and roadmap
                             request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'roadmap', 'version', 'updatedAt']) &&
                             (request.resource.data.roadmap == resource.data.roadmap || isValidRoadmap(request.resource.data.roadmap)) && // If roadmap is updated, validate it
                             (request.resource.data.version == resource.data.version || request.resource.data.version == resource.data.version + 1) // Version can only increment or stay same (settings change doesn't increment version)
                            ) ||
                            (!isPlanOwner() && isPlanEditor() && // Non-owner editor can only update roadmap
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                             isValidRoadmap(request.resource.data.roadmap) &&
                             request.resource.data.version == resource.data.version + 1 // Version must increment for roadmap change by non-owner
                            )
                        );

        allow delete: if isPlanOwner();

        // Plan Versions Subcollection
        match /versions/{versionId} {
            allow read: if isPlanViewer(); // Inherits parent plan's view permission
            allow list: if isPlanViewer();
            allow create: if isAuthenticated() && isPlanEditor() && // User must be an editor of the main plan
                             request.resource.data.planId == planId &&
                             request.resource.data.editorUid == request.auth.uid &&
                             request.resource.data.versionNumber is number &&
                             isValidRoadmap(request.resource.data.roadmap) &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                             request.resource.data.size() == 5;
            allow update, delete: if false; // Versions are immutable once created
        }
    }

    // Article Tags Collection (news related)
    match /articleTags/{tagId} {
      allow read: if true; // Tags are public for searching/display
      allow list: if true;
      allow create: if isAuthenticated() &&
                      request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                      request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                      request.resource.data.usageCount >= 0 && // Can be 0 or more initially
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']) &&
                      request.resource.data.size() == 5;
      allow update: if isAuthenticated() && // Typically for incrementing/decrementing usageCount
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.nameLowercase == resource.data.nameLowercase &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
                       (request.resource.data.usageCount == resource.data.usageCount + 1 || request.resource.data.usageCount == resource.data.usageCount - 1 || request.resource.data.usageCount >= 0); // Allow setting if it was negative from bad decrement.
      allow delete: if false; // Tags are not typically deleted, only usageCount reduced
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.userId;
        }
        function isNewsArticlePublished() {
            return resource.data.status == 'published';
        }

        allow read: if isNewsArticlePublished() || isNewsArticleOwner();
        allow list: if true; // Client will filter for 'published' status

        allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                       request.resource.data.content is string &&
                       request.resource.data.status in ['draft', 'published'] &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.status == 'draft' || request.resource.data.publishedAt == request.time) &&
                       request.resource.data.likeCount == 0 &&
                       request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.keys().hasAll([
                           'userId', 'title', 'tags', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt',
                           'likeCount', 'likedBy', 'commentCount',
                           'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline',
                           'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry',
                           'draftContent', 'hasUnpublishedChanges' // Added draft fields
                       ]) &&
                       request.resource.data.size() == 28; // Ensure all expected fields are present

        allow update: if isAuthenticated() &&
                       request.resource.data.updatedAt == request.time &&
                       (
                           ( // Case 1: Author updates their article (general fields, status, content, draft)
                             isNewsArticleOwner() &&
                             request.resource.data.userId == resource.data.userId && // Cannot change author
                             request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                             // If status changes to published and publishedAt was null, it must be set to request.time
                             (request.resource.data.status != resource.data.status && request.resource.data.status == 'published' && resource.data.publishedAt == null ? request.resource.data.publishedAt == request.time : true) &&
                             // If status changes from published to something else, publishedAt should become null
                             (request.resource.data.status != resource.data.status && resource.data.status == 'published' && request.resource.data.status != 'published' ? request.resource.data.publishedAt == null : true) &&
                             // If status is not changing but was already published, publishedAt should not change (unless explicitly nulled with status change)
                             (request.resource.data.status == resource.data.status && resource.data.status == 'published' ? request.resource.data.publishedAt == resource.data.publishedAt : true) &&
                             request.resource.data.diff(resource.data).affectedKeys().hasAny([
                                'title', 'tags', 'content', 'status', 'coverImageUrl', 'publishedAt', 'updatedAt',
                                'draftContent', 'hasUnpublishedChanges', // Allow draft updates by owner
                                'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline',
                                'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                             ])
                           ) ||
                           ( // Case 2: Any authenticated user liking/unliking
                             request.auth.uid != resource.data.userId && // Not the author liking their own article
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             // Immutable checks for non-like fields
                             request.resource.data.title == resource.data.title &&
                             request.resource.data.content == resource.data.content &&
                             request.resource.data.status == resource.data.status &&
                             // Correct like logic
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                              request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                           ) ||
                           ( // Case 3: Authenticated user triggering comment count update
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                             (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                             // Ensure other critical fields remain unchanged by this operation
                             request.resource.data.title == resource.data.title &&
                             request.resource.data.content == resource.data.content &&
                             request.resource.data.status == resource.data.status &&
                             request.resource.data.userId == resource.data.userId
                           )
                       );

        allow delete: if isNewsArticleOwner();

        // --- News Comments Subcollection (for 'newsArticles') ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true; // Simplified, client filters shadow-banned
            allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleCommentOwner();

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9;

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             // Ensure other fields are immutable for this case
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName &&
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                              request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                             // Ensure other fields are immutable for this case
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName &&
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.likeCount == resource.data.likeCount &&
                             request.resource.data.likedBy == resource.data.likedBy
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true;
                allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleSubCommentOwner();

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.isShadowBanned == false &&
                               request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']) &&
                               request.resource.data.size() == 8;

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                 request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                                  request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                 request.resource.data.likeCount == resource.data.likeCount &&
                                 request.resource.data.likedBy == resource.data.likedBy
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }
  }
}
