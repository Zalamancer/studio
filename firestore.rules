
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(docDataUserId) {
      return isAuthenticated() && request.auth.uid == docDataUserId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.uid == userId; // Can only update their own
      allow delete: if isOwner(userId); // Or admin role if you have one
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow list: if true; // Anyone can list posts (client filters further)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow list: if true;
        allow create: if isAuthenticated(); // User must be logged in to comment
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid; // Only comment owner can edit
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Only comment owner can delete

        // SubComments Subcollection
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated();
          allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }

      // Bids Subcollection (for help_request type posts)
      match /bids/{bidId} {
        allow read: if isAuthenticated(); // Or more specific if needed
        allow list: if isAuthenticated(); // Allow listing if authenticated (e.g., post owner or interested parties)
        allow create: if isAuthenticated() && request.resource.data.bidderId == request.auth.uid && request.resource.data.postId == postId; // Bidder must be self
        // No update/delete for bids for simplicity, or add owner/bidder based logic
      }
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.status == 'pending';
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // User must be part of connection
                       // Allow if accepting (recipient is auth.uid, requester is not)
                       (request.resource.data.status == 'connected' && resource.data.status == 'pending' && resource.data.requesterId != request.auth.uid) ||
                       // Allow if blocking (either user can block)
                       (request.resource.data.status == 'blocked');
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Allow connected users to remove or requester to cancel
    }

    // Notifications Collection
    match /notifications/{notificationId} {
        allow read, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated(); // Creation might be done by server/functions or specific client actions
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) &&
                         request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // User can delete their own notifications
    }

    // userPreferences Collection
    match /userPreferences/{userId} {
        allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
      // RULES FOR NEWS ARTICLES
      // IMPORTANT: These rules assume corresponding Firestore indexes are in place:
      // 1. newsArticles(userId ASC, updatedAt DESC)
      // 2. newsArticles(userId ASC, status ASC, updatedAt DESC)
      // 3. newsArticles(status ASC, publishedAt DESC)

      allow list: if isAuthenticated() && (
                    // Case 1.1: User fetching their own articles (any status), ordered by updatedAt
                    // Client Query: where('userId', '==', auth.uid), orderBy('updatedAt', 'desc'), limit(X)
                    (
                      request.query.filters.size() == 1 &&
                      request.query.filters[0][0] == 'userId' &&
                      request.query.filters[0][2] == request.auth.uid &&
                      request.query.orderBy.path == path(['updatedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    ) ||
                    // Case 1.2: User fetching their own articles with a specific status, ordered by updatedAt
                    // Client Query: where('userId', '==', auth.uid), where('status', '==', 'draft'/'published'), orderBy('updatedAt', 'desc'), limit(X)
                    (
                      request.query.filters.size() == 2 &&
                      ((request.query.filters[0][0] == 'userId' && request.query.filters[0][2] == request.auth.uid && request.query.filters[1][0] == 'status') ||
                       (request.query.filters[1][0] == 'userId' && request.query.filters[1][2] == request.auth.uid && request.query.filters[0][0] == 'status')) &&
                      request.query.orderBy.path == path(['updatedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    ) ||
                    // Case 2: Any authenticated user fetching published articles, ordered by publishedAt
                    // Client Query: where('status', '==', 'published'), orderBy('publishedAt', 'desc'), limit(X)
                    (
                      request.query.filters.size() == 1 &&
                      request.query.filters[0][0] == 'status' &&
                      request.query.filters[0][2] == 'published' &&
                      request.query.orderBy.path == path(['publishedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    )
                  );

      allow get, read: if isAuthenticated() && (
                           resource.data.status == 'published' ||
                           resource.data.userId == request.auth.uid
                         );

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       // Check for existence of all expected fields and correct number of fields
                       request.resource.data.keys().hasAll(['userId', 'title', 'category', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'commentCount', 'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry']) &&
                       request.resource.data.size() == 24 && // Number of fields in NewsArticle + timestamps
                       // Timestamps must be server timestamps
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // publishedAt logic
                       (request.resource.data.status == 'published' ? request.resource.data.publishedAt == request.time : request.resource.data.publishedAt == null) &&
                       // Default values for counters
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.ratingScore == 0 &&
                       // Logic for help_request specific fields
                       (request.resource.data.requestType == 'help_request' ? (request.resource.data.maxBudget == null || request.resource.data.maxBudget >= 0) : request.resource.data.maxBudget == null) &&
                       (request.resource.data.requestType == 'help_request' ? (request.resource.data.deadline == null || request.resource.data.deadline > request.time) : request.resource.data.deadline == null);


      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid && // Original owner must be current user
                       request.resource.data.userId == resource.data.userId && // userId cannot be changed
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot be changed
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       // publishedAt logic for updates
                       (request.resource.data.status == 'published' && resource.data.status != 'published' ? request.resource.data.publishedAt == request.time : true ) && // Set publishedAt if transitioning to published
                       (request.resource.data.status == 'published' && resource.data.status == 'published' ? request.resource.data.publishedAt == resource.data.publishedAt : true) && // Keep publishedAt if already published and status is still published
                       (request.resource.data.status != 'published' ? request.resource.data.publishedAt == null : true) && // Nullify publishedAt if status is not published
                       // Only allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'content', 'status', 'coverImageUrl', 'updatedAt', 'publishedAt']);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Plans Collection
    match /plans/{planId} {
      function isPlanOwner() { return request.auth.uid == resource.data.ownerId; }
      function isPlanEditor() { return isPlanOwner() || request.auth.uid in resource.data.editUserIds; }
      function canViewPlan() {
        return resource.data.visibility == 'public' ||
               (resource.data.visibility == 'unlisted' && isAuthenticated()) ||
               (resource.data.visibility == 'private' && (isPlanOwner() || request.auth.uid in resource.data.viewUserIds));
      }
      allow read: if isAuthenticated() && canViewPlan();
      allow list: if isAuthenticated() &&
                      ( (request.query.filters.size() > 0 && request.query.filters[0][0] == 'visibility' && request.query.filters[0][2] in ['public', 'unlisted']) ||
                        (request.query.filters.size() > 0 && request.query.filters[0][0] == 'ownerId' && request.query.filters[0][2] == request.auth.uid)
                      );
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.version == 1 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['name', 'ownerId', 'sector', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'description', 'subSector', 'industry']) &&
                       request.resource.data.size() == 15 &&
                       (request.resource.data.visibility == 'public' ? request.resource.data.viewUserIds.size() == 0 : request.resource.data.viewUserIds.hasAny([request.auth.uid])) &&
                       (request.resource.data.editability == 'everyone' ? request.resource.data.editUserIds.size() == 0 : request.resource.data.editUserIds.hasAny([request.auth.uid]));
      allow update: if isAuthenticated() &&
                      ( resource.data.ownerId == request.auth.uid ||
                        (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
                        (resource.data.editability == 'everyone' &&
                           (resource.data.visibility == 'public' || (resource.data.visibility == 'unlisted' && isAuthenticated()) || (resource.data.visibility == 'private' && request.auth.uid in resource.data.viewUserIds))
                        )
                      ) &&
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time &&
                      (request.resource.data.roadmap != resource.data.roadmap ? request.resource.data.version == resource.data.version + 1 : request.resource.data.version == resource.data.version) &&
                      ( resource.data.ownerId == request.auth.uid ?
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt', 'version']) :
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'updatedAt', 'version'])
                      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      match /versions/{versionId} {
        allow read, list: if isAuthenticated() && parent.data.ownerId == request.auth.uid;
        allow create: if isAuthenticated() &&
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                         request.resource.data.size() == 5;
        allow update, delete: if false;
      }
    }

    // Collections (User's private post collections)
    match /collections/{collectionId} {
      function isCollectionOwner() { return request.auth.uid == resource.data.ownerId; }
      function isSharedWithUser() { return request.auth.uid in resource.data.sharedWithUserIds; }
      allow read, get: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      allow list: if isAuthenticated() &&
                     ( (request.query.filters.size() == 1 && request.query.filters[0][0] == 'ownerId' && request.query.filters[0][2] == request.auth.uid) ||
                       (request.query.filters.size() == 1 && request.query.filters[0][0] == 'sharedWithUserIds' && request.query.filters[0][1] == 'array-contains' && request.query.filters[0][2] == request.auth.uid)
                     );
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.name != null && request.resource.data.name != "" &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.postIds is list &&
                       request.resource.data.sharedWithUserIds is list &&
                       request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                       request.resource.data.size() == 7;
      allow update: if isAuthenticated() &&
                       isCollectionOwner() &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
      allow delete: if isAuthenticated() && isCollectionOwner();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow list: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.targetUserId != request.auth.uid &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated() &&
                       resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid;
    }
  }
}

    