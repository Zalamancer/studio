rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default: Deny all reads and writes
    // match /{document=**} {
    //   allow read, write: if false;
    // }

    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read: if request.auth != null; // Any authenticated user can read basic profiles
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
                       // Protect sensitive fields from being changed by client after creation
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.companyName == resource.data.companyName && // Assuming companyName set at signup
                       request.resource.data.mentionName == resource.data.mentionName &&
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.isBotAccount == resource.data.isBotAccount &&
                       // Ensure only allowed fields are updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'tags', 'established',
                         'lastLoginAt', 'updatedAt', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'incomeRange'
                       ]) &&
                       request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId; // Or disallow completely
    }

    // Allow users to read/write posts according to their role/permissions
    match /posts/{postId} {
      allow read: if true; // Or request.auth != null; for authenticated reads
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId &&
                       // Validate required fields
                       request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 200 &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() >= 10 &&
                       request.resource.data.tags is list && request.resource.data.tags.size() >= 1 &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (request.resource.data.maxBudget == null || request.resource.data.maxBudget is number && request.resource.data.maxBudget >= 0) &&
                       (request.resource.data.deadline == null || request.resource.data.deadline is timestamp) &&
                       request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.createdAt == request.time &&
                       // All other fields should be checked too, e.g., ratingScore, imageUrls, mentionedUserIds
                       request.resource.data.ratingScore is number &&
                       request.resource.data.imageUrls is list &&
                       request.resource.data.mentionedUserIds is list &&
                       // Strict field check
                       request.resource.data.keys().hasAll([
                           'userId', 'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                           'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                           'maxBudget', 'deadline', 'requestType', 'ratingScore',
                           'imageUrls', 'mentionedUserIds', 'createdAt', 'commentCount'
                       ]) && request.resource.data.size() == 18;


      allow update: if request.auth != null &&
                       // Only allow updating commentCount and updatedAt for now by general users (e.g., via backend function)
                       // Owner can update more if needed via separate rules or more specific functions
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                       request.resource.data.commentCount >= 0 && // Ensure commentCount doesn't go negative
                       request.resource.data.updatedAt == request.time;
                       // Add more specific update rules if users can edit their own posts. E.g.:
                       // allow update: if request.auth != null && request.auth.uid == resource.data.userId && ... (check modifiable fields) ...

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Or request.auth != null;
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.userId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list; // Check other required fields
        allow update: if request.auth != null &&
                         // Allow users to update their own comments (text, updatedAt)
                         (request.auth.uid == resource.data.userId &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) &&
                          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                          request.resource.data.updatedAt == request.time) ||
                         // Allow liking/unliking
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                          request.resource.data.updatedAt == request.time &&
                          (
                            (request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) || // Adding a like
                            (!request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1) // Removing a like
                          )
                         );

        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

        // SubComments subcollection
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if request.auth != null &&
                           request.auth.uid == request.resource.data.userId &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list;
          allow update: if request.auth != null &&
                           (request.auth.uid == resource.data.userId &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) &&
                            request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                            request.resource.data.updatedAt == request.time) ||
                           // Allow liking/unliking subcomments
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                            request.resource.data.updatedAt == request.time &&
                            (
                                (request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) ||
                                (!request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1)
                            )
                           );
          allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
      // Bids subcollection
      match /bids/{bidId} {
        allow read: if request.auth != null; // Authenticated users can read bids on a post
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.bidderId &&
                         request.resource.data.postId is string &&
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                         (request.resource.data.bidMessage == null || request.resource.data.bidMessage is string) &&
                         request.resource.data.timestamp == request.time;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.bidderId; // Bidder can update/delete their own bid
      }
    }

    match /mutuals/{connectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.requesterId &&
                       request.auth.uid in request.resource.data.userIds &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                       request.resource.data.size() == 5 && // Ensure no extra fields
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.userIds && // User must be part of the connection
                       // Accepting a request
                       (request.resource.data.status == 'connected' &&
                        resource.data.status == 'pending' &&
                        request.auth.uid != resource.data.requesterId && // Accepter is not the original requester
                        request.resource.data.connectedAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']))
                       // Potentially other update scenarios like blocking, if added later
                       ;
      allow delete: if request.auth != null && request.auth.uid in resource.data.userIds; // Users can cancel/reject/remove
    }

    match /conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid in resource.data.participants;
        allow create: if request.auth != null &&
                         request.auth.uid in request.resource.data.participants &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Direct Chat Specific Rules
                         ((request.resource.data.type == 'direct' &&
                           request.resource.data.participants.size() == 2 &&
                           (request.resource.data.postId == null || request.resource.data.postId is string) &&
                           request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                           request.resource.data.size() == 11 && // Ensure no extra fields for direct chat
                           request.resource.data.groupName == null &&
                           request.resource.data.groupAvatarUrl == null &&
                           request.resource.data.ownerId == null &&
                           request.resource.data.adminIds is list && request.resource.data.adminIds.size() == 0
                         ) ||
                         // Group Chat Specific Rules
                         (request.resource.data.type == 'group' &&
                           request.resource.data.participants.size() >= 2 && // Group must have at least 2 participants
                           request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                           (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                           request.resource.data.ownerId == request.auth.uid && // Creator is owner
                           request.resource.data.adminIds is list && request.resource.data.adminIds.hasAny([request.auth.uid]) && // Creator is admin
                           request.resource.data.postId == null && // postId must be null for groups
                           request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                           request.resource.data.size() == 11 // Ensure no extra fields for group chat
                         ));


        allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
                         request.resource.data.updatedAt == request.time &&
                         // Updating last message details (by participant)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'lastMessageSenderId', 'updatedAt']) ||
                         // Updating group details (only by admin, owner is also an admin)
                          (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds &&
                           request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt'])
                          ) ||
                         // Adding/removing members or admins (only by admin for add/remove, only owner for admin changes)
                          (resource.data.type == 'group' &&
                            (
                                (request.auth.uid in resource.data.adminIds && request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'updatedAt'])) || // Admins can add/remove participants
                                (resource.data.ownerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'ownerId', 'updatedAt'])) // Owner can change admins/owner
                            ) &&
                            request.resource.data.participants.size() >= 1 // Must have at least one participant (the owner if all others leave/are removed)
                          ) ||
                         // Leaving a group (removing self from participants and potentially admins)
                          (resource.data.type == 'group' &&
                           request.resource.data.participants.size() == resource.data.participants.size() - 1 && // One user removed
                           !request.resource.data.participants.hasAny([request.auth.uid]) && // The authenticated user is the one removed
                           resource.data.participants.hasAny([request.auth.uid]) && // User was a participant before
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'ownerId']) && // AdminIds and ownerId might change if owner leaves
                            // If owner leaves and is last admin, next rule or client logic handles new owner/admin.
                            // This rule just ensures the operation itself is valid.
                            (request.resource.data.participants.size() >= 1 || request.resource.data.ownerId == null) // Allow last participant (owner) to leave if group is to be auto-deleted by that logic
                          )
                         );

        match /messages/{messageId} {
            allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
            allow create: if request.auth != null &&
                             request.auth.uid == request.resource.data.senderId &&
                             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                             request.resource.data.conversationId == conversationId &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             (request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                             (request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                             request.resource.data.isBotMessage is bool &&
                             request.resource.data.read == false;
            allow update, delete: if false; // Messages are generally immutable
        }
    }

    match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && // Authenticated user (sender or system)
                         request.resource.data.userId is string && // Recipient exists
                         request.resource.data.senderId is string && // Sender exists
                         request.resource.data.type is string &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.isRead == false;
        allow update: if request.auth != null && request.auth.uid == resource.data.userId && // Only recipient can update
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']); // Only isRead can be updated
        allow delete: if false; // Notifications generally not deleted by users
    }

    match /userPreferences/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId &&
                         request.resource.data.userId == userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Ensure all boolean notification preferences are booleans or null
                         (request.resource.data.notifyOnReply == null || request.resource.data.notifyOnReply is bool) &&
                         (request.resource.data.notifyOnMention == null || request.resource.data.notifyOnMention is bool) &&
                         (request.resource.data.notifyOnNewConnectionRequest == null || request.resource.data.notifyOnNewConnectionRequest is bool) &&
                         (request.resource.data.notifyOnConnectionAccepted == null || request.resource.data.notifyOnConnectionAccepted is bool) &&
                         (request.resource.data.notifyOnNewMessage == null || request.resource.data.notifyOnNewMessage is bool) &&
                         (request.resource.data.notifyOnPlatformUpdates == null || request.resource.data.notifyOnPlatformUpdates is bool) &&
                         // Stripe fields are optional or null
                         (request.resource.data.stripeCustomerId == null || request.resource.data.stripeCustomerId is string) &&
                         (request.resource.data.stripeSubscriptionId == null || request.resource.data.stripeSubscriptionId is string) &&
                         (request.resource.data.activeStripePriceId == null || request.resource.data.activeStripePriceId is string) &&
                         (request.resource.data.stripeSubscriptionStatus == null || request.resource.data.stripeSubscriptionStatus is string) &&
                         (request.resource.data.stripeSubscriptionCurrentPeriodEnd == null || request.resource.data.stripeSubscriptionCurrentPeriodEnd is number) &&
                         (request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd == null || request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd is bool) &&
                         request.resource.data.paymentMethods is list; // Ensure paymentMethods is a list

        allow update: if request.auth != null && request.auth.uid == userId &&
                         request.resource.data.userId == userId && // Cannot change userId
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                         request.resource.data.updatedAt == request.time &&
                         // Allow only specific fields to be updated
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                            'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                            'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd',
                            'stripeSubscriptionWillCancelAtPeriodEnd', 'paymentMethods', 'updatedAt'
                         ]) &&
                         (request.resource.data.notifyOnReply == null || request.resource.data.notifyOnReply is bool) &&
                         (request.resource.data.notifyOnMention == null || request.resource.data.notifyOnMention is bool) &&
                         (request.resource.data.notifyOnNewConnectionRequest == null || request.resource.data.notifyOnNewConnectionRequest is bool) &&
                         (request.resource.data.notifyOnConnectionAccepted == null || request.resource.data.notifyOnConnectionAccepted is bool) &&
                         (request.resource.data.notifyOnNewMessage == null || request.resource.data.notifyOnNewMessage is bool) &&
                         (request.resource.data.notifyOnPlatformUpdates == null || request.resource.data.notifyOnPlatformUpdates is bool) &&
                         (request.resource.data.stripeCustomerId == null || request.resource.data.stripeCustomerId is string) &&
                         (request.resource.data.stripeSubscriptionId == null || request.resource.data.stripeSubscriptionId is string) &&
                         (request.resource.data.activeStripePriceId == null || request.resource.data.activeStripePriceId is string) &&
                         (request.resource.data.stripeSubscriptionStatus == null || request.resource.data.stripeSubscriptionStatus is string) &&
                         (request.resource.data.stripeSubscriptionCurrentPeriodEnd == null || request.resource.data.stripeSubscriptionCurrentPeriodEnd is number) &&
                         (request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd == null || request.resource.data.stripeSubscriptionWillCancelAtPeriodEnd is bool) &&
                         request.resource.data.paymentMethods is list;
    }

    match /collections/{collectionId} {
        allow read: if request.auth != null && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.sharedWithUserIds);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.ownerId &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         (request.resource.data.description == null || request.resource.data.description is string) &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['name', 'ownerId', 'description', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                         request.resource.data.size() == 7; // Ensure only expected fields

        allow update: if request.auth != null &&
                         request.auth.uid == resource.data.ownerId && // Only owner can update
                         request.resource.data.ownerId == resource.data.ownerId && // Cannot change owner
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                         request.resource.data.updatedAt == request.time && // updatedAt must be server time
                         // Allow only name, description, postIds, sharedWithUserIds to be changed
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']) &&
                         // Validate types of fields being updated
                         (request.resource.data.name is string && request.resource.data.name.size() > 0) &&
                         (request.resource.data.description == null || request.resource.data.description is string) &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list;

        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId; // Only owner can delete
    }

    match /plans/{planId} {
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['name', 'ownerId', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap']) &&
                       request.resource.data.size() == 10;

      allow list, get: if request.auth != null;

      allow update: if request.auth != null &&
                       // Immutable fields must match existing values
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       // Other fields not being changed by *this specific roadmap update operation* must also match if sent
                       // If a field is NOT in request.resource.data, this part of condition is true
                       (!('name' in request.resource.data) || request.resource.data.name == resource.data.name) &&
                       (!('sector' in request.resource.data) || request.resource.data.sector == resource.data.sector) &&
                       (!('subSector' in request.resource.data) || request.resource.data.subSector == resource.data.subSector) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == resource.data.industry) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == resource.data.naicsCode) &&
                       // Actual changed fields must be from this set:
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'updatedAt', 'version']) &&
                       // Validate server timestamp for updatedAt
                       request.resource.data.updatedAt == request.time;
                       // The check for version increment (e.g., request.resource.data.version == resource.data.version + 1)
                       // was removed because FieldValue.increment(1) makes request.resource.data.version a special object,
                       // not a number that can be directly compared in rules.
                       // We trust the client sends increment(1) and the hasOnly() check allows 'version' to be modified.

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /versions/{versionId} {
        allow create: if request.auth != null &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.planId == planId &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['planId', 'editorUid', 'roadmap', 'versionNumber', 'timestamp']) &&
                         request.resource.data.size() == 5;
        allow list, get: if request.auth != null;
        allow update, delete: if false;
      }
    }
  }
}

    