
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts and their comments
    match /posts/{postId} {
      allow read, write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Only the user who created the comment can update or delete it
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      allow get, list: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if request.auth != null
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if request.auth != null
                    && resource.data.participants.hasAll([request.auth.uid])
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // Ensuring this is consistently false for safety
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      allow read: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences (for favorite sectors)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (for shared whiteboards per NAICS code)
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsCode;
    }

    // Notifications
    match /notifications/{notificationId} {
      // Allow a user to read notifications intended for them
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow any authenticated user to create a notification
      // (senderId will be set by the app, userId is the recipient)
      allow create: if request.auth != null;
      // Allow a user to update (e.g., mark as read) their own notifications
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      // Typically, users don't delete notifications directly, but you can allow it if needed:
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Or if false;
    }

    // Fallback rule: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
