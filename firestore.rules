
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if a string is not empty
    function isNotEmpty(value) {
      return value is string && value.size() > 0;
    }

    // Helper function to check if user is owner of a generic document
    function isDocumentOwner(docName) {
      return isAuthenticated() && request.auth.uid == resource.data[docName];
    }


    // --- User Profiles Collection ---
    match /users/{userId} {
      allow read: if true; // Public profiles typically readable

      allow create: if isAuthenticated() &&
                     request.auth.uid == userId && // User can only create their own profile
                     request.resource.data.uid == userId &&
                     isNotEmpty(request.resource.data.mentionName) &&
                     isNotEmpty(request.resource.data.mentionNameLowercase) &&
                     request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower() &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.lastLoginAt == request.time &&
                     // Check all expected fields are present and no unexpected ones
                     request.resource.data.keys().hasAll([
                       'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                       'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName',
                       'subSectorName', 'industryName', 'naicsCode', 'tags', 'established',
                       'verified', 'isBotAccount', 'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt'
                     ]) &&
                     request.resource.data.size() == 22;


      allow update: if isAuthenticated() &&
                       request.auth.uid == userId && // User can only update their own profile
                       request.resource.data.uid == resource.data.uid && // Cannot change UID
                       request.resource.data.email == resource.data.email && // Cannot change email via this
                       request.resource.data.companyName == resource.data.companyName && // Cannot change companyName via this (set at signup)
                       request.resource.data.mentionName == resource.data.mentionName && // Cannot change mentionName
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // Cannot change mentionNameLowercase
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       // Only allow specific fields to be updated by the user directly
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established', 'incomeRange',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode', // Added NAICS fields
                         'lastLoginAt', 'updatedAt' // Allow lastLoginAt to be updated by system/client on login
                       ]);

      allow delete: if isAuthenticated() && request.auth.uid == userId; // User can delete their own profile
    }

    // --- User Preferences Collection ---
    match /userPreferences/{userId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
        // Simplified: users can read/write their own preferences document.
        // For write (create/update):
        // - Ensure userId field in document matches auth.uid
        // - Ensure createdAt is server time on create
        // - Ensure updatedAt is server time on update
        // - Validate data types for preference fields
        allow create: if isAuthenticated() &&
                         request.auth.uid == userId &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Add checks for all fields to ensure correct types and presence/absence
                         request.resource.data.keys().hasAll([
                            'userId', 'paymentMethods', 'notifyOnReply', 'notifyOnMention',
                            'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted', 'notifyOnNewMessage',
                            'notifyOnPlatformUpdates', 'stripeCustomerId', 'stripeSubscriptionId',
                            'activeStripePriceId', 'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd',
                            'stripeSubscriptionWillCancelAtPeriodEnd', 'createdAt', 'updatedAt'
                         ]) && request.resource.data.size() == 16 && // favoriteSectorCodes removed, count decreases
                         request.resource.data.paymentMethods is list;


        allow update: if isAuthenticated() &&
                         request.auth.uid == userId &&
                         request.resource.data.userId == resource.data.userId && // Cannot change userId
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                         request.resource.data.updatedAt == request.time &&
                         // Ensure only allowed fields are being modified
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'paymentMethods', 'notifyOnReply', 'notifyOnMention',
                            'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted', 'notifyOnNewMessage',
                            'notifyOnPlatformUpdates', 'stripeCustomerId', 'stripeSubscriptionId',
                            'activeStripePriceId', 'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd',
                            'stripeSubscriptionWillCancelAtPeriodEnd', 'updatedAt' // favoriteSectorCodes removed
                         ]);
    }


    // --- Mutual Connections Collection ---
    match /mutuals/{connectionId} {
      function isParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.userIds;
      }
      function isRequester() {
        return isAuthenticated() && request.auth.uid == resource.data.requesterId;
      }
      function isRecipient() {
        return isAuthenticated() && request.auth.uid != resource.data.requesterId && request.auth.uid in resource.data.userIds;
      }

      allow read: if isParticipant();

      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid && // Requester must be current user
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // UserIds must contain current user
                       request.resource.data.userIds.size() == 2 && // Must be between 2 users
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time && // requestedAt must be server time
                       request.resource.data.updatedAt == request.time &&   // updatedAt must be server time
                       // Ensure all expected fields and no extras for a new request
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                       request.resource.data.size() == 5;


      allow update: if isAuthenticated() &&
                       isRecipient() && // Only recipient can update (to accept)
                       resource.data.status == 'pending' && // Can only update pending requests
                       request.resource.data.status == 'connected' && // Update must be to 'connected'
                       request.resource.data.connectedAt == request.time && // connectedAt must be server time
                       request.resource.data.updatedAt == request.time &&   // updatedAt must be server time
                       // Ensure immutable fields are not changed
                       request.resource.data.userIds == resource.data.userIds &&
                       request.resource.data.requesterId == resource.data.requesterId &&
                       request.resource.data.requestedAt == resource.data.requestedAt &&
                       // Ensure only status, connectedAt, updatedAt are being modified
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']);

      allow delete: if isParticipant() && (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    // --- Main Posts Collection ---
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow list: if true; // Allow querying posts for the board

      // Only authenticated users can create posts
      // Creator must be the authenticated user
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isNotEmpty(request.resource.data.question) &&
                       request.resource.data.question.size() <= 200 &&
                       request.resource.data.descriptionDetails is string &&
                       request.resource.data.requestType in ['post', 'help_request'] &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.imageUrls is list &&
                       request.resource.data.mentionedUserIds is list &&
                       // Ensure all required fields and no extras
                       request.resource.data.keys().hasAll([
                         'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'ratingScore',
                         'createdAt', 'imageUrls', 'mentionedUserIds', 'requestType', 'commentCount',
                         'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline'
                       ]) &&
                       request.resource.data.size() == 18; // Adjust size based on current fields


      // Only the owner of the post can delete it
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        allow read: if true; // Comments are public
        allow list: if true; // Allow listing comments

        // Only authenticated users can create comments
        // Creator must be the authenticated user
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         isNotEmpty(request.resource.data.text) &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.isShadowBanned == false &&
                         // Ensure all required fields and no extras for a new comment
                         request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                         request.resource.data.size() == 9;

        // Liking/Unliking comments:
        // - Must be authenticated.
        // - Cannot change immutable fields (userId, text, timestamp).
        // - Only 'likedBy', 'likeCount', 'updatedAt' can be affected.
        // - likeCount must change by exactly 1 (up or down).
        // - likedBy array must correctly reflect the addition or removal of auth.uid.
        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.mentionName == resource.data.mentionName &&
                         request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                         request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                           ( // Liking
                             request.resource.data.likeCount == resource.data.likeCount + 1 &&
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                             request.auth.uid in request.resource.data.likedBy &&
                             !(request.auth.uid in resource.data.likedBy)
                           ) ||
                           ( // Unliking
                             request.resource.data.likeCount == resource.data.likeCount - 1 &&
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                             !(request.auth.uid in request.resource.data.likedBy) &&
                             request.auth.uid in resource.data.likedBy
                           )
                         );

        // Only the owner of the comment can delete it
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        // --- SubComments (Replies to Comments) Subcollection ---
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow list: if true;

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             isNotEmpty(request.resource.data.text) &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9; // If mentionName is added here, size should be 9


            allow update: if isAuthenticated() && // Similar to comment update for likes
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName &&
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (
                               ( // Liking
                                 request.resource.data.likeCount == resource.data.likeCount + 1 &&
                                 request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                                 request.auth.uid in request.resource.data.likedBy &&
                                 !(request.auth.uid in resource.data.likedBy)
                               ) ||
                               ( // Unliking
                                 request.resource.data.likeCount == resource.data.likeCount - 1 &&
                                 request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                                 !(request.auth.uid in resource.data.likedBy) &&
                                 request.auth.uid in resource.data.likedBy
                               )
                             );

            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }

      // --- Bids Subcollection (under posts) ---
      match /bids/{bidId} {
        allow read: if true; // Bids could be public or restricted
        allow list: if true; // Assuming bids on a post are queryable

        allow create: if isAuthenticated() &&
                         request.resource.data.bidderId == request.auth.uid && // Bidder must be current user
                         request.resource.data.postId == postId && // Bid must be for this post
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                         request.resource.data.timestamp == request.time &&
                         // Ensure all required fields and no extras for a new bid
                         request.resource.data.keys().hasAll(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                         request.resource.data.size() == 5;
                         // Note: `bidMessage` can be optional (e.g., string or null)

        // Updates to bids are generally not allowed to maintain integrity.
        // If updates were allowed, specific fields and conditions would be needed here.
        allow update: if false;
        // Only the bidder can delete their bid (if deletion is allowed at all)
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.bidderId;
      }
    }

    // --- Conversations Collection ---
    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participants;
      }
      function isCreatorOrAdmin() {
        return isAuthenticated() && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.adminIds);
      }

      allow read: if isParticipant();
      allow list: if isAuthenticated() && request.query.filters.size() == 1 && request.query.filters[0].fieldPath == 'participants' && request.query.filters[0].op == 'array-contains' && request.query.filters[0].value == request.auth.uid;

      allow create: if isAuthenticated() &&
                       // General conditions for any conversation type
                       request.resource.data.participants.hasAny([request.auth.uid]) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       ( // Direct Chat Specific
                         (
                           request.resource.data.type == 'direct' &&
                           request.resource.data.participants.size() == 2 &&
                           request.resource.data.groupName == null &&
                           request.resource.data.groupAvatarUrl == null &&
                           request.resource.data.ownerId == null &&
                           request.resource.data.adminIds is list && request.resource.data.adminIds.size() == 0 &&
                           request.resource.data.keys().hasAll([
                             'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                             'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds'
                           ]) && request.resource.data.size() == 11 // Count fields carefully
                         ) ||
                         // Group Chat Specific
                         (
                           request.resource.data.type == 'group' &&
                           request.resource.data.participants.size() >= 2 &&
                           request.resource.data.ownerId == request.auth.uid && // Creator must be owner
                           request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator must be admin
                           request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                           (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                           request.resource.data.postId == null && // postId is null for new groups
                           request.resource.data.keys().hasAll([
                             'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                             'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds'
                           ]) && request.resource.data.size() == 11 // Count fields carefully
                         )
                       );


      allow update: if isParticipant() &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.createdAt == resource.data.createdAt && // Immutable
                       request.resource.data.type == resource.data.type &&           // Immutable
                       request.resource.data.postId == resource.data.postId &&         // Immutable (for direct chats related to posts)
                       ( // Path 1: Updating last message details by a participant
                         request.resource.data.diff(resource.data).affectedKeys().hasAll(['lastMessage', 'lastMessageTimestamp', 'updatedAt']) &&
                         request.resource.data.diff(resource.data).affectedKeys().size() == 3 &&
                         request.resource.data.lastMessageSenderId == request.auth.uid // Ensure sender is the one updating
                       ) ||
                       ( // Path 2: Group admin updating group details (name, avatar)
                         request.resource.data.type == 'group' &&
                         isCreatorOrAdmin() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot be changed this way
                         request.resource.data.participants == resource.data.participants && // Participants managed by specific actions
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'])
                       ) ||
                       ( // Path 3: Group admin adding/removing members or admins (participants, adminIds)
                         request.resource.data.type == 'group' &&
                         isCreatorOrAdmin() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot be changed this way
                         request.resource.data.groupName == resource.data.groupName &&
                         request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'adminIds', 'updatedAt']) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt'])
                       ) ||
                       ( // Path 4: Group owner transferring ownership
                          request.resource.data.type == 'group' &&
                          request.auth.uid == resource.data.ownerId && // Only current owner can transfer
                          request.resource.data.ownerId != resource.data.ownerId && // OwnerId must change
                          request.resource.data.ownerId in request.resource.data.participants && // New owner must be a participant
                          request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) && // New owner must become an admin
                          request.resource.data.groupName == resource.data.groupName &&
                          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                          request.resource.data.participants == resource.data.participants && // Participants not changed here
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt'])
                       ) ||
                       ( // Path 5: User leaving a group (participants, potentially adminIds, formerParticipants)
                         request.resource.data.type == 'group' &&
                         isParticipant() && // Current user must be a participant
                         !request.resource.data.participants.hasAny([request.auth.uid]) && // User is removed from participants
                         request.resource.data.adminIds.hasOnly(resource.data.adminIds.removed(request.auth.uid)) && // User removed from admin if they were one
                         request.resource.data.ownerId == resource.data.ownerId && // Owner doesn't change here
                         request.resource.data.groupName == resource.data.groupName &&
                         request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                         (request.resource.data.formerParticipants == null || request.resource.data.formerParticipants[request.auth.uid] == request.time) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'adminIds', 'formerParticipants', 'updatedAt'])
                       );


      // --- Messages Subcollection ---
      match /messages/{messageId} {
        allow read: if isParticipant(); // Only participants can read messages in a conversation
        allow list: if isParticipant(); // Only participants can list messages

        allow create: if isAuthenticated() &&
                         request.resource.data.senderId == request.auth.uid && // Sender must be current user
                         request.resource.data.conversationId == conversationId && // Message must belong to this conversation
                         isNotEmpty(request.resource.data.text) &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.read == false &&
                         request.resource.data.isBotMessage == (false || true) && // Allow false or true
                         // Ensure all required fields and no extras
                         request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId']) &&
                         request.resource.data.size() == 8;

        // Messages are typically immutable after creation
        allow update: if false;
        allow delete: if false;
      }
    }

    // --- Article Tags Collection ---
    match /articleTags/{tagId} {
        allow read: if true; // Tags are generally public for searching/displaying
        allow list: if true; // Allow querying tags for suggestions

        allow create: if isAuthenticated() &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount >= 0 && // Can be 0 or 1 on create
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']) &&
                         request.resource.data.size() == 5;

        allow update: if isAuthenticated() && // Allow authenticated users to update usageCount
                         request.resource.data.name == resource.data.name && // Immutable fields
                         request.resource.data.nameLowercase == resource.data.nameLowercase &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']); // Only usageCount can change
        allow delete: if false; // Tags are not typically deleted, usageCount goes to 0
    }

    // --- News Articles Collection ---
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read: if resource.data.status == 'published' || isNewsArticleOwner(); // Published articles or owner reading their draft
        allow list: if true; // Allow querying published articles for the news feed

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.content is string &&
                         request.resource.data.status in ['draft', 'published'] &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Corrected publishedAt logic for create
                         (
                           (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null) ||
                           (request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time)
                         ) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.draftContent == null &&
                         request.resource.data.hasUnpublishedChanges == false &&
                         // Ensure all expected fields are present (14 fields)
                         request.resource.data.keys().hasAll([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount'
                         ]) &&
                         request.resource.data.size() == 14; // Size matches the 14 fields

        allow update: if isAuthenticated() &&
                       request.resource.data.updatedAt == request.time && // Must be part of any update
                       ( // Case 1: Owner updating their article (draft or published)
                         isNewsArticleOwner() &&
                         request.resource.data.userId == resource.data.userId && // Cannot change owner
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                         // Immutable fields for this path (counts/likes handled by other paths)
                         request.resource.data.commentCount == resource.data.commentCount &&
                         request.resource.data.likeCount == resource.data.likeCount &&
                         request.resource.data.likedBy == resource.data.likedBy &&
                         // Only allow specific fields to be updated by owner
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'content', 'tags', 'status', 'coverImageUrl',
                           'draftContent', 'hasUnpublishedChanges', 'publishedAt', 'updatedAt'
                         ]) &&
                         // Corrected publishedAt logic for updates by owner
                         (
                           (request.resource.data.status == 'published' && resource.data.status != 'published' && request.resource.data.publishedAt == request.time) || // Transitioning to published
                           (request.resource.data.status == 'published' && resource.data.status == 'published' && request.resource.data.publishedAt == resource.data.publishedAt) || // Staying published, not changing publishedAt (e.g. content update)
                           (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null) // Transitioning to draft or staying draft
                         )
                       ) ||
                       ( // Case 2: Any authenticated user liking/unliking (but not the author)
                         request.auth.uid != resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                           ( // Liking
                             request.resource.data.likeCount == resource.data.likeCount + 1 &&
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                             request.auth.uid in request.resource.data.likedBy &&
                             !(request.auth.uid in resource.data.likedBy)
                           ) ||
                           ( // Unliking
                             request.resource.data.likeCount == resource.data.likeCount - 1 &&
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                             !(request.auth.uid in request.resource.data.likedBy) &&
                             request.auth.uid in resource.data.likedBy
                           )
                         )
                       ) ||
                       ( // Case 3: System (or trusted function) updating commentCount
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                         (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1)
                       );

        allow delete: if isNewsArticleOwner();

        // --- News Comments Subcollection (for 'newsArticles') ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true; // Simplified, client filters shadow-banned
            allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleCommentOwner();

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             isNotEmpty(request.resource.data.text) &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             // Allow 'mentionName' to be present
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9; // size is 9 because mentionName is included

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             // Ensure other fields are immutable for this case
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName && // Keep mentionName immutable
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (
                               (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy)) || // Liking
                               (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && !(request.auth.uid in request.resource.data.likedBy) && request.auth.uid in resource.data.likedBy)    // Unliking
                             )
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                             // Ensure other fields are immutable for this case
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName && // Keep mentionName immutable
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.likeCount == resource.data.likeCount &&
                             request.resource.data.likedBy == resource.data.likedBy
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true;
                allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleSubCommentOwner();

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               isNotEmpty(request.resource.data.text) &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.isShadowBanned == false &&
                               // Allow 'mentionName' if it's part of your subCommentData structure (it should be for consistency)
                               request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                               request.resource.data.size() == 9; // Assuming mentionName is included

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.mentionName == resource.data.mentionName && // Keep mentionName immutable
                                 request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                 request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (
                                   (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy)) || // Liking
                                   (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && !(request.auth.uid in resource.data.likedBy) && request.auth.uid in resource.data.likedBy)    // Unliking
                                 )
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.mentionName == resource.data.mentionName && // Keep mentionName immutable
                                 request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                 request.resource.data.likeCount == resource.data.likeCount &&
                                 request.resource.data.likedBy == resource.data.likedBy
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }

    // --- Collaboration Plans Collection ---
    match /plans/{planId} {
      function isPlanOwner() {
        return isAuthenticated() && request.auth.uid == resource.data.ownerId;
      }

      function canViewPlan(planDoc) { // planDoc is resource.data
        return (planDoc.visibility == 'public') ||
               (planDoc.visibility == 'unlisted' && isAuthenticated() && (request.auth.uid == planDoc.ownerId || request.auth.uid in planDoc.viewUserIds)) ||
               (planDoc.visibility == 'private' && isAuthenticated() && request.auth.uid == planDoc.ownerId);
      }

      function canEditPlan(planDoc) { // planDoc is resource.data
        return isAuthenticated() && (
          (request.auth.uid == planDoc.ownerId) ||
          (planDoc.editability == 'collaborators' && request.auth.uid in planDoc.editUserIds && canViewPlan(planDoc)) || // Collaborators must also be able to view
          (planDoc.editability == 'everyone' && canViewPlan(planDoc)) // Anyone who can view can edit if 'everyone'
        );
      }

      allow read: if canViewPlan(resource.data);
      allow list: if isAuthenticated(); // For Discover page, client will filter based on visibility

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       isNotEmpty(request.resource.data.name) &&
                       isNotEmpty(request.resource.data.sector) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list &&
                       request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                       request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                       request.resource.data.viewUserIds is list &&
                       request.resource.data.editUserIds is list &&
                       // Ensure owner is in viewUserIds if not public, and in editUserIds if 'owner_only' or 'collaborators'
                       (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAll([request.auth.uid])) &&
                       (request.resource.data.editability == 'everyone' || request.resource.data.editUserIds.hasAll([request.auth.uid])) &&
                       // No 'everyone' editability for unlisted/private plans
                       !((request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'private') && request.resource.data.editability == 'everyone') &&
                       // Private plans must be owner_only editable
                       !(request.resource.data.visibility == 'private' && request.resource.data.editability != 'owner_only') &&
                       // Check all expected fields
                       request.resource.data.keys().hasAll([
                         'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                         'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability',
                         'viewUserIds', 'editUserIds'
                       ]) &&
                       request.resource.data.size() == 15;

      allow update: if canEditPlan(resource.data) &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.ownerId == resource.data.ownerId && // Owner immutable
                       request.resource.data.createdAt == resource.data.createdAt && // CreatedAt immutable
                       ( // E1: Roadmap update path (user can edit plan, version increments)
                         request.resource.data.version == resource.data.version + 1 &&
                         request.resource.data.keys().has('roadmap') &&
                         request.resource.data.keys().hasOnly(['roadmap', 'version', 'updatedAt'])
                       ) ||
                       ( // E2: Settings update path (owner only, version doesn't change here)
                         isPlanOwner() &&
                         request.resource.data.version == resource.data.version && // Version doesn't change for settings
                         // Validate visibility and editability consistency
                         !((request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'private') && request.resource.data.editability == 'everyone') &&
                         !(request.resource.data.visibility == 'private' && request.resource.data.editability != 'owner_only') &&
                         // Ensure viewUserIds and editUserIds are consistent with visibility/editability
                         (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAll([request.auth.uid])) &&
                         (request.resource.data.editability == 'everyone' || request.resource.data.editUserIds.hasAll([request.auth.uid])) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                           'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                         ])
                       );

      allow delete: if isPlanOwner();

      // Subcollection for plan versions
      match /versions/{versionId} {
        allow read: if canViewPlan(get(/databases/$(database)/documents/plans/$(planId)).data); // If can view parent plan
        allow list: if canViewPlan(get(/databases/$(database)/documents/plans/$(planId)).data);

        // Create is handled by backend logic when plan is updated
        allow create: if canEditPlan(get(/databases/$(database)/documents/plans/$(planId)).data) && // Must be able to edit parent to create version
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                         request.resource.data.size() == 5;

        allow update, delete: if false; // Versions are immutable
      }
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public

      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid && // Reviewer is current user
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure all required fields and no extras
                       request.resource.data.keys().hasAll([
                         'targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar',
                         'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt'
                       ]) &&
                       request.resource.data.size() == 9;

      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       request.resource.data.targetUserId == resource.data.targetUserId && // Cannot change who is reviewed
                       request.resource.data.reviewerId == resource.data.reviewerId &&   // Cannot change reviewer
                       request.resource.data.reviewerName == resource.data.reviewerName &&
                       request.resource.data.reviewerAvatar == resource.data.reviewerAvatar &&
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && // Historical avg is immutable
                       request.resource.data.updatedAt == request.time &&
                       // Only rating and comment can be changed
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

  }
}
