
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isOwner(resource.data.userId);
    }
    
    function isCollectionOwner() { // For collections
      return isOwner(resource.data.ownerId);
    }

    function isNotEmpty(value) {
      return value != null && value.size() > 0;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true; // Public profiles generally readable
      allow create: if isOwner(userId) && 
                       request.resource.data.uid == userId &&
                       request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt', 'companyName', 'industry', 'avatarUrl', 'descriptionVisibility', 'isBotAccount']) &&
                       request.resource.data.size() == 12 && // Adjust if more/less fields on create
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(userId) &&
                       request.resource.data.uid == resource.data.uid && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email cannot change
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // Must update timestamp
                       // Allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 
                         'established', 'incomeRange', 
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode', 
                         'updatedAt', 'lastLoginAt', 'tags' // Add tags if it becomes updatable
                       ]);
      allow delete: if false; // Typically users cannot delete their own profiles directly
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds[0] < request.resource.data.userIds[1] && // Enforce sorted order
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']);


      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // User part of existing connection
                       request.resource.data.userIds == resource.data.userIds && // Cannot change participants
                       request.resource.data.requesterId == resource.data.requesterId && // Cannot change requester
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.updatedAt == request.time && // Must update timestamp
                       (
                         // Accepting a request
                         (resource.data.status == 'pending' && request.resource.data.status == 'connected' && request.auth.uid != resource.data.requesterId && request.resource.data.connectedAt == request.time) ||
                         // Blocking (simplified, needs more robust logic for who can block whom)
                         (request.resource.data.status == 'blocked' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected' || resource.data.status == 'blocked');
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
      allow list: if isAuthenticated() && (
                    (
                      request.query.filters.size() == 1 &&
                      request.query.filters[0][0] == 'userId' &&
                      request.query.filters[0][2] == request.auth.uid &&
                      request.query.orderBy.path == path(['updatedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    ) ||
                    (
                      request.query.filters.size() == 2 &&
                      ((request.query.filters[0][0] == 'userId' && request.query.filters[0][2] == request.auth.uid && request.query.filters[1][0] == 'status') ||
                       (request.query.filters[1][0] == 'userId' && request.query.filters[1][2] == request.auth.uid && request.query.filters[0][0] == 'status')) &&
                      request.query.orderBy.path == path(['updatedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    ) ||
                    (
                      request.query.filters.size() == 1 &&
                      request.query.filters[0][0] == 'status' &&
                      request.query.filters[0][2] == 'published' &&
                      request.query.orderBy.path == path(['publishedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    )
                  );

      allow get, read: if isAuthenticated() && (
                           resource.data.status == 'published' ||
                           resource.data.userId == request.auth.uid
                         );

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'title', 'category', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'commentCount', 'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry', 'tags']) &&
                       request.resource.data.size() == 25 && 
                       request.resource.data.tags is list && 
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.status == 'published' ? request.resource.data.publishedAt == request.time : request.resource.data.publishedAt == null) &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.ratingScore == 0 &&
                       (request.resource.data.requestType == 'help_request' ? (request.resource.data.maxBudget == null || request.resource.data.maxBudget >= 0) : request.resource.data.maxBudget == null) &&
                       (request.resource.data.requestType == 'help_request' ? (request.resource.data.deadline == null || request.resource.data.deadline > request.time) : request.resource.data.deadline == null);


      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid && 
                       request.resource.data.userId == resource.data.userId && 
                       request.resource.data.createdAt == resource.data.createdAt && 
                       request.resource.data.updatedAt == request.time && 
                       // PublishedAt logic for updates:
                       // 1. Transitioning from non-published to published: new publishedAt must be server time.
                       (request.resource.data.status == 'published' && resource.data.status != 'published' ? request.resource.data.publishedAt == request.time : true ) &&
                       // 2. Already published and status remains published: publishedAt must not change from existing doc.
                       (request.resource.data.status == 'published' && resource.data.status == 'published' ? request.resource.data.publishedAt == resource.data.publishedAt : true) &&
                       // 3. Transitioning to draft (or any non-published status): publishedAt must become null.
                       (request.resource.data.status == 'draft' ? request.resource.data.publishedAt == null : true) &&
                       // 4. If status is not 'draft' and not 'published' (if other statuses existed), publishedAt should also be null.
                       //    This is covered if status is 'draft' (above) or if only 'draft'/'published' are valid statuses.
                       //    If new non-published statuses are added, ensure this rule line is adapted or a general rule for non-published is present.
                       (request.resource.data.status != 'published' && request.resource.data.status != 'draft' ? request.resource.data.publishedAt == null : true) &&
                       // Only allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'title', 'category', 'content', 'status', 'coverImageUrl', 
                         'updatedAt', 'publishedAt', 'tags', 
                         'sector', 'subSector', 'industry', 'naicsCode', 
                         'requestType', 'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                         'maxBudget', 'deadline', 'imageUrls', 'mentionedUserIds'
                       ]);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; 
      allow list: if true; 

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'question', 'tags', 'sector', 'ratingScore', 'createdAt', 'requestType', 'commentCount', 'descriptionDetails']) && 
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.ratingScore == 0;


      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'ratingScore', 'updatedAt']); 

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow list: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['userId', 'postId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0;

        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && 
                         request.resource.data.userId == resource.data.userId && 
                         request.resource.data.postId == resource.data.postId && 
                         request.resource.data.timestamp == resource.data.timestamp && 
                         request.resource.data.updatedAt == request.time && 
                         request.resource.data.diff(resource.data).hasOnly(['text', 'updatedAt', 'mentionedUserIds']); 
                  || (isAuthenticated() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                      request.resource.data.userId == resource.data.userId && 
                      request.resource.data.postId == resource.data.postId &&
                      request.resource.data.timestamp == resource.data.timestamp &&
                      request.resource.data.text == resource.data.text &&
                      request.resource.data.updatedAt == request.time
                  );


        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; 

        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy.size() == 0;

          allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.diff(resource.data).hasOnly(['text', 'updatedAt', 'mentionedUserIds']);
                        || (isAuthenticated() &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.text == resource.data.text &&
                            request.resource.data.updatedAt == request.time
                        );

          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
        allow read: if isAuthenticated(); 
        allow list: if isAuthenticated(); 
        allow create: if isAuthenticated() &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId && 
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                         request.resource.data.bidAmount >= 0; 

        allow update: if false; 
        allow delete: if isAuthenticated() && resource.data.bidderId == request.auth.uid; 
      }
    }
    
    match /reviews/{reviewId} {
      allow read: if true; 
      allow list: if true; 
      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid && 
                       request.resource.data.targetUserId != request.auth.uid && 
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       isNotEmpty(request.resource.data.comment) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']) &&
                       request.resource.data.size() == 9;
                       
      allow update: if isAuthenticated() &&
                       resource.data.reviewerId == request.auth.uid && 
                       request.resource.data.reviewerId == resource.data.reviewerId && 
                       request.resource.data.targetUserId == resource.data.targetUserId && 
                       request.resource.data.createdAt == resource.data.createdAt && 
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       isNotEmpty(request.resource.data.comment) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt', 'reviewerHistoricalAvgRating']);

      allow delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid; 
    }

    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants.size() >= 2 &&
                       (
                         (request.resource.data.type == 'direct' &&
                          request.resource.data.participants.size() == 2 &&
                          request.resource.data.groupName == null &&
                          request.resource.data.groupAvatarUrl == null &&
                          request.resource.data.ownerId == null &&
                          request.resource.data.adminIds.size() == 0
                         ) ||
                         (request.resource.data.type == 'group' &&
                          isNotEmpty(request.resource.data.groupName) &&
                          request.resource.data.ownerId == request.auth.uid &&
                          request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                          request.resource.data.adminIds.size() >= 1 &&
                          request.resource.data.ownerId in request.resource.data.participants && 
                          request.resource.data.adminIds.hasAll(request.resource.data.participants.intersect(request.resource.data.adminIds)) 
                         )
                       ) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastMessage == (request.resource.data.type == 'group' ? "Group created by " + getUser(request.auth.uid).data.mentionName : null) &&
                       request.resource.data.lastMessageTimestamp == request.time &&
                       (request.resource.data.postId == null || request.resource.data.postId is string) &&
                       request.resource.data.keys().hasAll(['participants', 'type', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                       request.resource.data.size() == 11; 
                       
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && 
                         request.resource.data.senderId == request.auth.uid &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants && 
                         request.resource.data.conversationId == conversationId &&
                         isNotEmpty(request.resource.data.text) &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['conversationId', 'senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet']) &&
                         request.resource.data.size() == 8 && 
                         request.resource.data.read == false &&
                         (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true) && 
                         (request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                         (request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string);
        allow update, delete: if false; 
      }
    }

    match /userPreferences/{userId} {
      allow read, update, create: if isAuthenticated() && request.auth.uid == userId;
      allow create: if request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly([
                         'userId', 'createdAt', 'updatedAt', 
                         'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                         'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                         'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', 
                         'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                         'paymentMethods'
                       ]);

      allow update: if request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'updatedAt', 
                         'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                         'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                         'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', 
                         'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                         'paymentMethods'
                       ]);
    }

    match /plans/{planId} {
        function isPlanOwner() { return request.auth.uid == resource.data.ownerId; }
        function isPlanEditor() { return request.auth.uid in resource.data.editUserIds; }
        function canViewPlan() {
          return resource.data.visibility == 'public' ||
                 (resource.data.visibility == 'unlisted' && request.auth.uid in resource.data.viewUserIds) || 
                 (resource.data.visibility == 'private' && isPlanOwner()) || 
                 (request.auth.uid in resource.data.viewUserIds); 
        }
        function canEditPlan() {
            return isPlanOwner() ||
                   (resource.data.editability == 'collaborators' && isPlanEditor()) ||
                   (resource.data.editability == 'everyone' && canViewPlan()); 
        }

        allow read: if isAuthenticated() && canViewPlan();

        allow list: if isAuthenticated() && (
            (
                request.query.filters.size() == 1 &&
                request.query.filters[0][0] == 'visibility' &&
                request.query.filters[0][1] == 'in' &&
                request.query.filters[0][2].hasAll(['public', 'unlisted']) && 
                request.query.orderBy.path == path(['createdAt']) &&
                request.query.orderBy.direction == 'desc' &&
                request.query.limit <= 12 
            )
        );
        
        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.version == 1 &&
                         request.resource.data.roadmap.size() == 0 &&
                         request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                         request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                         request.resource.data.viewUserIds is list && request.resource.data.viewUserIds.hasAll([request.auth.uid]) &&
                         request.resource.data.editUserIds is list && request.resource.data.editUserIds.hasAll([request.auth.uid]) &&
                         request.resource.data.keys().hasAll([
                             'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                             'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability',
                             'viewUserIds', 'editUserIds'
                         ]) &&
                         request.resource.data.size() == 14; 

        allow update: if isAuthenticated() && canEditPlan() &&
                         request.resource.data.ownerId == resource.data.ownerId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.roadmap != resource.data.roadmap ? request.resource.data.version == resource.data.version + 1 : request.resource.data.version == resource.data.version) &&
                         (isPlanOwner() ?
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                 'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                 'updatedAt', 'version', 'roadmap', 'visibility', 'editability',
                                 'viewUserIds', 'editUserIds'
                             ])
                             : 
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                 'updatedAt', 'version', 'roadmap'
                             ])
                         ) &&
                         (request.resource.data.name == null || request.resource.data.name is string && isNotEmpty(request.resource.data.name)) &&
                         (request.resource.data.visibility == null || request.resource.data.visibility in ['private', 'unlisted', 'public']) &&
                         (request.resource.data.editability == null || request.resource.data.editability in ['owner_only', 'collaborators', 'everyone']) &&
                         (request.resource.data.viewUserIds == null || request.resource.data.viewUserIds is list) &&
                         (request.resource.data.editUserIds == null || request.resource.data.editUserIds is list) &&
                         (request.resource.data.roadmap == null || request.resource.data.roadmap is list);

        allow delete: if isAuthenticated() && isPlanOwner();

        match /versions/{versionId} {
          allow read: if isAuthenticated() && canViewPlan(); 
          allow list: if isAuthenticated() && canViewPlan();
          allow create: if isAuthenticated() && canEditPlan() && 
                           request.resource.data.planId == planId &&
                           request.resource.data.editorUid == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.versionNumber is number &&
                           request.resource.data.roadmap is list &&
                           request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                           request.resource.data.size() == 5;
          allow update, delete: if false; 
        }
    }

  }
}
