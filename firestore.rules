
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow read/write access to users collection for authenticated users
    // but only allow users to read/write their own document unless specified otherwise
    match /users/{userId} {
      allow read: if request.auth != null; // Any authenticated user can read basic profiles
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
                       // Ensure only allowed fields are updated by the user themselves
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established', 'incomeRange',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'updatedAt', 'lastLoginAt' // lastLoginAt often updated on sign-in
                       ]) &&
                       request.resource.data.uid == resource.data.uid && // uid cannot change
                       request.resource.data.email == resource.data.email && // email cannot change by user
                       request.resource.data.companyName == resource.data.companyName && // companyName from signup
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName is system generated
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // system generated
                       request.resource.data.createdAt == resource.data.createdAt; // createdAt cannot change
      // No delete rule for users for now, handle via admin or specific function
    }

    // Rules for posts
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Ensure all required fields are present and of correct type for create
      // request.resource.data.keys().hasAll(['userId', 'question', 'tags', 'sector', 'descriptionDetails', 'requestType', 'ratingScore', 'createdAt', 'commentCount'])
      // && request.resource.data.userId is string
      // && request.resource.data.question is string && request.resource.data.question.size() > 0
      // && request.resource.data.tags is list
      // && request.resource.data.sector is string
      // && request.resource.data.descriptionDetails is string
      // && request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request')
      // && request.resource.data.ratingScore is number
      // && request.resource.data.createdAt == request.time
      // && request.resource.data.commentCount == 0
      // Optional fields need to be handled (e.g. imageUrls, mentionedUserIds, maxBudget, deadline etc.)
      // For simplicity, create is just checking auth for now, but should be tightened.

      allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                       // Only allow updating specific fields by the post owner
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                         'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                         'maxBudget', 'deadline', 'imageUrls', 'mentionedUserIds', 'updatedAt'
                       ]) &&
                       request.resource.data.userId == resource.data.userId && // userId cannot change
                       request.resource.data.createdAt == resource.data.createdAt; // createdAt cannot change

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Subcollection for comments
      match /comments/{commentId} {
        allow read: if true; // Anyone can read comments
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.postId == postId;
        // Add more validation for comment creation fields
        allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                         // Only allow liking/unliking and editing text by comment owner
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt']) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.timestamp == resource.data.timestamp;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

        // Subcollection for subcomments (replies)
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.postId == postId && request.resource.data.commentId == commentId;
          // Add more validation for subComment creation fields
          allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likedBy', 'likeCount', 'updatedAt']) &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.postId == resource.data.postId &&
                           request.resource.data.commentId == resource.data.commentId &&
                           request.resource.data.timestamp == resource.data.timestamp;
          allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
      // Subcollection for bids on a post
      match /bids/{bidId} {
        allow read: if request.auth != null; // Authenticated users can read bids (e.g. post owner or potential bidders)
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.bidderId &&
                         request.resource.data.postId == postId &&
                         // Ensure user is not bidding on their own post
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        // Add more validation for bid creation fields (amount, message etc.)
        allow update, delete: if false; // Bids are generally immutable once placed
      }
    }

    // Rules for mutual connections
    match /mutuals/{connectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       // Further checks: status is 'pending', userIds size is 2,
                       // and connectionId is correctly formed (e.g., sorted UIDs joined by '_')
                       request.resource.data.status == 'pending' &&
                       request.resource.data.userIds.size() == 2 &&
                       connectionId == getMutualConnectionDocId(request.resource.data.userIds[0], request.resource.data.userIds[1]);
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.userIds &&
                       // If accepting: acceptor is not original requester and status was pending
                       (request.resource.data.status == 'connected' &&
                        resource.data.status == 'pending' &&
                        resource.data.requesterId != request.auth.uid &&
                        request.resource.data.connectedAt == request.time) ||
                       // Allow only specific fields to be updated for safety if other updates are needed
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'connectedAt']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.userIds;
    }
    function getMutualConnectionDocId(uid1, uid2) {
      return uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1;
    }

    // Rules for conversations
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.participants &&
                       // For direct chats
                       (request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2
                       ) ||
                       // For group chats
                       (request.resource.data.type == 'group' &&
                        request.resource.data.ownerId == request.auth.uid &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        request.resource.data.participants.size() >= 2 // Min 2 for a group (owner + 1)
                       );
      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
                       // Allow updating last message details by participants
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'updatedAt', 'participants', 'adminIds', 'ownerId', 'groupName', 'groupAvatarUrl', 'formerParticipants']) &&
                        // Group specific updates can only be done by admins/owner
                        ( (request.resource.data.type == 'group' && request.auth.uid in resource.data.adminIds &&
                           (request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'adminIds', 'groupName', 'groupAvatarUrl', 'formerParticipants']) ||
                            request.resource.data.ownerId == resource.data.ownerId // Owner can only change via specific function
                           )
                          ) ||
                          // Allow owner to transfer ownership (new ownerId, adminIds updated)
                          (request.resource.data.type == 'group' && request.auth.uid == resource.data.ownerId &&
                           request.resource.data.ownerId != resource.data.ownerId && // ownerId is changing
                           request.resource.data.adminIds.hasAll([request.resource.data.ownerId, resource.data.ownerId]) // both old and new owner are admins
                          ) ||
                          // General last message updates by any participant
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'updatedAt'])
                        )
                       );
      allow delete: if false; // Generally, conversations are not deleted by users

      // Subcollection for messages within a conversation
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Additional create validation: senderId must be auth.uid
        // allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // No direct update/delete for messages by users for now
      }
    }

    // Rules for userPreferences
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Add specific field validations for create/update if needed
    }

    // Rules for notifications
    match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
                      // Ensure all required fields like userId, type, senderId, timestamp are present
                      // request.resource.data.keys().hasAll(['userId', 'type', 'senderId', 'timestamp', 'isRead'])
                      // && request.resource.data.userId is string && request.resource.data.userId.size() > 0
                      // && request.resource.data.type is string && request.resource.data.type.size() > 0
                      // && request.resource.data.senderId is string && request.resource.data.senderId.size() > 0
                      // && request.resource.data.timestamp == request.time
                      // && request.resource.data.isRead == false;
        allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                         // Only allow updating isRead status by the recipient
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
                         request.resource.data.userId == resource.data.userId; // userId cannot change
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Rules for 'reviews' collection
    match /reviews/{reviewId} {
      allow read: if true; // Anyone can read reviews
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.reviewerId &&
                       request.resource.data.targetUserId != request.auth.uid; // Cannot review self
                       // Add more validation for rating range, comment length, etc.
                       // request.resource.data.rating is number && request.resource.data.rating >=1 && request.resource.data.rating <=5

      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       // Allow only rating and comment to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
                       request.resource.data.reviewerId == resource.data.reviewerId && // ReviewerId cannot change
                       request.resource.data.targetUserId == resource.data.targetUserId && // TargetUserId cannot change
                       request.resource.data.createdAt == resource.data.createdAt; // CreatedAt cannot change


      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

    // Rules for 'collections'
    match /collections/{collectionId} {
        allow read: if request.auth != null && (
                        request.auth.uid == resource.data.ownerId ||
                        request.auth.uid in resource.data.sharedWithUserIds
                      );
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.ownerId &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.postIds is list && // must be a list (can be empty)
                         request.resource.data.sharedWithUserIds is list && // must be a list (can be empty)
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null &&
                         request.auth.uid == resource.data.ownerId &&
                         // Owner can update name, description, postIds, sharedWithUserIds
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']) &&
                         request.resource.data.ownerId == resource.data.ownerId && // ownerId cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                         request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.ownerId;
    }

    // START: Rules for 'plans' collection and 'versions' subcollection
    match /plans/{planId} {
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure only expected fields are present at creation
                       request.resource.data.keys().hasAll(['name', 'ownerId', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap']) &&
                       request.resource.data.size() == 10;


      allow get: if request.auth != null;

      allow update: if request.auth != null &&
                       // Protect core immutable fields
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       // Protect other fields unless explicitly allowed for general update
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.sector == resource.data.sector &&
                       (request.resource.data.subSector == resource.data.subSector || (request.resource.data.subSector == null && resource.data.subSector == null)) &&
                       (request.resource.data.industry == resource.data.industry || (request.resource.data.industry == null && resource.data.industry == null)) &&
                       (request.resource.data.naicsCode == resource.data.naicsCode || (request.resource.data.naicsCode == null && resource.data.naicsCode == null)) &&
                       // Allow changes only to 'roadmap', 'updatedAt', 'version'
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'updatedAt', 'version']) &&
                       // Ensure version is incremented and updatedAt is server time
                       (request.resource.data.version == resource.data.version + 1) &&
                       request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /versions/{versionId} {
        allow create: if request.auth != null &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.planId == planId &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasAll(['planId', 'editorUid', 'roadmap', 'versionNumber', 'timestamp']) &&
                         request.resource.data.size() == 5;

        allow list, get: if request.auth != null;

        allow update, delete: if false;
      }
    }
    // END: Rules for 'plans' collection and 'versions' subcollection

  }
}

    