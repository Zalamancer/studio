
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is owner of the resource
    function isOwner(userIdField) {
      return isAuthenticated() && request.auth.uid == userIdField;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
        allow update: if isAuthenticated() &&
                        ( // Liking/Unliking
                          (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                            ( // Adding a like
                              request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) &&
                              request.resource.data.likeCount == resource.data.likeCount + 1
                            ) ||
                            ( // Removing a like
                              request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]) &&
                              request.resource.data.likeCount == resource.data.likeCount - 1
                            )
                          ) ||
                          // Owner editing their comment (text, mentionedUserIds)
                          (isOwner(resource.data.userId) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt'])
                          )
                        );
        allow delete: if isAuthenticated() && isOwner(resource.data.userId);

        // SubComments Subcollection (Replies to Comments)
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
          allow update: if isAuthenticated() &&
                          ( // Liking/Unliking
                            (
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                              ( // Adding a like
                                  request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) &&
                                  request.resource.data.likeCount == resource.data.likeCount + 1
                              ) ||
                              ( // Removing a like
                                  request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]) &&
                                  request.resource.data.likeCount == resource.data.likeCount - 1
                              )
                            ) ||
                            // Owner editing their subcomment (text, mentionedUserIds)
                            (isOwner(resource.data.userId) &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt'])
                            )
                          );
          allow delete: if isAuthenticated() && isOwner(resource.data.userId);
        }
      }

      // Bids Subcollection (under posts)
      match /bids/{bidId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        request.resource.data.bidderId == request.auth.uid &&
                        request.resource.data.postId == postId;
        allow update: if isAuthenticated() && isOwner(resource.data.bidderId);
        allow delete: if isAuthenticated() && isOwner(resource.data.bidderId);
      }
    }

    // Mutuals Collection (Connections)
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                      request.resource.data.requesterId == request.auth.uid &&
                      request.auth.uid in request.resource.data.userIds &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.userIds.size() == 2 &&
                      request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                      !request.resource.data.keys().hasAny(['connectedAt']);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.userIds && (
                      (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                       request.resource.data.requesterId == resource.data.requesterId &&
                       request.auth.uid != resource.data.requesterId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])
                      ) ||
                      (resource.data.status == 'connected' && request.resource.data.status == 'blocked')
                    );
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds;
    }

    // userPreferences collection
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.userId == userId;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated(); // Simplified for now; consider senderId == request.auth.uid for client-side creation
      allow update(markAsRead): if isAuthenticated() && resource.data.userId == request.auth.uid &&
                                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']);
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read, list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
                      request.auth.uid in request.resource.data.participants &&
                      request.resource.data.participants.size() == 2 &&
                      request.resource.data.keys().hasAll(['participants', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'postId']);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']);

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, list: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() &&
                        request.auth.uid == request.resource.data.senderId &&
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.data.naicsCode == naicsCode;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                      request.resource.data.reviewerId == request.auth.uid &&
                      request.resource.data.targetUserId != request.auth.uid;
      allow update: if isAuthenticated() &&
                      resource.data.reviewerId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid;
    }
  }
}

    