
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isNotEmpty(value) {
      return value != null && value != '';
    }

    function isMap(value) {
      return value is map;
    }

    function isString(value) {
      return value is string;
    }

    function isStringOrNull(value) {
      return value is string || value == null;
    }

    function isNumber(value) {
      return value is number;
    }

    function isNumberOrNull(value) {
      return value is number || value == null;
    }
    
    function isBoolean(value) {
      return value is bool;
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    function isServerTimestamp() {
      return request.time;
    }
    
    function isArray(value) {
      return value is list;
    }

    function isValidPostRequestType(type) {
      return type == 'post' || type == 'help_request';
    }

    function planVisibilityValues() {
      return ['private', 'unlisted', 'public'];
    }

    function planEditabilityValues() {
      return ['owner_only', 'collaborators', 'everyone'];
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Anyone authenticated can read basic profile info
      allow create: if isAuthenticated() && isOwner(userId) &&
                    request.resource.data.uid == userId &&
                    isStringOrNull(request.resource.data.email) &&
                    isString(request.resource.data.mentionName) &&
                    isString(request.resource.data.mentionNameLowercase) &&
                    isStringOrNull(request.resource.data.companyName) &&
                    isStringOrNull(request.resource.data.industry) &&
                    isStringOrNull(request.resource.data.avatarUrl) &&
                    isStringOrNull(request.resource.data.description) &&
                    isStringOrNull(request.resource.data.descriptionVisibility) &&
                    isStringOrNull(request.resource.data.sectorName) &&
                    isStringOrNull(request.resource.data.subSectorName) &&
                    isStringOrNull(request.resource.data.industryName) &&
                    isStringOrNull(request.resource.data.naicsCode) &&
                    (isArray(request.resource.data.tags) || request.resource.data.tags == null) &&
                    isStringOrNull(request.resource.data.established) &&
                    isBoolean(request.resource.data.verified) &&
                    isBoolean(request.resource.data.isBotAccount) &&
                    isStringOrNull(request.resource.data.incomeRange) &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.updatedAt == request.time &&
                    request.resource.data.lastLoginAt == request.time &&
                    request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 
                        'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 
                        'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 
                        'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt'
                    ]);

      allow update: if isAuthenticated() && isOwner(userId) &&
                      request.resource.data.uid == resource.data.uid && // Cannot change UID
                      request.resource.data.email == resource.data.email && // Email typically not changed this way
                      request.resource.data.mentionName == resource.data.mentionName && // Mention name should be immutable post-creation by user
                      request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                      request.resource.data.companyName == resource.data.companyName && // Company name immutable here
                      request.resource.data.createdAt == resource.data.createdAt && // createdAt immutable
                      request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                      request.resource.data.isBotAccount == resource.data.isBotAccount && // isBotAccount immutable by user
                      request.resource.data.verified == resource.data.verified && // verified status changed by admin
                      request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 
                        'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 
                        'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 
                        'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt'
                      ]) &&
                      // Fields user can update:
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'lastLoginAt', 
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 
                        'incomeRange', 'updatedAt'
                      ]));
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      isNotEmpty(request.resource.data.question) &&
                      isNotEmpty(request.resource.data.sector) &&
                      isValidPostRequestType(request.resource.data.requestType) &&
                      request.resource.data.createdAt == request.time &&
                      // Optional fields checks
                      (isStringOrNull(request.resource.data.descriptionDetails) || isString(request.resource.data.descriptionDetails)) && // descriptionDetails is string, not null
                      isStringOrNull(request.resource.data.descriptionTried) &&
                      isStringOrNull(request.resource.data.descriptionOutcome) &&
                      (isNumberOrNull(request.resource.data.maxBudget) || request.resource.data.maxBudget == null) &&
                      (isTimestamp(request.resource.data.deadline) || request.resource.data.deadline == null) &&
                      isArray(request.resource.data.tags) &&
                      isArray(request.resource.data.imageUrls) &&
                      isArray(request.resource.data.mentionedUserIds) &&
                      isNumber(request.resource.data.ratingScore) &&
                      isNumber(request.resource.data.commentCount) &&
                      request.resource.data.keys().hasOnly([
                        'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'ratingScore', 'createdAt',
                        'imageUrls', 'mentionedUserIds', 'requestType', 'descriptionDetails', 'descriptionTried',
                        'descriptionOutcome', 'maxBudget', 'deadline', 'commentCount'
                      ]);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                       // Allow updating commentCount and updatedAt only for now
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                       request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        isNotEmpty(request.resource.data.text) &&
                        request.resource.data.timestamp == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        (isNumberOrNull(request.resource.data.likeCount) || request.resource.data.likeCount == 0) &&
                        isArray(request.resource.data.likedBy) && request.resource.data.likedBy.size() == 0 &&
                        (isArray(request.resource.data.mentionedUserIds) || request.resource.data.mentionedUserIds == null) &&
                        isBoolean(request.resource.data.isShadowBanned) && request.resource.data.isShadowBanned == false &&
                        request.resource.data.keys().hasOnly([
                          'userId', 'text', 'timestamp', 'updatedAt', 'mentionName', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned'
                        ]);
        allow update: if isAuthenticated() &&
                        // Allow liking/unliking by any authenticated user
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) ||
                        // Allow author to update text or shadowBan status
                         (resource.data.userId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'isShadowBanned', 'updatedAt', 'mentionedUserIds']))
                        ) &&
                        request.resource.data.timestamp == resource.data.timestamp && // Original timestamp cannot change
                        request.resource.data.userId == resource.data.userId && // Comment author cannot change
                        request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Only comment author can delete

        // SubComments Subcollection
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if isAuthenticated() &&
                          request.resource.data.userId == request.auth.uid &&
                          isNotEmpty(request.resource.data.text) &&
                          request.resource.data.timestamp == request.time &&
                          request.resource.data.updatedAt == request.time &&
                          (isNumberOrNull(request.resource.data.likeCount) || request.resource.data.likeCount == 0) &&
                          isArray(request.resource.data.likedBy) && request.resource.data.likedBy.size() == 0 &&
                          (isArray(request.resource.data.mentionedUserIds) || request.resource.data.mentionedUserIds == null) &&
                          isBoolean(request.resource.data.isShadowBanned) && request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasOnly([
                            'userId', 'text', 'timestamp', 'updatedAt', 'mentionName', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned'
                          ]);
          allow update: if isAuthenticated() &&
                          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) ||
                           (resource.data.userId == request.auth.uid &&
                            request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'isShadowBanned', 'updatedAt', 'mentionedUserIds']))
                          ) &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.updatedAt == request.time;
          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }
      // Bids Subcollection
       match /bids/{bidId} {
         allow read: if isAuthenticated(); // Allow authenticated users to read bids, specific filtering done client-side if needed
         allow create: if isAuthenticated() &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId && // Bid is for this post
                         isNumber(request.resource.data.bidAmount) &&
                         request.resource.data.bidAmount >= 0 && // Bid amount must be non-negative
                         (isStringOrNull(request.resource.data.bidMessage)) &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
         // No update/delete for bids for now to keep them as records
       }
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
        allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
        allow create: if isAuthenticated() &&
                        request.resource.data.requesterId == request.auth.uid &&
                        request.resource.data.userIds.hasAll([request.auth.uid]) && // Ensure creator is in userIds
                        request.resource.data.userIds.size() == 2 && // Only two users in a connection
                        request.resource.data.status == 'pending' &&
                        request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']);
        allow update: if isAuthenticated() &&
                        request.auth.uid in resource.data.userIds && // User must be part of the connection
                        // Allow accepting a request (status to 'connected', connectedAt updated)
                        (request.resource.data.status == 'connected' &&
                         resource.data.status == 'pending' &&
                         request.resource.data.requesterId == resource.data.requesterId && // Requester cannot change
                         request.resource.data.userIds == resource.data.userIds && // Participants cannot change
                         request.resource.data.connectedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])
                        ) &&
                        request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Both users can end connection or cancel request
    }

    // userPreferences collection
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId); // Only owner can read/write their preferences
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid; // User can read their own notifications
      allow list: if isAuthenticated() && request.query.filters.size() > 0 && request.query.filters[0].userId == request.auth.uid; // User can list their own notifications
      allow create: if isAuthenticated() &&
                      request.resource.data.userId != request.auth.uid && // Cannot create notification for self through this
                      request.resource.data.senderId == request.auth.uid && // Sender must be the authenticated user
                      isNotEmpty(request.resource.data.type) &&
                      request.resource.data.timestamp == request.time &&
                      // isRead must be false on creation
                      request.resource.data.isRead == false &&
                      request.resource.data.keys().hasOnly([
                        'userId', 'type', 'senderId', 'senderName', 'senderAvatar', 'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId', 'textSnippet', 'timestamp', 'isRead'
                      ]);

      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                      // Only allow updating isRead and updatedAt
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) &&
                      request.resource.data.updatedAt == request.time;
      // No delete for notifications by users
    }
    
    // Plans collection
    match /plans/{planId} {
      function isPlanOwner() { return resource.data.ownerId == request.auth.uid; }
      function isPlanEditor() {
        return resource.data.editability == 'everyone' || // if plan allows everyone to edit
               (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds);
      }
      function canReadPlan() {
        return resource.data.visibility == 'public' ||
               isPlanOwner() ||
               (resource.data.visibility == 'unlisted' && request.auth.uid in resource.data.viewUserIds) ||
               (resource.data.visibility == 'private' && isPlanOwner()); // Redundant but clear for private
      }

      allow read: if isAuthenticated() && canReadPlan();

      allow create: if isAuthenticated() &&
                      isOwner(request.resource.data.ownerId) &&
                      isNotEmpty(request.resource.data.name) && isString(request.resource.data.name) &&
                      isString(request.resource.data.sector) && isNotEmpty(request.resource.data.sector) &&
                      isStringOrNull(request.resource.data.subSector) &&
                      isStringOrNull(request.resource.data.industry) &&
                      isStringOrNull(request.resource.data.naicsCode) && isNotEmpty(request.resource.data.naicsCode) &&
                      isStringOrNull(request.resource.data.description) &&
                      request.resource.data.version == 1 &&
                      isArray(request.resource.data.roadmap) &&
                      isString(request.resource.data.visibility) && request.resource.data.visibility in planVisibilityValues() &&
                      isString(request.resource.data.editability) && request.resource.data.editability in planEditabilityValues() &&
                      isArray(request.resource.data.viewUserIds) && (request.resource.data.visibility == 'public' || request.auth.uid in request.resource.data.viewUserIds) &&
                      isArray(request.resource.data.editUserIds) && (request.resource.data.editability == 'everyone' || request.auth.uid in request.resource.data.editUserIds) &&
                      // Check visibility/editability constraints
                      (request.resource.data.visibility != 'private' || request.resource.data.editability == 'owner_only') &&
                      (request.resource.data.visibility != 'unlisted' || request.resource.data.editability != 'everyone') &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.keys().hasOnly([
                        'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 
                        'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 
                        'viewUserIds', 'editUserIds'
                      ]);
      
      allow update: if isAuthenticated() &&
                      (isPlanOwner() || (isPlanEditor() && canReadPlan())) && // Owner or permitted editor can update
                      request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                      request.resource.data.createdAt == resource.data.createdAt && // Creation time immutable
                      request.resource.data.updatedAt == request.time &&
                      // Owner can change all allowed fields
                      (isPlanOwner() || 
                        // Non-owner editors can only update roadmap and version (implicitly via roadmap update)
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt'])
                      ) &&
                      // Validate fields if changed by owner
                      (!request.resource.data.diff(resource.data).affectedKeys().has('name') || (isString(request.resource.data.name) && isNotEmpty(request.resource.data.name))) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('description') || isStringOrNull(request.resource.data.description)) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('sector') || (isString(request.resource.data.sector) && isNotEmpty(request.resource.data.sector))) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('naicsCode') || (isStringOrNull(request.resource.data.naicsCode) && (request.resource.data.naicsCode == null || isNotEmpty(request.resource.data.naicsCode)))) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('visibility') || (isString(request.resource.data.visibility) && request.resource.data.visibility in planVisibilityValues())) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('editability') || (isString(request.resource.data.editability) && request.resource.data.editability in planEditabilityValues())) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('viewUserIds') || isArray(request.resource.data.viewUserIds)) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().has('editUserIds') || isArray(request.resource.data.editUserIds)) &&
                      // Check visibility/editability constraints on update
                      (request.resource.data.visibility != 'private' || request.resource.data.editability == 'owner_only') &&
                      (request.resource.data.visibility != 'unlisted' || request.resource.data.editability != 'everyone') &&
                      // Ensure roadmap, if updated, is an array
                      (!request.resource.data.diff(resource.data).affectedKeys().has('roadmap') || isArray(request.resource.data.roadmap)) &&
                      // Version must increment or stay same (if only settings change)
                      (!request.resource.data.diff(resource.data).affectedKeys().has('version') || (isNumber(request.resource.data.version) && request.resource.data.version >= resource.data.version)) &&
                       request.resource.data.keys().hasOnly([
                        'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 
                        'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 
                        'viewUserIds', 'editUserIds'
                      ]);

      allow delete: if isAuthenticated() && isPlanOwner();

      // Versions subcollection
      match /versions/{versionId} {
        allow read: if isAuthenticated() && canReadPlan(); // If user can read the plan, they can read its versions
        allow create: if isAuthenticated() &&
                        (isPlanOwner() || (isPlanEditor() && canReadPlan())) && // Update: Allow editors who can read (and thus edit roadmap) to create versions
                        request.resource.data.planId == planId &&
                        request.resource.data.editorUid == request.auth.uid &&
                        request.resource.data.timestamp == request.time &&
                        isArray(request.resource.data.roadmap) &&
                        isNumber(request.resource.data.versionNumber) &&
                        request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
        // No update or delete for versions by users
      }
    }
    
    // Simplified list rule for plans:
    // Allows authenticated users to list plans with common orderings and a limit.
    // Document-level read rules will filter out plans the user shouldn't see.
    match /plans/{planId} {
      // ... (read, create, update, delete rules from above) ...
      allow list: if isAuthenticated() &&
                  request.query.limit <= 50 &&
                  (request.query.orderBy == null || 
                   request.query.orderBy.path == 'createdAt' || 
                   request.query.orderBy.path == 'updatedAt');
    }


    // articleTags collection
    match /articleTags/{tagId} {
      allow read: if true; // All users can read tags
      allow create: if isAuthenticated() &&
                      isString(request.resource.data.name) && isNotEmpty(request.resource.data.name) &&
                      isString(request.resource.data.nameLowercase) && isNotEmpty(request.resource.data.nameLowercase) &&
                      request.resource.data.name.toLowerCase() == request.resource.data.nameLowercase &&
                      isNumber(request.resource.data.usageCount) && request.resource.data.usageCount >= 0 &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
      allow update: if isAuthenticated() && // Only allow updating usageCount
                      request.resource.data.name == resource.data.name &&
                      request.resource.data.nameLowercase == resource.data.nameLowercase &&
                      request.resource.data.createdBy == resource.data.createdBy &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isNumber(request.resource.data.usageCount) && request.resource.data.usageCount >= 0 &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
      // No delete for tags by users to preserve integrity
    }

    // newsArticles collection
    match /newsArticles/{articleId} {
      function isArticleOwner() { return resource.data.userId == request.auth.uid; }
      
      allow read: if resource.data.status == 'published' || 
                    (isAuthenticated() && isArticleOwner() && resource.data.status == 'draft');

      allow list: if true; // Allow listing, client filters by status='published'
                           // Or if a user queries their own drafts (needs rule for that query pattern)
                           // For getNewsArticlesByUserId:
                           // query(newsArticlesCollectionRef, where('userId', '==', userId), orderBy('updatedAt', 'desc'))
                           // For getPublishedNewsArticles:
                           // query(newsArticlesCollectionRef, where('status', '==', 'published'), orderBy('publishedAt', 'desc'))
      
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      isNotEmpty(request.resource.data.title) && isString(request.resource.data.title) &&
                      isArray(request.resource.data.tags) &&
                      isString(request.resource.data.content) && // Main content is required
                      isStringOrNull(request.resource.data.draftContent) &&
                      isBoolean(request.resource.data.hasUnpublishedChanges) &&
                      isStringOrNull(request.resource.data.coverImageUrl) &&
                      isString(request.resource.data.status) && (request.resource.data.status == 'draft' || request.resource.data.status == 'published') &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null) &&
                      (isNumberOrNull(request.resource.data.likeCount) || request.resource.data.likeCount == 0) &&
                      isArray(request.resource.data.likedBy) && request.resource.data.likedBy.size() == 0 &&
                      (isNumberOrNull(request.resource.data.commentCount) || request.resource.data.commentCount == 0) &&
                      request.resource.data.keys().hasOnly([
                        'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 
                        'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount',
                        // Fields from Post type
                        'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget',
                        'deadline', 'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType',
                        'sector', 'subSector', 'industry'
                      ]);

      allow update: if isAuthenticated() && isArticleOwner() &&
                      request.resource.data.userId == resource.data.userId && // Cannot change author
                      request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                      request.resource.data.updatedAt == request.time &&
                      // Allow updates to specified fields, likeCount/likedBy are separate
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 
                        'publishedAt', 'updatedAt', // updatedAt is required, publishedAt can change
                        // Fields from Post type, if they become editable
                        'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget',
                        'deadline', 'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType',
                        'sector', 'subSector', 'industry'
                        // Not allowing direct update of commentCount or likeCount/likedBy here, handled by specific functions
                      ]) &&
                      isString(request.resource.data.title) && isNotEmpty(request.resource.data.title) &&
                      isString(request.resource.data.content) && // Content always required
                      isString(request.resource.data.status) && (request.resource.data.status == 'draft' || request.resource.data.status == 'published');


      allow delete: if isAuthenticated() && isArticleOwner();

      // News Comments Subcollection
      match /newsComments/{commentId} {
        allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && isArticleOwner()); // Only author can see shadow-banned comments
        allow create: if isAuthenticated() &&
                        request.resource.data.userId == request.auth.uid &&
                        isNotEmpty(request.resource.data.text) &&
                        request.resource.data.timestamp == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        (isNumberOrNull(request.resource.data.likeCount) || request.resource.data.likeCount == 0) &&
                        isArray(request.resource.data.likedBy) && request.resource.data.likedBy.size() == 0 &&
                        (isArray(request.resource.data.mentionedUserIds) || request.resource.data.mentionedUserIds == null) &&
                        isBoolean(request.resource.data.isShadowBanned) && request.resource.data.isShadowBanned == false &&
                        request.resource.data.keys().hasOnly([
                          'userId', 'text', 'timestamp', 'updatedAt', 'mentionName', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned'
                        ]);
        allow update: if isAuthenticated() &&
                        // Liking/Unliking by any authenticated user
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) ||
                        // Author of comment updating text or if article author is shadow banning
                         ( (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'updatedAt', 'mentionedUserIds'])) ||
                           (isArticleOwner() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['isShadowBanned', 'updatedAt']))
                         )
                        ) &&
                        request.resource.data.timestamp == resource.data.timestamp && // Original timestamp cannot change
                        request.resource.data.userId == resource.data.userId && // Comment author cannot change
                        request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Only comment author can delete

        // News SubComments Subcollection
        match /newsSubcomments/{subCommentId} {
          allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && isArticleOwner());
          allow create: if isAuthenticated() &&
                          request.resource.data.userId == request.auth.uid &&
                          isNotEmpty(request.resource.data.text) &&
                          request.resource.data.timestamp == request.time &&
                          request.resource.data.updatedAt == request.time &&
                          (isNumberOrNull(request.resource.data.likeCount) || request.resource.data.likeCount == 0) &&
                          isArray(request.resource.data.likedBy) && request.resource.data.likedBy.size() == 0 &&
                          (isArray(request.resource.data.mentionedUserIds) || request.resource.data.mentionedUserIds == null) &&
                          isBoolean(request.resource.data.isShadowBanned) && request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasOnly([
                            'userId', 'text', 'timestamp', 'updatedAt', 'mentionName', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned'
                          ]);
          allow update: if isAuthenticated() &&
                          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) ||
                           ( (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'updatedAt', 'mentionedUserIds'])) ||
                             (isArticleOwner() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['isShadowBanned', 'updatedAt']))
                           )
                          ) &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.updatedAt == request.time;
          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }
    }
    
    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Allow anyone to read reviews
      allow create: if isAuthenticated() &&
                      request.resource.data.reviewerId == request.auth.uid && // Must be self
                      request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                      isNotEmpty(request.resource.data.reviewerName) &&
                      isStringOrNull(request.resource.data.reviewerAvatar) &&
                      isNumber(request.resource.data.rating) && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                      isString(request.resource.data.comment) &&
                      (isNumberOrNull(request.resource.data.reviewerHistoricalAvgRating) || request.resource.data.reviewerHistoricalAvgRating == null) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.keys().hasOnly([
                        'targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 
                        'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt'
                      ]);
      allow update: if isAuthenticated() &&
                      resource.data.reviewerId == request.auth.uid && // Only reviewer can update
                      request.resource.data.targetUserId == resource.data.targetUserId && // Cannot change who is reviewed
                      request.resource.data.reviewerId == resource.data.reviewerId && // Cannot change reviewer
                      request.resource.data.reviewerName == resource.data.reviewerName && // Reviewer name set at creation
                      request.resource.data.reviewerAvatar == resource.data.reviewerAvatar && // Avatar set at creation
                      request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && // Historical avg is snapshot
                      request.resource.data.createdAt == resource.data.createdAt && // Creation time immutable
                      request.resource.data.updatedAt == request.time && // Must update time
                      isNumber(request.resource.data.rating) && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                      isString(request.resource.data.comment) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid; // Only reviewer can delete
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      function isParticipant() { return request.auth.uid in resource.data.participants; }
      function isCreatorOrAdmin() {
        return resource.data.type == 'group' && 
               (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.adminIds);
      }
      function isCreatingDirectChat() {
        return request.resource.data.type == 'direct' &&
               request.resource.data.participants.size() == 2 &&
               request.auth.uid in request.resource.data.participants &&
               request.resource.data.groupName == null &&
               request.resource.data.groupAvatarUrl == null &&
               request.resource.data.ownerId == null &&
               request.resource.data.adminIds.size() == 0;
      }
      function isCreatingGroupChat() {
        return request.resource.data.type == 'group' &&
               request.resource.data.participants.size() >= 2 &&
               request.auth.uid in request.resource.data.participants &&
               request.resource.data.ownerId == request.auth.uid &&
               request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator must be an admin
               isNotEmpty(request.resource.data.groupName) && isString(request.resource.data.groupName) &&
               isStringOrNull(request.resource.data.groupAvatarUrl);
      }
       function isUpdatingParticipantsOrAdmins() { // For group chats
          return request.resource.data.type == 'group' &&
                 isCreatorOrAdmin() && // Only admin can modify participants/admins list
                 request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                 request.resource.data.adminIds.hasAll(resource.data.adminIds.intersect(request.resource.data.adminIds)) && // Admins can only be added by owner, or existing admins can add others if rule allows
                 request.resource.data.participants.hasAll(resource.data.participants.intersect(request.resource.data.participants)); // Can only add participants
      }
       function isUpdatingLastMessage() {
         return request.resource.data.lastMessage != resource.data.lastMessage ||
                request.resource.data.lastMessageTimestamp != resource.data.lastMessageTimestamp ||
                request.resource.data.lastMessageSenderId != resource.data.lastMessageSenderId;
       }
       function isValidGroupUpdateByAdmin() {
         return request.resource.data.type == 'group' && isCreatorOrAdmin() &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'updatedAt', 
                  'lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp' // Allow last message updates too
                ]) &&
                (request.resource.data.diff(resource.data).affectedKeys().has('groupName') ? isNotEmpty(request.resource.data.groupName) && isString(request.resource.data.groupName) : true) &&
                (request.resource.data.diff(resource.data).affectedKeys().has('groupAvatarUrl') ? isStringOrNull(request.resource.data.groupAvatarUrl) : true) &&
                (request.resource.data.diff(resource.data).affectedKeys().has('participants') ? isArray(request.resource.data.participants) && request.resource.data.participants.size() >= 1 : true) && // Group needs at least 1 participant (owner could be last one)
                (request.resource.data.diff(resource.data).affectedKeys().has('adminIds') ? isArray(request.resource.data.adminIds) && request.resource.data.adminIds.size() >= 1 && request.resource.data.ownerId in request.resource.data.adminIds : true); // Owner must remain an admin
       }
       function isValidOwnershipTransfer() {
          return request.resource.data.type == 'group' &&
                 resource.data.ownerId == request.auth.uid && // Only current owner can transfer
                 request.resource.data.ownerId != resource.data.ownerId && // Owner must change
                 request.resource.data.ownerId in request.resource.data.participants && // New owner must be a participant
                 request.resource.data.ownerId in request.resource.data.adminIds && // New owner must become an admin
                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt']);
       }

      allow read, list: if isAuthenticated() && isParticipant();
      allow create: if isAuthenticated() &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      (isStringOrNull(request.resource.data.lastMessage) || request.resource.data.lastMessage == null) &&
                      request.resource.data.lastMessageTimestamp == request.time &&
                      isStringOrNull(request.resource.data.postId) &&
                      (request.resource.data.formerParticipants == null || request.resource.data.formerParticipants.size() == 0) &&
                      request.resource.data.keys().hasOnly([
                        'participants', 'type', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'postId',
                        'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'updatedAt'
                        // 'formerParticipants' // Not allowed at creation via rule
                      ]) &&
                      (isCreatingDirectChat() || isCreatingGroupChat());
                      
      allow update: if isAuthenticated() && isParticipant() &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.createdAt == resource.data.createdAt && // Immutable
                      request.resource.data.type == resource.data.type && // Type immutable
                      request.resource.data.postId == resource.data.postId && // Post link immutable
                      ( // Case 1: Simple last message update (by any participant)
                        (isUpdatingLastMessage() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                        // Case 2: Group admin updating group details or members (more complex)
                        isValidGroupUpdateByAdmin() ||
                        // Case 3: Owner transferring ownership
                        isValidOwnershipTransfer() ||
                        // Case 4: Updating formerParticipants when leaving
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'formerParticipants', 'updatedAt']) &&
                         !(request.auth.uid in request.resource.data.participants) && // Current user is being removed from participants
                         request.resource.data.formerParticipants[request.auth.uid] == request.time // Current user's leave time is now
                        )
                      );
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read, list: if isAuthenticated() && isParticipant(); // Users in conversation can read/list messages
        allow create: if isAuthenticated() && isParticipant() &&
                        request.resource.data.senderId == request.auth.uid &&
                        isNotEmpty(request.resource.data.text) &&
                        request.resource.data.timestamp == request.time &&
                        (isStringOrNull(request.resource.data.replyToMessageId) || request.resource.data.replyToMessageId == null) &&
                        (isStringOrNull(request.resource.data.repliedToTextSnippet) || request.resource.data.repliedToTextSnippet == null) &&
                        request.resource.data.conversationId == conversationId &&
                        (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true) && // Allow boolean
                        request.resource.data.read == false &&
                        request.resource.data.keys().hasOnly([
                           'senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId'
                        ]);
        // No updates or deletes for messages by users to maintain chat history integrity
      }
    }

    // Collections (user-specific saved posts)
    match /collections/{collectionId} {
      function isCollectionOwner() { return resource.data.ownerId == request.auth.uid; }
      function isSharedWithUser() { return request.auth.uid in resource.data.sharedWithUserIds; }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      allow list: if isAuthenticated() && // Allow users to list collections they own or are shared with.
                    request.query.limit <= 100 &&
                    (request.query.filters.size() == 0 || // List all accessible by auth uid (read rule will filter)
                     (request.query.filters.size() == 1 && request.query.filters[0].ownerId == request.auth.uid) ||
                     (request.query.filters.size() == 1 && request.query.filters[0].sharedWithUserIds.hasAny([request.auth.uid]))
                    );

      allow create: if isAuthenticated() &&
                      isOwner(request.resource.data.ownerId) && // Owner is the creator
                      isNotEmpty(request.resource.data.name) && isString(request.resource.data.name) &&
                      isStringOrNull(request.resource.data.description) &&
                      isArray(request.resource.data.postIds) &&
                      isArray(request.resource.data.sharedWithUserIds) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.keys().hasOnly([
                        'name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt'
                      ]);
      allow update: if isAuthenticated() && isCollectionOwner() && // Only owner can update
                      request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                      request.resource.data.createdAt == resource.data.createdAt && // Creation time immutable
                      request.resource.data.updatedAt == request.time &&
                      // Check for allowed fields to be updated
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                        ['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']
                      ) &&
                      // Validate types if fields are present in the update
                      (request.resource.data.diff(resource.data).affectedKeys().has('name') ? (isString(request.resource.data.name) && isNotEmpty(request.resource.data.name)) : true) &&
                      (request.resource.data.diff(resource.data).affectedKeys().has('description') ? isStringOrNull(request.resource.data.description) : true) &&
                      (request.resource.data.diff(resource.data).affectedKeys().has('postIds') ? isArray(request.resource.data.postIds) : true) &&
                      (request.resource.data.diff(resource.data).affectedKeys().has('sharedWithUserIds') ? isArray(request.resource.data.sharedWithUserIds) : true);

      allow delete: if isAuthenticated() && isCollectionOwner(); // Only owner can delete
    }


  }
}

  