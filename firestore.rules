
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (defined globally for use across multiple match blocks if needed, or within specific blocks)
    // It's generally safer to define them within the match block where they are most relevant to avoid unintended scope issues.

    // Stripe Customers & Payment Information
    // Allow users to read their own Stripe customer data and payment methods.
    // Creation and modification are handled by secure backend (Stripe webhooks/API calls via Cloud Functions).
    match /stripeCustomers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // No client-side write/update/delete for stripeCustomers root doc.
      // Subcollections for payment_methods or subscriptions might have different rules if managed by client,
      // but typically also backend-managed.
      match /payment_methods/{paymentMethodId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // No client-side write/update/delete for payment_methods.
      }
      match /subscriptions/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
         // No client-side write/update/delete for subscriptions.
      }
    }

    // User Preferences
    // Users can read and write their own preferences document.
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Ensure that when writing, the userId field in the document matches the authenticated user.
      // And sensitive fields like stripeCustomerId are not writable by client if they already exist.
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       (!('stripeCustomerId' in request.resource.data) || request.resource.data.stripeCustomerId == null); // Prevent client setting stripeCustomerId on create
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       (!('stripeCustomerId' in request.resource.data) || request.resource.data.stripeCustomerId == resource.data.stripeCustomerId); // Prevent client changing stripeCustomerId
    }

    // Users Collection (Public Profiles)
    match /users/{userId} {
      allow read: if true; // Publicly readable profiles
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.createdAt == request.time &&
                       !('verified' in request.resource.data && request.resource.data.verified == true); // Cannot self-verify
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.uid == resource.data.uid && // Cannot change UID
                       request.resource.data.email == resource.data.email && // Email should not be changed by client here
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName is system-generated/immutable by client
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // immutable
                       !('verified' in request.resource.data && request.resource.data.verified == true && resource.data.verified == false) && // Cannot self-verify
                       request.resource.data.updatedAt == request.time;
      // Allow users to update their own profile details like description, avatarUrl, industry, etc.
      // Specific fields that can be updated:
      // description, descriptionVisibility, avatarUrl, industry, established, incomeRange,
      // sectorName, subSectorName, industryName, naicsCode, tags
      // Ensure `updatedAt` is set to `request.time`.
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // All posts are publicly readable

      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0);

      allow update:
        // Branch 1: Owner can update their post (most fields, but not userId or createdAt)
        (
          request.auth != null && resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&                 // Cannot change owner
          request.resource.data.createdAt == resource.data.createdAt &&             // Cannot change creation time
          request.resource.data.updatedAt == request.time &&                        // Must set update time
          // Owner should not directly update commentCount here; it's managed by comment actions
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']))
        ) ||
        // Branch 2: Any authenticated user can update commentCount and updatedAt (for comment actions)
        (
          request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
          request.resource.data.updatedAt == request.time
          // No need to check other fields like userId == resource.userId if hasOnly is used.
        );

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only post owner can delete

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true; // All comments are publicly readable
        allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId && // Ensure comment is for this post
                         request.resource.data.timestamp == request.time && // Use server timestamp
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0;

        allow update:
          // Branch 1: Owner can edit text and mentionedUserIds
          (
            request.auth != null && resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId &&         // Immutable
            request.resource.data.postId == resource.data.postId &&         // Immutable
            request.resource.data.timestamp == resource.data.timestamp &&   // Immutable
            request.resource.data.updatedAt == request.time                  // Must set update time
          ) ||
          // Branch 2: Any authenticated user can update likedBy and likeCount (for liking)
          (
            request.auth != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
            // Validate likedBy array change (add self or remove self)
            (
              (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAll([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) || // Adding self
              (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasAll([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)    // Removing self
            ) &&
            // Validate likeCount change (+1 or -1)
            (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
            // Ensure other core fields are not changed during a like operation
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.postId == resource.data.postId &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.timestamp == resource.data.timestamp &&
            request.resource.data.updatedAt == request.time
          );

        allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only comment owner can delete

        // SubComments (Replies)
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if request.auth != null &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy.size() == 0;
          allow update:
            // Branch 1: Owner can edit text and mentionedUserIds
            (
              request.auth != null && resource.data.userId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.updatedAt == request.time
            ) ||
            // Branch 2: Any authenticated user can update likedBy and likeCount (for liking subcomments)
            (
              request.auth != null &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
              (
                (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAll([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1) ||
                (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasAll([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)
              ) &&
              (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.text == resource.data.text &&
              request.resource.data.timestamp == resource.data.timestamp &&
              request.resource.data.updatedAt == request.time
            );
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }
      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if request.auth != null; // Allow authenticated users to read bids on a post
        allow create: if request.auth != null &&
                         request.resource.data.postId == postId &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         resource.data.userId != request.auth.uid; // Cannot bid on own post
        // Bids are generally not updatable or deletable by clients once placed
        allow update, delete: if false;
      }
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Ensure auth user is one of the UIDs
                       request.resource.data.userIds.size() == 2 && // Must be between 2 users
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.userIds[0] != request.resource.data.userIds[1]; // Cannot connect to self
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.userIds && // Must be one of the users in the connection
                       request.resource.data.userIds == resource.data.userIds && // Cannot change participants
                       request.resource.data.requesterId == resource.data.requesterId && // Cannot change original requester
                       request.resource.data.requestedAt == resource.data.requestedAt && // Cannot change request time
                       (
                         // Scenario 1: Accepting a request
                         (
                           resource.data.status == 'pending' &&
                           request.resource.data.status == 'connected' &&
                           request.resource.data.requesterId != request.auth.uid && // Acceptor cannot be the original requester
                           request.resource.data.connectedAt == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])
                         ) ||
                         // Scenario 2: User who is part of the connection can update other mutable fields (if any were added later, none currently)
                         // For now, only status changes (accepting) are allowed beyond creation.
                         // Blocking users would be a separate logic/status.
                         false // No other client updates allowed currently
                       );
      allow delete: if request.auth != null &&
                       request.auth.uid in resource.data.userIds &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected'); // Can delete pending (cancel/reject) or connected (remove)
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId &&
                            // For updates, only allow 'isRead' and 'updatedAt' to be changed
                            (request.method == 'get' || (request.method == 'update' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && request.resource.data.updatedAt == request.time ));
      allow create: if request.auth != null &&
                       request.resource.data.userId != request.auth.uid && // Cannot send notification to self via client
                       request.resource.data.senderId == request.auth.uid && // Sender must be the authenticated user
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false;
      allow delete: if false; // Notifications generally not deleted by clients
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{docId} {
      allow read: if true; // Or specific conditions if needed
      allow write: if request.auth != null &&
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time &&
                      // Ensure the naicsCode field in the document matches the document ID
                      request.resource.data.naicsCode == docId;
    }

    // Conversations and Messages
    // Helper functions scoped to conversations and messages
    function isAuthUserParticipant(authUid, convData) {
      return authUid != null && convData.participants.hasAny([authUid]);
    }
    function isGroupOwner(authUid, convData) {
      return convData.type == 'group' && convData.ownerId == authUid;
    }
    function isGroupAdmin(authUid, convData) {
      return convData.type == 'group' && convData.adminIds.hasAny([authUid]);
    }

    match /conversations/{conversationId} {
      allow get: if request.auth != null && isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if request.auth != null && request.query.limit <= 100; // Basic authenticated list

      allow create:
        // Branch 1: Creating a 'direct' chat
        (
          request.auth != null &&
          request.resource.data.type == 'direct' &&
          request.resource.data.participants.size() == 2 &&
          isAuthUserParticipant(request.auth.uid, request.resource.data) && // Current user is one of the participants
          request.resource.data.ownerId == null &&
          request.resource.data.adminIds.size() == 0 &&
          request.resource.data.groupName == null &&
          request.resource.data.groupAvatarUrl == null &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          // Ensure only expected fields are present for a direct chat creation
          request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl', 'lastMessage', 'lastMessageTimestamp', 'createdAt']) &&
          request.resource.data.keys().size() == 10 // Adjust count if adding/removing default fields
        ) ||
        // Branch 2: Creating a 'group' chat
        (
          request.auth != null &&
          request.resource.data.type == 'group' &&
          isAuthUserParticipant(request.auth.uid, request.resource.data) &&
          request.resource.data.ownerId == request.auth.uid && // Creator is owner
          request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
          request.resource.data.adminIds.size() >= 1 && // At least one admin (the owner)
          request.resource.data.participants.size() >= 2 && // At least two participants for a group
          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl', 'lastMessage', 'lastMessageTimestamp', 'createdAt']) &&
          request.resource.data.keys().size() == 10 // Adjust count
        );

      allow update:
        // Branch A (SEND MESSAGE - FOR ALL TYPES): Any participant can update last message details.
        (
          request.auth != null &&
          isAuthUserParticipant(request.auth.uid, resource.data) && // User must be a participant
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.resource.data.lastMessageSenderId == request.auth.uid && // Sender must be current user
          request.resource.data.updatedAt == request.time // Must update timestamp
          // Immutable fields for this action
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.type == resource.data.type
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.adminIds == resource.data.adminIds
          && request.resource.data.groupName == resource.data.groupName
          && request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl
          && request.resource.data.createdAt == resource.data.createdAt
        ) ||
        // Branch B (Admin: Update Group Name/Avatar)
        (
          request.auth != null &&
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) && // Check if ONLY these are intended to be changed + updatedAt
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'type', 'postId', 'ownerId', 'adminIds', 'lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'createdAt'])) && // Ensure no other fields are part of the write operation at all
          request.resource.data.updatedAt == request.time &&
          // Protect immutable fields explicitly if not covered by hasOnly logic
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds && // Admins can't change admin list here
          request.resource.data.createdAt == resource.data.createdAt
        ) ||
        // Branch C (Admin: Add/Remove Members - Owner handled in D for admin list)
        (
          request.auth != null &&
          resource.data.type == 'group' &&
          isGroupAdmin(request.auth.uid, resource.data) && // Admin performing action
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) && // Only these fields can change
          request.resource.data.updatedAt == request.time &&
          // Validate participant list changes (ensure no one critical is removed by non-owner admin)
          // An admin cannot remove the owner OR another admin unless they are the owner (owner logic is in Branch D)
          (
            request.resource.data.participants.size() > resource.data.participants.size() || // Adding members
            ( // Removing members
              request.resource.data.participants.size() < resource.data.participants.size() &&
              // Ensure removed members are not the owner, and if they are admins, the current user must be the owner
              resource.data.participants.filter(uid => !request.resource.data.participants.hasAny([uid])).get(0, '') != resource.data.ownerId &&
              (
                !resource.data.adminIds.hasAny(resource.data.participants.filter(uid => !request.resource.data.participants.hasAny([uid]))) || // removed user was not an admin
                isGroupOwner(request.auth.uid, resource.data) // or current user is owner (can remove anyone but self if last admin)
              )
            )
          ) &&
          // If a removed participant was an admin, they must also be removed from adminIds
          // And ensure adminIds only contains participants.
          request.resource.data.adminIds.hasOnly(request.resource.data.participants) &&
          // Protect immutable fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          // Ensure group has at least one participant after removal
          request.resource.data.participants.size() >= 1 &&
          // Ensure owner is still an admin
          request.resource.data.adminIds.hasAll([resource.data.ownerId])
        ) ||
        // Branch D (Owner: Promote/Demote Admins - also covers owner removing admin members)
        (
          request.auth != null &&
          resource.data.type == 'group' &&
          isGroupOwner(request.auth.uid, resource.data) && // Only owner can manage admins
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'participants', 'updatedAt']) && // Owner might remove an admin which also removes from participants
          request.resource.data.updatedAt == request.time &&
          // All admins must be participants
          request.resource.data.adminIds.hasOnly(request.resource.data.participants) &&
          // Owner must always remain an admin
          request.resource.data.adminIds.hasAll([resource.data.ownerId]) &&
          // Protect immutable fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.participants.size() >= 1 // Ensure group isn't emptied by removing owner through admin list somehow
        ) ||
        // Branch E (Participant: Leave Group)
        (
          request.auth != null &&
          isAuthUserParticipant(request.auth.uid, resource.data) &&
          resource.data.type == 'group' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          !request.resource.data.participants.hasAll([request.auth.uid]) && // User is removed from participants
          (!resource.data.adminIds.hasAll([request.auth.uid]) || !request.resource.data.adminIds.hasAll([request.auth.uid])) && // If was admin, also removed from admins
          request.resource.data.updatedAt == request.time &&
          // Owner Safeguard: Owner cannot leave if they are the sole admin and other participants remain.
          // This means client must handle promoting another admin first, or this write will be denied.
          !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && request.resource.data.participants.size() > 0) &&
          // Protect immutable fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.createdAt == resource.data.createdAt
        );

      // No client-side delete for conversations for now, can be managed by functions if needed
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
                      isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if request.auth != null &&
                         isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time;
        // Messages are generally immutable by clients once created, except for bot flags or reactions if implemented later
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid; // Only sender can edit/delete their own message.
      }
    }
  }
}

    