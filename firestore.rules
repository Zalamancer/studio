rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (inlined or defined above)
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- User Profile Functions ---
    function isUserProfileOwner(userId) {
      return isUser(userId);
    }

    // --- Plan Helper Functions ---
    function getPlan(planId) {
      return get(/databases/$(database)/documents/plans/$(planId)).data;
    }
    function isPlanOwner(planId) {
      return isAuthenticated() && request.auth.uid == getPlan(planId).ownerId;
    }
    function isPlanViewer(planId) { // Check if user is in viewUserIds or if plan is public/unlisted
      let plan = getPlan(planId);
      return isAuthenticated() && (
        plan.ownerId == request.auth.uid ||
        plan.visibility == 'public' ||
        (plan.visibility == 'unlisted' && plan.viewUserIds.hasAny([request.auth.uid])) || // Corrected: 'unlisted' also relies on viewUserIds if present
        (plan.visibility == 'private' && plan.viewUserIds.hasAny([request.auth.uid])) // For private, explicitly in viewUserIds
      );
    }
    function canViewPlan(planId) { // Combined logic for plan readability
        let plan = getPlan(planId);
        return plan.visibility == 'public' ||
               (isAuthenticated() && plan.ownerId == request.auth.uid) ||
               (isAuthenticated() && plan.visibility == 'unlisted') || // Any auth user can view unlisted IF they have the link (Firestore rules don't check link, but this allows DB read)
               (isAuthenticated() && plan.viewUserIds.hasAny([request.auth.uid]));
    }

    function canEditPlan(planId) {
        let plan = getPlan(planId);
        return isAuthenticated() && (
            plan.ownerId == request.auth.uid ||
            (plan.editability == 'collaborators' && plan.editUserIds.hasAny([request.auth.uid]) && canViewPlan(planId)) ||
            (plan.editability == 'everyone' && (plan.visibility == 'public' || plan.visibility == 'unlisted') && canViewPlan(planId)) // 'everyone' requires view access first
        );
    }
    function isValidPlanVisibility(visibility) {
      return visibility == 'private' || visibility == 'unlisted' || visibility == 'public';
    }
    function isValidPlanEditability(editability) {
      return editability == 'owner_only' || editability == 'collaborators' || editability == 'everyone';
    }
    function isValidViewAndEditUserIds(planData, ownerId) {
      let viewIdsValid = planData.viewUserIds is list;
      let editIdsValid = planData.editUserIds is list;

      if (!viewIdsValid || !editIdsValid) { return false; }

      // Owner must always be in viewUserIds and editUserIds if lists are not empty or based on role
      // (This check is more about ensuring lists are present and owner is included if lists are used for restriction)
      if (planData.visibility != 'public' && !planData.viewUserIds.hasAny([ownerId])) { return false; }
      if (planData.editability == 'collaborators' && !planData.editUserIds.hasAny([ownerId])) { return false; }
      if (planData.editability == 'owner_only' && !(planData.editUserIds.size() == 1 && planData.editUserIds.hasAny([ownerId]))) { return false; }

      // Ensure all editors are also viewers if visibility is not public
      if (planData.visibility != 'public') {
        return planData.editUserIds.every(editorId => planData.viewUserIds.hasAny([editorId]));
      }
      return true;
    }

    // --- News Article Helper Functions ---
    function getNewsArticle(articleId) {
      return get(/databases/$(database)/documents/newsArticles/$(articleId)).data;
    }
    function isNewsArticleOwner(articleId) {
      return isAuthenticated() && request.auth.uid == getNewsArticle(articleId).userId;
    }
    function isValidNewsStatus(status) {
      return status == 'draft' || status == 'published';
    }
    function canUpdateNewsSettings(articleId) { // Owner only for non-content fields
      return isNewsArticleOwner(articleId);
    }
    function canUpdateNewsContent(articleId) { // Owner only for content related fields
      return isNewsArticleOwner(articleId);
    }


    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // All authenticated users can read basic profiles
      allow create: if isAuthenticated() && request.auth.uid == userId && // User can create their own profile
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       (request.resource.data.companyName is string || request.resource.data.companyName == null) &&
                       (request.resource.data.industry is string || request.resource.data.industry == null) &&
                       (request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0) &&
                       (request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase.size() > 0) &&
                       (request.resource.data.email is string || request.resource.data.email == null) &&
                       (request.resource.data.avatarUrl is string || request.resource.data.avatarUrl == null) &&
                       (request.resource.data.descriptionVisibility is string && request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                       request.resource.data.keys().hasAll(['uid', 'createdAt', 'updatedAt', 'lastLoginAt', 'mentionName', 'mentionNameLowercase', 'email', 'companyName', 'industry', 'avatarUrl', 'descriptionVisibility']) &&
                       !request.resource.data.keys().hasAny(['description', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange']); // Fields set later
      allow update: if isAuthenticated() && isUserProfileOwner(userId) && // User can update their own profile
                       request.resource.data.uid == userId && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email cannot change via this
                       request.resource.data.companyName == resource.data.companyName && // Company name (from initial signup) cannot change via this
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // mentionNameLowercase cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       // Last login can be updated without other field restrictions
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt','updatedAt']) ||
                           // All other profile updates must conform to allowed fields
                           request.resource.data.keys().hasOnly([
                               'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl',
                               'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                               'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                               'createdAt', 'lastLoginAt', 'updatedAt'
                           ]) &&
                           (request.resource.data.descriptionVisibility is string && request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me'])
                       );
    }

    // User Preferences Collection
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated() && isUser(userId); // Users can read/write their own preferences
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in participants
                       request.resource.data.status == 'pending' &&
                       request.resource.data.size() == 4 && // userIds, status, requesterId, requestedAt
                       request.resource.data.requestedAt == request.time;

      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // User must be part of the connection
                       // Ensure only status and timestamps can be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']) &&
                       // Ensure userIds and requesterId are immutable
                       request.resource.data.userIds == resource.data.userIds &&
                       request.resource.data.requesterId == resource.data.requesterId &&
                       // Allow status change from pending to connected by recipient
                       (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                        request.auth.uid != resource.data.requesterId && // Only recipient can accept
                        request.resource.data.connectedAt == request.time) &&
                       request.resource.data.updatedAt == request.time;

      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Either user can delete
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Posts are public by default
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.keys().hasOnly([
                           'userId', 'tags', 'question', 'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                           'maxBudget', 'deadline', 'sector', 'subSector', 'industry', 'ratingScore', 'createdAt',
                           'naicsCode', 'imageUrls', 'mentionedUserIds', 'commentCount'
                       ]);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only owner can update their post
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only owner can delete

      // Comments Subcollection for Posts
      match /comments/{commentId} {
        allow read: if true; // Comments on posts are public
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.isShadowBanned == false &&
                         request.resource.data.keys().hasOnly(['userId', 'text', 'postId', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned']);
        allow update: if isAuthenticated() && // Liking/unliking a comment
                        (request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId) && // Comment owner or post owner for shadow ban
                        request.resource.data.postId == postId &&
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.timestamp == resource.data.timestamp &&
                        request.resource.data.updatedAt == request.time &&
                        (
                            // Liking/unliking
                            (
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                (
                                    (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy) ) || // Liking
                                    (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && !(request.auth.uid in request.resource.data.likedBy) && request.auth.uid in resource.data.likedBy)    // Unliking
                                )
                            )
                            // Shadow banning by post owner - This path is not used for 'posts', only for 'newsArticles'
                            // ||
                            // (
                            //     request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId &&
                            //     request.resource.data.isShadowBanned != resource.data.isShadowBanned &&
                            //     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                            // )
                        );
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only comment owner can delete

        // SubComments (Replies) Subcollection for Post Comments
        match /subcomments/{subCommentId} {
          allow read: if true; // Replies are public
          allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned']);
          allow update: if isAuthenticated() && // Liking/unliking a subcomment
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           (
                               (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy) ) || // Liking
                               (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && !(request.auth.uid in request.resource.data.likedBy) && request.auth.uid in resource.data.likedBy)    // Unliking
                           );
                           // Shadow banning by post owner - Not used for 'posts'
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only subcomment owner can delete
        }
      }
      // Bids Subcollection for Posts
      match /bids/{bidId} {
        allow read: if isAuthenticated(); // Allow authenticated users to read bids on a post
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.bidderId && // Bidder must be self
                         request.resource.data.postId == postId &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid && // Cannot bid on own post
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
        allow update, delete: if false; // Bids are immutable once placed
      }
    }

    // Plans Collection
    match /plans/{planId} {
      allow read: if // Inlined canViewPlan
                     get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' ||
                     (isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) ||
                     (isAuthenticated() && get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted') ||
                     (isAuthenticated() && get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds.hasAny([request.auth.uid]));

     allow list: if isAuthenticated() &&
                    request.query.limit <= 50 &&
                    (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt');


      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list &&
                       // Inlined isValidPlanVisibility
                       (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public') &&
                       // Inlined isValidPlanEditability
                       (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone') &&
                       // Inlined isValidViewAndEditUserIds
                       (
                         (request.resource.data.viewUserIds is list && request.resource.data.editUserIds is list) &&
                         (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAny([request.resource.data.ownerId])) &&
                         (request.resource.data.editability != 'collaborators' || request.resource.data.editUserIds.hasAny([request.resource.data.ownerId])) &&
                         (request.resource.data.editability != 'owner_only' || (request.resource.data.editUserIds.size() == 1 && request.resource.data.editUserIds.hasAny([request.resource.data.ownerId]))) &&
                         (request.resource.data.visibility == 'public' || request.resource.data.editUserIds.every(editorId => request.resource.data.viewUserIds.hasAny([editorId])))
                       ) &&
                       request.resource.data.keys().hasOnly(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']);

      allow update: if isAuthenticated() &&
                       // Inlined canEditPlan(planId)
                       (
                           request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'collaborators' && get(/databases/$(database)/documents/plans/$(planId)).data.editUserIds.hasAny([request.auth.uid]) && canViewPlan(planId)) ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'everyone' && (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' || get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted') && canViewPlan(planId))
                       ) &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       (
                           ( // E1: Roadmap update path
                               request.resource.data.version == resource.data.version + 1 &&
                               request.resource.data.keys().has('roadmap') &&
                               request.resource.data.keys().hasOnly(['roadmap', 'version', 'updatedAt'])
                           ) ||
                           ( // E2: Settings update path
                               // Inlined isPlanOwner(planId)
                               (request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) &&
                               !request.resource.data.keys().hasAny(['roadmap', 'version']) &&
                               request.resource.data.keys().hasOnly([
                                   'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                   'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                               ]) &&
                               // Inlined isValidPlanVisibility & isValidPlanEditability & isValidViewAndEditUserIds
                               (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public') &&
                               (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone') &&
                               (
                                 (request.resource.data.viewUserIds is list && request.resource.data.editUserIds is list) &&
                                 (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAny([request.resource.data.ownerId])) &&
                                 (request.resource.data.editability != 'collaborators' || request.resource.data.editUserIds.hasAny([request.resource.data.ownerId])) &&
                                 (request.resource.data.editability != 'owner_only' || (request.resource.data.editUserIds.size() == 1 && request.resource.data.editUserIds.hasAny([request.resource.data.ownerId]))) &&
                                 (request.resource.data.visibility == 'public' || request.resource.data.editUserIds.every(editorId => request.resource.data.viewUserIds.hasAny([editorId])))
                               ) &&
                               request.resource.data.version == resource.data.version
                           )
                       );

      allow delete: if isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId; // Inlined isPlanOwner

      // Plan Versions Subcollection
      match /versions/{versionId} {
          allow read: if // Inlined canViewPlan(planId)
                         get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' ||
                         (isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) ||
                         (isAuthenticated() && get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted') ||
                         (isAuthenticated() && get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds.hasAny([request.auth.uid]));

         allow list: if isAuthenticated() && exists(/databases/$(database)/documents/plans/$(planId)) && // Ensure parent plan exists
                        // Inlined canViewPlan(planId) logic for the parent plan
                        (
                            get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' ||
                            (request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) ||
                            (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted') || // Allow if plan is unlisted (link access implies list access to history)
                            get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds.hasAny([request.auth.uid])
                        );


          allow create: if isAuthenticated() &&
                         // Inlined canEditPlan(planId)
                         (
                             request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId ||
                             (get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'collaborators' && get(/databases/$(database)/documents/plans/$(planId)).data.editUserIds.hasAny([request.auth.uid]) && canViewPlan(planId)) ||
                             (get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'everyone' && (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' || get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted') && canViewPlan(planId))
                         ) &&
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
          allow update, delete: if false; // Versions are immutable
      }
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
      allow read: if resource.data.status == 'published' ||
                     (isAuthenticated() && request.auth.uid == resource.data.userId); // Author can read their own drafts

      allow list: if request.query.filters.size() == 0 || // Allow general listing (e.g., for public feed)
                     (request.query.filters.size() == 1 && request.query.filters[0].field == 'status' && request.query.filters[0].value == 'published') || // Allow listing published
                     (isAuthenticated() && request.query.filters.size() == 1 && request.query.filters[0].field == 'userId' && request.query.filters[0].value == request.auth.uid); // User listing their own

      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       isValidNewsStatus(request.resource.data.status) &&
                       (request.resource.data.status == 'draft' || request.resource.data.publishedAt == request.time) &&
                       request.resource.data.likeCount == 0 &&
                       request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.keys().hasOnly([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount',
                           'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls',
                           'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                           'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                       ]);

      allow update: if isAuthenticated() &&
                       request.resource.data.userId == resource.data.userId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       (
                           // Case 1: Owner editing their article (content, status, settings, etc.)
                           (
                               request.auth.uid == resource.data.userId &&
                               isValidNewsStatus(request.resource.data.status) &&
                               // If changing status to published, publishedAt must be now or already set. If to draft, publishedAt must be null or not changed.
                               (
                                   (request.resource.data.status == 'published' && (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == resource.data.publishedAt)) ||
                                   (request.resource.data.status == 'draft' && (request.resource.data.publishedAt == null || request.resource.data.publishedAt == resource.data.publishedAt))
                               ) &&
                               // Allow specific fields to be updated by the owner
                               request.resource.data.keys().hasOnly([
                                   'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 'updatedAt', 'publishedAt',
                                   'likeCount', 'likedBy', 'commentCount', // These are usually updated by separate actions but need to be allowd for owner edits if necessary
                                   'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls',
                                   'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                                   'ratingScore', 'requestType', 'sector', 'subSector', 'industry',
                                   'userId', 'createdAt' // Allow if not changing, for diff
                               ])
                           )
                           ||
                           // Case 2: Any authenticated user liking/unliking (but not the author)
                           (
                               request.auth.uid != resource.data.userId &&
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                               (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                               (
                                   // Liking
                                   (
                                       request.resource.data.likeCount == resource.data.likeCount + 1 &&
                                       request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                                       request.auth.uid in request.resource.data.likedBy &&
                                       !(request.auth.uid in resource.data.likedBy)
                                   ) ||
                                   // Unliking
                                   (
                                       request.resource.data.likeCount == resource.data.likeCount - 1 &&
                                       request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                                       !(request.auth.uid in request.resource.data.likedBy) &&
                                       request.auth.uid in resource.data.likedBy
                                   )
                               )
                           )
                           ||
                           // Case 3: Article author shadow banning/unbanning a comment (this rule applies to article update, not comment update)
                           // This case is usually handled on the comment itself, but if article stats need update due to comment ban, allow it.
                           // For now, let's assume comment counts are handled separately.
                           // This path is more for a general "article interaction" that might affect counts.
                           // If a commentCount is updated here, it must be by the author.
                           (
                               request.auth.uid == resource.data.userId &&
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                               (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount -1)
                           )
                       );


      allow delete: if isAuthenticated() && isNewsArticleOwner(articleId);

      // newsComments Subcollection for News Articles
      match /newsComments/{commentId} {
        allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && request.auth.uid == getNewsArticle(articleId).userId);
        allow list: if true; // Let client filter shadow banned based on read rule
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.isShadowBanned == false &&
                         request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned', 'userName', 'userAvatar']);
        allow update: if isAuthenticated() &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.updatedAt == request.time &&
                         (
                             // Liking/unliking
                             (
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (
                                     (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy) ) ||
                                     (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && !(request.auth.uid in request.resource.data.likedBy) && request.auth.uid in resource.data.likedBy)
                                 )
                             )
                             || // Shadow banning/unbanning by article author
                             (
                                 request.auth.uid == getNewsArticle(articleId).userId && // Only article author
                                 request.resource.data.isShadowBanned != resource.data.isShadowBanned && // isShadowBanned must be changing
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) // Only these fields can change
                             )
                         );
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only comment owner can delete

        // newsSubcomments Subcollection
        match /newsSubcomments/{subCommentId} {
          allow read: if resource.data.isShadowBanned == false || (isAuthenticated() && request.auth.uid == getNewsArticle(articleId).userId);
          allow list: if true;
          allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'mentionName', 'isShadowBanned', 'userName', 'userAvatar']);
          allow update: if isAuthenticated() &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time &&
                           (
                               // Liking/unliking
                               (
                                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                   (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                   (
                                       (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy && !(request.auth.uid in resource.data.likedBy) ) ||
                                       (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && !(request.auth.uid in request.resource.data.likedBy) && request.auth.uid in resource.data.likedBy)
                                   )
                               )
                               || // Shadow banning/unbanning by article author
                               (
                                   request.auth.uid == getNewsArticle(articleId).userId && // Only article author
                                   request.resource.data.isShadowBanned != resource.data.isShadowBanned && // isShadowBanned must be changing
                                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) // Only these fields can change
                               )
                           );
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only subcomment owner can delete
        }
      }
    }

    // Article Tags Collection
    match /articleTags/{tagId} {
        allow read: if true; // Tags are public
        allow list: if true; // Allow listing tags
        allow create: if isAuthenticated() && // Any authenticated user can propose a new tag
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount == 1 && // Initial usage count
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
        allow update: if isAuthenticated() && // Usage count can be updated by anyone (e.g., system or trusted functions)
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
                         request.resource.data.usageCount >= 0 && // Usage count should not be negative
                         // Ensure immutable fields are not changed
                         request.resource.data.name == resource.data.name &&
                         request.resource.data.nameLowercase == resource.data.nameLowercase &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false; // Tags are generally not deleted, usage count goes to 0
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can manage their own notifications
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.senderId && // Notification must be sent by the authenticated user
                       request.resource.data.userId != request.auth.uid && // Cannot send notification to self via this rule
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false &&
                       request.resource.data.keys().hasOnly([
                           'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                           'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId',
                           'textSnippet', 'timestamp', 'isRead'
                       ]);
    }


    // Conversations Collection
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                             // Additional check: if user is in formerParticipants, deny read/update
                             !(request.auth.uid in resource.data.formerParticipants);


      allow create: if isAuthenticated() &&
                       request.resource.data.participants.hasAll([request.auth.uid]) && // Creator must be in participants
                       request.resource.data.participants.size() >= 2 && // Must have at least 2 participants
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastMessageTimestamp == request.time &&
                       // Type specific rules
                       (
                         ( // Direct Chat
                           request.resource.data.type == 'direct' &&
                           request.resource.data.participants.size() == 2 && // Direct chats have exactly 2
                           request.resource.data.ownerId == null &&
                           request.resource.data.adminIds.size() == 0 &&
                           request.resource.data.groupName == null &&
                           request.resource.data.groupAvatarUrl == null &&
                           request.resource.data.keys().hasOnly([
                             'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                             'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds',
                             'groupName', 'groupAvatarUrl'
                           ])
                         ) ||
                         ( // Group Chat
                           request.resource.data.type == 'group' &&
                           request.resource.data.ownerId == request.auth.uid && // Creator is owner
                           request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
                           request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                           (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                           request.resource.data.keys().hasOnly([
                             'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                             'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds',
                             'groupName', 'groupAvatarUrl'
                             // 'formerParticipants' can be added later by update, not at creation by client
                           ])
                         )
                       );
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.senderId && // Sender must be self
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants && // Sender must be a participant
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time && // Timestamp must be server time
                         request.resource.data.read == false && // New messages are unread
                         request.resource.data.keys().hasOnly([
                           'conversationId', 'senderId', 'text', 'timestamp', 'read',
                           'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet'
                         ]);
        allow update, delete: if false; // Messages are immutable once sent
      }
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.reviewerId && // Reviewer is self
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       // reviewerHistoricalAvgRating can be number or null
                       (request.resource.data.reviewerHistoricalAvgRating is number || request.resource.data.reviewerHistoricalAvgRating == null) &&
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);

      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change original reviewer/target/createdAt
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       // reviewerHistoricalAvgRating cannot be changed by client on update
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating &&
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);


      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

  }
}

  