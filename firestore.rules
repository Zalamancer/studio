
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if true; // Publicly readable for display names, avatars, etc.
      allow create: if isAuthenticated() && isOwner(userId) &&
                    request.resource.data.uid == userId &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.updatedAt == request.time &&
                    request.resource.data.lastLoginAt == request.time &&
                    // Ensure only expected fields are present and correctly typed (basic example)
                    request.resource.data.keys().hasAll(['uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt']) &&
                    request.resource.data.size() == 22 &&
                    (request.resource.data.email == null || request.resource.data.email is string) &&
                    (request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                    request.resource.data.mentionName is string &&
                    (request.resource.data.mentionNameLowercase == null || request.resource.data.mentionNameLowercase is string) &&
                    (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                    (request.resource.data.industry == null || request.resource.data.industry is string) &&
                    (request.resource.data.description == null || request.resource.data.description is string) &&
                    (request.resource.data.descriptionVisibility == null || request.resource.data.descriptionVisibility is string) &&
                    (request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                    (request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                    (request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                    (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                    (request.resource.data.tags == null || request.resource.data.tags is list) &&
                    (request.resource.data.established == null || request.resource.data.established is string) &&
                    (request.resource.data.verified == null || request.resource.data.verified is bool) &&
                    (request.resource.data.isBotAccount == null || request.resource.data.isBotAccount is bool) &&
                    (request.resource.data.incomeRange == null || request.resource.data.incomeRange is string);

      allow update: if isAuthenticated() && isOwner(userId) &&
                     request.resource.data.uid == userId && // UID cannot change
                     request.resource.data.email == resource.data.email && // Email cannot change through this path
                     request.resource.data.mentionName == resource.data.mentionName && // Mention name cannot change
                     request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                     request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                     request.resource.data.updatedAt == request.time && // UpdatedAt must be server time
                     // Only allow specific fields to be updated
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'lastLoginAt', 'updatedAt', 'incomeRange']);
      // No general delete for user profiles for now
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // All posts are publicly readable
      allow list: if isAuthenticated(); // Basic list access for authenticated users, client must filter

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time && // Ensure createdAt is server time
                       request.resource.data.keys().hasAll(['userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType', 'createdAt', 'commentCount', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline']) &&
                       request.resource.data.size() == 18 && // Check number of fields
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.tags is list &&
                       request.resource.data.sector is string &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.ratingScore is number &&
                       request.resource.data.imageUrls is list &&
                       request.resource.data.mentionedUserIds is list &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() > 0 &&
                       (request.resource.data.descriptionTried == null || request.resource.data.descriptionTried is string) &&
                       (request.resource.data.descriptionOutcome == null || request.resource.data.descriptionOutcome is string) &&
                       (request.resource.data.requestType == 'help_request' ? (request.resource.data.maxBudget == null || request.resource.data.maxBudget >= 0) : request.resource.data.maxBudget == null) &&
                       (request.resource.data.requestType == 'help_request' ? (request.resource.data.deadline == null || request.resource.data.deadline > request.time) : request.resource.data.deadline == null);

      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                       // Only allow commentCount and updatedAt to be updated by this general rule (liking/commenting will have own rules)
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt', 'ratingScore']) &&
                       request.resource.data.updatedAt == request.time; // Ensure updatedAt is server time

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true; // All comments are publicly readable
        allow list: if true; // All comments are publicly listable for a post

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['userId', 'postId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                         request.resource.data.size() == 8 &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list;

        allow update: if isAuthenticated() &&
                         resource.data.userId == request.auth.uid && // User can only update their own comment text
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.timestamp == resource.data.timestamp && // Original timestamp cannot change
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']);

        allow update: if isAuthenticated() && // Liking/unliking
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.text == resource.data.text &&
                        request.resource.data.timestamp == resource.data.timestamp &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.diff(resource.data).affectedKeys().hasAll(['likeCount', 'likedBy', 'updatedAt']);

        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Only comment owner can delete

        // SubComments (Replies) Subcollection
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;

          allow create: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.postId == postId &&       // ensure subcomment belongs to correct post
                           request.resource.data.commentId == commentId && // ensure subcomment belongs to correct parent comment
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.keys().hasAll(['userId', 'postId', 'commentId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                           request.resource.data.size() == 9 &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list;

          allow update: if isAuthenticated() && // Liking/unliking subcomments
                          resource.data.userId == request.resource.data.userId && // userId cannot change
                          resource.data.postId == request.resource.data.postId &&
                          resource.data.commentId == request.resource.data.commentId &&
                          resource.data.text == request.resource.data.text && // text cannot be changed by this rule
                          resource.data.timestamp == request.resource.data.timestamp && // original timestamp cannot change
                          request.resource.data.updatedAt == request.time &&
                          request.resource.data.diff(resource.data).affectedKeys().hasAll(['likeCount', 'likedBy', 'updatedAt']);

          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Only subcomment owner can delete
        }
      }
      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if isAuthenticated() && (resource.data.bidderId == request.auth.uid || resource.data.postAuthorId == request.auth.uid); // Bidder or post author can read
        allow list: if isAuthenticated(); // Allow listing if user is authenticated, client must filter for relevant bids
        allow create: if isAuthenticated() &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId && // Ensure bid is for the correct post
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0;
        // No update/delete for bids to keep history, can be added if needed
      }
    }

    // Mutuals Collection (for connections)
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      // List rule for mutuals (e.g., to get all connections for a user)
      // This rule allows querying where 'userIds' array-contains the auth.uid and status is 'connected' or 'pending'
      allow list: if isAuthenticated() &&
                     request.query.filters.size() > 0 && // Must have at least one filter
                     request.query.filters[0][0] == 'userIds' &&
                     request.query.filters[0][1] == 'array-contains' &&
                     request.query.filters[0][2] == request.auth.uid;

      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) && // Ensure only these fields
                       request.resource.data.size() == 5; // Check exact number of fields

      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // User must be part of the connection
                       request.auth.uid != resource.data.requesterId && // Only recipient can accept (requester cancels via delete)
                       resource.data.status == 'pending' && // Can only update if pending
                       request.resource.data.status == 'connected' && // Only allowed update is to 'connected'
                       request.resource.data.connectedAt == request.time && // Set connectedAt time
                       request.resource.data.updatedAt == request.time &&
                       // Ensure only status, connectedAt, and updatedAt are changed
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Either user can cancel/remove
    }

    // User Preferences Collection
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // All reviews are public
      allow list: if true; // List all reviews for a profile

      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid && // Must be own review
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       (request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number) &&
                       request.resource.data.keys().hasAll(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']) &&
                       request.resource.data.size() == 9;

      allow update: if isAuthenticated() &&
                       resource.data.reviewerId == request.auth.uid && // Can only update own review
                       request.resource.data.reviewerId == resource.data.reviewerId && // ReviewerId cannot change
                       request.resource.data.targetUserId == resource.data.targetUserId && // TargetUserId cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                       request.resource.data.updatedAt == request.time && // UpdatedAt must be server time
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

      allow delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid; // Can only delete own review
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
      // RULES FOR NEWS ARTICLES
      // IMPORTANT: These rules assume corresponding Firestore indexes are in place:
      // 1. newsArticles(userId ASC, updatedAt DESC)
      // 2. newsArticles(userId ASC, status ASC, updatedAt DESC)
      // 3. newsArticles(status ASC, publishedAt DESC)

      allow list: if isAuthenticated() && (
                    // Case 1.1: User fetching their own articles (any status), ordered by updatedAt
                    // Client Query: where('userId', '==', auth.uid), orderBy('updatedAt', 'desc'), limit(X)
                    (
                      request.query.filters.size() == 1 &&
                      request.query.filters[0][0] == 'userId' &&
                      request.query.filters[0][2] == request.auth.uid &&
                      request.query.orderBy.path == path(['updatedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    ) ||
                    // Case 1.2: User fetching their own articles with a specific status, ordered by updatedAt
                    // Client Query: where('userId', '==', auth.uid), where('status', '==', 'draft'/'published'), orderBy('updatedAt', 'desc'), limit(X)
                    (
                      request.query.filters.size() == 2 &&
                      ((request.query.filters[0][0] == 'userId' && request.query.filters[0][2] == request.auth.uid && request.query.filters[1][0] == 'status') ||
                       (request.query.filters[1][0] == 'userId' && request.query.filters[1][2] == request.auth.uid && request.query.filters[0][0] == 'status')) &&
                      request.query.orderBy.path == path(['updatedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    ) ||
                    // Case 2: Any authenticated user fetching published articles, ordered by publishedAt
                    // Client Query: where('status', '==', 'published'), orderBy('publishedAt', 'desc'), limit(X)
                    (
                      request.query.filters.size() == 1 &&
                      request.query.filters[0][0] == 'status' &&
                      request.query.filters[0][2] == 'published' &&
                      request.query.orderBy.path == path(['publishedAt']) &&
                      request.query.orderBy.direction == 'desc'
                    )
                  );

      allow get, read: if isAuthenticated() && (
                           resource.data.status == 'published' ||
                           resource.data.userId == request.auth.uid
                         );

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       // Check for existence of all expected fields and correct number of fields
                       request.resource.data.keys().hasAll(['userId', 'title', 'category', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'commentCount', 'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry', 'tags']) &&
                       request.resource.data.size() == 25 && // Adjusted size to 25
                       // Type checks
                       request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                       request.resource.data.category is string && request.resource.data.category.size() > 0 &&
                       request.resource.data.content is string && request.resource.data.content.size() > 0 &&
                       request.resource.data.status is string && (request.resource.data.status == 'draft' || request.resource.data.status == 'published') &&
                       (request.resource.data.coverImageUrl == null || request.resource.data.coverImageUrl is string) &&
                       request.resource.data.tags is list && // Validate tags as a list
                       // Timestamps must be server timestamps
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // publishedAt logic
                       (request.resource.data.status == 'published' ? request.resource.data.publishedAt == request.time : request.resource.data.publishedAt == null) &&
                       // Default values for counters
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.ratingScore == 0 &&
                       // Validations for other potentially inherited fields (assuming nullable defaults)
                       (request.resource.data.descriptionDetails == null || request.resource.data.descriptionDetails is string) &&
                       (request.resource.data.descriptionOutcome == null || request.resource.data.descriptionOutcome is string) &&
                       (request.resource.data.descriptionTried == null || request.resource.data.descriptionTried is string) &&
                       request.resource.data.imageUrls is list &&
                       (request.resource.data.maxBudget == null || request.resource.data.maxBudget is number) &&
                       (request.resource.data.deadline == null || request.resource.data.deadline is timestamp) &&
                       request.resource.data.mentionedUserIds is list &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (request.resource.data.question == null || request.resource.data.question is string) &&
                       (request.resource.data.requestType == null || request.resource.data.requestType is string) &&
                       (request.resource.data.sector == null || request.resource.data.sector is string) &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string);


      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid && // Original owner must be current user
                       request.resource.data.userId == resource.data.userId && // userId cannot be changed
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot be changed
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       // publishedAt logic for updates
                       (request.resource.data.status == 'published' && resource.data.status != 'published' ? request.resource.data.publishedAt == request.time : true ) && // Set publishedAt if transitioning to published
                       (request.resource.data.status == 'published' && resource.data.status == 'published' ? request.resource.data.publishedAt == resource.data.publishedAt : true) && // Keep publishedAt if already published and status is still published
                       (request.resource.data.status != 'published' ? request.resource.data.publishedAt == null : true) && // Nullify publishedAt if status is not published
                       // Only allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'content', 'status', 'coverImageUrl', 'updatedAt', 'publishedAt', 'tags']); // Added 'tags' to updatable fields

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Plans Collection
    match /plans/{planId} {
      // Helper function specific to plans
      function isPlanOwner() {
        return resource.data.ownerId == request.auth.uid;
      }
      function canViewPlan() {
        return resource.data.visibility == 'public' ||
               (resource.data.visibility == 'unlisted' && isAuthenticated()) || // Anyone with link if authenticated
               (resource.data.visibility == 'private' && (isPlanOwner() || request.auth.uid in resource.data.viewUserIds));
      }
      function canEditPlan() {
         return isPlanOwner() ||
                (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
                (resource.data.editability == 'everyone' && canViewPlan()); // If "everyone" can edit, they must also be able to view
      }

      allow get: if isAuthenticated() && canViewPlan();
      allow list: if isAuthenticated(); // Keep this general for discover page (client filters public/unlisted)

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.sector is string && request.resource.data.sector.size() > 0 &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (request.resource.data.description == null || request.resource.data.description is string) &&
                       request.resource.data.roadmap is list &&
                       request.resource.data.visibility is string && (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public') &&
                       request.resource.data.editability is string && (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone') &&
                       request.resource.data.viewUserIds is list &&
                       request.resource.data.editUserIds is list &&
                       // Ensure owner is automatically in view and edit lists based on visibility/editability logic
                       (request.resource.data.visibility == 'public' ? request.resource.data.viewUserIds.size() == 0 : request.auth.uid in request.resource.data.viewUserIds) &&
                       (request.resource.data.editability == 'everyone' ? request.resource.data.editUserIds.size() == 0 : request.auth.uid in request.resource.data.editUserIds) &&
                       // All editors must also be viewers if plan is not public
                       (request.resource.data.visibility == 'public' || request.resource.data.editUserIds.hasAll(request.resource.data.viewUserIds)) &&
                       request.resource.data.keys().hasAll(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']) &&
                       request.resource.data.size() == 15;

      allow update: if isAuthenticated() && canEditPlan() &&
                       request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.version == resource.data.version || request.resource.data.version == resource.data.version + 1) && // Version can only increment or stay same
                       // Define allowed fields for update. Settings and roadmap are updated separately.
                       // This rule might be split based on whether it's a roadmap update or settings update.
                       // If only settings are updated, roadmap should not change
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt']) ||
                       // If only roadmap is updated, only roadmap, version and updatedAt can change
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt'])
                       ) &&
                       // Further validation for specific fields if they are being updated
                       (request.resource.data.name == null || request.resource.data.name is string && request.resource.data.name.size() > 0) &&
                       (request.resource.data.description == null || request.resource.data.description is string) &&
                       (request.resource.data.sector == null || request.resource.data.sector is string) &&
                       (request.resource.data.visibility == null || (request.resource.data.visibility is string && (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public'))) &&
                       (request.resource.data.editability == null || (request.resource.data.editability is string && (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone'))) &&
                       (request.resource.data.viewUserIds == null || request.resource.data.viewUserIds is list) &&
                       (request.resource.data.editUserIds == null || request.resource.data.editUserIds is list) &&
                       (request.resource.data.roadmap == null || request.resource.data.roadmap is list);

      allow delete: if isAuthenticated() && isPlanOwner(); // Only owner can delete

      // Versions Subcollection for Plans
      match /versions/{versionId} {
        allow read, get: if isAuthenticated() && canViewPlan(); // If user can view the plan, they can view its history.
        allow list: if isAuthenticated() && canViewPlan();

        // Version creation is handled by update to the main plan document (triggers function or direct write)
        // For direct write from client (if allowed), this would be:
        allow create: if isAuthenticated() && canEditPlan() && // User who can edit the plan can save a version
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                         request.resource.data.size() == 5;
        allow update, delete: if false; // Versions are immutable once created
      }
    }

    // Conversations Collection
    match /conversations/{conversationId} {
        allow read: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                       (resource.data.type == 'direct' || (resource.data.type == 'group' && (resource.data.formerParticipants == null || !(request.auth.uid in resource.data.formerParticipants))));

        allow list: if isAuthenticated() && request.query.filters[0][2] == request.auth.uid &&
                        request.query.filters.size() == 1 &&
                        request.query.filters[0][0] == 'participants' &&
                        request.query.filters[0][1] == 'array-contains';

        allow create: if isAuthenticated() &&
                        request.auth.uid in request.resource.data.participants &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        // Common fields for both types
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                        request.resource.data.size() == 11 &&
                        request.resource.data.participants is list && request.resource.data.participants.size() >= 2 &&
                        request.resource.data.type is string && (request.resource.data.type == 'direct' || request.resource.data.type == 'group') &&
                        (request.resource.data.postId == null || request.resource.data.postId is string) &&
                        (request.resource.data.lastMessage == null || request.resource.data.lastMessage is string) &&
                        // Group specific validations
                        (request.resource.data.type == 'group' ?
                            request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                            (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                            request.resource.data.ownerId == request.auth.uid && // Creator is owner
                            request.resource.data.adminIds is list && request.resource.data.adminIds.hasAny([request.auth.uid]) // Creator is admin
                        : // Direct specific validations (or lack thereof beyond common)
                            request.resource.data.groupName == null &&
                            request.resource.data.groupAvatarUrl == null &&
                            request.resource.data.ownerId == null &&
                            request.resource.data.adminIds.size() == 0
                        );


        allow update: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                        request.resource.data.updatedAt == request.time &&
                        // Allow updating last message details by any participant
                        (
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                            request.resource.data.lastMessageSenderId == request.auth.uid
                        ) ||
                        // Allow group admins to update group details or manage participants
                        (
                            resource.data.type == 'group' && request.auth.uid in resource.data.adminIds &&
                            request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'ownerId', 'updatedAt', 'formerParticipants']) &&
                            (request.resource.data.groupName == null || request.resource.data.groupName is string) &&
                            (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                            request.resource.data.participants is list &&
                            request.resource.data.adminIds is list &&
                            (request.resource.data.ownerId == null || request.resource.data.ownerId is string) &&
                            (request.resource.data.ownerId == null || request.resource.data.ownerId in request.resource.data.participants) && // New owner must be participant
                            (request.resource.data.adminIds.hasAll(request.resource.data.participants) == false) && // Not all participants can be admins without reason
                            request.resource.data.adminIds.hasAll(request.resource.data.ownerId != null ? [request.resource.data.ownerId] : []) && // Owner (if exists) must be admin
                            (request.resource.data.formerParticipants == null || request.resource.data.formerParticipants is map)
                        ) ||
                        // Allow a user to update 'participants' and 'adminIds' (to remove themselves) and 'formerParticipants' (to add themselves) when leaving a group
                        (
                            resource.data.type == 'group' &&
                            request.auth.uid in resource.data.participants && // User is currently a participant
                            !(request.auth.uid in request.resource.data.participants) && // User is not in the new participants list (they are leaving)
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants']) &&
                            (resource.data.ownerId != request.auth.uid || request.resource.data.participants.size() == 0 || request.resource.data.ownerId != request.auth.uid ) && // Owner can only leave if group becomes empty or new owner is set (handled by transfer)
                            (request.resource.data.formerParticipants == null || (request.resource.data.formerParticipants[request.auth.uid] == request.time)) // If formerParticipants exists, their entry must be the server time
                        );
        // No general delete for conversations, manage via participant leaving or specific archival logic

        // Messages Subcollection
        match /messages/{messageId} {
            allow read, list: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                                (get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants == null || !(request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants));
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId &&
                            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                             (get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants == null || !(request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.formerParticipants)) &&
                            request.resource.data.timestamp == request.time &&
                            request.resource.data.conversationId == conversationId &&
                            request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                            request.resource.data.read == false &&
                            (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true) &&
                            (request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                            (request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                            request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId']) &&
                            request.resource.data.size() == 8;
            allow update, delete: if false; // Messages are immutable
        }
    }
  }
}

    