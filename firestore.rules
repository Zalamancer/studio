
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // DEFENSIVE VERSION of isAuthUserParticipant
    function isAuthUserParticipant(authUid, convData) {
      return authUid != null &&
             convData != null &&
             convData.participants != null &&
             convData.participants is list &&
             convData.participants.hasAny([authUid]);
    }

    function isGroupOwner(authUid, convData) {
      return authUid != null &&
             convData.type == 'group' &&
             convData.ownerId == authUid;
    }

    function isGroupAdmin(authUid, convData) {
      return authUid != null &&
             convData.type == 'group' &&
             convData.adminIds.hasAny([authUid]);
    }

    // =============================================
    // Stripe Customers and Subscriptions (from user)
    // =============================================
    match /stripe_customers/{userId} {
      allow read, write: if request.auth.uid == userId;

      match /subscriptions/{subscriptionId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /payment_methods/{paymentId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // =============================================
    // User Preferences (from user)
    // =============================================
    match /userPreferences/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // =============================================
    // Posts (from user)
    // =============================================
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts

      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time;
                       // Add other necessary field validations for create

      allow update: if request.auth != null && (
                      // Branch 1: Owner can update their post
                      ( resource.data.userId == request.auth.uid &&
                        request.resource.data.userId == resource.data.userId && // Cannot change owner
                        request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                        request.resource.data.updatedAt == request.time &&
                        // Owner cannot directly manipulate commentCount here, it's handled by Branch 2
                        !( 'commentCount' in request.resource.data.diff(resource.data).affectedKeys() &&
                           request.resource.data.commentCount != resource.data.commentCount + 1 &&
                           request.resource.data.commentCount != resource.data.commentCount - 1
                         )
                      ) ||
                      // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                        request.resource.data.updatedAt == request.time
                        // No need to check other fields like userId == resource.userId here,
                        // because hasOnly ensures they are NOT part of the update request.
                      )
                    );

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        allow read: if true; // Anyone can read comments

        allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0;

        allow update: if request.auth != null &&
                       ( // Branch 1: Comment owner can edit their comment text and mentions
                         ( request.auth.uid == resource.data.userId &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                           request.resource.data.userId == resource.data.userId && // Cannot change owner
                           request.resource.data.timestamp == resource.data.timestamp && // Cannot change original timestamp
                           request.resource.data.updatedAt == request.time
                         ) ||
                         // Branch 2: Any authenticated user can like/unlike (modifying likedBy and likeCount)
                         (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                           request.resource.data.userId == resource.data.userId && // Ensure core fields not changed
                           request.resource.data.text == resource.data.text &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time &&
                           // Validate likedBy array modification
                           ( request.resource.data.likedBy.hasAll(resource.data.likedBy) || // adding a like
                             resource.data.likedBy.hasAll(request.resource.data.likedBy)    // removing a like
                           ) &&
                           ( request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 ||
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
                           ) &&
                           // Validate likeCount increment/decrement
                           ( request.resource.data.likeCount == resource.data.likeCount + 1 ||
                             request.resource.data.likeCount == resource.data.likeCount - 1
                           )
                         )
                       );
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

        // --- SubComments (Replies) Subcollection ---
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if request.auth != null &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy.size() == 0;
          allow update: if request.auth != null &&
                         ( // Branch 1: SubComment owner can edit their text and mentions
                           ( request.auth.uid == resource.data.userId &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time
                           ) ||
                           // Branch 2: Any authenticated user can like/unlike
                           (
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time &&
                             ( request.resource.data.likedBy.hasAll(resource.data.likedBy) ||
                               resource.data.likedBy.hasAll(request.resource.data.likedBy)
                             ) &&
                             ( request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 ||
                               request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
                             ) &&
                             ( request.resource.data.likeCount == resource.data.likeCount + 1 ||
                               request.resource.data.likeCount == resource.data.likeCount - 1
                             )
                           )
                         );
          allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
      // --- Bids Subcollection (under posts) ---
      match /posts/{postId}/bids/{bidId} {
        allow read: if true; // Anyone can read bids on a post
        allow create: if request.auth != null &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         // Ensure bidder is not the post owner
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        // No updates or deletes allowed for bids for simplicity, or define if needed
      }
    }

    // =============================================
    // Users (from user)
    // =============================================
    match /users/{userId} {
      allow read: if true; // Anyone can read basic profile data

      allow create: if request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       // Ensure mentionName and mentionNameLowercase are provided and match rules
                       request.resource.data.mentionName is string &&
                       request.resource.data.mentionName.size() > 0 &&
                       request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower();
                       // Add other initial field validations if necessary

      allow update: if request.auth.uid == userId &&
                       request.resource.data.uid == resource.data.uid && // Cannot change UID
                       request.resource.data.email == resource.data.email && // Cannot change email via this
                       request.resource.data.mentionName == resource.data.mentionName && // Cannot change mentionName
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                       request.resource.data.updatedAt == request.time &&
                       // Allow specific fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'tags', 'established',
                         'lastLoginAt', 'updatedAt', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'incomeRange'
                       ]);
    }

    // =============================================
    // Mutual Connections (from user)
    // =============================================
    match /mutuals/{connectionId} {
      allow get, list, create, update, delete: if request.auth != null &&
                                            (connectionId.split('_')[0] == request.auth.uid ||
                                             connectionId.split('_')[1] == request.auth.uid) &&
                                            (request.resource == null || // For delete, get, list
                                             (request.resource.data.userIds.hasAll([request.auth.uid]) && // For create, update
                                             (request.method == 'create' || request.method == 'update' ? request.resource.data.updatedAt == request.time : true) &&
                                             (request.method == 'create' ? request.resource.data.createdAt == request.time : true)
                                             )
                                            );
    }

    // =============================================
    // Whiteboard Annotations (from user)
    // =============================================
    match /whiteboardAnnotations/{naicsCode} {
      allow read: if true; // Anyone can read whiteboard annotations for a NAICS code.
      allow write: if request.auth != null &&
                      request.resource.data.naicsCode == naicsCode && // Ensure doc ID matches field
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time &&
                      request.resource.data.shapes is list; // Ensure shapes is a list
                      // Add validation for shape properties if needed
    }
    
    // =============================================
    // Notifications (from user)
    // =============================================
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Only allow creating notifications via backend/functions for security.
      // If client needs to create certain types, add specific 'create' rules.
      allow create: if false; // Disallow client-side creation by default
    }

    // =============================================
    // Conversations & Messages
    // =============================================
    match /conversations/{conversationId} {
      function isAuthUserParticipant(authUid, convData) {
        return authUid != null &&
               convData != null &&
               convData.participants != null &&
               convData.participants is list &&
               convData.participants.hasAny([authUid]);
      }
      function isGroupOwner(authUid, convData) {
        return authUid != null &&
               convData.type == 'group' &&
               convData.ownerId == authUid;
      }
      function isGroupAdmin(authUid, convData) {
        return authUid != null &&
               convData.type == 'group' &&
               convData.adminIds.hasAny([authUid]);
      }

      allow get: if request.auth != null &&
                    isAuthUserParticipant(request.auth.uid, resource.data);
      allow list: if request.auth != null; // Secure with 'get' rule implicitly by Firestore

      allow create: if request.auth != null && (
                      // Direct Chat Creation
                      ( request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        isAuthUserParticipant(request.auth.uid, request.resource.data) &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds.size() == 0 &&
                        request.resource.data.groupName == null &&
                        request.resource.data.groupAvatarUrl == null &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        // Ensure only expected fields are present
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'createdAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                        request.resource.data.keys().size() == 11 // Count them carefully
                      ) ||
                      // Group Chat Creation
                      ( request.resource.data.type == 'group' &&
                        request.resource.data.ownerId == request.auth.uid && // Creator is owner
                        request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
                        request.resource.data.participants.hasAll([request.auth.uid]) && // Creator is participant
                        request.resource.data.participants.size() >= 2 && // At least 2 participants for a group (owner + 1)
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'createdAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                        request.resource.data.keys().size() == 11 // Count them carefully
                      )
                    );

      allow update: if request.auth != null && (
                      // Branch A: Updating lastMessage, lastMessageSenderId, lastMessageTimestamp, updatedAt
                      // Any participant can do this.
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.updatedAt == request.time &&
                        // Ensure immutable fields are not changed
                        request.resource.data.type == resource.data.type &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.participants.hasAll(resource.data.participants) && resource.data.participants.hasAll(request.resource.data.participants) && // participants list unchanged
                        request.resource.data.adminIds.hasAll(resource.data.adminIds) && resource.data.adminIds.hasAll(request.resource.data.adminIds) && // adminIds list unchanged
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl
                      ) ||
                      // Branch B: Admin updating groupName or groupAvatarUrl
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) && // Allow partial update
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) && // But only these specific keys
                        request.resource.data.updatedAt == request.time &&
                        // Ensure immutable fields are not changed
                        request.resource.data.participants.hasAll(resource.data.participants) && resource.data.participants.hasAll(request.resource.data.participants) &&
                        request.resource.data.adminIds.hasAll(resource.data.adminIds) && resource.data.adminIds.hasAll(request.resource.data.adminIds) && // Admin cannot change admin list here
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      ) ||
                      // Branch C: Admin/Owner adding/removing members (ensure owner is not removed by non-owner admin)
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
                        // Allow adding new participants (they must not be there before, and are there after)
                        ( request.resource.data.participants.size() > resource.data.participants.size() &&
                          request.resource.data.participants.hasAll(resource.data.participants)
                        ) ||
                        // Allow removing participants (they must be there before, and not there after)
                        ( resource.data.participants.size() > request.resource.data.participants.size() &&
                          resource.data.participants.hasAll(request.resource.data.participants) &&
                           // Owner check: if owner is being removed, requester must be owner
                          ( !resource.data.participants.hasAny([resource.data.ownerId]) || // if owner wasn't in participants (should not happen)
                            request.resource.data.participants.hasAny([resource.data.ownerId]) || // if owner still in participants
                            resource.data.ownerId == request.auth.uid // if owner is being removed, requester must be owner
                          )
                        ) &&
                        request.resource.data.updatedAt == request.time &&
                        // Ensure immutable fields are not changed
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      ) ||
                      // Branch D: Owner promoting/demoting admins
                      (
                        isGroupOwner(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
                        // New admins must be participants, owner must remain admin
                        request.resource.data.participants.hasAll(request.resource.data.adminIds) &&
                        request.resource.data.adminIds.hasAll([resource.data.ownerId]) &&
                        request.resource.data.updatedAt == request.time &&
                        // Ensure immutable fields are not changed
                        request.resource.data.participants.hasAll(resource.data.participants) && resource.data.participants.hasAll(request.resource.data.participants) &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      ) ||
                      // Branch E: Participant leaving group
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' &&
                        request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
                        !request.resource.data.participants.hasAny([request.auth.uid]) && // User is removed from participants
                        (!resource.data.adminIds.hasAny([request.auth.uid]) || !request.resource.data.adminIds.hasAny([request.auth.uid])) && // If user was admin, they are removed
                        // Owner safeguard: Owner cannot leave if they are the sole admin and other participants remain
                        !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && resource.data.adminIds.hasAny([request.auth.uid]) && request.resource.data.participants.size() > 0) &&
                        request.resource.data.updatedAt == request.time &&
                        // Ensure immutable fields are not changed
                        request.resource.data.ownerId == resource.data.ownerId &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.postId == resource.data.postId &&
                        request.resource.data.groupName == resource.data.groupName &&
                        request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                        request.resource.data.lastMessage == resource.data.lastMessage &&
                        request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
                        request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp
                      )
                    );

      // No direct deletion of conversations by client for now. Could be added if needed.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
                      isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if request.auth != null &&
                         isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time;
        allow update, delete: if request.auth != null &&
                                 resource.data.senderId == request.auth.uid; // Only sender can update/delete their own messages
      }
    }
  }
}

    