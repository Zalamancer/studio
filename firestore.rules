
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true; // Public profiles are readable
      allow create: if request.auth != null && request.auth.uid == userId; // User can create their own profile
      allow update: if request.auth != null && request.auth.uid == userId; // User can update their own profile
    }

    // --- Mutuals (Connections) Collection ---
    match /mutuals/{connectionId} {
        function isAuthenticated() {
            return request.auth != null;
        }

        function isUserInConnection() {
            return isAuthenticated() && request.auth.uid in resource.data.userIds;
        }
        
        function isUserInNewConnection() {
            return isAuthenticated() && request.auth.uid in request.resource.data.userIds;
        }
        
        function isValidNewConnectionRequest() {
          return request.resource.data.requesterId == request.auth.uid &&
                 request.resource.data.userIds.hasAll([request.auth.uid]) && // Redundant but safe
                 request.resource.data.userIds.size() == 2 &&
                 request.resource.data.status == 'pending' &&
                 request.resource.data.requestedAt == request.time;
        }

        allow read: if isUserInConnection();

        allow create: if isValidNewConnectionRequest();

        allow update: if isUserInConnection() &&
                       // Accepting a request
                       (request.resource.data.status == 'connected' &&
                        resource.data.status == 'pending' &&
                        request.resource.data.requesterId != request.auth.uid && // The acceptor cannot be the original requester
                        request.resource.data.connectedAt == request.time);

        allow delete: if isUserInConnection();
    }


    // --- Posts Collection ---
    match /posts/{postId} {
        function isPostOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read: if true; // Anyone can read posts
        allow list: if true; // Allow querying posts

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.createdAt == request.time; // Ensure server sets timestamp

        allow update: if isAuthenticated() &&
                       // Case 1: Owner editing the post content
                       (isPostOwner() &&
                        request.resource.data.diff(resource.data).hasAny(['question', 'description', 'tags', 'imageUrls'])) ||
                       // Case 2: System (or trusted function) updating comment count
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        (request.resource.data.commentCount == resource.data.commentCount + 1 ||
                         request.resource.data.commentCount == resource.data.commentCount - 1));

        allow delete: if isPostOwner();

        // --- Comments Subcollection ---
        match /comments/{commentId} {
            function isCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            allow list: if true;
            allow read: if true;
            allow create: if isAuthenticated();
            allow update: if isAuthenticated() &&
                           (isCommentOwner() ||
                           // Allow anyone to like/unlike
                           (request.resource.data.diff(resource.data).hasOnly(['likedBy', 'likeCount']) &&
                            (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1)));
            allow delete: if isCommentOwner();

            // --- SubComments Subcollection ---
            match /subcomments/{subCommentId} {
                function isSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }
                allow list: if true;
                allow read: if true;
                allow create: if isAuthenticated();
                allow update: if isAuthenticated() &&
                                (isSubCommentOwner() ||
                                // Allow anyone to like/unlike
                                (request.resource.data.diff(resource.data).hasOnly(['likedBy', 'likeCount']) &&
                                (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1)));
                allow delete: if isSubCommentOwner();
            }
        }

        // --- Bids Subcollection ---
        match /bids/{bidId} {
            function isPostOwnerForBidContext() {
                // Get the parent post document
                let post = get(/databases/$(database)/documents/posts/$(postId));
                return isAuthenticated() && request.auth.uid == post.data.userId;
            }
            function isBidder() {
                return isAuthenticated() && request.auth.uid == resource.data.bidderId;
            }
            allow list: if isAuthenticated() && (isPostOwnerForBidContext() || isBidder());
            allow read: if isAuthenticated() && (isPostOwnerForBidContext() || isBidder());
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.bidderId;
            allow delete: if false; // Generally, bids shouldn't be deleted
        }
    }
    
    // --- Article Tags Collection ---
    match /articleTags/{tagId} {
        allow read: if true;
        allow list: if true;

        allow create: if isAuthenticated() &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount >= 0 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy', 'updatedAt']) &&
                         request.resource.data.size() == 6;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.name == resource.data.name &&
                         request.resource.data.nameLowercase == resource.data.nameLowercase &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'updatedAt']);
        allow delete: if false;
    }

    // --- News Articles Collection ---
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read: if resource.data.status == 'published' || isNewsArticleOwner();
        allow list: if true;

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.content is string &&
                         request.resource.data.status in ['draft', 'published'] &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.status == 'draft' ? request.resource.data.publishedAt == null : request.resource.data.publishedAt == request.time) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.keys().hasAll([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount'
                         ]) &&
                         request.resource.data.size() == 14;

        allow update: if isAuthenticated() &&
                       request.resource.data.updatedAt == request.time &&
                       (
                         ( // Case 1: Owner updating their article
                           isNewsArticleOwner() &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.createdAt == resource.data.createdAt &&
                           request.resource.data.commentCount == resource.data.commentCount &&
                           request.resource.data.likeCount == resource.data.likeCount &&
                           request.resource.data.likedBy == resource.data.likedBy &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'title', 'content', 'tags', 'status', 'coverImageUrl', 'draftContent',
                             'hasUnpublishedChanges', 'publishedAt', 'updatedAt'
                           ]) &&
                           (request.resource.data.status == 'published' ? request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == resource.data.publishedAt : true) &&
                           (request.resource.data.status == 'draft' ? request.resource.data.publishedAt == null : true)
                         ) ||
                         ( // Case 2: Any authenticated user liking/unliking (but not the author)
                           request.auth.uid != resource.data.userId &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           (
                             (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid])) ||
                             (request.resource.data.likedBy == resource.data.likedBy.removed(request.auth.uid))
                           )
                         ) ||
                         ( // Case 3: System (or trusted function) updating commentCount
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                           (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1)
                         )
                       );

        allow delete: if isNewsArticleOwner();

        // --- News Comments Subcollection ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true;
            allow read: if resource.data.get('isShadowBanned', false) == false || isParentArticleOwner() || isArticleCommentOwner();

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.mentionName is string &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9;

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                             request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                             request.resource.data.get('isShadowBanned', false) == resource.data.get('isShadowBanned', false) &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                              request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                             request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                             request.resource.data.likeCount == resource.data.likeCount &&
                             request.resource.data.likedBy == resource.data.likedBy
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true;
                allow read: if resource.data.get('isShadowBanned', false) == false || isParentArticleOwner() || isArticleSubCommentOwner();

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.mentionName is string &&
                               request.resource.data.isShadowBanned == false &&
                               request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                               request.resource.data.size() == 9;

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                                 request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                                 request.resource.data.get('isShadowBanned', false) == resource.data.get('isShadowBanned', false) &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                                  request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                                 request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                                 request.resource.data.likeCount == resource.data.likeCount &&
                                 request.resource.data.likedBy == resource.data.likedBy
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }

    // --- Plans Collection ---
    match /plans/{planId} {
        function isPlanOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }

        function canViewPlan() {
          let plan = get(/databases/$(database)/documents/plans/$(planId)).data;
          return (plan.visibility == 'public' ||
                  plan.visibility == 'unlisted' ||
                  (plan.visibility == 'private' && request.auth.uid in plan.viewUserIds));
        }
        
        function canEditPlan() {
            let plan = get(/databases/$(database)/documents/plans/$(planId)).data;
            return (plan.ownerId == request.auth.uid ||
                    (plan.editability == 'everyone' && canViewPlan()) ||
                    (plan.editability == 'collaborators' && request.auth.uid in plan.editUserIds));
        }

        allow read: if canViewPlan();

        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.version == 1;

        allow update: if isAuthenticated() && canEditPlan() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.ownerId == resource.data.ownerId &&
                         request.resource.data.createdAt == resource.data.createdAt;
                         

        allow delete: if isPlanOwner();

        match /versions/{versionId} {
            allow read, list: if canViewPlan();
            allow create: if isAuthenticated() && canEditPlan() &&
                           request.resource.data.editorUid == request.auth.uid &&
                           request.resource.data.timestamp == request.time;
            allow update, delete: if false;
        }
    }
    
    // --- Reviews Collection ---
    match /reviews/{reviewId} {
        function isReviewOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.reviewerId;
        }
        allow read: if true; // Reviews are public
        allow list: if true;
        allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.reviewerId &&
                       request.resource.data.targetUserId != request.auth.uid; // Cannot review yourself
        allow update: if isReviewOwner();
        allow delete: if isReviewOwner();
    }
  }
}
