
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isOwner() {
        return isAuthenticated() && request.auth.uid == userId;
      }
      function isProfileOwner(profileUid) { // Renamed to avoid conflict
        return isAuthenticated() && request.auth.uid == profileUid;
      }

      allow read: if true; // Profiles are generally public, client filters based on visibility settings
      allow list: if isAuthenticated(); // Allow querying users for suggestions, e.g., mentions, connections
      allow create: if isAuthenticated() &&
                     request.resource.data.uid == request.auth.uid &&
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.lastLoginAt == request.time &&
                     request.resource.data.keys().hasAll([
                       'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                       'avatarUrl', 'industry', 'descriptionVisibility', 'createdAt', 'updatedAt', 'lastLoginAt'
                     ]) &&
                     request.resource.data.size() >= 11 && request.resource.data.size() <= 22;


      allow update: if isOwner() &&
                       request.resource.data.uid == resource.data.uid && 
                       request.resource.data.email == resource.data.email && 
                       request.resource.data.mentionName == resource.data.mentionName && 
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && 
                       request.resource.data.companyName == resource.data.companyName && 
                       request.resource.data.createdAt == resource.data.createdAt && 
                       request.resource.data.updatedAt == request.time && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'tags', 'established', 'lastLoginAt', 'updatedAt',
                         'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode'
                       ]);
      allow delete: if isOwner(); 
    }

    // --- User Preferences Collection ---
    match /userPreferences/{userId} {
      function isOwner() {
        return isAuthenticated() && request.auth.uid == userId;
      }
      allow read, write: if isOwner();
      allow create: if isOwner() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isOwner() &&
                       request.resource.data.userId == resource.data.userId && 
                       request.resource.data.createdAt == resource.data.createdAt && 
                       request.resource.data.updatedAt == request.time;
    }

    // --- Mutuals (Connections) Collection ---
    match /mutuals/{connectionId} {
        function isUserInConnection() {
            return isAuthenticated() && request.auth.uid in resource.data.userIds;
        }
        function isRequester() {
            return isAuthenticated() && request.auth.uid == request.resource.data.requesterId;
        }
        function isRecipient() {
             return isAuthenticated() && request.auth.uid != request.resource.data.requesterId && request.auth.uid in request.resource.data.userIds;
        }
        function isConnectionDocIdValid(uid1, uid2) {
            return connectionId == (uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1);
        }

        allow read: if isUserInConnection();
        allow list: if isAuthenticated() && request.query.filters.size() > 0;

        allow create: if isAuthenticated() && 
                         isRequester() &&     
                         request.resource.data.userIds.hasAll([request.auth.uid]) && 
                         request.resource.data.userIds.size() == 2 && 
                         isConnectionDocIdValid(request.resource.data.userIds[0], request.resource.data.userIds[1]) && 
                         request.resource.data.status == 'pending' && 
                         request.resource.data.requestedAt == request.time && 
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                         request.resource.data.size() == 5;

        allow update: if isAuthenticated() &&
                         isUserInConnection() && 
                         request.resource.data.updatedAt == request.time && 
                         ( 
                           isRecipient() && 
                           resource.data.status == 'pending' && 
                           request.resource.data.status == 'connected' && 
                           request.resource.data.connectedAt == request.time && 
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])
                         );
        allow delete: if isAuthenticated() && isUserInConnection();
    }

    // --- Posts Collection ---
    match /posts/{postId} {
      function isPostOwner() {
        return isAuthenticated() && request.auth.uid == resource.data.userId;
      }
      allow read: if true; 
      allow list: if true; 

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.requestType in ['post', 'help_request'] &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 &&
                       request.resource.data.keys().hasAll([
                         'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                         'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType', 'createdAt', 'commentCount',
                         'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline'
                       ]) &&
                       request.resource.data.size() == 17; 

      allow update: if isPostOwner() &&
                       request.resource.data.userId == resource.data.userId && 
                       request.resource.data.createdAt == resource.data.createdAt && 
                       (
                         ( 
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls',
                             'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                             'maxBudget', 'deadline', 'requestType', 'updatedAt' 
                           ]) &&
                           request.resource.data.updatedAt == request.time 
                         ) ||
                         ( 
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                           (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                            request.resource.data.updatedAt == request.time 
                         )
                       );

      allow delete: if isPostOwner();

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        function isCommentOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }
        allow read: if true; 
        allow list: if true; 

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.isShadowBanned == false &&
                         request.resource.data.keys().hasAll(['userId', 'postId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                         request.resource.data.size() == 10;


        allow update: if isAuthenticated() && 
                        request.resource.data.updatedAt == request.time && 
                        request.resource.data.userId == resource.data.userId && 
                        request.resource.data.postId == resource.data.postId && 
                        request.resource.data.timestamp == resource.data.timestamp && 
                        request.resource.data.text == resource.data.text && 
                        request.resource.data.mentionName == resource.data.mentionName && 
                        request.resource.data.mentionedUserIds == resource.data.mentionedUserIds && 
                        request.resource.data.isShadowBanned == resource.data.isShadowBanned && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                        (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                        (
                            (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid))) || 
                            (request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))   
                        );

        allow delete: if isCommentOwner();

        // --- SubComments Subcollection ---
        match /subcomments/{subCommentId} {
            function isSubCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            allow read: if true;
            allow list: if true;

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 8; 

            allow update: if isAuthenticated() &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                              request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)));

            allow delete: if isSubCommentOwner();
        }
      }
      // --- Bids Subcollection ---
      match /bids/{bidId} {
          function isBidOwner() {
              return isAuthenticated() && request.auth.uid == resource.data.bidderId;
          }
          function isPostOwnerForBid() {
              let postResource = get(/databases/$(database)/documents/posts/$(postId));
              return isAuthenticated() && request.auth.uid == postResource.data.userId;
          }

          allow read: if isAuthenticated(); 
          allow list: if isAuthenticated(); 

          allow create: if isAuthenticated() &&
                           request.resource.data.bidderId == request.auth.uid &&
                           request.resource.data.postId == postId &&
                           request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId &&
                           request.resource.data.keys().hasAll(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                           request.resource.data.size() == 5;
          allow update: if false; 
          allow delete: if isBidOwner(); 
      }
    }

    // --- Conversations Collection ---
    match /conversations/{conversationId} {
        function isUserParticipant() {
            return isAuthenticated() && request.auth.uid in resource.data.participants;
        }
        function isUserFormerParticipant() {
             return isAuthenticated() && request.auth.uid in resource.data.formerParticipants;
        }
        function isUserOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }
        function isUserAdmin() {
            return isAuthenticated() && request.auth.uid in resource.data.adminIds;
        }

        allow read: if isUserParticipant() || isUserFormerParticipant(); 
        allow list: if isAuthenticated() && request.query.filters.size() > 0; 

        allow create: if isAuthenticated() &&
                         request.resource.data.participants.hasAll([request.auth.uid]) && 
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.lastMessageTimestamp == request.time &&
                         ( 
                           (request.resource.data.type == 'direct' &&
                            request.resource.data.participants.size() == 2 &&
                            request.resource.data.groupName == null &&
                            request.resource.data.groupAvatarUrl == null &&
                            request.resource.data.ownerId == null &&
                            request.resource.data.adminIds.size() == 0 &&
                            request.resource.data.keys().hasAll([
                                'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                                'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl',
                                'ownerId', 'adminIds' 
                            ]) &&
                            (request.resource.data.size() == 11 || (request.resource.data.keys().hasAny(['formerParticipants']) && request.resource.data.size() == 12))
                           ) ||
                           (request.resource.data.type == 'group' &&
                            request.resource.data.participants.size() >= 2 && 
                            request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                            (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                            request.resource.data.ownerId == request.auth.uid && 
                            request.resource.data.adminIds.hasAll([request.auth.uid]) && 
                            request.resource.data.postId == null && 
                            request.resource.data.keys().hasAll([
                                'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                                'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl',
                                'ownerId', 'adminIds' 
                            ]) &&
                            (request.resource.data.size() == 11 || (request.resource.data.keys().hasAny(['formerParticipants']) && request.resource.data.size() == 12))
                           )
                         );

        allow update: if isAuthenticated() && isUserParticipant() && 
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.postId == resource.data.postId && 
                         ( 
                           request.resource.data.diff(resource.data).affectedKeys().hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                           request.resource.data.participants == resource.data.participants &&
                           request.resource.data.groupName == resource.data.groupName &&
                           request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                           request.resource.data.ownerId == resource.data.ownerId &&
                           request.resource.data.adminIds == resource.data.adminIds
                         ) ||
                         ( 
                           resource.data.type == 'group' && isUserAdmin() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                           request.resource.data.participants == resource.data.participants &&
                           request.resource.data.ownerId == resource.data.ownerId &&
                           request.resource.data.adminIds == resource.data.adminIds 
                         ) ||
                         ( 
                           resource.data.type == 'group' && isUserAdmin() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'updatedAt', 'adminIds']) && 
                           request.resource.data.groupName == resource.data.groupName &&
                           request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
                           request.resource.data.ownerId == resource.data.ownerId 
                         ) ||
                         ( 
                           resource.data.type == 'group' && isUserOwner() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'adminIds', 'updatedAt']) &&
                           request.resource.data.ownerId != resource.data.ownerId ? 
                             (request.resource.data.ownerId in resource.data.participants && 
                              request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) && 
                              request.auth.uid in request.resource.data.adminIds 
                             ) : true && 
                           request.resource.data.participants == resource.data.participants &&
                           request.resource.data.groupName == resource.data.groupName &&
                           request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl
                         ) ||
                         ( 
                           resource.data.type == 'group' &&
                           request.auth.uid in resource.data.participants && 
                           !(request.auth.uid in request.resource.data.participants) && 
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'ownerId', 'updatedAt', 'formerParticipants']) &&
                           ( 
                             resource.data.ownerId == request.auth.uid ?
                               (request.resource.data.participants.size() == 0 ? 
                                 (request.resource.data.ownerId == null && request.resource.data.adminIds.size() == 0) :
                                 (request.resource.data.ownerId in request.resource.data.participants && 
                                  request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) 
                                 )
                               ) :
                               (request.resource.data.ownerId == resource.data.ownerId) 
                           ) &&
                           (request.resource.data.formerParticipants[request.auth.uid] == request.time) 
                         );
        allow delete: if false; 

        // --- Messages Subcollection ---
        match /messages/{messageId} {
            function isSender() {
                return isAuthenticated() && request.auth.uid == request.resource.data.senderId;
            }
            allow read: if isUserParticipant();
            allow list: if isUserParticipant();

            allow create: if isAuthenticated() &&
                             isSender() && 
                             request.resource.data.conversationId == conversationId &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 10000 &&
                             request.resource.data.timestamp == request.time && 
                             request.resource.data.read == false && 
                             request.resource.data.isBotMessage is bool &&
                             (request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                             (request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                             request.resource.data.keys().hasAll([
                                'conversationId', 'senderId', 'text', 'timestamp', 'read', 'isBotMessage',
                                'replyToMessageId', 'repliedToTextSnippet'
                             ]) &&
                             request.resource.data.size() == 8;

            allow update: if isAuthenticated() &&
                             isUserParticipant() && 
                             request.resource.data.senderId == resource.data.senderId && 
                             request.resource.data.text == resource.data.text && 
                             request.resource.data.timestamp == resource.data.timestamp && 
                             request.resource.data.isBotMessage == resource.data.isBotMessage &&
                             request.resource.data.replyToMessageId == resource.data.replyToMessageId &&
                             request.resource.data.repliedToTextSnippet == resource.data.repliedToTextSnippet &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

            allow delete: if false; 
        }
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
        function isNotificationRecipient() {
            return isAuthenticated() && request.auth.uid == resource.data.userId;
        }
        allow read, list: if isNotificationRecipient(); 

        allow create: if isAuthenticated() && 
                         request.resource.data.userId is string && 
                         request.resource.data.type is string && 
                         request.resource.data.senderId is string && 
                         request.resource.data.timestamp == request.time && 
                         request.resource.data.isRead == false && 
                         request.resource.data.keys().hasAll([
                           'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                           'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId',
                           'textSnippet', 'timestamp', 'isRead'
                         ]) &&
                         request.resource.data.size() == 13;

        allow update: if isNotificationRecipient() && 
                         request.resource.data.userId == resource.data.userId && 
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.senderId == resource.data.senderId &&
                         request.resource.data.senderName == resource.data.senderName &&
                         request.resource.data.senderAvatar == resource.data.senderAvatar &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.postQuestion == resource.data.postQuestion &&
                         request.resource.data.commentId == resource.data.commentId &&
                         request.resource.data.subCommentId == resource.data.subCommentId &&
                         request.resource.data.conversationId == resource.data.conversationId &&
                         request.resource.data.textSnippet == resource.data.textSnippet &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) &&
                         request.resource.data.updatedAt == request.time; 

        allow delete: if isNotificationRecipient(); 
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
        function isReviewer() {
            return isAuthenticated() && request.auth.uid == resource.data.reviewerId;
        }
        allow read: if true; 
        allow list: if true; 

        allow create: if isAuthenticated() &&
                         request.resource.data.reviewerId == request.auth.uid && 
                         request.resource.data.targetUserId != request.auth.uid && 
                         request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string && request.resource.data.comment.size() <= 2000 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll([
                           'targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar',
                           'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt'
                         ]) &&
                         request.resource.data.size() == 9;

        allow update: if isReviewer() && 
                         request.resource.data.reviewerId == resource.data.reviewerId && 
                         request.resource.data.targetUserId == resource.data.targetUserId && 
                         request.resource.data.createdAt == resource.data.createdAt && 
                         request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && 
                         request.resource.data.updatedAt == request.time && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

        allow delete: if isReviewer(); 
    }

    // --- Article Tags Collection ---
    match /articleTags/{tagId} {
        allow read: if true; 
        allow list: if true; 

        allow create: if isAuthenticated() &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount >= 0 && 
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']) &&
                         request.resource.data.size() == 5;

 allow update: if isAuthenticated() &&
 request.resource.data.updatedAt == request.time;

        allow delete: if false;
    }

    // --- News Articles Collection ---
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read: if resource.data.status == 'published' || isNewsArticleOwner();
        allow list: if true;

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.content is string &&
                         request.resource.data.status in ['draft', 'published'] &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         ( (request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time) ||
                           (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null) ) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.keys().hasAll([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount'
                         ]) &&
                         request.resource.data.size() == 14;

        allow update: if isAuthenticated() &&
                       request.resource.data.updatedAt == request.time &&
                       ( // Case 1: Owner updating their article
                         isNewsArticleOwner() &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.commentCount == resource.data.commentCount &&
                         request.resource.data.likeCount == resource.data.likeCount &&
                         request.resource.data.likedBy == resource.data.likedBy &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'content', 'tags', 'status', 'coverImageUrl',
                           'draftContent', 'hasUnpublishedChanges', 'publishedAt', 'updatedAt'
                         ]) &&
                         ( (request.resource.data.status == 'published' && resource.data.status == 'draft' && request.resource.data.publishedAt == request.time) ||
                           (request.resource.data.status == 'published' && resource.data.status == 'published' && request.resource.data.publishedAt == resource.data.publishedAt) ||
                           (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null)
                         )
                       ) ||
                       ( // Case 2: Any authenticated user liking/unliking (not author)
                         request.auth.uid != resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                           ( // Liking
                             request.resource.data.likeCount == resource.data.likeCount + 1 &&
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
                             request.auth.uid in request.resource.data.likedBy &&
                             !(request.auth.uid in resource.data.likedBy)
                           ) ||
                           ( // Unliking
                             request.resource.data.likeCount == resource.data.likeCount - 1 &&
                             request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
                             !(request.auth.uid in request.resource.data.likedBy) &&
                             request.auth.uid in resource.data.likedBy
                           )
                         )
                       ) ||
                       ( // Case 3: System (or trusted function) updating commentCount
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                         (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.title == resource.data.title &&
                         request.resource.data.content == resource.data.content &&
                         request.resource.data.status == resource.data.status &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.likeCount == resource.data.likeCount &&
                         request.resource.data.likedBy == resource.data.likedBy
                       );

        allow delete: if isNewsArticleOwner();

        // --- News Comments Subcollection (for 'newsArticles') ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true;
            allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleCommentOwner();

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9;

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName &&
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                              request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.mentionName == resource.data.mentionName &&
                             request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                             request.resource.data.likeCount == resource.data.likeCount &&
                             request.resource.data.likedBy == resource.data.likedBy
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true;
                allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleSubCommentOwner();

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.isShadowBanned == false &&
                               request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']) &&
                               request.resource.data.size() == 8;

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                 request.resource.data.isShadowBanned == resource.data.isShadowBanned &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (request.resource.data.likedBy.hasOnly(resource.data.likedBy.added(request.auth.uid)) ||
                                  request.resource.data.likedBy.hasOnly(resource.data.likedBy.removed(request.auth.uid)))
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.mentionedUserIds == resource.data.mentionedUserIds &&
                                 request.resource.data.likeCount == resource.data.likeCount &&
                                 request.resource.data.likedBy == resource.data.likedBy
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }

    // --- Collaboration Plans Collection ---
    match /plans/{planId} {
        function isPlanOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }
        function canUserView() {
            return resource.data.visibility == 'public' ||
                   resource.data.visibility == 'unlisted' || // Unlisted can be viewed by anyone with link (implies client has ID)
                   (isAuthenticated() && request.auth.uid in resource.data.viewUserIds);
        }
        function canUserEdit() {
            return (isPlanOwner()) ||
                   (isAuthenticated() && resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
                   (isAuthenticated() && resource.data.editability == 'everyone' && canUserView()); // If 'everyone' can edit, they must also be able to view
        }

        allow read: if canUserView();
        allow list: if true; // Allow listing of public/unlisted plans (client filters further if needed)

        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.version == 1 &&
                         request.resource.data.roadmap is list && // roadmap can be empty on create
                         request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                         request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                         request.resource.data.viewUserIds is list &&
                         request.resource.data.editUserIds is list &&
                         // Check correct setup of view/edit arrays based on visibility/editability
                         (request.resource.data.visibility == 'public' ? request.resource.data.viewUserIds.size() == 0 : request.resource.data.viewUserIds.hasAll([request.auth.uid])) &&
                         (request.resource.data.editability == 'owner_only' ? request.resource.data.editUserIds.hasAll([request.auth.uid]) :
                           (request.resource.data.editability == 'collaborators' ? request.resource.data.editUserIds.hasAll([request.auth.uid]) : request.resource.data.editUserIds.size() == 0)
                         ) &&
                         request.resource.data.keys().hasAll([
                            'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                            'createdAt', 'updatedAt', 'version', 'roadmap',
                            'visibility', 'editability', 'viewUserIds', 'editUserIds'
                         ]) &&
                         request.resource.data.size() == 15;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.ownerId == resource.data.ownerId &&     // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                         ( // Path 1: User with edit permissions updating the roadmap
                           (canUserEdit() &&
                            request.resource.data.version == resource.data.version + 1 && // Version must increment
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                            // Ensure settings are not changed via roadmap update path
                            request.resource.data.name == resource.data.name &&
                            request.resource.data.description == resource.data.description &&
                            request.resource.data.sector == resource.data.sector &&
                            request.resource.data.subSector == resource.data.subSector &&
                            request.resource.data.industry == resource.data.industry &&
                            request.resource.data.naicsCode == resource.data.naicsCode &&
                            request.resource.data.visibility == resource.data.visibility &&
                            request.resource.data.editability == resource.data.editability &&
                            request.resource.data.viewUserIds == resource.data.viewUserIds &&
                            request.resource.data.editUserIds == resource.data.editUserIds
                           ) ||
                           // Path 2: Plan owner updating settings (name, description, sector, visibility, editability, user lists)
                           (isPlanOwner() &&
                            request.resource.data.version == resource.data.version && // Version does not change for settings update
                            request.resource.data.roadmap == resource.data.roadmap &&   // Roadmap does not change for settings update
                            request.resource.data.diff(resource.data).affectedKeys().hasAny([
                                'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                            ]) &&
                            // Visibility and Editability consistency checks during update
                            (request.resource.data.visibility == 'private' ? request.resource.data.editability == 'owner_only' : true) &&
                            (request.resource.data.visibility == 'unlisted' ? request.resource.data.editability != 'everyone' : true) &&
                            // Ensure viewUserIds and editUserIds are consistent with new visibility/editability
                            (request.resource.data.visibility == 'public' ? request.resource.data.viewUserIds.size() == 0 : request.resource.data.viewUserIds.hasAll([request.auth.uid])) &&
                            (request.resource.data.editability == 'owner_only' ? request.resource.data.editUserIds.hasAll([request.auth.uid]) :
                              (request.resource.data.editability == 'collaborators' ? request.resource.data.editUserIds.hasAll([request.auth.uid]) : request.resource.data.editUserIds.size() == 0)
                            ) &&
                            // If not public, editors must be in viewers list
                            (request.resource.data.visibility != 'public' ? request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds) : true)
                           )
                         );

        allow delete: if isPlanOwner();

        // Subcollection for plan versions
        match /versions/{versionId} {
            allow read: if canUserView(); // Same read permission as parent plan
            allow list: if canUserView(); // Same list permission

            allow create: if canUserEdit() && // Only users who can edit the plan can create a version snapshot
                             request.resource.data.planId == planId &&
                             request.resource.data.editorUid == request.auth.uid &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.versionNumber is number && request.resource.data.versionNumber > 0 &&
                             request.resource.data.roadmap is list &&
                             request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                             request.resource.data.size() == 5;

            allow update, delete: if false; // Versions are immutable
        }
    }

    // --- User Collections ---
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return isAuthenticated() && request.auth.uid == resource.data.ownerId;
      }
      function isSharedWithUser() {
        return isAuthenticated() && request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isCollectionOwner() || isSharedWithUser();
      allow list: if isAuthenticated() && request.query.filters.size() > 0;

      allow create: if isAuthenticated() &&
                     request.resource.data.ownerId == request.auth.uid &&
                     request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                     request.resource.data.postIds is list && // Can be empty on create
                     request.resource.data.sharedWithUserIds is list && // Can be empty on create
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                     request.resource.data.size() == 7;

      allow update: if isCollectionOwner() &&
                     request.resource.data.ownerId == resource.data.ownerId && // Cannot change owner
                     request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                     request.resource.data.updatedAt == request.time &&
                     // Allow name, description, postIds, and sharedWithUserIds to be updated by owner
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);

      allow delete: if isCollectionOwner();
    }
  }
}

    