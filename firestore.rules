
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true; // Public profiles are readable
      allow create: if request.auth != null && request.auth.uid == userId; // User can create their own profile
      allow update: if request.auth != null && request.auth.uid == userId; // User can update their own profile
    }

    // --- Posts Collection ---
    match /posts/{postId} {
      allow read: if true; // All posts are public
      allow list: if true; // Allow querying for posts list
      allow create: if request.auth.uid == request.resource.data.userId; // User can create posts for themselves
      allow delete: if request.auth.uid == resource.data.userId; // User can delete their own posts

      // Comments Subcollection
      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if request.auth.uid == request.resource.data.userId; // Authenticated users can comment
        allow delete: if request.auth.uid == resource.data.userId; // User can delete their own comment
        allow update: if request.auth.uid == resource.data.userId; // User can edit their own comment
        
        // Sub-comments (Replies)
        match /subcomments/{subCommentId} {
           allow read, list: if true;
           allow create: if request.auth.uid == request.resource.data.userId; // Authenticated users can reply
           allow delete: if request.auth.uid == resource.data.userId; // User can delete their own reply
           allow update: if request.auth.uid == resource.data.userId; // User can edit their own reply
        }
      }
    }

    // --- Mutuals Collection (for Connections) ---
    match /mutuals/{connectionId} {
      function isOwner() {
        return request.auth.uid == resource.data.requesterId;
      }
      function isRecipient() {
        return request.auth.uid in resource.data.userIds && request.auth.uid != resource.data.requesterId;
      }
      function isParticipant() {
        return request.auth.uid in resource.data.userIds;
      }
      allow get: if isParticipant();
      allow create: if request.auth.uid == request.resource.data.requesterId && request.auth.uid in request.resource.data.userIds;
      allow update: if (isRecipient() && request.resource.data.status == 'connected') || (isOwner() && request.resource.data.status == 'blocked');
      allow delete: if isParticipant();
    }
    
    // --- Conversations Collection ---
    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function isGroupAdmin() {
          return resource.data.type == 'group' && request.auth.uid in resource.data.adminIds;
      }
      function isGroupOwner() {
          return resource.data.type == 'group' && request.auth.uid == resource.data.ownerId;
      }
       function creatingValidDirectChat() {
        return request.resource.data.type == 'direct' &&
               request.resource.data.participants.size() == 2 &&
               request.auth.uid in request.resource.data.participants &&
               request.resource.data.groupName == null &&
               request.resource.data.groupAvatarUrl == null &&
               request.resource.data.ownerId == null &&
               request.resource.data.adminIds.size() == 0;
      }
      function creatingValidGroupChat() {
          return request.resource.data.type == 'group' &&
                 request.resource.data.participants.size() >= 2 &&
                 request.auth.uid in request.resource.data.participants &&
                 request.resource.data.ownerId == request.auth.uid &&
                 request.resource.data.adminIds.size() >= 1 &&
                 request.auth.uid in request.resource.data.adminIds &&
                 request.resource.data.groupName is string &&
                 request.resource.data.groupName.size() > 0;
      }

      allow get, list: if isParticipant();

      allow create: if request.auth != null && 
                       (creatingValidDirectChat() || creatingValidGroupChat());

      allow update: if isParticipant() && 
                       ( // Updating last message details
                         request.resource.data.diff(resource.data).affectedKeys().hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])
                       ) ||
                       ( // Group admin updating details
                         isGroupAdmin() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'updatedAt'])
                       ) ||
                       ( // Group owner transferring ownership
                         isGroupOwner() &&
                         request.resource.data.ownerId != resource.data.ownerId && // ownerId is changing
                         request.resource.data.ownerId in resource.data.participants && // new owner is a participant
                         request.auth.uid in request.resource.data.adminIds && // old owner remains an admin
                         request.resource.data.ownerId in request.resource.data.adminIds && // new owner becomes an admin
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt'])
                       );


      // Messages Subcollection
      match /messages/{messageId} {
        allow read, list: if isParticipant();
        allow create: if request.auth.uid == request.resource.data.senderId && isParticipant();
      }
    }

    // --- Article Tags Collection ---
    match /articleTags/{tagId} {
        allow read: if true; // Tags are generally public for searching/displaying
        allow list: if true; // Allow querying tags for suggestions

        allow create: if isAuthenticated() &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount >= 0 && // Can be 0 or 1 on create
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time && // Add updatedAt to create rule
                         request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy', 'updatedAt']) &&
                         request.resource.data.size() == 6;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time;
                         // This is a simplified rule for diagnostics. A more secure rule would be:
                         // request.resource.data.name == resource.data.name &&
                         // request.resource.data.nameLowercase == resource.data.nameLowercase &&
                         // request.resource.data.createdAt == resource.data.createdAt &&
                         // request.resource.data.createdBy == resource.data.createdBy &&
                         // request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'updatedAt']);

        allow delete: if false; // Tags are not typically deleted, usageCount goes to 0
    }

    // --- News Articles Collection ---
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }
        
        function isAuthenticated() {
           return request.auth != null;
        }

        allow read: if resource.data.status == 'published' || isNewsArticleOwner();
        allow list: if true;

        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.content is string &&
                         request.resource.data.status in ['draft', 'published'] &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Rule for publishedAt based on status
                         (request.resource.data.status == 'draft' ? request.resource.data.publishedAt == null : request.resource.data.publishedAt == request.time) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.keys().hasAll([
                           'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                           'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount'
                         ]) &&
                         request.resource.data.size() == 14;

        allow update: if isAuthenticated() &&
                       request.resource.data.updatedAt == request.time &&
                       ( // Case 1: Owner updating their article (draft or published)
                         isNewsArticleOwner() &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.commentCount == resource.data.commentCount &&
                         request.resource.data.likeCount == resource.data.likeCount &&
                         request.resource.data.likedBy == resource.data.likedBy &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'content', 'tags', 'status', 'coverImageUrl',
                           'draftContent', 'hasUnpublishedChanges', 'publishedAt', 'updatedAt'
                         ])
                       ) ||
                       ( // Case 2: Any authenticated user liking/unliking (but not the author)
                         request.auth.uid != resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                           (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet()) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy) || // Liking
                           (resource.data.likedBy.toSet().hasAll(request.resource.data.likedBy.toSet()) && resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1 && !(request.auth.uid in request.resource.data.likedBy))    // Unliking
                         )
                       ) ||
                       ( // Case 3: System (or trusted function) updating commentCount
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                         (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1)
                       );

        allow delete: if isNewsArticleOwner();

        // --- News Comments Subcollection (for 'newsArticles') ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true;
            allow read: if resource.data.isShadowBanned == false || isParentArticleOwner() || isArticleCommentOwner();

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9;

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             // Ensure other fields are immutable for this case
                             request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
                             request.resource.data.get('text', '') == resource.data.get('text', '') &&
                             request.resource.data.get('timestamp', null) == resource.data.get('timestamp', null) &&
                             request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                             request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                             request.resource.data.get('isShadowBanned', false) == resource.data.get('isShadowBanned', false) &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet()) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy) || 
                             (resource.data.likedBy.toSet().hasAll(request.resource.data.likedBy.toSet()) && resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1 && !(request.auth.uid in request.resource.data.likedBy))
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                             // Ensure other fields are immutable for this case
                             request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
                             request.resource.data.get('text', '') == resource.data.get('text', '') &&
                             request.resource.data.get('timestamp', null) == resource.data.get('timestamp', null) &&
                             request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                             request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                             request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) &&
                             request.resource.data.get('likedBy', []) == resource.data.get('likedBy', [])
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true;
                allow read: if resource.data.get('isShadowBanned', false) == false || isParentArticleOwner() || isArticleSubCommentOwner();

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.isShadowBanned == false &&
                               request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                               request.resource.data.size() == 9;

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
                                 request.resource.data.get('text', '') == resource.data.get('text', '') &&
                                 request.resource.data.get('timestamp', null) == resource.data.get('timestamp', null) &&
                                 request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                                 request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                                 request.resource.data.get('isShadowBanned', false) == resource.data.get('isShadowBanned', false) &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet()) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.auth.uid in request.resource.data.likedBy) || 
                                 (resource.data.likedBy.toSet().hasAll(request.resource.data.likedBy.toSet()) && resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1 && !(request.auth.uid in request.resource.data.likedBy))
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                 request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
                                 request.resource.data.get('text', '') == resource.data.get('text', '') &&
                                 request.resource.data.get('timestamp', null) == resource.data.get('timestamp', null) &&
                                 request.resource.data.get('mentionName', null) == resource.data.get('mentionName', null) &&
                                 request.resource.data.get('mentionedUserIds', []) == resource.data.get('mentionedUserIds', []) &&
                                 request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) &&
                                 request.resource.data.get('likedBy', []) == resource.data.get('likedBy', [])
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }
     match /userPreferences/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
