
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isAuthUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic info needed by other services
      allow create: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       (!('companyName' in request.resource.data) || request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 0 &&
                       request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase.size() > 0 &&
                       request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt']) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'industry',
                         'avatarUrl', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                         'createdAt', 'lastLoginAt', 'updatedAt'
                       ]); // Allow all fields on create for simplicity if they are optional

      allow update: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.uid == userId && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email cannot change via this update
                       request.resource.data.mentionName == resource.data.mentionName && // MentionName is fixed
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt is fixed
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       // Allow lastLoginAt to be updated to server time or be unchanged
                       (request.resource.data.lastLoginAt == request.time || request.resource.data.lastLoginAt == resource.data.lastLoginAt) &&
                       // Editable fields:
                       (!('companyName' in request.resource.data) || request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                       (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description is string) &&
                       (!('descriptionVisibility' in request.resource.data) || request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                       (!('sectorName'in request.resource.data) || request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                       (!('subSectorName'in request.resource.data) || request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                       (!('industryName'in request.resource.data) || request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                       (!('naicsCode'in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (!('tags' in request.resource.data) || request.resource.data.tags == null || request.resource.data.tags is list) &&
                       (!('established' in request.resource.data) || request.resource.data.established == null || request.resource.data.established is string) &&
                       (!('verified'in request.resource.data) || request.resource.data.verified == null || request.resource.data.verified is bool) &&
                       (!('isBotAccount'in request.resource.data) || request.resource.data.isBotAccount == null || request.resource.data.isBotAccount is bool) &&
                       (!('incomeRange'in request.resource.data) || request.resource.data.incomeRange == null || request.resource.data.incomeRange is string) &&
                       // Ensure only allowed fields are changed
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'lastLoginAt', 'updatedAt',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established',
                         'incomeRange' // Allow verified and isBotAccount to be updated if needed by admin roles later
                       ]);
      allow delete: if false; // Generally, users should not delete their own profiles directly
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if isAuthUser() && request.auth.uid == userId;
      // On create, ensure userId matches docId and auth.uid
      allow create: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.userId == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      allow update: if isAuthUser() && request.auth.uid == userId &&
                       request.resource.data.userId == userId && // Cannot change userId
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change createdAt
                       request.resource.data.updatedAt == request.time; // Must update timestamp
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if isAuthUser() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() > 0 &&
                       request.resource.data.tags is list &&
                       request.resource.data.sector is string &&
                       request.resource.data.requestType in ['post', 'help_request'] &&
                       request.resource.data.ratingScore is number &&
                       request.resource.data.commentCount == 0 &&
                       // Check optional fields only if they are present
                       (!('descriptionTried' in request.resource.data) || request.resource.data.descriptionTried == null || request.resource.data.descriptionTried is string) &&
                       (!('descriptionOutcome' in request.resource.data) || request.resource.data.descriptionOutcome == null || request.resource.data.descriptionOutcome is string) &&
                       (!('maxBudget' in request.resource.data) || request.resource.data.maxBudget == null || request.resource.data.maxBudget is number) &&
                       (!('deadline' in request.resource.data) || request.resource.data.deadline == null || request.resource.data.deadline is timestamp) &&
                       (!('subSector' in request.resource.data) || request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (!('industry' in request.resource.data) || request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (!('naicsCode' in request.resource.data) || request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       (!('imageUrls' in request.resource.data) || request.resource.data.imageUrls == null || request.resource.data.imageUrls is list) &&
                       (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds == null || request.resource.data.mentionedUserIds is list);

      allow update: if isAuthUser() && request.auth.uid == resource.data.userId && // Only owner can update
                       request.resource.data.userId == resource.data.userId && // Cannot change owner
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       // Allow updating commentCount and updatedAt (system fields for updates)
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.commentCount == resource.data.commentCount + 1 // Specific to new comment
                       );
                       // Add other update scenarios if needed (e.g., editing post content)

      allow delete: if isAuthUser() && request.auth.uid == resource.data.userId; // Only owner can delete

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Comments are public if post is public
        allow create: if isAuthUser() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list);
        allow update: if isAuthUser() && // Liking/unliking or editing own comment
                       (
                         // Liking/Unliking
                         (
                           request.resource.data.userId == resource.data.userId && // User field unchanged
                           request.resource.data.postId == resource.data.postId && // PostId field unchanged
                           request.resource.data.text == resource.data.text && // Text field unchanged
                           request.resource.data.timestamp == resource.data.timestamp && // Timestamp field unchanged
                           request.resource.data.updatedAt == request.time && // Update time must be server time
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                           (
                             (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount + 1) || // Liking
                             (request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount - 1)    // Unliking
                           )
                         ) ||
                         // Editing own comment (text, mentionedUserIds)
                         (
                           request.auth.uid == resource.data.userId && // Must be owner
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.postId == resource.data.postId &&
                           request.resource.data.timestamp == resource.data.timestamp && // Original timestamp preserved
                           request.resource.data.updatedAt == request.time && // Update time must be server time
                           request.resource.data.likeCount == resource.data.likeCount && // Likes not changed here
                           request.resource.data.likedBy == resource.data.likedBy &&   // LikedBy not changed here
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt'])
                         )
                       );
        allow delete: if isAuthUser() && request.auth.uid == resource.data.userId; // Only owner of comment can delete

        // SubComments (replies) subcollection
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if isAuthUser() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list);
          allow update: if isAuthUser() && // Liking/unliking or editing own subcomment
                         (
                            // Liking/Unliking
                           (
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                             (
                               (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount + 1) ||
                               (request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]) && request.resource.data.likeCount == resource.data.likeCount - 1)
                             )
                           ) ||
                           // Editing own subcomment
                           (
                             request.auth.uid == resource.data.userId && // Must be owner
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == resource.data.likeCount &&
                             request.resource.data.likedBy == resource.data.likedBy &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             (!('mentionedUserIds' in request.resource.data) || request.resource.data.mentionedUserIds is list) &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt'])
                           )
                         );
          allow delete: if isAuthUser() && request.auth.uid == resource.data.userId; // Only owner of subcomment
        }
      }
      // Bids subcollection (for help_request posts)
      match /bids/{bidId} {
        allow read: if isAuthUser() && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid || // Post owner can read bids
                       request.auth.uid == resource.data.bidderId; // Bidder can read their own bid
                       // Potentially allow all connected users of post owner if needed later

        allow create: if isAuthUser() &&
                         request.resource.data.postId == postId &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.bidderId != get(/databases/$(database)/documents/posts/$(postId)).data.userId && // Cannot bid on own post
                         get(/databases/$(database)/documents/posts/$(postId)).data.requestType == 'help_request' && // Can only bid on help requests
                         request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                         // Bid amount must not exceed maxBudget if maxBudget is set on the post
                         (get(/databases/$(database)/documents/posts/$(postId)).data.maxBudget == null || request.resource.data.bidAmount <= get(/databases/$(database)/documents/posts/$(postId)).data.maxBudget) &&
                         request.resource.data.timestamp == request.time;
        allow update: if false; // Bids are generally not updatable, create new one or handle via different process
        allow delete: if isAuthUser() && request.auth.uid == resource.data.bidderId; // Bidder can delete their own bid (if not accepted etc.)
      }
    }

    // Mutual Connections
    match /mutuals/{connectionId} {
      function isUserInConnection(userId) {
        return userId in resource.data.userIds;
      }
      function isRequester(userId) {
        return resource.data.requesterId == userId;
      }
      function isReceiver(userId) {
        return resource.data.requesterId != userId && isUserInConnection(userId);
      }
      // Document ID must be a sorted combination of two UIDs
      allow read: if isAuthUser() && request.auth.uid in resource.data.userIds &&
                     connectionId == resource.data.userIds[0] + '_' + resource.data.userIds[1]; // Check sorted IDs
      allow create: if isAuthUser() &&
                       request.auth.uid == request.resource.data.requesterId &&
                       request.auth.uid in request.resource.data.userIds &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.userIds[0] != request.resource.data.userIds[1] && // Ensure two different users
                       connectionId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1] && // Sorted IDs for doc ID
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']);

      allow update: if isAuthUser() &&
                       isUserInConnection(request.auth.uid) && // Must be one of the users in the connection
                       connectionId == resource.data.userIds[0] + '_' + resource.data.userIds[1] &&
                       // Scenario 1: Accepting a request (receiver accepts)
                       (resource.data.status == 'pending' &&
                        request.resource.data.status == 'connected' &&
                        isReceiver(request.auth.uid) && // Only the receiver can accept
                        request.resource.data.connectedAt == request.time &&
                        request.resource.data.updatedAt == request.time &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']) &&
                        request.resource.data.userIds == resource.data.userIds && // Other fields must be unchanged
                        request.resource.data.requesterId == resource.data.requesterId &&
                        request.resource.data.requestedAt == resource.data.requestedAt
                       );
                       // Note: Rejecting/Cancelling is a delete operation. Removing a connection is also a delete.
      allow delete: if isAuthUser() && isUserInConnection(request.auth.uid) &&
                       connectionId == resource.data.userIds[0] + '_' + resource.data.userIds[1] &&
                       // Allow deleting a pending request (by requester or receiver) or a connected relationship
                       (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    // Conversations and Messages
    match /conversations/{conversationId} {
      // Helper functions specific to conversation context
      function isAuthUserParticipant(authUid, convData) {
        return authUid in convData.participants;
      }
      function isAuthUserActiveParticipant(authUid, convData) {
        return isAuthUserParticipant(authUid, convData) &&
               (convData.formerParticipants == null || !(authUid in convData.formerParticipants.keys()));
      }
      function isAuthUserOwner(authUid, convData) {
        return convData.type == 'group' && convData.ownerId == authUid;
      }
      function isAuthUserAdmin(authUid, convData) {
        return convData.type == 'group' && authUid in convData.adminIds;
      }
      function isTargetUserOwner(targetUid, convData) {
        return convData.type == 'group' && targetUid == convData.ownerId;
      }

      // Rules for /conversations/{conversationId}
      allow read: if isAuthUser() && isAuthUserActiveParticipant(request.auth.uid, resource.data); // Only active participants can GET the conversation doc itself

      allow list: if isAuthUser(); // Query will be filtered by 'participants' array-contains request.auth.uid

      allow create: if isAuthUser() && (
        // Branch for creating a DIRECT conversation
        (
          request.resource.data.type == 'direct' &&
          request.resource.data.participants.hasAll([request.auth.uid]) &&
          request.resource.data.participants.size() == 2 &&
          request.resource.data.participants[0] != request.resource.data.participants[1] && // Ensure two different users
          // For direct chats, these group-specific fields must be null or not present
          request.resource.data.groupName == null &&
          request.resource.data.groupAvatarUrl == null &&
          request.resource.data.ownerId == null &&
          request.resource.data.adminIds.size() == 0 &&
          // postId can be null (general chat) or a string (post-related chat)
          (request.resource.data.postId == null || request.resource.data.postId is string) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.formerParticipants.size() == 0 && // Must be empty on create
          request.resource.data.keys().hasOnly([
            'participants', 'type', 'postId',
            'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt',
            'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'formerParticipants' // List all, but check values
          ])
        ) ||
        // Branch for creating a GROUP conversation
        (
          request.resource.data.type == 'group' &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.adminIds.hasAll([request.auth.uid]) &&
          request.resource.data.adminIds.size() == 1 &&
          request.resource.data.participants.hasAll([request.auth.uid]) &&
          request.resource.data.participants.size() >= 2 &&
          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
          (!('groupAvatarUrl' in request.resource.data) || request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
          request.resource.data.postId == null &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          request.resource.data.formerParticipants.size() == 0 && // Must be empty on create
          request.resource.data.keys().hasOnly([
            'participants', 'type', 'groupName', 'groupAvatarUrl',
            'ownerId', 'adminIds', 'postId',
            'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'formerParticipants'
          ])
        )
      );

      allow update: if isAuthUser() && (
        // Branch A: Sending a message (for any active participant, direct or group)
        (
          isAuthUserActiveParticipant(request.auth.uid, resource.data) &&
          request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.writeFields.size() == 4 &&
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.lastMessageTimestamp == request.time &&
          // Ensure other essential fields are NOT being modified by this specific "send message" operation
          request.resource.data.type == resource.data.type &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.formerParticipants == resource.data.formerParticipants // formerParticipants not changed here
        ) ||
        // Branch B: Updating group name or avatar (group admins only)
        (
          resource.data.type == 'group' &&
          isAuthUserActiveParticipant(request.auth.uid, resource.data) && // Must be active
          isAuthUserAdmin(request.auth.uid, resource.data) && // Must be an admin
          (
            request.writeFields.hasAny(['groupName', 'groupAvatarUrl']) || // At least one of these must be changing
            (request.writeFields.has('groupName') && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0) ||
            (request.writeFields.has('groupAvatarUrl') && (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string))
          ) &&
          request.resource.data.updatedAt == request.time &&
          // Ensure only specified fields and updatedAt are being modified
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'].filter(key => key in request.resource.data)) &&
          // Immutable fields for this operation
          request.resource.data.type == resource.data.type &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds && // adminIds list itself not changed here
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastMessage == resource.data.lastMessage &&
          request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId &&
          request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp &&
          request.resource.data.formerParticipants == resource.data.formerParticipants
        ) ||
        // Branch C: Adding members to a group (group admins only)
        (
          resource.data.type == 'group' &&
          isAuthUserActiveParticipant(request.auth.uid, resource.data) &&
          isAuthUserAdmin(request.auth.uid, resource.data) &&
          request.resource.data.participants.hasAll(resource.data.participants) && // New list must contain all old members
          request.resource.data.participants.size() > resource.data.participants.size() && // Must be adding members
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt']) &&
          // Immutable fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.adminIds == resource.data.adminIds &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.formerParticipants == resource.data.formerParticipants // formerParticipants not changed by this action
        ) ||
        // Branch D: Removing members from a group (group admins only, cannot remove owner)
        (
          resource.data.type == 'group' &&
          isAuthUserActiveParticipant(request.auth.uid, resource.data) &&
          isAuthUserAdmin(request.auth.uid, resource.data) &&
          resource.data.participants.hasAll(request.resource.data.participants) && // Old list must contain all new members
          request.resource.data.participants.size() < resource.data.participants.size() && // Must be removing members
          !request.resource.data.participants.hasAny([resource.data.ownerId]) && // Cannot remove owner this way
          request.resource.data.adminIds.hasAll(request.resource.data.adminIds.removeAll(resource.data.participants.removeAll(request.resource.data.participants))) && // Admins being removed must also be removed from adminIds
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          // Immutable fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.formerParticipants == resource.data.formerParticipants // formerParticipants not changed by this action
        ) ||
        // Branch E: Promoting/Demoting Admins (group owner only, owner cannot be demoted)
        (
          resource.data.type == 'group' &&
          isAuthUserActiveParticipant(request.auth.uid, resource.data) &&
          isAuthUserOwner(request.auth.uid, resource.data) && // Only owner can change admin list
          request.resource.data.adminIds.hasAny([resource.data.ownerId]) && // Owner must remain an admin
          request.resource.data.participants.hasAll(request.resource.data.adminIds) && // All admins must be participants
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          // Immutable fields
          request.resource.data.type == resource.data.type &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.formerParticipants == resource.data.formerParticipants // formerParticipants not changed by this action
        ) ||
        // Branch F: Participant leaving a group (active participant themself)
        (
          resource.data.type == 'group' &&
          isAuthUserActiveParticipant(request.auth.uid, resource.data) && // User must be currently active to leave
          request.resource.data.participants.size() == resource.data.participants.size() - 1 && // Removing exactly one participant (themselves)
          request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]) &&
          // If user was an admin, they must be removed from adminIds as well. Owner cannot leave if they are sole admin and others remain.
          (
            (request.auth.uid in resource.data.adminIds && request.resource.data.adminIds.size() == resource.data.adminIds.size() -1 && request.resource.data.adminIds == resource.data.adminIds.removeAll([request.auth.uid])) ||
            (!(request.auth.uid in resource.data.adminIds) && request.resource.data.adminIds == resource.data.adminIds)
          ) &&
          // Owner safeguard: Owner cannot leave if they are the sole admin AND other participants remain.
          // They must either promote another admin first, or be the last one out.
          !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && request.resource.data.participants.size() > 0) &&
          // Record leave time
          request.resource.data.formerParticipants[request.auth.uid] == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'formerParticipants', 'updatedAt']) &&
          // Immutable fields for this operation
          request.resource.data.type == resource.data.type &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );

      allow delete: if false; // Prevent direct deletion of conversations. Manage via 'leave' or archiving.

      match /messages/{messageId} {
        // Helper function specific to this match block
        function isMessageSender() {
          return request.auth.uid == request.resource.data.senderId;
        }
        // Helper function for canViewMessage, placed inside this match block
        function canViewMessage() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          // 1️⃣ Still an active participant (not in formerParticipants) → full access
          if (isAuthUserActiveParticipant(request.auth.uid, conv)) { return true; }
          // 2️⃣ Former participant (in formerParticipants) → only up to leave-time
          if (conv.formerParticipants != null && request.auth.uid in conv.formerParticipants.keys()) {
            return resource.data.timestamp <= conv.formerParticipants[request.auth.uid];
          }
          return false; // Default if not current and not former with valid leave time
        }

        allow read: if isAuthUser() && canViewMessage();

        allow create: if isAuthUser() && isMessageSender() &&
                         isAuthUserActiveParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data) && // Sender must be an active participant
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         // isBotMessage can be true or false or not present (defaults to false in service)
                         (!('isBotMessage' in request.resource.data) || request.resource.data.isBotMessage is bool) &&
                         // replyToMessageId and repliedToTextSnippet are optional
                         (!('replyToMessageId' in request.resource.data) || request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                         (!('repliedToTextSnippet' in request.resource.data) || request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                         request.resource.data.read == false;

        allow update: if false; // Messages are immutable once created (no edits)
        allow delete: if false; // Messages cannot be deleted by users (soft delete if needed)
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthUser() && resource.data.userId == request.auth.uid;
      allow list: if isAuthUser(); // Query must be filtered by userId == request.auth.uid
      allow create: if isAuthUser() && // Sender must be authenticated
                       request.resource.data.userId is string && // Recipient User ID
                       request.resource.data.senderId == request.auth.uid && // Sender must be the one creating it (or a trusted server role)
                       request.resource.data.type is string &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false;
      allow update: if isAuthUser() && resource.data.userId == request.auth.uid && // Only recipient can update
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && // Only isRead can be changed
                       request.resource.data.isRead == true; // Can only mark as read
      allow delete: if isAuthUser() && resource.data.userId == request.auth.uid; // Recipient can delete their notifications
    }

    // Whiteboard Annotations (User-generated content for a specific NAICS code)
    match /whiteboardAnnotations/{naicsCodeDocId} {
      allow read: if true; // Whiteboard content is public for a given NAICS code
      allow list: if true; // Allow listing whiteboard documents (e.g., for discovery if needed)

      allow create: if isAuthUser() &&
                       request.resource.data.naicsCode == naicsCodeDocId && // Ensure data consistency
                       request.resource.data.lastUpdatedBy == request.auth.uid &&
                       request.resource.data.lastUpdatedAt == request.time &&
                       request.resource.data.shapes is list;
                       // Shapes content validation can be added here if complex, e.g., size limits, field types within shapes

      allow update: if isAuthUser() &&
                       request.resource.data.naicsCode == naicsCodeDocId && // Ensure data consistency with doc ID
                       resource.data.naicsCode == naicsCodeDocId && // Ensure existing doc also matches
                       request.resource.data.lastUpdatedBy == request.auth.uid &&
                       request.resource.data.lastUpdatedAt == request.time &&
                       request.resource.data.shapes is list &&
                       // Allow only 'shapes', 'lastUpdatedAt', 'lastUpdatedBy' to be changed
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shapes', 'lastUpdatedAt', 'lastUpdatedBy']);

      allow delete: if false; // Or restrict to specific admin roles if deletion is needed
    }
  }
}

    