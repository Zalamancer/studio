rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true; // Publicly readable for profiles, or adjust as needed
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastLoginAt == request.time &&
                       // Ensure required fields on creation, allow optional to be absent
                       request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt', 'descriptionVisibility']) &&
                       // Allow these optional fields at creation
                       request.resource.data.keys().hasOnly(['uid', 'email', 'companyName', 'industry', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'descriptionVisibility', 'createdAt', 'updatedAt', 'lastLoginAt', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode']);

      allow update: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.uid == resource.data.uid && // uid cannot change
                       request.resource.data.email == resource.data.email && // email should not be changed here
                       request.resource.data.companyName == resource.data.companyName && // company name not editable here
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName is fixed
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // fixed
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt is immutable
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       // Allow updates to specific fields only
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                         'tags', 'established', 'lastLoginAt', 'updatedAt', 'incomeRange'
                       ]);
      allow delete: if isAuthenticated() && request.auth.uid == userId; // User can delete their own account data
    }

    // --- Posts Collection ---
    match /posts/{postId} {
      allow read: if true; // Publicly readable posts
      allow list: if true; // Allow listing posts on the main board

      function isPostOwner() {
        return isAuthenticated() && request.auth.uid == resource.data.userId;
      }
      function isIncrementingCommentCount() {
        return request.resource.data.commentCount == resource.data.commentCount + 1 ||
               request.resource.data.commentCount == resource.data.commentCount - 1;
      }

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 && // Initial comment count
                       request.resource.data.ratingScore is number && // Ensure ratingScore is a number
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.descriptionDetails is string &&
                       request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                       request.resource.data.tags is list &&
                       request.resource.data.sector is string &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.imageUrls is list &&
                       request.resource.data.mentionedUserIds is list &&
                       // Ensure only allowed fields are present
                       request.resource.data.keys().hasAll(['userId', 'question', 'descriptionDetails', 'requestType', 'tags', 'sector', 'createdAt', 'ratingScore', 'commentCount', 'imageUrls', 'mentionedUserIds']) &&
                       // Allow optional fields to be present or absent
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'userId', 'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'requestType',
                           'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'ratingScore', 'imageUrls', 'mentionedUserIds',
                           'maxBudget', 'deadline', 'createdAt', 'commentCount'
                       ]);


      allow update: if isPostOwner() && // Only post owner can edit their post details
                       request.resource.data.userId == resource.data.userId && // Cannot change author
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.updatedAt == request.time && // Must set new update time
                       // Define which fields owner can update (e.g., question, description, tags, etc.)
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                         'imageUrls', 'mentionedUserIds', 'maxBudget', 'deadline', 'requestType', 'updatedAt'
                         // 'ratingScore' is usually from reviews, not direct edit. 'commentCount' is transactional.
                       ])
                    || // OR allow anyone authenticated to update commentCount (for when comments are added/deleted)
                       isAuthenticated() &&
                       request.resource.data.updatedAt == request.time &&
                       isIncrementingCommentCount() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']);


      allow delete: if isPostOwner(); // Only post owner can delete

      // --- Comments Subcollection (for 'posts') ---
      match /comments/{commentId} {
        function isCommentOwner() {
          return isAuthenticated() && request.auth.uid == resource.data.userId;
        }
        allow read: if true;
        allow list: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.isShadowBanned == false && // Should be false for regular post comments
                         request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                         request.resource.data.size() == 9;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         // Validate like operation
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                           (request.resource.data.likedBy.hasAny([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) || // Adding like
                           (!request.resource.data.likedBy.hasAny([request.auth.uid]) && resource.data.likedBy.hasAny([request.auth.uid]))    // Removing like
                         );

        allow delete: if isCommentOwner();

        // --- SubComments Subcollection (for 'posts/comments') ---
        match /subcomments/{subCommentId} {
          function isSubCommentOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.userId;
          }
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list &&
                           request.resource.data.isShadowBanned == false &&
                           request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned']) &&
                           request.resource.data.size() == 8; // No mentionName typically stored here

          allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                           // Validate like operation
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           (
                             (request.resource.data.likedBy.hasAny([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) || // Adding like
                             (!request.resource.data.likedBy.hasAny([request.auth.uid]) && resource.data.likedBy.hasAny([request.auth.uid]))    // Removing like
                           );
          allow delete: if isSubCommentOwner();
        }
      }

      // --- Bids Subcollection ---
      match /bids/{bidId} {
          allow read: if isAuthenticated(); // Any authenticated user can read bids on a post
          allow list: if isAuthenticated(); // Any authenticated user can list bids on a post
          allow create: if isAuthenticated() &&
                           request.resource.data.bidderId == request.auth.uid &&
                           get(/databases/$(database)/documents/posts/$(postId)).data.get('userId', '') != request.auth.uid && // Cannot bid on own post (safer get)
                           request.resource.data.postId == postId &&
                           request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.bidMessage is string && // bidMessage should be string
                           request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                           request.resource.data.size() == 5;
          allow update: if false;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.bidderId;
      }
    }

    // --- Mutuals Collection (Connections) ---
    match /mutuals/{connectionId} {
        function isUserInConnection() {
            return request.auth.uid in resource.data.userIds;
        }
        function isConnectionCreator() {
            return request.auth.uid == request.resource.data.requesterId;
        }
        function isConnectionRecipient() {
            return request.auth.uid in request.resource.data.userIds && request.auth.uid != request.resource.data.requesterId;
        }

        allow read: if isAuthenticated() && isUserInConnection();
        allow list: if isAuthenticated(); // User can only list connections they are part of (via where clause in service)
                                        // Firestore rules don't secure list operations directly, but client query must filter.

        allow create: if isAuthenticated() &&
                         isConnectionCreator() &&
                         request.resource.data.userIds.hasAll([request.auth.uid]) && // requester is in userIds
                         request.resource.data.userIds.size() == 2 && // Must be between 2 users
                         request.resource.data.status == 'pending' &&
                         request.resource.data.requestedAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                         request.resource.data.size() == 5;

        allow update: if isAuthenticated() && isUserInConnection() &&
                         request.resource.data.userIds == resource.data.userIds && // userIds cannot change
                         request.resource.data.requesterId == resource.data.requesterId && // requester cannot change
                         request.resource.data.requestedAt == resource.data.requestedAt && // requestedAt cannot change
                         request.resource.data.updatedAt == request.time &&
                         ( // Case 1: Accepting a request
                           resource.data.status == 'pending' &&
                           request.resource.data.status == 'connected' &&
                           request.resource.data.connectedAt == request.time &&
                           request.auth.uid != resource.data.requesterId && // Recipient accepts
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])
                         );
                         // No direct update for 'blocked' status through client-side rules.
                         // Blocking might be better handled via a Cloud Function for more complex logic.

        allow delete: if isAuthenticated() && isUserInConnection() &&
                         (resource.data.status == 'pending' || resource.data.status == 'connected');
                         // User can cancel their sent request, reject a received one, or remove an existing connection.
    }

    // --- Conversations Collection ---
    match /conversations/{conversationId} {
        function isParticipant() {
            return request.auth.uid in resource.data.participants;
        }
        function isCreatingDirectChat() {
            return request.resource.data.type == 'direct' &&
                   request.resource.data.participants.size() == 2 &&
                   request.resource.data.participants.hasAll([request.auth.uid]) &&
                   request.resource.data.groupName == null &&
                   request.resource.data.groupAvatarUrl == null &&
                   request.resource.data.ownerId == null &&
                   request.resource.data.adminIds.size() == 0;
        }
        function isCreatingGroupChat() {
            return request.resource.data.type == 'group' &&
                   request.resource.data.participants.size() >= 2 &&
                   request.resource.data.participants.hasAll([request.auth.uid]) &&
                   request.resource.data.ownerId == request.auth.uid &&
                   request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                   request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                   (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string);
        }
        function isValidTimestampField(fieldName) {
            return request.resource.data[fieldName] == request.time || request.resource.data[fieldName] == null;
        }
        function isConversationFieldUnchanged(fieldName) {
            return request.resource.data[fieldName] == resource.data[fieldName];
        }
        function isOnlyUpdatingLastMessage() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']);
        }
        function isGroupAdmin() {
            return request.auth.uid in resource.data.adminIds;
        }
        function isGroupOwner() {
            return request.auth.uid == resource.data.ownerId;
        }

        allow read: if isAuthenticated() && isParticipant();
        allow list: if isAuthenticated(); // Client queries filter by 'participants array-contains request.auth.uid'

        allow create: if isAuthenticated() &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         isValidTimestampField('lastMessageTimestamp') &&
                         (isCreatingDirectChat() || isCreatingGroupChat());

        allow update: if isAuthenticated() && isParticipant() && request.resource.data.updatedAt == request.time &&
                        // Immutable core fields:
                        isConversationFieldUnchanged('participants') && // For direct chats. Groups handle via specific actions.
                        isConversationFieldUnchanged('type') &&
                        isConversationFieldUnchanged('postId') &&
                        isConversationFieldUnchanged('createdAt') &&
                        ( // Case 1: Updating last message (done by message sender or system)
                          isOnlyUpdatingLastMessage() &&
                          request.resource.data.lastMessage is string &&
                          request.resource.data.lastMessageSenderId == request.auth.uid // Only sender can update last msg sender
                        ) ||
                        ( // Case 2: Group admin updating group details
                          isGroupAdmin() && resource.data.type == 'group' &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                          (request.resource.data.groupName is string && request.resource.data.groupName.size() > 0) &&
                          (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string)
                        ) ||
                        ( // Case 3: Adding/removing members or admins (by admin/owner)
                          isGroupAdmin() && resource.data.type == 'group' &&
                          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'adminIds', 'updatedAt'])) &&
                          // Further checks for specific array ops in service logic
                          (request.resource.data.participants is list) &&
                          (request.resource.data.adminIds is list)
                        ) ||
                        ( // Case 4: Owner transferring ownership
                          isGroupOwner() && resource.data.type == 'group' &&
                          request.resource.data.diff(resource.data).affectedKeys().hasAll(['ownerId', 'adminIds', 'updatedAt']) &&
                          request.resource.data.ownerId != resource.data.ownerId && // ownerId must change
                          request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) // new owner must be an admin
                        ) ||
                        ( // Case 5: User leaving a group (updating participants and formerParticipants)
                          resource.data.type == 'group' &&
                          request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
                          request.resource.data.participants.hasAll(resource.data.participants.removed(request.auth.uid)) &&
                          request.resource.data.formerParticipants[request.auth.uid] == request.time && // User added to formerParticipants with leave time
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'formerParticipants', 'updatedAt', 'adminIds']) // Also allow adminIds to be updated if user was admin
                        );

        // --- Messages Subcollection ---
        match /messages/{messageId} {
          allow read: if isAuthenticated() && isParticipant(); // Use parent's isParticipant context
          allow list: if isAuthenticated() && isParticipant();

          allow create: if isAuthenticated() &&
                           request.resource.data.senderId == request.auth.uid &&
                           request.resource.data.conversationId == conversationId &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.read == false &&
                           (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true) &&
                           (request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                           (request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                           request.resource.data.keys().hasOnly(['conversationId', 'senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet']) &&
                           request.resource.data.size() == 8;
                           // No updates to messages allowed through client rules
          allow update: if false;
          allow delete: if false; // For now, no client-side message deletion
        }
    }

    // --- User Preferences ---
    match /userPreferences/{userId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId &&
                         request.resource.data.userId == userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'createdAt', 'updatedAt',
                            'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', 'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd','stripeSubscriptionWillCancelAtPeriodEnd',
                            'paymentMethods'
                         ]);
        allow update: if isAuthenticated() && request.auth.uid == userId &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                            'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', 'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                            'paymentMethods',
                            'updatedAt'
                         ]);
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow list: if isAuthenticated() && request.auth.uid == request.query.filters[0][2]; // Secure list by userId query
        allow create: if isAuthenticated() &&
                         request.resource.data.userId is string && // Recipient
                         request.resource.data.senderId == request.auth.uid && // Sender must be current user OR system (TODO: check for system role if needed)
                         request.resource.data.type is string &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.isRead == false &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                            'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId', 'textSnippet',
                            'timestamp', 'isRead'
                         ]); // Add other optional fields
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                         request.resource.data.userId == resource.data.userId && // Cannot change who it's for
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && // Only allow marking as read
                         request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete their own notifications
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        allow list: if true; // List reviews (e.g., for a profile)

        function isReviewOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.reviewerId;
        }

        allow create: if isAuthenticated() &&
                         request.resource.data.reviewerId == request.auth.uid &&
                         request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                         request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number) &&
                         request.resource.data.keys().hasAll(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']) &&
                         request.resource.data.size() == 9;

        allow update: if isReviewOwner() &&
                         request.resource.data.reviewerId == resource.data.reviewerId &&
                         request.resource.data.targetUserId == resource.data.targetUserId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && // Historical avg should not be client-updatable
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

        allow delete: if isReviewOwner();
    }

    // --- Collections ---
    match /collections/{collectionId} {
        function isCollectionOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }
        function isSharedWithUser() {
            return isAuthenticated() && request.auth.uid in resource.data.sharedWithUserIds;
        }

        allow read: if isCollectionOwner() || isSharedWithUser();
        // For list, use query constraints in service based on ownerId or sharedWithUserIds
        allow list: if isAuthenticated(); // Client must filter via where clauses

        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.description is string &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                         request.resource.data.size() == 7;

        allow update: if isCollectionOwner() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
                         // Ensure list operations are safe (e.g., not removing owner from shared list if that means something)

        allow delete: if isCollectionOwner();
    }

    // --- Plans Collection ---
    match /plans/{planId} {
        function isPlanOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }
        function canViewPlan() {
            return resource.data.visibility == 'public' ||
                   (resource.data.visibility == 'unlisted' && isAuthenticated() && request.auth.uid in resource.data.viewUserIds) ||
                   (resource.data.visibility == 'private' && isPlanOwner());
        }
        function canEditPlan() {
          return isPlanOwner() ||
                 (resource.data.editability == 'collaborators' && isAuthenticated() && request.auth.uid in resource.data.editUserIds) ||
                 (resource.data.editability == 'everyone' && isAuthenticated() && canViewPlan()); // 'everyone' can edit if they can view
        }

        allow read: if canViewPlan();
        allow list: if isAuthenticated(); // Client must filter based on visibility rules or user's viewUserIds list

        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.sector is string &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.version == 1 &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.visibility is string && request.resource.data.visibility.matches('private|unlisted|public') &&
                         request.resource.data.editability is string && request.resource.data.editability.matches('owner_only|collaborators|everyone') &&
                         request.resource.data.viewUserIds is list &&
                         request.resource.data.editUserIds is list &&
                         // All required fields
                         request.resource.data.keys().hasAll(['name', 'ownerId', 'sector', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']) &&
                         // Allow optional fields to be present or absent but nothing extra
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                            'createdAt', 'updatedAt', 'version', 'roadmap',
                            'visibility', 'editability', 'viewUserIds', 'editUserIds'
                         ]);

        allow update: if isAuthenticated() && canEditPlan() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                         request.resource.data.updatedAt == request.time &&
                         ( // Case 1: Updating roadmap (includes version increment)
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                           request.resource.data.version == resource.data.version + 1
                         ) ||
                         ( // Case 2: Owner updating settings (name, description, permissions)
                           isPlanOwner() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                             'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                           ])
                         );

        allow delete: if isPlanOwner();

        // --- Versions Subcollection for Plans ---
        match /versions/{versionId} {
            allow read: if canViewPlan(); // If user can view plan, they can view its history
            allow list: if canViewPlan();
            allow create: if isAuthenticated() && canEditPlan() && // User who can edit the plan can create a version
                           request.resource.data.planId == planId &&
                           request.resource.data.editorUid == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.roadmap is list &&
                           request.resource.data.versionNumber is number &&
                           request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                           request.resource.data.size() == 5;
            allow update: if false; // Versions are immutable
            allow delete: if false; // Versions are immutable (or only by admin/owner via Cloud Function)
        }
    }

    // --- Article Tags ---
    match /articleTags/{tagId} {
      allow read: if true; // Tags are public
      allow list: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.nameLowercase is string &&
                       request.resource.data.usageCount >= 0 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']) &&
                       request.resource.data.size() == 5;

      allow update: if isAuthenticated() && // Allow authenticated users to increment/decrement usageCount
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.nameLowercase == resource.data.nameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       (request.resource.data.usageCount == resource.data.usageCount + 1 ||
                        request.resource.data.usageCount == resource.data.usageCount - 1 ||
                        (request.resource.data.usageCount == 0 && resource.data.usageCount == 1) // Allow setting to 0 if decrementing from 1
                       ) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
      allow delete: if false; // Tags not typically deleted, usage count goes to 0
    }

    // --- News Articles ---
    match /newsArticles/{articleId} {
        function isNewsArticleOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read: if resource.data.status == 'published' || (isAuthenticated() && request.auth.uid == resource.data.userId);
        allow list: if true; // Client filters by status

        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null) &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.content is string && request.resource.data.content.size() > 0 &&
                         request.resource.data.status.matches('draft|published') &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.keys().hasOnly([
                           'userId', 'title', 'tags', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount',
                           'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                           'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry',
                           'draftContent', 'hasUnpublishedChanges' // Added these two
                         ]) &&
                         request.resource.data.size() == 27; // Update size check

        allow update: if
            ( // Case 1: Owner updating their article
                isNewsArticleOwner() &&
                request.resource.data.userId == resource.data.userId &&
                request.resource.data.createdAt == resource.data.createdAt &&
                request.resource.data.updatedAt == request.time &&
                (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null || request.resource.data.publishedAt == resource.data.publishedAt) &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'title', 'tags', 'content', 'status', 'coverImageUrl', 'updatedAt', 'publishedAt',
                   'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                   'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry',
                   'draftContent', 'hasUnpublishedChanges' // Added these two
                ])
            ) ||
            ( // Case 2: Any authenticated user liking/unliking (but not the author)
                isAuthenticated() && request.auth.uid != resource.data.userId &&
                request.resource.data.updatedAt == request.time &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                (
                  (request.resource.data.likedBy.hasAny([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) ||
                  (!request.resource.data.likedBy.hasAny([request.auth.uid]) && resource.data.likedBy.hasAny([request.auth.uid]))
                )
            ) ||
            ( // Case 3: Any authenticated user (comment creator) incrementing/decrementing commentCount
                isAuthenticated() &&
                request.resource.data.updatedAt == request.time &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1)
            );

        allow delete: if isNewsArticleOwner();

            // --- News Comments Subcollection (for 'newsArticles') ---
        match /newsComments/{commentId} {
            function isArticleCommentOwner() {
                return isAuthenticated() && request.auth.uid == resource.data.userId;
            }
            function isParentArticleOwner() {
                return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
            }

            allow list: if true; // Client filters shadow-banned for non-authors
            allow read: if isAuthenticated(); // Allow any authenticated user to read (client filters display)

            allow create: if isAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.mentionedUserIds is list &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']) &&
                             request.resource.data.size() == 9;

            allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           ( // Case 1: Liking/Unliking
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                             (
                               (request.resource.data.likedBy.hasAny([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) || // Adding like
                               (!request.resource.data.likedBy.hasAny([request.auth.uid]) && resource.data.likedBy.hasAny([request.auth.uid]))    // Removing like
                             )
                           ) ||
                           ( // Case 2: Article owner shadow banning/unbanning
                             isParentArticleOwner() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                           );

            allow delete: if isArticleCommentOwner();

            // --- News SubComments Subcollection ---
            match /newsSubcomments/{subCommentId} {
                function isArticleSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }

                allow list: if true; // Client filters shadow-banned
                allow read: if isAuthenticated(); // Allow any authenticated user to read

                allow create: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                               request.resource.data.timestamp == request.time &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.likeCount == 0 &&
                               request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                               request.resource.data.mentionedUserIds is list &&
                               request.resource.data.isShadowBanned == false &&
                               // mentionName is optional for subcomments and will be populated by service
                               request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds', 'isShadowBanned', 'mentionName']) &&
                               request.resource.data.size() >= 8 && request.resource.data.size() <= 9; // size 8 if no mentionName, 9 if present

                allow update: if isAuthenticated() &&
                               request.resource.data.updatedAt == request.time &&
                               ( // Case 1: Liking/Unliking
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                                 (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                                 (
                                   (request.resource.data.likedBy.hasAny([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) ||
                                   (!request.resource.data.likedBy.hasAny([request.auth.uid]) && resource.data.likedBy.hasAny([request.auth.uid]))
                                 )
                               ) ||
                               ( // Case 2: Article owner shadow banning/unbanning
                                 isParentArticleOwner() &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                               );
                allow delete: if isArticleSubCommentOwner();
            }
        }
    }
  }
}
