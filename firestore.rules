
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (Inlined for clarity and to avoid complex cross-function calls in rules)

    // --- User-related Data ---
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId ||
                    (resource.data.descriptionVisibility == 'everyone') ||
                    (resource.data.descriptionVisibility == 'connected' &&
                      exists(/databases/$(database)/documents/mutuals/$(request.auth.uid)_$(userId)) &&
                      get(/databases/$(database)/documents/mutuals/$(request.auth.uid)_$(userId)).data.status == 'connected'
                    ) ||
                    (resource.data.descriptionVisibility == 'connected' &&
                      exists(/databases/$(database)/documents/mutuals/$(userId)_$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/mutuals/$(userId)_$(request.auth.uid)).data.status == 'connected'
                    )
                  );
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt', 'companyName', 'industry', 'avatarUrl', 'descriptionVisibility']) &&
                       (request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                       (request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']);


      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.uid == resource.data.uid && // UID cannot change
                       request.resource.data.email == resource.data.email && // Email typically doesn't change via profile update
                       request.resource.data.mentionName == resource.data.mentionName && // Mention name doesn't change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                       request.resource.data.companyName == resource.data.companyName && // Company name from signup
                       request.resource.data.industry == resource.data.industry && // Original industry from signup
                       request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       // Allow specific fields to be updated
                       request.resource.data.keys().hasOnly([
                         'uid', 'email', 'mentionName', 'mentionNameLowercase', 'companyName', 'industry', 'createdAt', 'updatedAt', 'lastLoginAt', // Read-only or server-managed
                         'avatarUrl', 'description', 'descriptionVisibility', 'established', 'incomeRange', // Editable fields
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode', // NAICS fields
                         'tags', 'verified', 'isBotAccount' // Other potential fields
                       ]);
    }

    match /mutuals/{connectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.userIds.size() == 2 && // Must be between 2 users
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']); // Ensure updatedAt is set on create too
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.userIds && // User must be part of the connection
                       request.resource.data.userIds == resource.data.userIds && // userIds array cannot change
                       request.resource.data.requesterId == resource.data.requesterId && // requester cannot change
                       request.resource.data.requestedAt == resource.data.requestedAt && // requestedAt cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt
                       ( // Either accepting a request
                         (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                          request.auth.uid != resource.data.requesterId && // Only recipient can accept
                          request.resource.data.connectedAt == request.time &&
                          request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt', 'connectedAt'])) ||
                         // Or, if one day we allow blocking (not implemented yet)
                         (request.resource.data.status == 'blocked' && request.resource.data.keys().hasAll(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt' /* add blocking related fields*/]))
                       );
      allow delete: if request.auth != null && request.auth.uid in resource.data.userIds &&
                       (resource.data.status == 'pending' || resource.data.status == 'connected');
    }

    match /posts/{postId} {
      allow read: if true; // Anyone can read posts for now
      allow list: if request.auth != null && request.query.limit <= 50; // Logged-in users can list
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.commentCount == 0 &&
                       (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                       request.resource.data.keys().hasOnly([
                          'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                          'ratingScore', 'createdAt', 'imageUrls', 'mentionedUserIds', 'commentCount',
                          'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                          'maxBudget', 'deadline'
                       ]);
      allow update: if request.auth != null && request.auth.uid == resource.data.userId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       // Only allow updating specific fields for now, e.g., commentCount by server
                       request.resource.data.keys().hasOnly([
                           'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                           'ratingScore', 'createdAt', 'imageUrls', 'mentionedUserIds', 'commentCount',
                           'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                           'maxBudget', 'deadline', 'updatedAt' // Add updatedAt if posts become editable
                       ]) &&
                       (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) && request.resource.data.updatedAt == request.time)
                         // Add other allowed update scenarios here if posts become editable by users
                       );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true; // Anyone can read comments
        allow list: if request.auth != null && request.query.limit <= 100;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0 &&
                         (request.resource.data.isShadowBanned == false || request.resource.data.isShadowBanned == null) &&
                         request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
        allow update: if request.auth != null &&
                         ( // User liking/unliking their own or other's comment
                           (request.auth.uid == request.resource.data.userId || request.auth.uid != request.resource.data.userId) &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.text == resource.data.text &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned'])
                         );
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId; // Only comment owner can delete

        // SubComments (Replies) Subcollection
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow list: if request.auth != null && request.query.limit <= 50;
            allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy.size() == 0 &&
                             (request.resource.data.isShadowBanned == false || request.resource.data.isShadowBanned == null) &&
                             request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
            allow update: if request.auth != null &&
                             (
                               (request.auth.uid == request.resource.data.userId || request.auth.uid != request.resource.data.userId) && // Liking
                               request.resource.data.userId == resource.data.userId &&
                               request.resource.data.text == resource.data.text &&
                               request.resource.data.timestamp == resource.data.timestamp &&
                               request.resource.data.updatedAt == request.time &&
                               request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned'])
                             );
            allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }

      // Bids Subcollection
      match /bids/{bidId} {
          allow read: if request.auth != null; // Logged-in users can read bids
          allow list: if request.auth != null && request.query.limit <= 50;
          allow create: if request.auth != null &&
                           request.auth.uid == request.resource.data.bidderId &&
                           get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid && // Cannot bid on own post
                           request.resource.data.postId == postId &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.bidAmount >= 0 &&
                           (request.resource.data.bidMessage == null || request.resource.data.bidMessage is string) &&
                           request.resource.data.keys().hasAll(['postId', 'bidderId', 'bidAmount', 'timestamp']) &&
                           request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
          allow update, delete: if false; // Bids are immutable once placed
      }
    }

    // Plans Collection
    match /plans/{planId} {
      allow read: if request.auth != null &&
                     (
                       resource.data.visibility == 'public' ||
                       (resource.data.visibility == 'unlisted' && request.auth.uid in resource.data.viewUserIds) ||
                       (resource.data.visibility == 'private' && request.auth.uid == resource.data.ownerId) || // Private implies owner is sole viewer unless explicitly shared
                       (request.auth.uid in resource.data.viewUserIds) // Explicitly in viewUserIds (covers shared private if rules evolve)
                     );

     // SIMPLIFIED LIST RULE: Allows authenticated users to list plans with common constraints.
     // The `canViewPlan` in `allow read` will handle actual document visibility.
     allow list: if request.auth != null &&
                    request.query.limit <= 50 &&
                    (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt');


      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.roadmap is list && // roadmap must be a list (can be empty)
                       (request.resource.data.visibility in ['private', 'unlisted', 'public']) &&
                       (request.resource.data.editability in ['owner_only', 'collaborators', 'everyone']) &&
                       // Start isValidViewAndEditUserIds logic (inlined)
                       (
                         (
                           request.resource.data.visibility == 'private' &&
                           request.resource.data.editability == 'owner_only' &&
                           request.resource.data.viewUserIds.hasOnly([request.auth.uid]) &&
                           request.resource.data.editUserIds.hasOnly([request.auth.uid])
                         ) ||
                         (
                           request.resource.data.visibility == 'unlisted' &&
                           (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators') &&
                           request.resource.data.viewUserIds.hasAny([request.auth.uid]) && // Owner must be in viewers
                           request.resource.data.editUserIds.hasAll(request.resource.data.editUserIds) && // All editors must be... (this is tautological but fine)
                           request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds) // All editors must be viewers
                         ) ||
                         (
                           request.resource.data.visibility == 'public' &&
                           (
                             request.resource.data.editability == 'owner_only' ||
                             request.resource.data.editability == 'collaborators' ||
                             request.resource.data.editability == 'everyone'
                           ) &&
                           // For public, viewUserIds should be empty unless editability is 'collaborators' (then it contains owner + collaborators)
                           (request.resource.data.editability == 'collaborators' ? request.resource.data.viewUserIds.hasAny([request.auth.uid]) && request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds) : request.resource.data.viewUserIds.hasOnly([])) &&
                           // editUserIds checks
                           (request.resource.data.editability == 'owner_only' ? request.resource.data.editUserIds.hasOnly([request.auth.uid]) : true) &&
                           (request.resource.data.editability == 'collaborators' ? request.resource.data.editUserIds.hasAny([request.auth.uid]) : true) &&
                           (request.resource.data.editability == 'everyone' ? request.resource.data.editUserIds.hasOnly([]) : true)
                         )
                       ) &&
                       // End isValidViewAndEditUserIds logic
                       request.resource.data.keys().hasOnly(['name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']);

      allow update: if request.auth != null &&
                       // Start canEditPlan logic
                       (
                         resource.data.ownerId == request.auth.uid ||
                         (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
                         ( // User can edit if 'everyone' and they can view it
                           resource.data.editability == 'everyone' &&
                           (
                             resource.data.visibility == 'public' ||
                             (resource.data.visibility == 'unlisted' && request.auth.uid in resource.data.viewUserIds) ||
                             (resource.data.visibility == 'private' && request.auth.uid == resource.data.ownerId) // Effectively owner only for private
                           )
                         )
                       ) &&
                       // End canEditPlan logic
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       (
                           ( // E1: Roadmap update path
                             request.resource.data.version == resource.data.version + 1 && // Version *must* be incrementing
                             request.resource.data.keys().has('roadmap') &&                 // The 'roadmap' field *must* be in the update
                             request.resource.data.keys().hasOnly(['roadmap', 'version', 'updatedAt']) // Only these fields are allowed in this specific update
                           ) ||
                           ( // E2: Settings update path
                               resource.data.ownerId == request.auth.uid && // Stricter check: only owner for these settings
                               !request.resource.data.keys().hasAny(['roadmap', 'version']) &&
                               request.resource.data.keys().hasOnly([
                                   'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                   'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                               ]) &&
                               (request.resource.data.visibility in ['private', 'unlisted', 'public']) &&
                               (request.resource.data.editability in ['owner_only', 'collaborators', 'everyone']) &&
                               // Start isValidViewAndEditUserIds logic (inlined for settings update)
                               (
                                 (
                                   request.resource.data.visibility == 'private' &&
                                   request.resource.data.editability == 'owner_only' &&
                                   request.resource.data.viewUserIds.hasOnly([request.auth.uid]) &&
                                   request.resource.data.editUserIds.hasOnly([request.auth.uid])
                                 ) ||
                                 (
                                   request.resource.data.visibility == 'unlisted' &&
                                   (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators') &&
                                   request.resource.data.viewUserIds.hasAny([request.auth.uid]) &&
                                   request.resource.data.editUserIds.hasAll(request.resource.data.editUserIds) &&
                                   request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds)
                                 ) ||
                                 (
                                   request.resource.data.visibility == 'public' &&
                                   (
                                     request.resource.data.editability == 'owner_only' ||
                                     request.resource.data.editability == 'collaborators' ||
                                     request.resource.data.editability == 'everyone'
                                   ) &&
                                   (request.resource.data.editability == 'collaborators' ? request.resource.data.viewUserIds.hasAny([request.auth.uid]) && request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds) : request.resource.data.viewUserIds.hasOnly([])) &&
                                   (request.resource.data.editability == 'owner_only' ? request.resource.data.editUserIds.hasOnly([request.auth.uid]) : true) &&
                                   (request.resource.data.editability == 'collaborators' ? request.resource.data.editUserIds.hasAny([request.auth.uid]) : true) &&
                                   (request.resource.data.editability == 'everyone' ? request.resource.data.editUserIds.hasOnly([]) : true)
                                 )
                               ) &&
                               // End isValidViewAndEditUserIds logic
                               request.resource.data.version == resource.data.version // Version number must remain same
                           )
                       );

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid; // Only owner can delete

      // Plan Versions Subcollection
      match /versions/{versionId} {
          allow read: if request.auth != null &&
                         // Inlined canViewPlan logic for parent plan
                         (
                           get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted' && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds) ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'private' && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) ||
                           (request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds)
                         );
         allow list: if request.auth != null && exists(/databases/$(database)/documents/plans/$(planId)) &&
                         // Inlined canViewPlan logic for parent plan (for list context)
                         (
                           get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted' && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds) ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'private' && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) ||
                           (request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds)
                         );

          allow create: if request.auth != null &&
                         // Inlined canEditPlan logic for parent plan
                         (
                           get(/databases/$(database)/documents/plans/$(planId)).data.ownerId == request.auth.uid ||
                           (
                             get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'collaborators' &&
                             request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.editUserIds
                           ) ||
                           (
                             get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'everyone' &&
                             (
                               get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' ||
                               (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted' && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds) ||
                               (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'private' && request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId)
                             )
                           )
                         ) &&
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
          allow update, delete: if false; // Versions are immutable
      }
    }

    // User Preferences Collection
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // For 'write' (create/update), ensure only allowed fields are written and userId matches
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == userId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly([
                         'userId', 'createdAt', 'updatedAt',
                         'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                         'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                         'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                         'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd', 'paymentMethods'
                       ]);
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == resource.data.userId && // userId cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly([ // All potentially updatable fields
                         'userId', 'createdAt', 'updatedAt',
                         'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                         'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                         'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                         'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd', 'paymentMethods'
                       ]);
    }

    // Article Tags Collection
    match /articleTags/{tagId} {
      allow read: if true; // Tags are public
      allow list: if request.auth != null && request.query.limit <= 20; // Authenticated users can list tags
      allow create: if request.auth != null &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.name is string &&
                       request.resource.data.nameLowercase is string &&
                       request.resource.data.usageCount is number && request.resource.data.usageCount >= 0 &&
                       request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
      allow update: if request.auth != null && // Only usageCount can be updated by any authenticated user
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.nameLowercase == resource.data.nameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.usageCount >= 0 &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
      allow delete: if false; // Tags are not deletable for now
    }


    // News Articles Collection
    match /newsArticles/{articleId} {
        // Default allow read for published articles. Drafts only by owner.
        allow read: if resource.data.status == 'published' || (request.auth != null && request.auth.uid == resource.data.userId);
        allow list: if request.auth != null && request.query.limit <= 100; // General listing for queries (e.g., by user, by status)

        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.status in ['draft', 'published'] &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                            'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount',
                            'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                            'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                         ]);

        allow update: if request.auth != null &&
                         (
                           // Owner updating their article
                           (request.auth.uid == resource.data.userId &&
                             request.resource.data.userId == resource.data.userId && // Cannot change owner
                             request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                             request.resource.data.updatedAt == request.time && // Must be server time
                             (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null || request.resource.data.publishedAt == resource.data.publishedAt) && // PublishedAt can be set, nulled, or unchanged
                             request.resource.data.status in ['draft', 'published'] && // Allowed status transitions
                             // Check that only allowed fields are being modified by the owner
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 'updatedAt', 'publishedAt',
                                'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                                'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                                // 'likeCount', 'likedBy', 'commentCount' are updated by specific actions/triggers
                             ])
                           ) ||
                           // Any authenticated user updating likeCount/likedBy
                           (
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                             request.resource.data.updatedAt == request.time &&
                             // Validate fields not allowed to change during a like
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.title == resource.data.title &&
                             request.resource.data.content == resource.data.content &&
                             request.resource.data.status == resource.data.status &&
                             request.resource.data.createdAt == resource.data.createdAt
                             // Add other fields that must not change during a 'like' operation
                           ) ||
                           // Server-side update to commentCount
                           (
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                             request.resource.data.updatedAt == request.time &&
                             // Basic sanity checks for comment count update
                             request.resource.data.commentCount >= 0
                           )
                         );

        allow delete: if request.auth != null && request.auth.uid == resource.data.userId; // Only owner can delete

        // News Article Comments Subcollection
        match /newsComments/{commentId} {
            allow read: if resource.data.isShadowBanned == false || (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId);
            allow list: if request.auth != null && request.query.limit <= 100; // Anyone authenticated can list, read rule filters
            allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy.size() == 0 &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);

            allow update: if request.auth != null &&
                             ( // User liking/unliking their own or other's comment OR article author shadow banning
                               (
                                 (request.auth.uid == request.resource.data.userId || request.auth.uid != request.resource.data.userId) && // Liking
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt'])
                               ) ||
                               ( // Article author shadow banning
                                 request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId &&
                                 request.resource.data.userId == resource.data.userId &&
                                 request.resource.data.text == resource.data.text &&
                                 request.resource.data.timestamp == resource.data.timestamp &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                               )
                             );
            allow delete: if request.auth != null && request.auth.uid == resource.data.userId; // Only comment owner can delete

            // News Article SubComments (Replies) Subcollection
            match /newsSubcomments/{subCommentId} {
                allow read: if resource.data.isShadowBanned == false || (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId);
                allow list: if request.auth != null && request.query.limit <= 50;
                allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                                 request.resource.data.timestamp == request.time &&
                                 request.resource.data.updatedAt == request.time &&
                                 request.resource.data.likeCount == 0 &&
                                 request.resource.data.likedBy.size() == 0 &&
                                 request.resource.data.isShadowBanned == false &&
                                 request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
                allow update: if request.auth != null &&
                                 ( // User liking/unliking OR article author shadow banning
                                   (
                                     (request.auth.uid == request.resource.data.userId || request.auth.uid != request.resource.data.userId) && // Liking
                                     request.resource.data.userId == resource.data.userId &&
                                     request.resource.data.text == resource.data.text &&
                                     request.resource.data.timestamp == resource.data.timestamp &&
                                     request.resource.data.updatedAt == request.time &&
                                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt'])
                                   ) ||
                                   ( // Article author shadow banning
                                     request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId &&
                                     request.resource.data.userId == resource.data.userId &&
                                     request.resource.data.text == resource.data.text &&
                                     request.resource.data.timestamp == resource.data.timestamp &&
                                     request.resource.data.updatedAt == request.time &&
                                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt'])
                                   )
                                 );
                allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
            }
        }
    }

    // Conversations Collection
    match /conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid in resource.data.participants;
        allow list: if request.auth != null && request.query.limit <= 50 && // Limit queries for performance
                       request.query.filters.size() == 1 && // Expecting one filter
                       request.query.filters[0].field == 'participants' &&
                       request.query.filters[0].operator == 'array-contains' &&
                       request.query.filters[0].value == request.auth.uid; // User must be part of listed conversations

        allow create: if request.auth != null &&
                         request.auth.uid in request.resource.data.participants &&
                         request.resource.data.participants.size() >= 2 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         // Type-specific rules
                         (
                           ( // Direct chat
                             request.resource.data.type == 'direct' &&
                             request.resource.data.participants.size() == 2 &&
                             request.resource.data.groupName == null &&
                             request.resource.data.groupAvatarUrl == null &&
                             request.resource.data.ownerId == null &&
                             request.resource.data.adminIds.size() == 0 &&
                             request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                             request.resource.data.keys().size() == 11 // Ensure no extra fields for direct
                           ) ||
                           ( // Group chat
                             request.resource.data.type == 'group' &&
                             request.resource.data.ownerId == request.auth.uid &&
                             request.auth.uid in request.resource.data.adminIds &&
                             request.resource.data.adminIds.size() >= 1 &&
                             request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                             (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                             request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                             request.resource.data.keys().size() == 11 // Ensure no extra fields for group
                           )
                         );

        allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
                         request.resource.data.participants.hasAll(resource.data.participants) && // Participants list can only grow or shrink via specific actions, not change existing
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time &&
                         // Type-specific update rules
                         (
                           ( // Update for any conversation type (last message, etc.)
                             request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt', 'participants', 'adminIds', 'groupName', 'groupAvatarUrl', 'ownerId', 'formerParticipants'])
                             // Additional checks for group-specific field updates IF they are being changed
                             && (request.resource.data.groupName == resource.data.groupName || (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds)) // Only admins can change groupName
                             && (request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl || (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds)) // Only admins can change groupAvatarUrl
                             && (request.resource.data.ownerId == resource.data.ownerId || (resource.data.type == 'group' && request.auth.uid == resource.data.ownerId)) // Only owner can change ownerId
                             && (
                                  // Adding members: must be admin, participants array must be superset of old
                                  (request.resource.data.participants.size() > resource.data.participants.size() &&
                                   resource.data.type == 'group' && request.auth.uid in resource.data.adminIds &&
                                   request.resource.data.participants.hasAll(resource.data.participants)) ||
                                  // Removing members (leave/kick): must be admin (for kick) or self (for leave)
                                  (request.resource.data.participants.size() < resource.data.participants.size() &&
                                   resource.data.type == 'group' &&
                                   ( (request.auth.uid in resource.data.adminIds && !request.resource.data.participants.hasAll(resource.data.participants.removeAll([request.auth.uid]))) || // Admin kicking someone else
                                     (!request.resource.data.participants.has(request.auth.uid) && resource.data.participants.has(request.auth.uid)) // User leaving themselves
                                   ) &&
                                   resource.data.participants.hasAll(request.resource.data.participants)
                                  ) ||
                                  // No change to participants list
                                  (request.resource.data.participants.size() == resource.data.participants.size() && request.resource.data.participants.hasAll(resource.data.participants))
                             )
                             && ( // Admin list updates
                                  (request.resource.data.adminIds.size() > resource.data.adminIds.size() && resource.data.type == 'group' && request.auth.uid == resource.data.ownerId && request.resource.data.adminIds.hasAll(resource.data.adminIds)) || // Owner promoting
                                  (request.resource.data.adminIds.size() < resource.data.adminIds.size() && resource.data.type == 'group' && request.auth.uid == resource.data.ownerId && resource.data.adminIds.hasAll(request.resource.data.adminIds)) || // Owner demoting
                                  (request.resource.data.adminIds.size() == resource.data.adminIds.size() && request.resource.data.adminIds.hasAll(resource.data.adminIds)) // No change
                             )
                           )
                         );
        allow delete: if false; // Conversations are not directly deletable for now (can be archived/left)

        // Messages Subcollection
        match /messages/{messageId} {
            allow read, list: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
            allow create: if request.auth != null &&
                             request.auth.uid == request.resource.data.senderId &&
                             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                             request.resource.data.conversationId == conversationId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                             request.resource.data.read == false &&
                             request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp', 'conversationId', 'read', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet']) &&
                             request.resource.data.keys().size() == 8; // Exact field count
            allow update, delete: if false; // Messages are immutable
        }
    }

    // Collections
    match /collections/{collectionId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.sharedWithUserIds);
      allow list: if request.auth != null && request.query.limit <= 100 && // Allow general listing for authenticated users with a limit
                       (
                         (request.query.filters.size() == 1 && request.query.filters[0].field == 'ownerId' && request.query.filters[0].operator == '==') ||
                         (request.query.filters.size() == 1 && request.query.filters[0].field == 'sharedWithUserIds' && request.query.filters[0].operator == 'array-contains')
                       ); // Queries must filter by ownerId OR sharedWithUserIds

      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.description is string && // Description can be empty string
                       request.resource.data.postIds is list &&
                       request.resource.data.sharedWithUserIds is list &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().size() == 7; // Ensure no extra fields

      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId && // Only owner can update
                       request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                       request.resource.data.updatedAt == request.time && // Must set updatedAt to server time
                       request.resource.data.keys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']) && // Whitelist allowed fields
                       (request.resource.data.name is string && request.resource.data.name.size() > 0) && // Name cannot be empty string upon update
                       (request.resource.data.description is string) &&
                       (request.resource.data.postIds is list) &&
                       (request.resource.data.sharedWithUserIds is list);

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId; // Only owner can delete
    }
    // Reviews Collection
    match /reviews/{reviewId} {
        allow read: if true; // Reviews are public
        allow list: if request.auth != null && request.query.limit <= 50; // Authenticated users can list reviews

        allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.reviewerId &&
                       request.resource.data.targetUserId != request.resource.data.reviewerId && // Cannot review self
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number) &&
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);

        allow update: if request.auth != null &&
                       request.auth.uid == resource.data.reviewerId && // Only reviewer can update their review
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.reviewerName == resource.data.reviewerName &&
                       request.resource.data.reviewerAvatar == resource.data.reviewerAvatar &&
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);

        allow delete: if request.auth != null && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete their review
    }


  }
}

    