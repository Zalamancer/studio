
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isResourceOwner(resourceData) {
      return isAuthenticated() && request.auth.uid == resourceData.ownerId;
    }
    function isNotEmpty(value) {
      return value is string && value.size() > 0;
    }
    function isNullOrString(value) {
      return value == null || (value is string);
    }
    function isNullOrStringArray(value) {
        return value == null || (value is list && (value.size() == 0 || value[0] is string));
    }
    function isNullOrNumber(value) {
        return value == null || (value is number);
    }
    function isNullOrTimestamp(value) {
        return value == null || (value is timestamp);
    }
    function isNullOrBoolean(value) {
        return value == null || (value is bool);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic info
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid
                    && isNotEmpty(request.resource.data.mentionName)
                    && request.resource.data.mentionNameLowercase == request.resource.data.mentionName.lower()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.lastLoginAt == request.time
                    && request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                        'createdAt', 'updatedAt', 'lastLoginAt'
                      ]);
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email // Email should not be updatable by user directly
                    && request.resource.data.companyName == resource.data.companyName // Company name not directly updatable post-signup
                    && request.resource.data.mentionName == resource.data.mentionName
                    && request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.isBotAccount == resource.data.isBotAccount
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase',
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                        'createdAt', 'updatedAt', 'lastLoginAt'
                      ]);
      allow delete: if false; // Users cannot delete their own profiles directly for now
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow list: if true; // List of posts is public
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && isNotEmpty(request.resource.data.question)
                    && request.resource.data.question.size() <= 200
                    && (request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() > 0)
                    && (isNullOrString(request.resource.data.descriptionTried))
                    && (isNullOrString(request.resource.data.descriptionOutcome))
                    && (request.resource.data.tags is list && request.resource.data.tags.size() >= 0 && request.resource.data.tags.size() <= 5)
                    && isNotEmpty(request.resource.data.sector)
                    && (isNullOrString(request.resource.data.subSector))
                    && (isNullOrString(request.resource.data.industry))
                    && (isNullOrNumber(request.resource.data.ratingScore)) // Allow null or number
                    && (request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request'))
                    && (request.resource.data.commentCount is number && request.resource.data.commentCount == 0)
                    && request.resource.data.createdAt == request.time
                    && (request.resource.data.imageUrls is list)
                    && (isNullOrStringArray(request.resource.data.mentionedUserIds))
                    && (
                          (request.resource.data.requestType == 'post' && request.resource.data.maxBudget == null && request.resource.data.deadline == null) ||
                          (request.resource.data.requestType == 'help_request' && (isNullOrNumber(request.resource.data.maxBudget)) && (isNullOrTimestamp(request.resource.data.deadline)))
                        )
                    && request.resource.data.keys().hasOnly([
                        'userId', 'tags', 'question', 'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                        'maxBudget', 'deadline', 'sector', 'subSector', 'industry', 'ratingScore', 'createdAt', 'naicsCode',
                        'imageUrls', 'mentionedUserIds', 'commentCount'
                      ]);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId // Only owner can update
                    && request.resource.data.userId == resource.data.userId // userId cannot change
                    && request.resource.data.createdAt == resource.data.createdAt // createdAt cannot change
                    && request.resource.data.keys().hasOnly([ // Add fields that can be updated
                        'userId', 'tags', 'question', 'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                        'maxBudget', 'deadline', 'sector', 'subSector', 'industry', 'ratingScore', 'createdAt', 'updatedAt', 'naicsCode',
                        'imageUrls', 'mentionedUserIds', 'commentCount'
                        // 'miroBoardEmbedUrl' was removed
                      ]);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Only owner can delete

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Comments are public
        allow list: if true;
        allow create: if isAuthenticated()
                      && request.resource.data.userId == request.auth.uid
                      && isNotEmpty(request.resource.data.text)
                      && request.resource.data.postId == postId
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.updatedAt == request.time
                      && (request.resource.data.likeCount is number && request.resource.data.likeCount == 0)
                      && (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0)
                      && (isNullOrStringArray(request.resource.data.mentionedUserIds))
                      && (isNullOrString(request.resource.data.parentCommentId)) // Allow null or string for parentCommentId
                      && (isNullOrBoolean(request.resource.data.isShadowBanned))
                      && request.resource.data.keys().hasOnly(['userId', 'text', 'postId', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'parentCommentId', 'isShadowBanned']);
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId // Owner can edit their comment (text, updatedAt)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.postId == resource.data.postId
                      && request.resource.data.timestamp == resource.data.timestamp
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.keys().hasOnly(['userId', 'text', 'postId', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'parentCommentId', 'isShadowBanned']);
                      // For liking/unliking by any authenticated user
                      // This rule needs to be more specific if only text/updatedAt is for owner
                      // More granular field control:
                      // allow update: if (isAuthenticated() && request.auth.uid == resource.data.userId && request.resource.data.keys().hasAny(['text', 'updatedAt'])) ||
                      //                 (isAuthenticated() && request.resource.data.keys().hasAny(['likedBy', 'likeCount']));
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // Owner can delete

        // SubComments (Replies to comments)
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow list: if true;
            allow create: if isAuthenticated()
                          && request.resource.data.userId == request.auth.uid
                          && isNotEmpty(request.resource.data.text)
                          && request.resource.data.timestamp == request.time
                          && request.resource.data.updatedAt == request.time
                          && (request.resource.data.likeCount is number && request.resource.data.likeCount == 0)
                          && (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0)
                          && (isNullOrStringArray(request.resource.data.mentionedUserIds))
                          && (isNullOrBoolean(request.resource.data.isShadowBanned))
                          && request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);

            allow update: if isAuthenticated() && request.auth.uid == resource.data.userId // Owner can edit text
                          && request.resource.data.userId == resource.data.userId
                          && request.resource.data.timestamp == resource.data.timestamp
                          && request.resource.data.updatedAt == request.time
                          && request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
                          // Add rule for liking/unliking by any authenticated user if needed, similar to main comments

            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      // Bids subcollection
      match /bids/{bidId} {
        allow read: if true; // Bids might be public or restricted to post owner + bidder
        allow list: if true; // Similar to read, might need rules
        allow create: if isAuthenticated()
                      && request.resource.data.bidderId == request.auth.uid
                      && request.resource.data.postId == postId
                      && request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0
                      && (isNullOrString(request.resource.data.bidMessage))
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
        // No updates or deletes for bids usually, unless specific logic is added
        allow update: if false;
        allow delete: if false;
      }
    }

    // Mutuals (Connections)
    match /mutuals/{connectionId} {
      // Users can only read/write their own connection documents
      // connectionId is {uid1}_{uid2} sorted.
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.auth.uid in request.resource.data.userIds
                    && request.resource.data.userIds.size() == 2
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedAt == request.time
                    && (request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) || request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt'])); // Allow with or without initial updatedAt

      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.userIds // Involved user can update (accept/reject/connect)
                    // Rule for accepting: recipient updates status to 'connected'
                    && ( (request.resource.data.status == 'connected' && resource.data.status == 'pending' && request.auth.uid != resource.data.requesterId && request.resource.data.connectedAt == request.time)
                    // Fields that can be updated
                    && request.resource.data.keys().hasOnly(['status', 'connectedAt', 'updatedAt', 'userIds', 'requesterId', 'requestedAt']) // Ensure only allowed fields are part of the update
                    && request.resource.data.userIds == resource.data.userIds
                    && request.resource.data.requesterId == resource.data.requesterId
                    && request.resource.data.updatedAt == request.time
                    // requestedAt should not change on accept
                    && (request.resource.data.requestedAt == resource.data.requestedAt || (request.resource.data.requestedAt == null && resource.data.requestedAt != null) || (resource.data.requestedAt == null && request.resource.data.requestedAt != null) )
                    )
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds // Involved user can delete (cancel/remove)
                    && (resource.data.status == 'pending' || resource.data.status == 'connected');
      allow list: if false; // Do not allow listing all mutuals docs. Users query by their UID.
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
      // More granular create/update if needed:
      allow create: if isOwner(userId)
                    && request.resource.data.userId == userId
                    && (request.resource.data.createdAt == request.time || request.resource.data.createdAt == null) // Allow null for initial creation from client
                    && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt == null)
                    && request.resource.data.keys().hasOnly([
                        'userId', 'notifyOnReply', 'notifyOnMention',
                        'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                        'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', 'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                        'paymentMethods', 'createdAt', 'updatedAt'
                    ]);
      allow update: if isOwner(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                        'userId', 'notifyOnReply', 'notifyOnMention',
                        'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                        'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId', 'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                        'paymentMethods', 'createdAt', 'updatedAt'
                    ]);
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow list: if true; // Allow listing by targetUserId or reviewerId
      allow create: if isAuthenticated()
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.targetUserId != request.auth.uid // Cannot review self
                    && isNotEmpty(request.resource.data.reviewerName)
                    && (request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)
                    && isNotEmpty(request.resource.data.comment)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                        'targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar',
                        'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt'
                    ]);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.reviewerId // Only reviewer can update
                    && request.resource.data.targetUserId == resource.data.targetUserId
                    && request.resource.data.reviewerId == resource.data.reviewerId
                    && request.resource.data.reviewerName == resource.data.reviewerName
                    && request.resource.data.reviewerAvatar == resource.data.reviewerAvatar
                    && request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && (request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)
                    && isNotEmpty(request.resource.data.comment)
                    && request.resource.data.keys().hasOnly([
                        'targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar',
                        'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt'
                    ]);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

    // Tags Collection for News Articles
    match /articleTags/{tagId} {
        allow read: if true;
        allow list: if true; // Allow searching/listing tags
        allow create: if isAuthenticated()
                        && request.resource.data.createdBy == request.auth.uid
                        && isNotEmpty(request.resource.data.name)
                        && request.resource.data.nameLowercase == request.resource.data.name.lower()
                        && request.resource.data.usageCount is number && request.resource.data.usageCount >= 0
                        && request.resource.data.createdAt == request.time
                        && request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
        allow update: if isAuthenticated() // Allow authenticated users to update usageCount (e.g. via transaction)
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.nameLowercase == resource.data.nameLowercase
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.usageCount is number && request.resource.data.usageCount >= 0 // Ensure it doesn't go negative
                        && request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
        allow delete: if false; // Tags are not deletable by users for now
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
      function isArticleOwner() {
        return isAuthenticated() && request.auth.uid == resource.data.userId;
      }
      function isPublished() {
        return resource.data.status == 'published';
      }
      function isDraftByOwner() {
        return resource.data.status == 'draft' && isArticleOwner();
      }

      allow read: if isPublished() || isDraftByOwner();
      allow list: if isAuthenticated() && request.query.limit <= 100; // Allow general listing for authenticated users

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && isNotEmpty(request.resource.data.title)
                    && request.resource.data.title.size() <= 250 // Example limit
                    && isNotEmpty(request.resource.data.content)
                    && (request.resource.data.status == 'draft' || request.resource.data.status == 'published')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == null)
                    && (request.resource.data.likeCount is number && request.resource.data.likeCount == 0)
                    && (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0)
                    && (request.resource.data.commentCount is number && request.resource.data.commentCount == 0)
                    && request.resource.data.keys().hasOnly([
                        'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status',
                        'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy',
                        'commentCount', 'descriptionDetails', 'descriptionOutcome', 'descriptionTried',
                        'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                        'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                      ]);

      allow update: if isArticleOwner()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && (request.resource.data.status == 'draft' || request.resource.data.status == 'published')
                    && (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == resource.data.publishedAt || request.resource.data.publishedAt == null)
                    && (request.resource.data.likeCount is number && request.resource.data.likeCount >= 0) // Allow like count to change
                    && (request.resource.data.likedBy is list) // Allow likedBy list to change
                    && (request.resource.data.commentCount is number && request.resource.data.commentCount >= 0) // Allow comment count to change
                    && request.resource.data.keys().hasOnly([
                        'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status',
                        'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy',
                        'commentCount', 'descriptionDetails', 'descriptionOutcome', 'descriptionTried',
                        'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                        'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                      ]);
                    // For liking/unliking by ANY authenticated user (not just owner)
                    // allow update: if isAuthenticated()
                    //             && request.resource.data.keys().hasOnly(['likedBy', 'likeCount', 'updatedAt'])
                    //             && request.resource.data.updatedAt == request.time
                    //             && request.resource.data.likeCount is number && request.resource.data.likeCount >= 0
                    //             && request.resource.data.likedBy is list;


      allow delete: if isArticleOwner();

      // News Comments Subcollection
      match /newsComments/{commentId} {
          function isCommentOwner() {
              return isAuthenticated() && request.auth.uid == resource.data.userId;
          }
          function isArticleOwnerForCommentContext() { // Check against parent article's owner
              return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
          }

          allow read: if resource.data.isShadowBanned == false || isArticleOwnerForCommentContext();
          allow list: if isAuthenticated(); // Simplified list, relies on read for actual visibility
          allow create: if isAuthenticated()
                        && request.resource.data.userId == request.auth.uid
                        && isNotEmpty(request.resource.data.text)
                        && request.resource.data.timestamp == request.time
                        && request.resource.data.updatedAt == request.time
                        && (request.resource.data.likeCount is number && request.resource.data.likeCount == 0)
                        && (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0)
                        && (isNullOrStringArray(request.resource.data.mentionedUserIds))
                        && (request.resource.data.isShadowBanned == false)
                        && request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
          allow update: if (isCommentOwner() && request.resource.data.text != resource.data.text) || // Owner can edit text
                          (isAuthenticated() && (request.resource.data.likedBy != resource.data.likedBy || request.resource.data.likeCount != resource.data.likeCount)) || // Anyone can like
                          (isArticleOwnerForCommentContext() && request.resource.data.isShadowBanned != resource.data.isShadowBanned) // Article owner can shadow ban
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.timestamp == resource.data.timestamp
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
          allow delete: if isCommentOwner() || isArticleOwnerForCommentContext(); // Owner of comment or article owner can delete

           // News SubComments (Replies to news comments)
            match /newsSubcomments/{subCommentId} {
                function isSubCommentOwner() {
                    return isAuthenticated() && request.auth.uid == resource.data.userId;
                }
                function isArticleOwnerForSubCommentContext() {
                    return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId;
                }

                allow read: if resource.data.isShadowBanned == false || isArticleOwnerForSubCommentContext();
                allow list: if isAuthenticated();
                allow create: if isAuthenticated()
                              && request.resource.data.userId == request.auth.uid
                              && isNotEmpty(request.resource.data.text)
                              && request.resource.data.timestamp == request.time
                              && request.resource.data.updatedAt == request.time
                              && (request.resource.data.likeCount is number && request.resource.data.likeCount == 0)
                              && (request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0)
                              && (isNullOrStringArray(request.resource.data.mentionedUserIds))
                              && (request.resource.data.isShadowBanned == false)
                              && request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
                allow update: if (isSubCommentOwner() && request.resource.data.text != resource.data.text) ||
                                (isAuthenticated() && (request.resource.data.likedBy != resource.data.likedBy || request.resource.data.likeCount != resource.data.likeCount)) ||
                                (isArticleOwnerForSubCommentContext() && request.resource.data.isShadowBanned != resource.data.isShadowBanned)
                              && request.resource.data.userId == resource.data.userId
                              && request.resource.data.timestamp == resource.data.timestamp
                              && request.resource.data.updatedAt == request.time
                              && request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
                allow delete: if isSubCommentOwner() || isArticleOwnerForSubCommentContext();
            }
      }
    }

    // Collaboration Plans
    match /plans/{planId} {
        function isPlanOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }
        function canViewPlan() {
            return (resource.data.visibility == 'public') ||
                   (resource.data.visibility == 'unlisted' && isAuthenticated()) ||
                   (resource.data.visibility == 'private' && isPlanOwner()) ||
                   (isAuthenticated() && request.auth.uid in resource.data.viewUserIds);
        }
        function canEditPlan() {
            return (isPlanOwner()) ||
                   (resource.data.editability == 'collaborators' && isAuthenticated() && request.auth.uid in resource.data.editUserIds) ||
                   (resource.data.editability == 'everyone' && isAuthenticated() && canViewPlan()); // If 'everyone' can edit, they must also be able to view
        }
        function planVisibilityValues() { return ['private', 'unlisted', 'public']; }
        function planEditabilityValues() { return ['owner_only', 'collaborators', 'everyone']; }
        function isValidRoadmap(roadmap) {
            return roadmap is list && (roadmap.size() == 0 || (
                roadmap[0].keys().hasAll(['id', 'title', 'x', 'y', 'childrenData']) &&
                roadmap[0].childrenData is list &&
                (roadmap[0].childrenData.size() == 0 || roadmap[0].childrenData[0].keys().hasAll(['id', 'title', 'parentCanvasNodeId']))
            ));
        }

        allow read: if canViewPlan();

        allow list: if isAuthenticated() &&
                        request.query.limit <= 50 &&
                        (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt') &&
                        (
                          // Case for getRecentPlans (and other visibility 'in' queries on createdAt/updatedAt order)
                          // This is more relaxed on the values of the 'in' filter, relying on 'read' rules for final document visibility.
                          (request.query.filters.size() == 1 && request.query.filters[0].field == 'visibility' && request.query.filters[0].operator == 'in') ||
                          (request.query.filters.size() == 0) || // Generic listing
                          (request.query.filters.size() == 1 && request.query.filters[0].field == 'ownerId' && request.query.filters[0].operator == '==' && request.query.filters[0].value == request.auth.uid) ||
                          (request.query.filters.size() == 1 && request.query.filters[0].field == 'viewUserIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid) ||
                          (request.query.filters.size() == 1 && request.query.filters[0].field == 'editUserIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid)
                        );


        allow create: if isAuthenticated()
                        && request.resource.data.ownerId == request.auth.uid
                        && isNotEmpty(request.resource.data.name)
                        && isNotEmpty(request.resource.data.sector)
                        && request.resource.data.createdAt == request.time
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.version == 1
                        && request.resource.data.roadmap is list && request.resource.data.roadmap.size() == 0
                        && request.resource.data.visibility in planVisibilityValues()
                        && request.resource.data.editability in planEditabilityValues()
                        && request.resource.data.viewUserIds is list
                        && request.resource.data.editUserIds is list
                        && (request.resource.data.visibility == 'private' ? request.resource.data.editability == 'owner_only' : true)
                        && (request.resource.data.visibility == 'unlisted' ? request.resource.data.editability != 'everyone' : true)
                        && request.resource.data.keys().hasOnly([
                            'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                            'createdAt', 'updatedAt', 'version', 'roadmap',
                            'visibility', 'editability', 'viewUserIds', 'editUserIds'
                          ]);

        allow update: if canEditPlan()
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.updatedAt == request.time
                        && (request.resource.data.version == resource.data.version + 1 || request.resource.data.version == resource.data.version)
                        && isValidRoadmap(request.resource.data.roadmap)
                        && request.resource.data.visibility in planVisibilityValues()
                        && request.resource.data.editability in planEditabilityValues()
                        && request.resource.data.viewUserIds is list
                        && request.resource.data.editUserIds is list
                        && (request.resource.data.visibility == 'private' ? request.resource.data.editability == 'owner_only' : true)
                        && (request.resource.data.visibility == 'unlisted' ? request.resource.data.editability != 'everyone' : true)
                        && request.resource.data.keys().hasOnly([
                            'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                            'createdAt', 'updatedAt', 'version', 'roadmap',
                            'visibility', 'editability', 'viewUserIds', 'editUserIds'
                          ]);
        allow delete: if isPlanOwner();

        match /versions/{versionId} {
            allow read: if canViewPlan();
            allow list: if canViewPlan() && request.query.limit <= 50;
            allow create: if canEditPlan()
                            && request.resource.data.planId == planId
                            && request.resource.data.editorUid == request.auth.uid
                            && request.resource.data.timestamp == request.time
                            && request.resource.data.versionNumber is number
                            && isValidRoadmap(request.resource.data.roadmap)
                            && request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);
            allow update, delete: if false;
        }
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participants;
      }
      function isGroupAdmin() {
        return isParticipant() && request.auth.uid in resource.data.adminIds;
      }
      function isGroupOwner() {
        return isParticipant() && request.auth.uid == resource.data.ownerId;
      }
      function isValidNewConversation() {
        return request.resource.data.participants.size() >= 2
               && request.auth.uid in request.resource.data.participants
               && request.resource.data.createdAt == request.time
               && request.resource.data.updatedAt == request.time
               && request.resource.data.lastMessageTimestamp == request.time
               && request.resource.data.lastMessage == null
               && (request.resource.data.postId == null || request.resource.data.postId is string)
               && (request.resource.data.type == 'direct' || request.resource.data.type == 'group')
               && (request.resource.data.type == 'direct' ?
                    request.resource.data.participants.size() == 2 &&
                    request.resource.data.groupName == null &&
                    request.resource.data.groupAvatarUrl == null &&
                    request.resource.data.ownerId == null &&
                    request.resource.data.adminIds.size() == 0
                  : true)
               && (request.resource.data.type == 'group' ?
                    isNotEmpty(request.resource.data.groupName) &&
                    (isNullOrString(request.resource.data.groupAvatarUrl)) &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.adminIds.hasAll([request.auth.uid])
                  : true)
               && request.resource.data.keys().hasOnly([
                    'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                    'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl',
                    'ownerId', 'adminIds', 'formerParticipants'
                  ]);
      }
      function isValidConversationUpdate() {
          return request.resource.data.participants is list
                && request.resource.data.type == resource.data.type
                && request.resource.data.postId == resource.data.postId
                && request.resource.data.createdAt == resource.data.createdAt
                && request.resource.data.updatedAt == request.time
                && (request.resource.data.lastMessage is string || request.resource.data.lastMessage == null)
                && (request.resource.data.lastMessageTimestamp == request.time || request.resource.data.lastMessageTimestamp == resource.data.lastMessageTimestamp)
                && request.resource.data.groupName == resource.data.groupName
                && request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl
                && request.resource.data.ownerId == resource.data.ownerId
                && request.resource.data.adminIds is list
                && request.resource.data.keys().hasOnly([
                      'participants', 'type', 'postId', 'createdAt', 'updatedAt',
                      'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl',
                      'ownerId', 'adminIds', 'formerParticipants'
                    ]);
      }
      function isValidGroupDetailsUpdate() {
          return request.resource.data.groupName is string && isNotEmpty(request.resource.data.groupName)
                && (isNullOrString(request.resource.data.groupAvatarUrl))
                && request.resource.data.keys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt',
                                                        'participants', 'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds', 'formerParticipants']);
      }
      function isValidParticipantUpdate() {
          return request.resource.data.participants is list
                && request.resource.data.adminIds is list
                && request.resource.data.keys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants',
                                                         'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId']);
      }
      function isValidOwnershipTransfer() {
        return request.resource.data.ownerId is string
               && request.resource.data.ownerId != resource.data.ownerId
               && request.resource.data.ownerId in request.resource.data.participants
               && request.resource.data.adminIds.hasAll([request.resource.data.ownerId])
               && request.resource.data.keys().hasOnly(['ownerId', 'adminIds', 'updatedAt',
                                                        'participants', 'type', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'formerParticipants']);
      }

      allow read: if isParticipant();
      allow list: if isAuthenticated() && request.query.limit <= 50;
      allow create: if isAuthenticated() && isValidNewConversation();
      allow update: if isAuthenticated() && isParticipant() && isValidConversationUpdate()
                      && (
                         (request.resource.data.lastMessage != resource.data.lastMessage || request.resource.data.lastMessageSenderId != resource.data.lastMessageSenderId) ||
                         (isGroupAdmin() && isValidGroupDetailsUpdate()) ||
                         (isGroupAdmin() && isValidParticipantUpdate()) ||
                         (isGroupOwner() && isValidOwnershipTransfer()) ||
                         (request.auth.uid in resource.data.participants && !(request.auth.uid in request.resource.data.participants) && request.resource.data.formerParticipants[request.auth.uid] == request.time )
                       );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant();
        allow list: if isParticipant();
        allow create: if isAuthenticated()
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.conversationId == conversationId
                      && isNotEmpty(request.resource.data.text)
                      && request.resource.data.timestamp == request.time
                      && (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true)
                      && (isNullOrString(request.resource.data.replyToMessageId))
                      && (isNullOrString(request.resource.data.repliedToTextSnippet))
                      && (request.resource.data.read == false)
                      && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'conversationId', 'read']);
        allow update: if false;
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
        function isNotificationRecipient() {
            return isAuthenticated() && request.auth.uid == resource.data.userId;
        }

        allow read, list: if isNotificationRecipient() && request.query.limit <= 50;
        allow create: if isAuthenticated()
                      && request.resource.data.userId is string
                      && request.resource.data.senderId is string
                      && (request.resource.data.type is string && request.resource.data.type in ['reply', 'mention', 'connection_request', 'connection_accepted', 'new_message'])
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.isRead == false
                      && request.resource.data.keys().hasOnly([
                          'userId', 'type', 'senderId', 'senderName', 'senderAvatar',
                          'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId',
                          'textSnippet', 'timestamp', 'isRead', 'updatedAt'
                      ]);
        allow update: if isNotificationRecipient()
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.type == resource.data.type
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.timestamp == resource.data.timestamp
                      && request.resource.data.keys().hasOnly(['userId', 'type', 'senderId', 'senderName', 'senderAvatar', 'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId', 'textSnippet', 'timestamp', 'isRead', 'updatedAt'])
                      && request.resource.data.updatedAt == request.time;
        allow delete: if false;
    }

    match /collections/{collectionId} {
        function isCollectionOwner() {
            return isAuthenticated() && request.auth.uid == resource.data.ownerId;
        }
        function isSharedWithUser() {
            return isAuthenticated() && request.auth.uid in resource.data.sharedWithUserIds;
        }

        allow read: if isCollectionOwner() || isSharedWithUser();
        allow list: if isAuthenticated() && request.query.limit <= 100 &&
                       ( (request.query.filters.size() == 1 && request.query.filters[0].field == 'ownerId' && request.query.filters[0].operator == '==' && request.query.filters[0].value == request.auth.uid) ||
                         (request.query.filters.size() == 1 && request.query.filters[0].field == 'sharedWithUserIds' && request.query.filters[0].operator == 'array-contains' && request.query.filters[0].value == request.auth.uid)
                       );

        allow create: if isAuthenticated()
                        && request.resource.data.ownerId == request.auth.uid
                        && isNotEmpty(request.resource.data.name)
                        && request.resource.data.name.size() <= 100
                        && (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
                        && request.resource.data.postIds is list
                        && request.resource.data.sharedWithUserIds is list
                        && request.resource.data.createdAt == request.time
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']);

        allow update: if isCollectionOwner()
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.updatedAt == request.time
                        && (request.resource.data.name == resource.data.name || (isNotEmpty(request.resource.data.name) && request.resource.data.name.size() <= 100) )
                        && (request.resource.data.description == resource.data.description || (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 500)))
                        && (request.resource.data.postIds is list)
                        && (request.resource.data.sharedWithUserIds is list)
                        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']);

        allow delete: if isCollectionOwner();
    }
  }
}

    