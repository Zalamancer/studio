
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getIncomingData() {
      return request.resource.data;
    }

    function getExistingData() {
      return resource.data;
    }

    function isNotEmpty(value) {
      return value != null && value.size() > 0;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Public profiles are generally readable
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                     getIncomingData().uid == userId &&
                     getIncomingData().createdAt == request.time &&
                     getIncomingData().updatedAt == request.time &&
                     getIncomingData().lastLoginAt == request.time &&
                     // Allow initial mentionName to be set, ensure it's string
                     getIncomingData().mentionName is string && isNotEmpty(getIncomingData().mentionName) &&
                     getIncomingData().mentionNameLowercase is string && isNotEmpty(getIncomingData().mentionNameLowercase) &&
                     // Optional fields can be null or their respective types
                     (getIncomingData().companyName == null || getIncomingData().companyName is string) &&
                     (getIncomingData().email == null || getIncomingData().email is string) &&
                     (getIncomingData().avatarUrl == null || getIncomingData().avatarUrl is string) &&
                     (getIncomingData().industry == null || getIncomingData().industry is string) &&
                     (getIncomingData().description == null || getIncomingData().description is string) &&
                     (getIncomingData().descriptionVisibility == null || getIncomingData().descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                     (getIncomingData().sectorName == null || getIncomingData().sectorName is string) &&
                     (getIncomingData().subSectorName == null || getIncomingData().subSectorName is string) &&
                     (getIncomingData().industryName == null || getIncomingData().industryName is string) &&
                     (getIncomingData().naicsCode == null || getIncomingData().naicsCode is string) &&
                     (getIncomingData().tags == null || getIncomingData().tags is list) &&
                     (getIncomingData().established == null || getIncomingData().established is string) &&
                     (getIncomingData().verified == null || getIncomingData().verified is bool) &&
                     (getIncomingData().isBotAccount == null || getIncomingData().isBotAccount is bool) &&
                     (getIncomingData().incomeRange == null || getIncomingData().incomeRange is string) &&
                     getIncomingData().keys().hasAll(['uid', 'createdAt', 'updatedAt', 'lastLoginAt', 'mentionName', 'mentionNameLowercase']) && // Ensure only allowed fields + required are present
                     getIncomingData().size() >= 6; // Min required fields

      allow update: if isAuthenticated() && request.auth.uid == userId &&
                     getIncomingData().updatedAt == request.time &&
                     // Ensure immutable fields are not changed if they exist
                     (resource.data.uid == null || getIncomingData().uid == resource.data.uid) &&
                     (resource.data.email == null || getIncomingData().email == resource.data.email) &&
                     (resource.data.createdAt == null || getIncomingData().createdAt == resource.data.createdAt) &&
                     (resource.data.mentionName == null || getIncomingData().mentionName == resource.data.mentionName) &&
                     (resource.data.mentionNameLowercase == null || getIncomingData().mentionNameLowercase == resource.data.mentionNameLowercase) &&
                     // Check allowed fields for update (only these + required ones)
                     getIncomingData().keys().hasOnly(['uid', 'createdAt', 'updatedAt', 'lastLoginAt', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange']) &&
                     // Flexible size check for updates as not all fields may be sent
                     getIncomingData().size() >= 1; // At least updatedAt
    }

    // Mutuals (Connections)
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time && // requestedAt should be set on create
                       request.resource.data.updatedAt == request.time && // updatedAt also on create
                       // Ensure no connectedAt on initial pending request
                       !request.resource.data.keys().hasAny(['connectedAt']) &&
                       request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']) &&
                       request.resource.data.size() == 5;

      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // User must be part of the connection
                       request.resource.data.updatedAt == request.time &&
                       // Ensure critical fields are not changed
                       request.resource.data.userIds.toSet() == resource.data.userIds.toSet() &&
                       request.resource.data.requesterId == resource.data.requesterId &&
                       request.resource.data.requestedAt == resource.data.requestedAt &&
                       // Allow status to change to 'connected' and connectedAt to be set
                       ( (request.resource.data.status == 'connected' && resource.data.status == 'pending' && request.resource.data.connectedAt == request.time) ||
                         // Allow status to change (e.g., to blocked - more specific rules needed if blocking implemented)
                         (request.resource.data.status != resource.data.status)
                       ) &&
                       // Define allowed fields for update
                       request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'connectedAt', 'updatedAt']) &&
                       request.resource.data.size() >= 5; // Min 5, can be 6 if connectedAt added

      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Both users can break connection or cancel
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // Publicly readable posts
      allow list: if true; // Allow listing posts, refine with query rules if needed

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       // Validate other required fields
                       request.resource.data.question is string && request.resource.data.question.size() > 0 &&
                       request.resource.data.descriptionDetails is string && request.resource.data.descriptionDetails.size() >= 0 && // Allow empty string
                       request.resource.data.requestType in ['post', 'help_request'] &&
                       request.resource.data.tags is list &&
                       request.resource.data.sector is string &&
                       (request.resource.data.ratingScore == null || request.resource.data.ratingScore is number) &&
                       (request.resource.data.commentCount == 0) &&
                       request.resource.data.keys().hasAll(['userId', 'question', 'tags', 'sector', 'createdAt', 'commentCount', 'requestType', 'descriptionDetails']) &&
                       // Ensure only allowed fields are present during creation
                       request.resource.data.keys().hasOnly([
                         'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'ratingScore',
                         'imageUrls', 'mentionedUserIds', 'requestType', 'createdAt', 'commentCount',
                         'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline'
                         // 'miroBoardEmbedUrl' // Removed
                       ]); // Check size based on required + optional fields sent
                       // Size check is tricky with optional fields. Rely on hasOnly for now.

      allow update: if isAuthenticated() &&
                       // User can only update their own posts
                       request.auth.uid == resource.data.userId &&
                       // Certain fields should be immutable or have specific update logic
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       // Allow updating commentCount only by +1 or -1, and ensure updatedAt is also set
                       (
                         ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                           (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                           request.resource.data.updatedAt == request.time
                         ) ||
                         // Allow general updates to other fields by the post owner
                         ( request.resource.data.diff(resource.data).affectedKeys().hasAny(['question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'requestType', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline', 'updatedAt']) &&
                           request.resource.data.updatedAt == request.time
                         )
                       );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow list: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId && // Ensure comment is for this post
                         request.resource.data.text is string && isNotEmpty(request.resource.data.text) &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         (request.resource.data.mentionName == null || request.resource.data.mentionName is string) && // mentionName can be null initially or string
                         request.resource.data.keys().hasAll(['userId', 'postId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) && // Removed mentionName from required on create
                         request.resource.data.size() >= 8; // Min 8 required, can be 9 if mentionName sent

        allow update: if isAuthenticated() &&
                         // Ensure only allowed fields are changed (primarily for likes, updatedAt)
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         // Validate likeCount and likedBy changes
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         ( (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet()) && request.resource.data.likedBy.toSet().addedKeys().hasOnly([request.auth.uid]) && request.resource.data.likedBy.toSet().removedKeys().size() == 0) || // Adding self
                           (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet().removeAll([request.auth.uid])) && request.resource.data.likedBy.toSet().addedKeys().size() == 0 && request.resource.data.likedBy.toSet().removedKeys().hasOnly([request.auth.uid])) // Removing self
                         ) &&
                         // Ensure no other fields are changed during a like update
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.updatedAt == request.time;

        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.text is string && isNotEmpty(request.resource.data.text) &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list &&
                           request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                           request.resource.data.size() == 7; // 7 fields if mentionName is not sent, service might add it

          allow update: if isAuthenticated() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           ( (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet()) && request.resource.data.likedBy.toSet().addedKeys().hasOnly([request.auth.uid]) && request.resource.data.likedBy.toSet().removedKeys().size() == 0) ||
                             (request.resource.data.likedBy.toSet().hasAll(resource.data.likedBy.toSet().removeAll([request.auth.uid])) && request.resource.data.likedBy.toSet().addedKeys().size() == 0 && request.resource.data.likedBy.toSet().removedKeys().hasOnly([request.auth.uid]))
                           ) &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.text == resource.data.text &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.updatedAt == request.time;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
          allow read: if isAuthenticated() && (request.auth.uid == resource.data.bidderId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId); // Bidder or Post owner
          allow list: if isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Only Post owner can list all bids for their post
          allow create: if isAuthenticated() &&
                           request.resource.data.bidderId == request.auth.uid &&
                           // Safer way to check "not bidding on own post"
                           // This means: (post doc has no userId field OR post's userId is not the current user)
                           (get(/databases/$(database)/documents/posts/$(postId)).data.get('userId', '') != request.auth.uid) &&
                           request.resource.data.postId == postId && // Ensure bid is for this post
                           request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.bidMessage is string && // bidMessage should be string
                           request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                           request.resource.data.size() == 5;
          allow update: if false; // Bids are generally not updatable, only created/deleted
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.bidderId; // Bidder can delete their bid
      }
    }

    // User Preferences
    match /userPreferences/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       getIncomingData().userId == userId && // Ensure userId field matches doc ID
                       getIncomingData().createdAt == request.time &&
                       getIncomingData().updatedAt == request.time &&
                       // Allow all other fields to be absent or their correct type
                       (getIncomingData().paymentMethods == null || getIncomingData().paymentMethods is list) &&
                       (getIncomingData().notifyOnReply == null || getIncomingData().notifyOnReply is bool) &&
                       (getIncomingData().notifyOnMention == null || getIncomingData().notifyOnMention is bool) &&
                       (getIncomingData().notifyOnNewConnectionRequest == null || getIncomingData().notifyOnNewConnectionRequest is bool) &&
                       (getIncomingData().notifyOnConnectionAccepted == null || getIncomingData().notifyOnConnectionAccepted is bool) &&
                       (getIncomingData().notifyOnNewMessage == null || getIncomingData().notifyOnNewMessage is bool) &&
                       (getIncomingData().notifyOnPlatformUpdates == null || getIncomingData().notifyOnPlatformUpdates is bool) &&
                       (getIncomingData().stripeCustomerId == null || getIncomingData().stripeCustomerId is string) &&
                       (getIncomingData().stripeSubscriptionId == null || getIncomingData().stripeSubscriptionId is string) &&
                       (getIncomingData().activeStripePriceId == null || getIncomingData().activeStripePriceId is string) &&
                       (getIncomingData().stripeSubscriptionStatus == null || getIncomingData().stripeSubscriptionStatus is string) &&
                       (getIncomingData().stripeSubscriptionCurrentPeriodEnd == null || getIncomingData().stripeSubscriptionCurrentPeriodEnd is number) &&
                       (getIncomingData().stripeSubscriptionWillCancelAtPeriodEnd == null || getIncomingData().stripeSubscriptionWillCancelAtPeriodEnd is bool) &&
                       getIncomingData().keys().hasAll(['userId', 'createdAt', 'updatedAt']); // Ensure only allowed fields + required are present

      allow update: if isAuthenticated() && request.auth.uid == userId &&
                       getIncomingData().userId == resource.data.userId && // Cannot change userId
                       getIncomingData().createdAt == resource.data.createdAt && // Cannot change createdAt
                       getIncomingData().updatedAt == request.time && // Must set updatedAt to server time
                       // Allow updates to only specific fields
                       getIncomingData().keys().hasOnly([
                         'userId', 'createdAt', 'updatedAt',
                         'paymentMethods',
                         'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                         'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                         'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                         'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd'
                       ]);
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow list: if true; // Allow listing reviews
      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.reviewerName is string &&
                       (request.resource.data.reviewerAvatar == null || request.resource.data.reviewerAvatar is string) &&
                       (request.resource.data.reviewerHistoricalAvgRating == null || request.resource.data.reviewerHistoricalAvgRating is number) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasAll(['targetUserId', 'reviewerId', 'reviewerName', 'rating', 'comment', 'createdAt', 'updatedAt', 'reviewerAvatar', 'reviewerHistoricalAvgRating']) &&
                       request.resource.data.size() == 9; // check size
      allow update: if isAuthenticated() && request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) && // Only rating, comment, updatedAt can change
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.updatedAt == request.time &&
                       // Immutable fields
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.reviewerName == resource.data.reviewerName &&
                       request.resource.data.reviewerAvatar == resource.data.reviewerAvatar &&
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

    // Collections
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return resource.data.ownerId == request.auth.uid;
      }
      function isSharedWithUser() {
        return request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      allow list: if isAuthenticated(); // Users can list collections they own or are shared with (client-side filters apply)
                       // Query needs to be secured: where('ownerId', '==', request.auth.uid) OR where('sharedWithUserIds', 'array-contains', request.auth.uid)
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       isNotEmpty(request.resource.data.name) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.postIds is list && // Can be empty initially
                       request.resource.data.sharedWithUserIds is list && // Can be empty initially
                       request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                       request.resource.data.size() >= 6; // name, ownerId, postIds, sharedWith, createdAt, updatedAt (description optional)

      allow update: if isAuthenticated() && isCollectionOwner() &&
                       request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be new server time
                       // Allow updates to name, description, postIds, sharedWithUserIds
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
      allow delete: if isAuthenticated() && isCollectionOwner();
    }

    // Plans & Plan Versions
    match /plans/{planId} {
        function isPlanOwner() {
            return resource.data.ownerId == request.auth.uid;
        }
        function canViewPlan() {
            return resource.data.visibility == 'public' ||
                   resource.data.visibility == 'unlisted' || // Unlisted implies link access, rule relies on client not showing it unless intended
                   isPlanOwner() ||
                   (resource.data.viewUserIds is list && request.auth.uid in resource.data.viewUserIds);
        }
        function canEditPlan() {
            return isPlanOwner() ||
                   (resource.data.editability == 'collaborators' && resource.data.editUserIds is list && request.auth.uid in resource.data.editUserIds) ||
                   (resource.data.editability == 'everyone' && canViewPlan()); // If everyone can edit, they must also be ableto view
        }

        allow read: if isAuthenticated() && canViewPlan();
        allow list: if isAuthenticated(); // Allow listing for discover page (client filters by visibility)
        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         isNotEmpty(request.resource.data.name) &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.version == 1 &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                         request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                         request.resource.data.viewUserIds is list &&
                         request.resource.data.editUserIds is list &&
                         request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'sector', 'subSector', 'industry', 'naicsCode', 'createdAt', 'updatedAt', 'version', 'roadmap', 'visibility', 'editability', 'viewUserIds', 'editUserIds']) &&
                         request.resource.data.size() >= 11; // Check min fields

        allow update: if isAuthenticated() && canEditPlan() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // CreatedAt cannot change
                         request.resource.data.updatedAt == request.time &&
                         // Allow updates based on role
                         (isPlanOwner() || // Owner can update all allowed fields
                            ( // Non-owner editors (collaborators or 'everyone') can only update roadmap and version
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']) &&
                              request.resource.data.version == resource.data.version + 1 // Only increment version with roadmap changes
                            )
                         ) &&
                         // General field integrity for owner updates
                         (!isPlanOwner() || (
                           request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
                           request.resource.data.editability in ['owner_only', 'collaborators', 'everyone'] &&
                           request.resource.data.viewUserIds is list &&
                           request.resource.data.editUserIds is list &&
                           request.resource.data.name is string && (request.resource.data.description == null || request.resource.data.description is string) &&
                           request.resource.data.roadmap is list && (request.resource.data.version == resource.data.version || request.resource.data.version == resource.data.version + 1)
                         ));

        allow delete: if isAuthenticated() && isPlanOwner(); // Only owner can delete plan

        match /versions/{versionId} {
            allow read: if isAuthenticated() && canViewPlan(); // Same view perm as parent plan
            allow list: if isAuthenticated() && canViewPlan();
            allow create: if isAuthenticated() && canEditPlan() && // User who can edit plan can create version
                           request.resource.data.planId == planId &&
                           request.resource.data.editorUid == request.auth.uid &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.versionNumber is number &&
                           request.resource.data.roadmap is list &&
                           request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                           request.resource.data.size() == 5;
            allow update: if false; // Versions are immutable
            allow delete: if false; // Versions are immutable
        }
    }

    // Article Tags
    match /articleTags/{tagId} {
        allow read: if true; // Tags are public for searching/display
        allow list: if true; // Allow listing/querying tags
        allow create: if isAuthenticated() && // Only authenticated users can create new tags
                         request.resource.data.name is string && isNotEmpty(request.resource.data.name) &&
                         request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                         request.resource.data.usageCount >= 0 && // Can be 0 or more on create
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.keys().hasAll(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']) &&
                         request.resource.data.size() == 5;
        allow update: if isAuthenticated() && // Allow authenticated users to update usageCount
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
                         request.resource.data.usageCount >= 0 && // Ensure usage count doesn't go negative through direct update
                         // Immutable fields
                         request.resource.data.name == resource.data.name &&
                         request.resource.data.nameLowercase == resource.data.nameLowercase &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false; // Tags are typically not deleted, usage count goes to 0
    }

    // News Articles
    match /newsArticles/{articleId} {
        function isArticleOwner() {
            return resource.data.userId == request.auth.uid;
        }
        function isPublished() {
            return resource.data.status == 'published';
        }
        // Fields allowed for direct update on published article by owner
        function allowedPublishedUpdateFields() {
            return ['title', 'tags', 'coverImageUrl', 'sector', 'subSector', 'industry', 'naicsCode', 'requestType', 'question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline', 'imageUrls', 'mentionedUserIds', 'content', 'updatedAt'];
        }
        // Fields allowed for draft updates or when publishing
        function allowedDraftOrPublishFields() {
            return ['title', 'tags', 'content', 'status', 'coverImageUrl', 'publishedAt', 'updatedAt',
                    'sector', 'subSector', 'industry', 'naicsCode', 'requestType', 'question',
                    'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline',
                    'imageUrls', 'mentionedUserIds', 'draftContent', 'hasUnpublishedChanges'];
        }

        allow read: if isPublished() || (isAuthenticated() && isArticleOwner());
        allow list: if true; // Allow listing for news feed, client filters drafts for non-owners

        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.title is string && isNotEmpty(request.resource.data.title) &&
                         request.resource.data.content is string &&
                         (request.resource.data.status == 'draft' || request.resource.data.status == 'published') &&
                         (request.resource.data.status == 'draft' || request.resource.data.publishedAt == null) &&
                         (request.resource.data.status == 'published' || request.resource.data.publishedAt == request.time) &&
                         (request.resource.data.commentCount == 0) &&
                         (request.resource.data.draftContent == null) && // On create, draftContent is null
                         (request.resource.data.hasUnpublishedChanges == false) && // On create, no unpublished changes
                         request.resource.data.keys().hasAll([
                            'userId', 'title', 'content', 'status', 'createdAt', 'updatedAt', 'publishedAt', 'commentCount', 'draftContent', 'hasUnpublishedChanges',
                            // Required from Post type now part of NewsArticle
                            'descriptionDetails', 'imageUrls', 'mentionedUserIds', 'ratingScore', 'tags'
                            // Other optional fields from Post type are okay if present or null
                         ]) &&
                         // Check that ONLY expected fields are present for security. All other fields from 'Post' must be optional or null.
                         request.resource.data.keys().hasOnly([
                            'userId', 'title', 'tags', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt', 'commentCount',
                            'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                            'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry',
                            'draftContent', 'hasUnpublishedChanges' // Added draft fields
                         ]);

        allow update: if isAuthenticated() && isArticleOwner() &&
                         request.resource.data.userId == resource.data.userId && // Cannot change owner
                         request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                         request.resource.data.updatedAt == request.time && // Must set update time
                         // If it's becoming published or was published and is changing content:
                         ( (request.resource.data.status == 'published' && (resource.data.status != 'published' || request.resource.data.publishedAt == null)) ?
                             request.resource.data.publishedAt == request.time &&
                             request.resource.data.content is string && // Content must be set for publishing
                             request.resource.data.draftContent == null && // Clear draft
                             request.resource.data.hasUnpublishedChanges == false // Clear flag
                           : true // Allow other updates if not this specific publishing scenario
                         ) &&
                         // If it's being unpublished (status changed from published to draft)
                         ( (resource.data.status == 'published' && request.resource.data.status == 'draft') ?
                             request.resource.data.publishedAt == null && // Clear publishedAt
                             request.resource.data.content is string // Content remains
                           : true
                         ) &&
                         // If saving a draft of an already published article
                         ( (resource.data.status == 'published' && request.resource.data.status == 'published' && request.resource.data.hasUnpublishedChanges == true) ?
                             request.resource.data.draftContent is string && // draftContent must be set
                             request.resource.data.content == resource.data.content && // Original content untouched
                             request.resource.data.publishedAt == resource.data.publishedAt // publishedAt untouched
                           : true
                         ) &&
                         // If updating a live published article (not just saving a draft on top of it)
                         ( (resource.data.status == 'published' && request.resource.data.status == 'published' && request.resource.data.hasUnpublishedChanges == false) ?
                             request.resource.data.content is string && // new content must be set
                             request.resource.data.draftContent == null && // draft must be cleared
                             request.resource.data.publishedAt == resource.data.publishedAt // publishedAt remains same
                           : true
                         ) &&
                         // Ensure only allowed fields are part of the update request, considering status
                         ( (resource.data.status == 'published' && request.resource.data.status == 'published' && request.resource.data.hasUnpublishedChanges == false) ?
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedPublishedUpdateFields())
                           :
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedDraftOrPublishFields())
                         );

        allow delete: if isAuthenticated() && isArticleOwner();
    }


    // Conversations and Messages
    match /conversations/{conversationId} {
        function isParticipant() {
            return request.auth.uid in resource.data.participants;
        }
        function isCreatorOrAdmin() {
            return request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.adminIds;
        }
        function isGroupChat() {
            return resource.data.type == 'group';
        }
        function isDirectChat() {
            return resource.data.type == 'direct';
        }

        allow read: if isAuthenticated() && isParticipant();
        allow list: if isAuthenticated(); // Client will filter via where('participants', 'array-contains', request.auth.uid)

        allow create: if isAuthenticated() &&
                         request.resource.data.participants.hasAll([request.auth.uid]) &&
                         request.resource.data.participants.size() >= 2 &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.lastMessageTimestamp == request.time &&
                         (request.resource.data.lastMessage == null || request.resource.data.lastMessage is string) &&
                         (isDirectChat() ? (
                           request.resource.data.type == 'direct' &&
                           (request.resource.data.postId == null || request.resource.data.postId is string) &&
                           request.resource.data.groupName == null &&
                           request.resource.data.groupAvatarUrl == null &&
                           request.resource.data.ownerId == null &&
                           request.resource.data.adminIds.size() == 0 &&
                           request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                           request.resource.data.size() == 11
                         ) : isGroupChat() ? (
                           request.resource.data.type == 'group' &&
                           request.resource.data.groupName is string && isNotEmpty(request.resource.data.groupName) &&
                           (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                           request.resource.data.ownerId == request.auth.uid && // Creator must be owner
                           request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator must be admin
                           request.resource.data.postId == null && // postId should be null for groups
                           request.resource.data.keys().hasAll(['participants', 'type', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp']) &&
                           request.resource.data.size() == 11
                         ) : false ); // Must be direct or group

        allow update: if isAuthenticated() && isParticipant() &&
                         request.resource.data.updatedAt == request.time &&
                         // Immutable fields for all updates
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.postId == resource.data.postId &&
                         // Allow updating last message details (by anyone in participants list)
                         ( (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                            request.resource.data.lastMessageSenderId == request.auth.uid) ||
                           // Allow group admins to update group details or participant list
                           (isGroupChat() && isCreatorOrAdmin() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'ownerId', 'updatedAt', 'formerParticipants']) && // Allow formerParticipants
                             // If changing owner, new owner must be an existing admin
                             (request.resource.data.ownerId == resource.data.ownerId || (request.resource.data.ownerId != resource.data.ownerId && resource.data.adminIds.hasAny([request.resource.data.ownerId]))) &&
                             // If changing admins, owner must remain admin
                             (request.resource.data.ownerId == null || request.resource.data.adminIds.hasAll([request.resource.data.ownerId])) &&
                             request.resource.data.participants.hasAll(request.resource.data.adminIds) && // Admins must be participants
                             request.resource.data.participants.hasAll([request.resource.data.ownerId]) && // Owner must be participant
                             (request.resource.data.formerParticipants == null || request.resource.data.formerParticipants is map) // Validate formerParticipants
                           )
                         );

        match /messages/{messageId} {
          allow read: if isAuthenticated() && isParticipant(); // Only participants can read messages
          allow list: if isAuthenticated() && isParticipant(); // Only participants can list messages
          allow create: if isAuthenticated() && isParticipant() &&
                           request.resource.data.senderId == request.auth.uid &&
                           request.resource.data.conversationId == conversationId &&
                           request.resource.data.text is string && isNotEmpty(request.resource.data.text) &&
                           request.resource.data.timestamp == request.time &&
                           (request.resource.data.isBotMessage == null || request.resource.data.isBotMessage is bool) && // isBotMessage is optional
                           (request.resource.data.replyToMessageId == null || request.resource.data.replyToMessageId is string) &&
                           (request.resource.data.repliedToTextSnippet == null || request.resource.data.repliedToTextSnippet is string) &&
                           request.resource.data.read == false && // New messages are unread
                           request.resource.data.keys().hasAll(['senderId', 'conversationId', 'text', 'timestamp', 'read']) &&
                           request.resource.data.size() >= 5; // Allow for optional fields

          allow update: if isAuthenticated() && isParticipant() && // Participant can update (e.g., mark as read)
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && // Only 'read' status can be updated
                         request.resource.data.read == true && // Can only mark as read
                         // Immutable fields
                         request.resource.data.senderId == resource.data.senderId &&
                         request.resource.data.conversationId == resource.data.conversationId &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp;

          allow delete: if false; // Messages typically not deletable by users directly
        }
    }

    // Notifications
    match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow list: if isAuthenticated() && request.query.resource.data.userId == request.auth.uid; // Secure list queries by userId
        allow create: if isAuthenticated() && // Sender can create notification for another user
                         request.resource.data.userId != request.auth.uid && // Cannot notify self through this rule (handled by client logic)
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.isRead == false &&
                         request.resource.data.type in ['reply', 'mention', 'connection_request', 'connection_accepted', 'new_message'] &&
                         request.resource.data.keys().hasAll(['userId', 'type', 'senderId', 'senderName', 'senderAvatar', 'timestamp', 'isRead']) && // Required base fields
                         request.resource.data.size() >= 7; // Allow for optional fields related to type
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && // Only recipient can update
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && // Can only mark as read or update internal timestamp
                         request.resource.data.isRead == true && // Can only mark as read
                         (request.resource.data.updatedAt == null || request.resource.data.updatedAt == request.time) && // Optional updatedAt
                         // Immutable fields
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.type == resource.data.type &&
                         request.resource.data.senderId == resource.data.senderId;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete their own notifications
    }


  }
}

    