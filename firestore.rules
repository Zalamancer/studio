
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for conversation rules (scoped within conversations match block)
    function isAuthUserParticipant(convData, authUid) {
      return authUid != null && convData.participants is list && convData.participants.hasAny([authUid]);
    }

    // Stripe rules (Unchanged from user's last version)
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Collections rules (Unchanged from user's last version)
    match /collections/{collectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Posts and their subcollections
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (
                      // Branch 1: Owner can update their post (most fields)
                      (
                        resource.data.userId == request.auth.uid &&
                        // Owner is not expected to directly modify commentCount here;
                        // it's handled by the commenting process itself.
                        // If owner *can* edit commentCount, a specific rule would be needed.
                        // This ensures owner updates don't accidentally reset commentCount
                        // if it's not sent in the request.
                        (!request.resource.data.keys().hasAny(['commentCount']) ||
                           request.resource.data.commentCount == resource.data.commentCount
                        ) &&
                        request.resource.data.updatedAt == request.time
                        // Add specific checks for other fields if owner updates are more granular
                      ) ||
                      // Branch 2: Any authenticated user can update ONLY commentCount and updatedAt
                      // This is primarily for incrementing/decrementing commentCount when comments are added/deleted.
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        // We cannot reliably check the exact value of FieldValue.increment() in rules.
                        // The security here relies on hasOnly() ensuring no other fields are touched by non-owners.
                        // The client-side service (addCommentToPost, deleteCommentFromPost) is responsible
                        // for sending the correct increment(1) or increment(-1).
                        request.resource.data.updatedAt == request.time
                      )
                    );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Comments (Rules for liking are working, kept as is)
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.timestamp == request.time; // use timestamp for comments
        allow update: if request.auth != null && (
                        ( // Owner edit text/mentions
                          resource.data.userId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.updatedAt == request.time
                        ) ||
                        ( // Liking/Unliking
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                          request.resource.data.userId == resource.data.userId && // Core fields must not change
                          request.resource.data.text == resource.data.text &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          ( // Validate likedBy array modification
                            (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasOnly(resource.data.likedBy.concat([request.auth.uid]))) ||
                            (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasOnly(resource.data.likedBy.removeAll([request.auth.uid])))
                          ) &&
                          ( // Validate likeCount change
                            request.resource.data.likeCount == resource.data.likeCount + 1 ||
                            (resource.data.likeCount > 0 && request.resource.data.likeCount == resource.data.likeCount - 1)
                          ) &&
                          request.resource.data.updatedAt == request.time
                        )
                      );
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

        // Subcomments (Rules for liking are working, kept as is)
        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.timestamp == request.time;
          allow update: if request.auth != null && (
                          ( // Owner edit
                            resource.data.userId == request.auth.uid &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            request.resource.data.updatedAt == request.time
                          ) ||
                          ( // Liking
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                            request.resource.data.userId == resource.data.userId &&
                            request.resource.data.text == resource.data.text &&
                            request.resource.data.timestamp == resource.data.timestamp &&
                            (
                              (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasOnly(resource.data.likedBy.concat([request.auth.uid]))) ||
                              (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.hasOnly(resource.data.likedBy.removeAll([request.auth.uid])))
                            ) &&
                            (request.resource.data.likeCount == resource.data.likeCount + 1 || (resource.data.likeCount > 0 && request.resource.data.likeCount == resource.data.likeCount - 1)) &&
                            request.resource.data.updatedAt == request.time
                          )
                        );
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }

      // Bids (Unchanged from user's last version)
      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                         request.resource.data.bidderId == request.auth.uid &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid &&
                         request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      allow get: if request.auth != null && isAuthUserParticipant(resource.data, request.auth.uid);
      allow list: if request.auth != null && request.query.limit <= 100; // Client query must enforce array-contains

      // Rule for creating a 'direct' conversation
      allow create: if request.auth != null &&
                       request.resource.data.type == 'direct' &&
                       request.resource.data.participants.size() == 2 &&
                       request.resource.data.participants.hasAny([request.auth.uid]) &&
                       request.resource.data.ownerId == null &&
                       request.resource.data.adminIds.size() == 0 &&
                       request.resource.data.groupName == null &&
                       request.resource.data.groupAvatarUrl == null &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.lastMessageTimestamp == request.time &&
                       // Ensure only expected fields for a new direct chat are present and correctly set by service
                       request.resource.data.keys().hasAll(['type', 'participants', 'postId', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'ownerId', 'adminIds', 'groupName', 'groupAvatarUrl']) &&
                       request.resource.data.keys().size() == 10;
                       // We will add group creation logic back carefully later.

      allow update: if request.auth != null && isAuthUserParticipant(resource.data, request.auth.uid) && (
                      // Branch A: Updating last message details by a participant
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp']) &&
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.lastMessageTimestamp == request.time
                        // Note: No 'updatedAt' field check here for conversation doc itself,
                        // assuming the service doesn't send it and we rely on Firestore's metadata.
                        // If `updatedAt` IS a field in your Conversation model and sent by client, add it to hasOnly and check its value.
                        // If `updatedAt` IS a field in your Conversation model and sent by client, add it to hasOnly and check its value.
                      )
                      // Placeholder for Group Management Updates - to be added back carefully
                    );

      match /messages/{messageId} {
        allow read: if request.auth != null &&
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // Mutual connections (Unchanged from user's last version)
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time;
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]) && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences (Unchanged from user's last version)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (Unchanged from user's last version)
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.resource.data.naicsCode == naicsDocId &&
                      request.resource.data.lastUpdatedBy == request.auth.uid &&
                      request.resource.data.lastUpdatedAt == request.time;
    }

    // Notifications collection (Unchanged from user's last version)
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User profiles (Unchanged from user's last version)
    match /users/{userId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} {
        allow list: if request.auth != null;
    }

    // Reviews collection (Unchanged from user's last version)
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.createdAt == request.time;
      allow update, delete: if request.auth != null &&
                               resource.data.reviewerId == request.auth.uid;
    }

    // Fallback rule (Unchanged from user's last version)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
