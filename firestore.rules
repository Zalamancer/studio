
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions (defined globally for use in various rules)
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Stripe Customers and Subscriptions:
    // Users can only read/write their own customer data.
    // For subscriptions, this might need to be callable by Stripe webhooks via a Cloud Function.
    match /stripe_customers/{userId} {
      allow read, write: if isUserAuthenticated() && request.auth.uid == userId;

      match /payment_methods/{paymentMethodId} {
        allow read, list: if isUserAuthenticated() && request.auth.uid == userId;
        // Client should not directly write/delete Stripe PMs; done via API and Stripe.
      }
      match /subscriptions/{subscriptionId} {
        allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
        // ^ This rule is for client-side convenience if needed.
        // Actual subscription management by Stripe/backend is recommended.
      }
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic info (displayName, avatar) by anyone
      allow create: if isUserAuthenticated() &&
                      request.auth.uid == userId &&
                      request.resource.data.uid == userId &&
                      request.resource.data.email == request.auth.token.email &&
                      request.resource.data.containsKey('mentionName') &&
                      request.resource.data.containsKey('mentionNameLowercase') &&
                      request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt', 'companyName', 'industry', 'avatarUrl', 'descriptionVisibility']) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.lastLoginAt == request.time;

      allow update: if isUserAuthenticated() && request.auth.uid == userId &&
                      // Fields that can be updated by the user
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established', 'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'updatedAt', 'lastLoginAt']) &&
                      // Immutable fields check
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.mentionName == resource.data.mentionName &&
                      request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time;
    }

    // User Preferences (e.g., notification settings, favorite sectors)
    match /userPreferences/{userId} {
      allow read, write: if isUserAuthenticated() && request.auth.uid == userId &&
                          (request.method == 'get' || request.method == 'list' ||
                           (request.method == 'create' && request.resource.data.userId == userId && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time) ||
                           (request.method == 'update' && request.resource.data.userId == userId && request.resource.data.updatedAt == request.time && request.resource.data.createdAt == resource.data.createdAt)
                          );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, list: if isUserAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isUserAuthenticated() &&
                       request.resource.data.userId != null && // recipient
                       request.resource.data.senderId == request.auth.uid && // sender must be the one creating it
                       request.resource.data.type != null &&
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false;
      allow update: if isUserAuthenticated() && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
                       request.resource.data.isRead == true; // Only allow marking as read
      allow delete: if false; // Generally, users don't delete notifications
    }

    // Mutual Connections
    // Helper function for mutuals
    function isUserInMutualConnection(authUid, mutualData) {
      return authUid != null &&
             mutualData != null &&
             mutualData.userIds != null &&
             mutualData.userIds is list && // Corrected from 'typeof mutualData.userIds == 'list''
             mutualData.userIds.hasAny([authUid]);
    }

    match /mutuals/{connectionId} {
      allow get: if isUserAuthenticated() &&
                    isUserInMutualConnection(request.auth.uid, resource.data);
      allow list: if isUserAuthenticated(); // Firestore will apply 'get' rule to results

      allow create: if isUserAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.userIds[0] != request.resource.data.userIds[1] && // Ensure not self-request
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       !request.resource.data.containsKey('connectedAt');

      allow update: if isUserAuthenticated() &&
                       isUserInMutualConnection(request.auth.uid, resource.data) &&
                       resource.data.status == 'pending' && // Can only update 'pending' requests (to 'connected')
                       request.resource.data.status == 'connected' &&
                       request.resource.data.requesterId != request.auth.uid && // Only recipient can accept
                       request.resource.data.userIds.isEqualTo(resource.data.userIds) &&
                       request.resource.data.requesterId == resource.data.requesterId &&
                       request.resource.data.connectedAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      allow delete: if isUserAuthenticated() &&
                       isUserInMutualConnection(request.auth.uid, resource.data) &&
                       // User can delete if it's their pending_sent request OR they are rejecting a pending_received OR removing a 'connected'
                       ( (resource.data.status == 'pending' && resource.data.requesterId == request.auth.uid) || // Cancel own sent request
                         (resource.data.status == 'pending' && resource.data.requesterId != request.auth.uid) || // Reject received request
                         (resource.data.status == 'connected') ); // Remove an existing connection
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // All posts are publicly readable

      allow create: if isUserAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       // Ensure all required fields are present
                       request.resource.data.containsKey('question') &&
                       request.resource.data.containsKey('descriptionDetails') &&
                       request.resource.data.containsKey('tags') &&
                       request.resource.data.containsKey('sector') &&
                       request.resource.data.containsKey('requestType') &&
                       request.resource.data.containsKey('ratingScore') &&
                       request.resource.data.containsKey('commentCount');


      allow update: if isUserAuthenticated() && (
                      // Branch 1: Owner can update their post details
                      (
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.userId == resource.data.userId && // Cannot change owner
                        request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                        request.resource.data.commentCount == resource.data.commentCount && // Owner cannot directly change commentCount via this path
                        // Only allow specific fields to be changed by owner:
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'requestType', 'maxBudget', 'deadline', 'updatedAt']) &&
                        request.resource.data.updatedAt == request.time
                      ) ||
                      // Branch 2: Any authenticated user can update commentCount (and only commentCount + updatedAt)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                        (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
                        request.resource.data.updatedAt == request.time &&
                        // Ensure other critical fields are not part of the update request (double check)
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.question == resource.data.question &&
                        request.resource.data.createdAt == resource.data.createdAt
                      )
                    );

      allow delete: if isUserAuthenticated() && resource.data.userId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // All comments are publicly readable

        allow create: if isUserAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy.size() == 0;

        allow update: if isUserAuthenticated() && (
                        // Branch 1: Comment owner can update text and mentions
                        (
                          resource.data.userId == request.auth.uid &&
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.postId == resource.data.postId &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.likeCount == resource.data.likeCount && // Owner cannot change likes directly here
                          request.resource.data.likedBy.isEqualTo(resource.data.likedBy) && // Owner cannot change likes directly here
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                          request.resource.data.updatedAt == request.time
                        ) ||
                        // Branch 2: Any authenticated user can update likes
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                          (
                            (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likedBy.hasAny([request.auth.uid])) || // Adding a like
                            (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1 && !request.resource.data.likedBy.hasAny([request.auth.uid]))    // Removing a like
                          ) &&
                          request.resource.data.likeCount == request.resource.data.likedBy.size() && // likeCount must match likedBy size
                          request.resource.data.updatedAt == request.time &&
                          // Ensure other fields are not changed
                          request.resource.data.userId == resource.data.userId &&
                          request.resource.data.postId == resource.data.postId &&
                          request.resource.data.text == resource.data.text &&
                          request.resource.data.timestamp == resource.data.timestamp &&
                          request.resource.data.mentionedUserIds.isEqualTo(resource.data.mentionedUserIds)
                        )
                      );

        allow delete: if isUserAuthenticated() && resource.data.userId == request.auth.uid;

        // SubComments subcollection
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow create: if isUserAuthenticated() &&
                             request.resource.data.userId == request.auth.uid &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy.size() == 0;

            allow update: if isUserAuthenticated() && (
                            // Branch 1: SubComment owner can update text and mentions
                            (
                                resource.data.userId == request.auth.uid &&
                                request.resource.data.userId == resource.data.userId &&
                                request.resource.data.timestamp == resource.data.timestamp &&
                                request.resource.data.likeCount == resource.data.likeCount &&
                                request.resource.data.likedBy.isEqualTo(resource.data.likedBy) &&
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
                                request.resource.data.updatedAt == request.time
                            ) ||
                            // Branch 2: Any authenticated user can update likes for subcomments
                            (
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                (
                                    (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likedBy.hasAny([request.auth.uid])) ||
                                    (resource.data.likedBy.hasAll(request.resource.data.likedBy) && resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1 && !request.resource.data.likedBy.hasAny([request.auth.uid]))
                                ) &&
                                request.resource.data.likeCount == request.resource.data.likedBy.size() &&
                                request.resource.data.updatedAt == request.time &&
                                // Ensure other fields are not changed
                                request.resource.data.userId == resource.data.userId &&
                                request.resource.data.text == resource.data.text &&
                                request.resource.data.timestamp == resource.data.timestamp &&
                                request.resource.data.mentionedUserIds.isEqualTo(resource.data.mentionedUserIds)
                            )
                        );
            allow delete: if isUserAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }

      // Bids subcollection
      match /bids/{bidId} {
        allow read: if true; // Publicly readable for transparency on posts
        allow create: if isUserAuthenticated() &&
                         request.resource.data.bidderId == request.auth.uid &&
                         request.resource.data.postId == postId &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid && // Cannot bid on own post
                         request.resource.data.timestamp == request.time;
        // Bids are generally not updatable or deletable by clients once placed
        allow update: if false;
        allow delete: if false;
      }
    }

    // Conversations and Messages
    match /conversations/{conversationId} {
      // Helper functions specific to conversation context
      function isAuthUserParticipant(authUid, convData) {
        return authUid != null &&
               convData != null &&
               convData.participants != null &&
               convData.participants is list &&
               convData.participants.hasAny([authUid]);
      }

      function isGroupOwner(authUid, groupData) {
        return groupData.type == 'group' && groupData.ownerId == authUid;
      }

      function isGroupAdmin(authUid, groupData) {
        return groupData.type == 'group' && groupData.adminIds.hasAny([authUid]);
      }

      function areImmutableConversationFieldsUnchanged(docBefore, docAfter) {
        return docBefore.type == docAfter.type &&
               docBefore.ownerId == docAfter.ownerId &&
               docBefore.createdAt == docAfter.createdAt &&
               docBefore.postId == docAfter.postId;
             // Note: participants, groupName, groupAvatarUrl, adminIds are mutable by specific actions
      }

      allow get: if isUserAuthenticated() &&
                    isAuthUserParticipant(request.auth.uid, resource.data);

      allow list: if isUserAuthenticated(); // Firestore applies 'get' rule filters

      allow create: if isUserAuthenticated() && (
                      // Direct Chat Creation
                      (
                        request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.participants.hasAny([request.auth.uid]) &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds.size() == 0 &&
                        request.resource.data.groupName == null &&
                        request.resource.data.groupAvatarUrl == null &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                        request.resource.data.keys().size() == 10 // Ensure exactly these fields
                      ) ||
                      // Group Chat Creation
                      (
                        request.resource.data.type == 'group' &&
                        request.resource.data.ownerId == request.auth.uid &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) && // Creator is admin
                        request.resource.data.participants.hasAll([request.auth.uid]) && // Creator is participant
                        request.resource.data.participants.size() >= 2 && // At least 2 for a group (creator + 1)
                        request.resource.data.groupName != null && request.resource.data.groupName.size() > 0 &&
                        request.resource.data.createdAt == request.time &&
                        request.resource.data.lastMessageTimestamp == request.time &&
                        request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                        request.resource.data.keys().size() == 10 // Ensure exactly these fields
                      )
                    );

      allow update: if isUserAuthenticated() && (
                      // Branch A: Sending a message (for any participant, direct or group)
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        // Ensures the client is ONLY trying to write these specific fields for a message send
                        request.writeFields.hasAll(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                        request.writeFields.size() == 4 &&
                        // Validate the values being written
                        request.resource.data.lastMessageSenderId == request.auth.uid &&
                        request.resource.data.updatedAt == request.time
                        // Implicitly, other fields remain unchanged because client is only sending these 4.
                      )
                      ||
                      // Branch B: Admin updating group info (name, avatar)
                      (
                        isGroupAdmin(request.auth.uid, resource.data) && // User is an admin of this group
                        resource.data.type == 'group' && // It's a group chat
                        request.resource.data.type == 'group' && // Type cannot change
                        // Only groupName or groupAvatarUrl (and updatedAt) can change
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) &&
                        (!request.writeFields.hasAny(['groupName', 'groupAvatarUrl']) || request.writeFields.hasAll(['updatedAt'])) && // If name/avatar sent, updatedAt must be too
                        (request.writeFields.has('groupName') ? request.resource.data.groupName != null && request.resource.data.groupName.size() > 0 : true) && // If groupName is being written, it must not be empty
                        areImmutableConversationFieldsUnchanged(resource.data, request.resource.data) && // Ensure core fields are not changed
                        request.resource.data.participants.isEqualTo(resource.data.participants) && // Participants cannot be changed by this action
                        request.resource.data.adminIds.isEqualTo(resource.data.adminIds) && // Admins cannot be changed by this action
                        request.resource.data.updatedAt == request.time
                      )
                      ||
                      // Branch C: Admin adding/removing members (not owner or other admins unless owner)
                      (
                        isGroupAdmin(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' && request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) && // Only participants, adminIds (if removing an admin), and updatedAt
                        // Validate participant changes (new members must be in new list, removed members must not be)
                        // (This is complex to write generally, relies on service logic to ensure valid array ops)
                        // Ensure owner is not removed by a non-owner admin
                        (resource.data.ownerId == request.auth.uid || !request.resource.data.participants.hasAny([resource.data.ownerId]) == !resource.data.participants.hasAny([resource.data.ownerId])) &&
                        // If a removed participant was an admin, they must also be removed from adminIds (unless they are the owner and being removed by owner action)
                        // This logic is better handled by backend/cloud function or very careful client logic + simpler rules
                        areImmutableConversationFieldsUnchanged(resource.data, request.resource.data) &&
                        (resource.data.groupName == request.resource.data.groupName) &&
                        (resource.data.groupAvatarUrl == request.resource.data.groupAvatarUrl) &&
                        request.resource.data.updatedAt == request.time
                      )
                      ||
                      // Branch D: Owner managing admins (promote/demote, but not self-demote if sole admin)
                      (
                        isGroupOwner(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' && request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
                        // New admins must be participants
                        request.resource.data.adminIds.toSet().difference(resource.data.adminIds.toSet()).hasOnly(request.resource.data.participants.toSet()) &&
                        // Owner must always remain an admin
                        request.resource.data.adminIds.hasAny([resource.data.ownerId]) &&
                        areImmutableConversationFieldsUnchanged(resource.data, request.resource.data) &&
                        (resource.data.participants.isEqualTo(request.resource.data.participants)) &&
                        (resource.data.groupName == request.resource.data.groupName) &&
                        (resource.data.groupAvatarUrl == request.resource.data.groupAvatarUrl) &&
                        request.resource.data.updatedAt == request.time
                      )
                      ||
                      // Branch E: Participant leaving group
                      (
                        isAuthUserParticipant(request.auth.uid, resource.data) &&
                        resource.data.type == 'group' && request.resource.data.type == 'group' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
                        // User is removed from participants
                        !request.resource.data.participants.hasAll([request.auth.uid]) &&
                        resource.data.participants.size() == request.resource.data.participants.size() + 1 &&
                        // If user was admin, they are removed from admins (unless they are owner and this would leave no admins)
                        ( (!resource.data.adminIds.hasAll([request.auth.uid])) || (!request.resource.data.adminIds.hasAll([request.auth.uid])) ) &&
                        // Owner cannot leave if they are the sole admin and other participants remain.
                        // This means the service/client must promote another admin first if this condition is met.
                        !(resource.data.ownerId == request.auth.uid && resource.data.adminIds.size() == 1 && resource.data.adminIds.hasAll([request.auth.uid]) && request.resource.data.participants.size() > 0 && resource.data.participants.size() > 1) &&
                        areImmutableConversationFieldsUnchanged(resource.data, request.resource.data) &&
                        (resource.data.groupName == request.resource.data.groupName) &&
                        (resource.data.groupAvatarUrl == request.resource.data.groupAvatarUrl) &&
                        request.resource.data.updatedAt == request.time
                      )
                    );


      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isUserAuthenticated() &&
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);

        allow create: if isUserAuthenticated() &&
                         isAuthUserParticipant(request.auth.uid, get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time &&
                         // Validate other fields based on Message type
                         request.resource.data.containsKey('text') &&
                         request.resource.data.containsKey('read') && request.resource.data.read == false &&
                         request.resource.data.containsKey('isBotMessage'); // Ensure isBotMessage is present

        allow update: if isUserAuthenticated() && resource.data.senderId == request.auth.uid &&
                         // Only allow updating 'text' or 'read' status (e.g., for edits, or marking as read by recipient - though read usually on conversation)
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'read', 'updatedAt']) && // 'updatedAt' would be for message edits
                         request.resource.data.senderId == resource.data.senderId && // Cannot change sender
                         request.resource.data.conversationId == resource.data.conversationId && // Cannot change conversation
                         request.resource.data.timestamp == resource.data.timestamp; // Cannot change original timestamp

        allow delete: if isUserAuthenticated() && resource.data.senderId == request.auth.uid; // Only sender can delete their message
      }
    }

    // Whiteboard Annotations
    match /whiteboardAnnotations/{docId} {
      allow read: if true; // Allow anyone to read whiteboard data, assuming it's not sensitive per-user

      allow create: if isUserAuthenticated() &&
                       request.resource.data.lastUpdatedBy == request.auth.uid &&
                       request.resource.data.lastUpdatedAt == request.time &&
                       request.resource.data.naicsCode == docId && // Ensure NAICS code in data matches doc ID
                       request.resource.data.containsKey('shapes');

      allow update: if isUserAuthenticated() &&
                       request.resource.data.lastUpdatedBy == request.auth.uid &&
                       request.resource.data.lastUpdatedAt == request.time &&
                       request.resource.data.naicsCode == docId && // Ensure NAICS code in data matches doc ID
                       request.resource.data.containsKey('shapes') &&
                       // Prevent changing who created it or when it was first created (if those fields exist)
                       (!resource.data.containsKey('firstCreatedBy') || request.resource.data.firstCreatedBy == resource.data.firstCreatedBy) &&
                       (!resource.data.containsKey('firstCreatedAt') || request.resource.data.firstCreatedAt == resource.data.firstCreatedAt);
      allow delete: if false; // Generally don't allow client-side deletion of shared whiteboards
    }

     // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public

      allow create: if isUserAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.targetUserId != request.auth.uid && // Can't review self
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      allow update: if isUserAuthenticated() &&
                       resource.data.reviewerId == request.auth.uid && // Only reviewer can update
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.updatedAt == request.time &&
                       // Immutable fields
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isUserAuthenticated() && resource.data.reviewerId == request.auth.uid; // Only reviewer can delete
    }
  }
}

    