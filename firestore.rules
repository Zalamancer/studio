rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    // Note: isNotEmpty is handled inline in the create rule for collections.
    // If you have a global isNotEmpty function, you can use it.
    // function isNotEmpty(value) {
    //   return value != null && value != '';
    // }

    // User's provided /collections/{collectionId} block
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return request.auth.uid == resource.data.ownerId;
      }
      function isSharedWithUser() {
        // Ensure sharedWithUserIds exists and is a list before checking 'in'
        return resource.data.sharedWithUserIds is list && request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name != null && request.resource.data.name != '' // Explicit check for non-empty name
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.postIds is list 
                    // Ensure specific fields for create, based on collectionService.ts
                    && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt'])
                    && request.resource.data.sharedWithUserIds.size() == 0; // Must start empty

      allow update: if isAuthenticated() && isCollectionOwner()
                    && request.resource.data.ownerId == resource.data.ownerId 
                    && request.resource.data.createdAt == resource.data.createdAt 
                    && request.resource.data.updatedAt == request.time
                    // Whitelist fields that can be updated when saving/removing posts or sharing
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);

      allow delete: if isAuthenticated() && isCollectionOwner();
    }

    // More precise list rule for the 'collections' collection path itself
    match /collections/{document=**} {
      allow list: if isAuthenticated() &&
                     (
                       (request.query.filters.size() > 0 && request.query.filters[0].fieldPathString == 'ownerId' && request.query.filters[0].value == request.auth.uid) ||
                       (request.query.filters.size() > 0 && request.query.filters[0].fieldPathString == 'sharedWithUserIds' && request.query.filters[0].opString == 'array-contains' && request.query.filters[0].value == request.auth.uid)
                     );
    }

    // --- Standard Rules for other collections ---
    match /users/{userId} {
      allow read: if true; 
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'avatarUrl', 'industry', 'description', 'descriptionVisibility',
                        'established', 'incomeRange', 'updatedAt',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'paymentMethods', 'stripeCustomerId', 'stripeSubscriptionId', 
                        'activeStripePriceId', 'stripeSubscriptionStatus', 
                        'stripeSubscriptionCurrentPeriodEnd', 'stripeSubscriptionWillCancelAtPeriodEnd',
                        'favoriteSectorCodes', 'notifyOnReply', 'notifyOnMention',
                        'notifyOnNewConnectionRequest', 'notifyOnConnectionAccepted',
                        'notifyOnNewMessage', 'notifyOnPlatformUpdates'
                        // mentionName and mentionNameLowercase should be managed by server/secure logic if updatable
                    ])
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.uid == resource.data.uid 
                    && request.resource.data.createdAt == resource.data.createdAt; 
    }

    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId 
                    && request.resource.data.createdAt == resource.data.createdAt; 
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
        // Allow update for fields like likeCount, likedBy, text (if editing is allowed)
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likeCount', 'likedBy', 'updatedAt', 'mentionedUserIds'])
                      && request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
            allow read: if true;
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
            allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'likeCount', 'likedBy', 'updatedAt', 'mentionedUserIds'])
                          && request.resource.data.updatedAt == request.time;
            allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
        allow read: if true; 
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.bidderId
                       && request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId; 
      }
    }

    match /mutuals/{connectionId} {
      function isUserInConnection() {
        return request.auth.uid in resource.data.userIds;
      }
      allow read: if isAuthenticated() && isUserInConnection();
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.auth.uid in request.resource.data.userIds;
      allow update: if isAuthenticated() && isUserInConnection()
                    && request.resource.data.status == 'connected'
                    && resource.data.status == 'pending'; 
      allow delete: if isAuthenticated() && isUserInConnection(); 
    }

    match /reviews/{reviewId} {
      allow read: if true; 
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.reviewerId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.reviewerId
                    && request.resource.data.reviewerId == resource.data.reviewerId
                    && request.resource.data.targetUserId == resource.data.targetUserId
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId;
    }

    match /notifications/{notificationId} {
        allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId;
        allow create: if isAuthenticated(); 
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
                      && request.resource.data.updatedAt == request.time; // Ensure updatedAt for notification updates
    }
    
    match /userPreferences/{userId} {
        allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    match /whiteboardAnnotations/{naicsCode} {
        allow read: if true; 
        allow create, update: if isAuthenticated() && request.resource.data.lastUpdatedBy == request.auth.uid
                              && request.resource.data.naicsCode == naicsCode; 
    }
    
    match /conversations/{conversationId} {
        function isParticipant() { return resource.data.participants is list && request.auth.uid in resource.data.participants; }
        function isFormerParticipant() { return resource.data.formerParticipants != null && request.auth.uid in resource.data.formerParticipants; }
        function isGroupAdmin() { return resource.data.type == 'group' && resource.data.adminIds is list && request.auth.uid in resource.data.adminIds; }
        function isGroupOwner() { return resource.data.type == 'group' && request.auth.uid == resource.data.ownerId; }

        allow read: if isAuthenticated() && (isParticipant() || isFormerParticipant()); 
        allow list: if isAuthenticated() && request.query.filters.find(f => f[0] == 'participants' && f[1] == 'array-contains' && f[2] == request.auth.uid) != null;
        
        allow create: if isAuthenticated() &&
                       request.resource.data.participants is list && request.resource.data.participants.hasAll([request.auth.uid]) &&
                       ((request.resource.data.type == 'direct' && request.resource.data.participants.size() == 2 && request.resource.data.keys().hasOnly(['participants', 'type', 'createdAt', 'lastMessage', 'lastMessageTimestamp', 'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'updatedAt'])) ||
                        (request.resource.data.type == 'group' &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.adminIds is list && request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                         request.resource.data.participants.size() >= 2 && 
                         request.resource.data.groupName != null && request.resource.data.groupName != '' &&
                         (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) &&
                         request.resource.data.postId == null && 
                         request.resource.data.keys().hasOnly([
                            'participants', 'type', 'createdAt', 'lastMessage', 'lastMessageTimestamp',
                            'postId', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'updatedAt'
                         ]) 
                        ));
                        
        allow update: if isAuthenticated() && isParticipant() && request.resource.data.updatedAt == request.time &&
                       ( (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                         (request.resource.data.type == 'group' && isGroupAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'])) ||
                         (request.resource.data.type == 'group' && isGroupAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt'])) ||
                         (request.resource.data.type == 'group' && isGroupOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'ownerId', 'updatedAt'])) ||
                         (request.resource.data.type == 'group' && // Leaving group
                          !request.resource.data.participants.hasAny([request.auth.uid]) && 
                          resource.data.participants.hasAll([request.auth.uid]) &&         
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants']) && 
                          request.resource.data.formerParticipants[request.auth.uid] == request.time
                         )
                       ) &&
                       request.resource.data.participants.size() >= (request.resource.data.type == 'group' ? (request.resource.data.ownerId == null ? 1:0) : 2 );

        match /messages/{messageId} {
            allow read, list: if isAuthenticated() && (isParticipant() || isFormerParticipant()); 
            allow create: if isAuthenticated() && isParticipant() && request.auth.uid == request.resource.data.senderId;
        }
    }
  }
}
