rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      // Deleting users should be handled by a secure backend process
      allow delete: if false;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);

      // Comments and Subcomments
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(resource.data.userId); // Only owner can update (e.g. like)
        allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.userId)); // Comment owner or post owner can delete
        
        match /subcomments/{subCommentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn() && isOwner(resource.data.userId);
          allow delete: if isSignedIn() && isOwner(resource.data.userId);
        }
      }
      
      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.bidderId;
      }
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.requesterId && request.auth.uid in request.resource.data.userIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.userIds; // For accepting/rejecting
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds; // For removing/cancelling
    }

    // Conversations & Messages
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // Notifications
    match /notifications/{notificationId} {
       allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
       // Create is handled by backend functions
       allow create: if false; 
    }

    // Plans Collection
    match /plans/{planId} {
        function canViewPlan() {
            return resource.data.visibility == 'public'
                   || (resource.data.visibility == 'unlisted' && isSignedIn())
                   || (isSignedIn() && request.auth.uid in resource.data.viewUserIds);
        }
        function canEditPlan() {
            return (isSignedIn() && request.auth.uid == resource.data.ownerId)
                   || (resource.data.editability == 'collaborators' && isSignedIn() && request.auth.uid in resource.data.editUserIds)
                   || (resource.data.editability == 'everyone' && canViewPlan());
        }

        allow read: if canViewPlan();
        allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
        allow update: if canEditPlan();
        allow delete: if isSignedIn() && isOwner(resource.data.ownerId);

        match /versions/{versionId} {
            allow read, create: if canEditPlan();
            allow update, delete: if isOwner(get(/databases/$(database)/documents/plans/$(planId)).data.ownerId);
        }

        match /viewingUsers/{userId} {
          allow read, write: if isSignedIn() && isOwner(userId);
        }
    }
    
    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.reviewerId);
      allow update, delete: if isSignedIn() && isOwner(resource.data.reviewerId);
    }
    
    // News Articles & Comments
    match /newsArticles/{articleId} {
        allow read: if resource.data.status == 'published' || (isSignedIn() && isOwner(resource.data.userId));
        allow create: if isSignedIn() && isOwner(request.resource.data.userId);
        allow update, delete: if isSignedIn() && isOwner(resource.data.userId);

        match /newsComments/{commentId} {
            allow read: if isSignedIn();
            allow create: if isSignedIn();
            allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isOwner(get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId));

            match /newsSubcomments/{subCommentId} {
                allow read: if isSignedIn();
                allow create: if isSignedIn();
                allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isOwner(get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId));
            }
        }
    }
    
    // Article Tags & Collections
    match /articleTags/{tagId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if false;
    }
    
    match /collections/{collectionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.ownerId) || request.auth.uid in resource.data.sharedWithUserIds);
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }
    
    // User Preferences
    match /userPreferences/{userId} {
        allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Follows Collection
    match /follows/{followId} {
      // Any signed-in user can check if a follow relationship exists.
      allow read: if isSignedIn();
      
      // A user can create a follow relationship for themselves.
      // Also validates that the document ID matches the content.
      allow create: if isSignedIn() 
                     && request.auth.uid == request.resource.data.followerId
                     && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      
      // A user can only delete their own follow relationships (unfollow).
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
      
      // Updates are not allowed; unfollow is a delete, follow is a create.
      allow update: if false;
    }

  }
}
