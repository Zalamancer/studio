
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Public profiles can be read
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                     request.resource.data.uid == userId &&
                     // Ensure only allowed fields are present at creation
                     request.resource.data.keys().hasAll(['uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange', 'createdAt', 'lastLoginAt', 'updatedAt']) &&
                     request.resource.data.size() == 22 && // Adjust size based on actual fields
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.updatedAt == request.time &&
                     request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(userId) &&
                     // Ensure only allowed fields are updated and critical fields are not changed
                     request.resource.data.uid == resource.data.uid &&
                     request.resource.data.email == resource.data.email && // Email shouldn't typically change this way
                     request.resource.data.mentionName == resource.data.mentionName &&
                     request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                     request.resource.data.createdAt == resource.data.createdAt && // createdAt is immutable
                     request.resource.data.updatedAt == request.time && // updatedAt must be new server time
                     // Allow only specific fields to be updated by the user profile settings
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'established',
                       'incomeRange', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags',
                       'lastLoginAt', 'updatedAt' // lastLoginAt is updated by initializeUserProfile on login
                     ]);
    }

    // Mutuals (Connections) collection
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) && // Requester must be in userIds
                       request.resource.data.userIds.size() == 2 && // Must be between 2 users
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdAt == request.time && // Correct for v2, use requestedAt for logic
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.requestedAt == request.time &&
                       !exists(/databases/$(database)/documents/mutuals/$(connectionId)); // Ensure it doesn't exist

      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds && // User must be part of the connection
                       request.resource.data.userIds == resource.data.userIds && // userIds cannot change
                       request.resource.data.requesterId == resource.data.requesterId && // requesterId cannot change
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt is immutable
                       request.resource.data.updatedAt == request.time &&
                       (
                         // Accepting a request
                         (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                          request.auth.uid != resource.data.requesterId && // Accepter is not the original requester
                          request.resource.data.connectedAt == request.time &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt'])
                         )
                         // Future status changes like 'blocked' could be added here
                       );
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Both users can delete
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow list: if isAuthenticated(); // Allow listing for queries where('participants', 'array-contains', request.auth.uid)

      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.lastMessageTimestamp == request.time &&
                       // Type-specific rules
                       (
                         (request.resource.data.type == 'direct' &&
                          request.resource.data.participants.size() == 2 &&
                          request.resource.data.groupName == null &&
                          request.resource.data.ownerId == null &&
                          request.resource.data.adminIds.size() == 0
                         ) ||
                         (request.resource.data.type == 'group' &&
                          request.resource.data.participants.size() >= 2 &&
                          request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 &&
                          request.resource.data.ownerId == request.auth.uid && // Creator is owner
                          request.resource.data.adminIds.hasAll([request.auth.uid]) // Creator is admin
                         )
                       ) &&
                       // Ensure correct fields and sizes based on type
                       (request.resource.data.type == 'direct' ?
                         request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) && request.resource.data.size() == 11 :
                         request.resource.data.keys().hasAll(['participants', 'type', 'postId', 'lastMessage', 'lastMessageTimestamp', 'createdAt', 'updatedAt', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) && request.resource.data.size() == 11
                       );


      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt immutable
                       request.resource.data.type == resource.data.type && // type immutable
                       request.resource.data.postId == resource.data.postId && // postId immutable post-creation
                       // General message update
                       (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])) ||
                         // Group specific updates (admin actions)
                         (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds &&
                           (
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'updatedAt'])) || // Edit group details
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt'])) || // Add/remove members by admin
                             (request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'updatedAt']) && request.auth.uid == resource.data.ownerId) // Promote/demote by owner
                           )
                         ) ||
                         // Leaving a group (owner cannot leave if sole admin and others present)
                         (resource.data.type == 'group' &&
                           request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]) &&
                           request.resource.data.adminIds == resource.data.adminIds.removeAll([request.auth.uid]) &&
                           !(request.auth.uid == resource.data.ownerId && resource.data.adminIds.size() == 1 && request.resource.data.participants.size() > 0) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt', 'formerParticipants'])
                         ) ||
                         // Transfer ownership (only owner can do this)
                         (resource.data.type == 'group' && request.auth.uid == resource.data.ownerId &&
                            request.resource.data.ownerId != resource.data.ownerId && // ownerId must change
                            request.resource.data.participants.hasAll([request.resource.data.ownerId]) && // new owner must be a participant
                            request.resource.data.adminIds.hasAll([request.resource.data.ownerId]) && // new owner becomes an admin
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'adminIds', 'updatedAt'])
                         )
                       );


      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow list: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants; // For queries
        allow create: if isAuthenticated() &&
                         request.auth.uid == request.resource.data.senderId &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         (request.resource.data.isBotMessage == false || request.resource.data.isBotMessage == true) && // must be boolean
                         request.resource.data.read == false && // New messages are unread
                         // Ensure correct fields and size
                         request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp', 'isBotMessage', 'replyToMessageId', 'repliedToTextSnippet', 'read', 'conversationId']) &&
                         request.resource.data.size() == 8;
      }
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow list: if isAuthenticated(); // For queries where('userId', '==', request.auth.uid)
      allow create: if isAuthenticated() && // Server-side (functions) usually creates notifications
                       request.resource.data.userId != request.auth.uid && // User cannot create for self directly
                       request.resource.data.isRead == false &&
                       request.resource.data.timestamp == request.time;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                       request.resource.data.isRead == true && // Can only mark as read
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && // Allow updatedAt
                       request.resource.data.updatedAt == request.time; // Ensure updatedAt is set
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow list: if true; // Allow listing reviews for a profile
      allow create: if isAuthenticated() &&
                       request.resource.data.reviewerId == request.auth.uid &&
                       request.resource.data.targetUserId != request.auth.uid && // Cannot review self
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure correct fields
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']) &&
                       request.resource.data.size() == 9;
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       request.resource.data.reviewerId == resource.data.reviewerId && // Cannot change reviewer
                       request.resource.data.targetUserId == resource.data.targetUserId && // Cannot change target
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       request.resource.data.updatedAt == request.time && // Must be new server time
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']); // Only rating, comment, updatedAt can change
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }


    // User Preferences collection
    match /userPreferences/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && request.resource.data.userId == userId &&
                       // Only allow specific preference fields to be updated
                       request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'notifyOnReply', 'notifyOnMention', 'notifyOnNewConnectionRequest',
                         'notifyOnConnectionAccepted', 'notifyOnNewMessage', 'notifyOnPlatformUpdates',
                         'stripeCustomerId', 'stripeSubscriptionId', 'activeStripePriceId',
                         'stripeSubscriptionStatus', 'stripeSubscriptionCurrentPeriodEnd', 'paymentMethods', 'stripeSubscriptionWillCancelAtPeriodEnd', // Added stripeSubscriptionWillCancelAtPeriodEnd
                         'updatedAt' // Always allow updatedAt
                       ]);
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow list: if true; // Allow listing posts

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request') &&
                       // Validate all fields for completeness and type
                       request.resource.data.keys().hasAll([
                         'userId', 'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode',
                         'ratingScore', 'imageUrls', 'mentionedUserIds', 'requestType', 'createdAt', 'commentCount',
                         'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline'
                       ]) &&
                       request.resource.data.size() == 18;

      allow update: if isAuthenticated() &&
                      // Only owner can update, OR for specific fields like commentCount
                     (
                       // Owner full update (most fields, restricted ones below)
                       (request.auth.uid == resource.data.userId &&
                        request.resource.data.userId == resource.data.userId && // Cannot change owner
                        request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                        request.resource.data.updatedAt == request.time && // Must be new server time
                        // Allow changes to common fields by owner
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'question', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds',
                            'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline', 'requestType',
                            'updatedAt' // ratingScore not typically user-editable directly, commentCount by functions
                        ])
                       ) ||
                       // Increment/decrement commentCount by 1 (typically by server/function)
                       (
                         request.resource.data.commentCount == resource.data.commentCount + 1 ||
                         request.resource.data.commentCount == resource.data.commentCount - 1
                       ) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
                       request.resource.data.updatedAt == request.time
                     );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // Subcollections of Posts
      match /comments/{commentId} {
        allow read: if true;
        allow list: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds']) &&
                         request.resource.data.size() == 8;

        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time && // Ensures updatedAt is always fresh
                         // Like operation: only likeCount and likedBy can change, plus updatedAt
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         // Validate likeCount change
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         // Validate likedBy change (user is adding/removing themselves)
                         (
                             (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) || // Adding self
                             (resource.data.likedBy.concat([request.auth.uid]) == request.resource.data.likedBy && resource.data.likedBy.hasAny([request.auth.uid]))   // Removing self
                         ) &&
                         // Ensure no other fields are changed if they are part of the request
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.mentionName == resource.data.mentionName &&
                         request.resource.data.mentionedUserIds == resource.data.mentionedUserIds;

        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list &&
                           request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                           request.resource.data.size() == 7;

          allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           // Like operation: only likeCount and likedBy can change, plus updatedAt
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                           // Validate likeCount change
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           // Validate likedBy change
                           (
                               (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) || // Adding self
                               (resource.data.likedBy.concat([request.auth.uid]) == request.resource.data.likedBy && resource.data.likedBy.hasAny([request.auth.uid]))   // Removing self
                           ) &&
                           // Ensure no other fields are changed if they are part of the request
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.text == resource.data.text &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.mentionedUserIds == resource.data.mentionedUserIds;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
      match /bids/{bidId} {
          allow read: if isAuthenticated() && (request.auth.uid == resource.data.bidderId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId); // Bidder or Post owner
          allow list: if isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Only Post owner can list all bids for their post
          allow create: if isAuthenticated() &&
                           request.resource.data.bidderId == request.auth.uid &&
                           request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId && // Cannot bid on own post
                           request.resource.data.postId == postId && // Ensure bid is for this post
                           request.resource.data.bidAmount is number && request.resource.data.bidAmount >= 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.bidMessage is string && // bidMessage should be string
                           request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']) &&
                           request.resource.data.size() == 5;
          allow update: if false; // Bids are generally not updatable, only created/deleted
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.bidderId; // Bidder can delete their bid
      }
    }

    // Collections
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return resource.data.ownerId == request.auth.uid;
      }
      function isSharedWithUser() {
        return request.auth.uid in resource.data.sharedWithUserIds;
      }

      allow read: if isAuthenticated() && (isCollectionOwner() || isSharedWithUser());
      allow list: if isAuthenticated(); // For queries: where('ownerId', '==', ...) OR where('sharedWithUserIds', 'array-contains', ...)

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.postIds is list && // Can be empty initially
                       request.resource.data.sharedWithUserIds is list && // Can be empty initially
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']) &&
                       request.resource.data.size() == 7;

      allow update: if isAuthenticated() && isCollectionOwner() &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);

      allow delete: if isAuthenticated() && isCollectionOwner();
    }

    // Plans collection
    match /plans/{planId} {
        function isPlanOwner() {
            return resource.data.ownerId == request.auth.uid;
        }
        function canViewPlan() {
            return resource.data.visibility == 'public' ||
                   resource.data.visibility == 'unlisted' || // Unlisted implies anyone with link (if they are auth'd)
                   (resource.data.visibility == 'private' && request.auth.uid in resource.data.viewUserIds);
        }
        function canEditPlan() {
            return isPlanOwner() ||
                   (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
                   (resource.data.editability == 'everyone' && canViewPlan()); // 'everyone' who can view can edit
        }

        allow read: if isAuthenticated() && canViewPlan();
        allow list: if isAuthenticated(); // Allow listing for queries, will be filtered by rules on specific fields

        allow create: if isAuthenticated() &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.version == 1 &&
                         // Correct field checks for plan creation
                         request.resource.data.keys().hasAll([
                            'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                            'createdAt', 'updatedAt', 'version', 'roadmap',
                            'visibility', 'editability', 'viewUserIds', 'editUserIds'
                         ]) &&
                         request.resource.data.size() == 15;

        allow update: if isAuthenticated() && canEditPlan() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // createdAt is immutable
                         request.resource.data.updatedAt == request.time &&
                         // Owner can update all allowed fields. Collaborators/everyone only roadmap & version.
                         (isPlanOwner() ?
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                                'roadmap', 'version', 'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt'
                            ]) :
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt'])
                         ) &&
                         // Version must increment if roadmap changes
                         (request.resource.data.roadmap == resource.data.roadmap || request.resource.data.version == resource.data.version + 1);


        match /versions/{versionId} {
            allow read: if isAuthenticated() && canViewPlan(); // If can view plan, can view its versions
            allow list: if isAuthenticated() && canViewPlan();
            allow create: if isAuthenticated() && canEditPlan() && // User who can edit plan can create a version snapshot
                             request.resource.data.planId == planId &&
                             request.resource.data.editorUid == request.auth.uid &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.versionNumber is number &&
                             request.resource.data.roadmap is list &&
                             request.resource.data.keys().hasAll(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']) &&
                             request.resource.data.size() == 5;
            allow update: if false; // Versions are immutable
            allow delete: if false; // Versions are immutable
        }
    }

    // Article Tags collection
    match /articleTags/{tagId} {
      allow read: if true; // Tags are public
      allow list: if true; // Allow listing tags
      allow create: if isAuthenticated() &&
                     request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                     request.resource.data.nameLowercase == request.resource.data.name.lower() &&
                     request.resource.data.usageCount >= 0 && // Can be 0 or more for new tags if incrementBy is negative
                     request.resource.data.createdAt == request.time &&
                     request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && // Allow updating usageCount
                     request.resource.data.name == resource.data.name &&
                     request.resource.data.nameLowercase == resource.data.nameLowercase &&
                     request.resource.data.createdAt == resource.data.createdAt &&
                     request.resource.data.createdBy == resource.data.createdBy &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
    }

    // News Articles collection (similar to Posts, but distinct)
    match /newsArticles/{articleId} {
      allow read: if resource.data.status == 'published' ||
                     (isAuthenticated() && request.auth.uid == resource.data.userId); // Author can read own drafts
      allow list: if true; // For querying published articles, or user's own articles

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (request.resource.data.status == 'draft' || request.resource.data.status == 'published') &&
                       (request.resource.data.status == 'published' ? request.resource.data.publishedAt == request.time : request.resource.data.publishedAt == null) &&
                       // Ensure all required fields from NewsArticle type are present
                       request.resource.data.keys().hasAll([
                          'userId', 'title', 'tags', 'content', 'status', 'coverImageUrl', 'createdAt', 'updatedAt', 'publishedAt',
                          'commentCount', 'descriptionDetails', 'descriptionOutcome', 'descriptionTried',
                          'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds', 'naicsCode', 'question',
                          'ratingScore', 'requestType', 'sector', 'subSector', 'industry', 'draftContent', 'hasUnpublishedChanges'
                       ]) &&
                       request.resource.data.size() == 26;


      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       // Validate status transitions and publishedAt logic
                       (
                         (request.resource.data.status == 'published' && (resource.data.status != 'published' || resource.data.publishedAt == null) ? request.resource.data.publishedAt == request.time : true) &&
                         (request.resource.data.status == 'draft' ? request.resource.data.publishedAt == null : true)
                       ) &&
                       // Allow updating specific fields
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 'publishedAt', 'updatedAt',
                           'sector', 'subSector', 'industry', 'naicsCode', 'requestType', 'question',
                           'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'maxBudget', 'deadline',
                           'imageUrls', 'mentionedUserIds' // commentCount and ratingScore usually updated by functions/aggregations
                       ]);


      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // News articles can also have comments, similar to posts
      // This rule is a copy of post comments, adjust if news comments have different structure/rules
      match /comments/{commentId} {
        allow read: if true;
        allow list: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                         request.resource.data.mentionedUserIds is list &&
                         request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds']) &&
                         request.resource.data.size() == 8;
        allow update: if isAuthenticated() &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                         (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                         (
                             (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) ||
                             (resource.data.likedBy.concat([request.auth.uid]) == request.resource.data.likedBy && resource.data.likedBy.hasAny([request.auth.uid]))
                         ) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.mentionName == resource.data.mentionName &&
                         request.resource.data.mentionedUserIds == resource.data.mentionedUserIds;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

        match /subcomments/{subCommentId} {
          allow read: if true;
          allow list: if true;
          allow create: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid &&
                           request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                           request.resource.data.timestamp == request.time &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.likeCount == 0 &&
                           request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0 &&
                           request.resource.data.mentionedUserIds is list &&
                           request.resource.data.keys().hasAll(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionedUserIds']) &&
                           request.resource.data.size() == 7;
          allow update: if isAuthenticated() &&
                           request.resource.data.updatedAt == request.time &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt']) &&
                           (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1) &&
                           (
                               (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]) && !resource.data.likedBy.hasAny([request.auth.uid])) ||
                               (resource.data.likedBy.concat([request.auth.uid]) == request.resource.data.likedBy && resource.data.likedBy.hasAny([request.auth.uid]))
                           ) &&
                           request.resource.data.userId == resource.data.userId &&
                           request.resource.data.text == resource.data.text &&
                           request.resource.data.timestamp == resource.data.timestamp &&
                           request.resource.data.mentionedUserIds == resource.data.mentionedUserIds;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
    }
  }
}

    