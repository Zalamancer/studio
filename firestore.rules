
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for conversation rules
    function isAuthUserParticipant() {
      return request.auth != null && resource.data.participants is list && resource.data.participants.hasAny([request.auth.uid]);
    }

    function isGroupOwner(authUid, convData) {
      return convData.type == 'group' && convData.ownerId == authUid;
    }

    function isGroupAdmin(authUid, convData) {
      return convData.type == 'group' && convData.adminIds is list && convData.adminIds.hasAny([authUid]);
    }

    // Stripe rules (as provided by user)
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Collections rules (as provided by user)
    match /collections/{collectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Posts and their subcollections (comments, bids)
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid; // Ensure updatedAt for update if needed

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time;
        allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time;
          allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.updatedAt == request.time;
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }

      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid
                      && request.resource.data.timestamp == request.time;
        allow update, delete: if false; // Bids typically not updatable/deletable by users
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      allow get: if request.auth != null &&
                 resource.data.participants is list &&
                 resource.data.participants.hasAny([request.auth.uid]);
      allow list: if request.auth != null && request.query.limit <= 100; // Firestore applies 'get' rule to each result

      allow create: if request.auth != null &&
                    request.resource.data.participants is list &&
                    request.resource.data.participants.hasAll([request.auth.uid]) &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.lastMessageTimestamp == request.time &&
                    (
                      // Direct Chat
                      (
                        request.resource.data.type == 'direct' &&
                        request.resource.data.participants.size() == 2 &&
                        request.resource.data.ownerId == null &&
                        request.resource.data.adminIds == [] &&
                        (request.resource.data.groupName == null || request.resource.data.groupName == '') &&
                        (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl == '')
                        // postId can be null or a string for direct chats related to a post
                      ) ||
                      // Group Chat
                      (
                        request.resource.data.type == 'group' &&
                        request.resource.data.participants.size() >= 2 &&
                        request.resource.data.ownerId == request.auth.uid &&
                        request.resource.data.adminIds is list &&
                        request.resource.data.adminIds.hasAll([request.auth.uid]) &&
                        request.resource.data.groupName is string && request.resource.data.groupName.size() > 0
                        // groupAvatarUrl is optional
                        // postId is typically null for group chats, but can be set
                      )
                    );

      allow update: if request.auth != null && isAuthUserParticipant() && request.resource.data.updatedAt == request.time && (
        // Rule A: Last message update by a participant
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
          request.resource.data.lastMessageSenderId == request.auth.uid
          // No need to check immutable fields here if hasOnly is strict enough for THIS action
        ) ||
        // Rule B: Admin updating groupName or groupAvatarUrl
        (
          resource.data.type == 'group' && isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt']) && // User might send one or both
          (request.resource.data.keys().has('groupName') ? request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 : true) &&
          (request.resource.data.keys().has('groupAvatarUrl') ? (request.resource.data.groupAvatarUrl is string || request.resource.data.groupAvatarUrl == null) : true) &&
          // Ensure immutable fields are not changed by this operation
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.participants == resource.data.participants && // Participants not changed here
          request.resource.data.adminIds == resource.data.adminIds // Admin list not changed here
        ) ||
        // Rule C & D combined: Admin/Owner managing participants (add/remove member or admin)
        // This rule handles: Owner removing admin/member, Admin removing non-admin member.
        (
          resource.data.type == 'group' && isGroupAdmin(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() >= 1 && // Group must have at least one member (owner)
          request.resource.data.participants.hasAll([resource.data.ownerId]) && // Owner cannot be removed
          // Let removedParticipantId be inferred by the change in participants list size
          (request.resource.data.participants.size() == resource.data.participants.size() - 1) &&
          // Let 'removedId' be the ID present in 'resource.data.participants' but not in 'request.resource.data.participants'
          // This requires ensuring the 'removedId' is not the owner (already handled by participants.hasAll([ownerId]))
          // And, if remover is just an Admin (not Owner), they cannot remove another Admin.
          (
            isGroupOwner(request.auth.uid, resource.data) || // Owner can remove anyone (except self via this rule, owner cannot be in removed set)
            (
              isGroupAdmin(request.auth.uid, resource.data) &&
              !resource.data.adminIds.hasAny(resource.data.participants.diff(request.resource.data.participants).removed()) // Admin cannot remove another admin
            )
          ) &&
          // Correctly update adminIds: if the removed user was an admin, remove them from adminIds. Otherwise, adminIds should be unchanged.
          (
            (resource.data.adminIds.hasAny(resource.data.participants.diff(request.resource.data.participants).removed())) &&
            request.resource.data.adminIds == resource.data.adminIds.removeAll(resource.data.participants.diff(request.resource.data.participants).removed())
          ) || (
            (!resource.data.adminIds.hasAny(resource.data.participants.diff(request.resource.data.participants).removed())) &&
            request.resource.data.adminIds == resource.data.adminIds
          ) &&
          // Ensure other immutable fields are not changed by this operation
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl
        ) ||
        // Rule D_bis: Owner promoting/demoting admins (only adminIds and updatedAt change)
        (
          resource.data.type == 'group' && isGroupOwner(request.auth.uid, resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds', 'updatedAt']) &&
          request.resource.data.adminIds is list && request.resource.data.adminIds.size() >= 1 &&
          request.resource.data.adminIds.hasAll([resource.data.ownerId]) && // Owner must remain an admin
          resource.data.participants.hasAll(request.resource.data.adminIds) && // All admins must be participants
          // Ensure other immutable fields are not changed by this operation
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl &&
          request.resource.data.participants == resource.data.participants
        ) ||
        // Rule E: Participant leaving group
        (
          resource.data.type == 'group' &&
          resource.data.participants.hasAny([request.auth.uid]) && // User is a participant
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'adminIds', 'updatedAt']) &&
          request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]) && // Participants list updated correctly
          // AdminIds list updated correctly (if user was admin, remove them, else same)
          request.resource.data.adminIds == (resource.data.adminIds.hasAny([request.auth.uid]) ? resource.data.adminIds.removeAll([request.auth.uid]) : resource.data.adminIds) &&
          // Owner safeguard: owner cannot leave if they are the sole admin and other members would remain
          !(
            resource.data.ownerId == request.auth.uid &&
            resource.data.adminIds.hasAny([request.auth.uid]) && // Current user (owner) is in adminIds
            resource.data.adminIds.size() == 1 && // And is the only admin
            request.resource.data.participants.size() > 0 // And after leaving, there are still participants
          ) &&
          // Ensure other immutable fields are not changed by this operation
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.groupName == resource.data.groupName &&
          request.resource.data.groupAvatarUrl == resource.data.groupAvatarUrl
        )
      );

      match /messages/{messageId} {
        allow read: if request.auth != null &&
                    get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.timestamp == request.time;
        allow update, delete: if false; // Messages typically immutable
      }
    }

    // Mutual connections (as provided by user)
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds is list && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null; // Firestore applies 'get' to each
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds is list
                    && request.resource.data.userIds.hasAll([request.auth.uid])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedAt == request.time
                    && request.resource.data.userIds.size() == 2; // Ensure only 2 UIDs for mutuals
      allow update: if request.auth != null && resource.data.userIds is list && resource.data.userIds.hasAny([request.auth.uid])
                    && request.resource.data.updatedAt == request.time;
                    // Specific update logic for status changes:
                    // Accept: (status 'pending' -> 'connected', connectedAt=now, acceptor is not requester)
                    // (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                    //  request.resource.data.connectedAt == request.time &&
                    //  !resource.data.userIds.hasAll([resource.data.requesterId, request.auth.uid]))
                    // No, simpler: acceptor is one of userIds but NOT the original requesterId for 'pending'
                    // Rule for accept:
                    // (resource.data.status == 'pending' && request.resource.data.status == 'connected' &&
                    //  request.resource.data.connectedAt == request.time &&
                    //  request.auth.uid != resource.data.requesterId &&
                    //  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'connectedAt', 'updatedAt']))
      allow delete: if request.auth != null && resource.data.userIds is list && resource.data.userIds.hasAny([request.auth.uid]);
                    // Allow if status is 'pending' (cancel/reject) or 'connected' (remove)
                    // (resource.data.status == 'pending' || resource.data.status == 'connected')
    }

    // User Preferences (as provided by user)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (as provided by user)
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId
                   && request.resource.data.lastUpdatedBy == request.auth.uid // Ensure modifier is tracked
                   && request.resource.data.lastUpdatedAt == request.time;
    }

    // Notifications collection (as provided by user)
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null; // Typically created by server/functions, or by user for self (less common)
                                           // If client creates for others: ensure senderId == auth.uid
                                           // if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']); // Only allow 'isRead' to be updated
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User profiles (as provided by user, ensure create/update has timestamp logic)
    match /users/{userId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.lastLoginAt == request.time; // Or handle lastLoginAt separately
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.updatedAt == request.time;
                    // Allow lastLoginAt to be updated without other fields changing by itself
                    // || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'updatedAt']) && request.resource.data.lastLoginAt == request.time)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} {
        allow list: if request.auth != null;
    }

    // Reviews collection (as provided by user, ensure timestamp logic)
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && resource.data.reviewerId == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if request.auth != null
                    && resource.data.reviewerId == request.auth.uid;
    }

    // Fallback rule (as provided by user)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
/