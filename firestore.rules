
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stripe rules (as provided by user)
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Collections rules (as provided by user)
    match /collections/{collectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Posts and their subcollections
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // MODIFIED: Allow post owner to update their post OR any authenticated user to update commentCount
      allow update: if request.auth != null && (
        // Rule 1: Owner can update their post content (most fields)
        (
          resource.data.userId == request.auth.uid &&
          // Owner should not directly manipulate commentCount here, it's handled by rule 2
          // If owner wants to edit other fields, they should not send commentCount unless they also intend to modify it as per rule 2's logic
          // This means the client logic for post editing by owner should be careful not to include commentCount unless it's a specific "fix" operation
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'maxBudget', 'deadline', 'requestType', 'updatedAt']) ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'updatedAt']) // for 'post' type without budget/deadline
          ) &&
          request.resource.data.userId == resource.data.userId && // Immutable
          request.resource.data.createdAt == resource.data.createdAt && // Immutable
          request.resource.data.updatedAt == request.time
        ) ||
        // Rule 2: Any authenticated user can update commentCount (increment/decrement)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 || request.resource.data.commentCount == resource.data.commentCount - 1) &&
          request.resource.data.updatedAt == request.time
          // No need to check other fields equality here as hasOnly ensures they are not part of the request
        )
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;


      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid; // Commenter is the authenticated user

        // MODIFIED: Allow owner to edit their comment text/mentions OR any user to like/unlike
        allow update: if request.auth != null && (
          // Rule 1: Owner can edit their comment (text, mentions)
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId && // Immutable
            request.resource.data.timestamp == resource.data.timestamp && // Immutable
            request.resource.data.updatedAt == request.time
          ) ||
          // Rule 2: Any authenticated user can like/unlike (update likedBy and likeCount)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
            request.resource.data.userId == resource.data.userId && // Ensure core fields are not changed during like
            request.resource.data.text == resource.data.text &&
            request.resource.data.timestamp == resource.data.timestamp &&
            (
              (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) || // Adding a like
              (resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1)    // Removing a like
            ) &&
            request.resource.data.updatedAt == request.time
          )
        );
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
          // MODIFIED: Allow owner to edit their subcomment OR any user to like/unlike
          allow update: if request.auth != null && (
            // Rule 1: Owner can edit their subcomment
            (
              resource.data.userId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUserIds', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId && // Immutable
              request.resource.data.timestamp == resource.data.timestamp && // Immutable
              request.resource.data.updatedAt == request.time
            ) ||
            // Rule 2: Any authenticated user can like/unlike
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
              request.resource.data.userId == resource.data.userId && // Ensure core fields are not changed
              request.resource.data.text == resource.data.text &&
              request.resource.data.timestamp == resource.data.timestamp &&
              (
                (request.resource.data.likedBy.hasAll(resource.data.likedBy) && request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 && request.resource.data.likeCount == resource.data.likeCount + 1) ||
                (resource.data.likedBy.hasAll(request.resource.data.likedBy) && !request.resource.data.likedBy.hasAny([request.auth.uid]) && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 && request.resource.data.likeCount == resource.data.likeCount - 1)
              ) &&
              request.resource.data.updatedAt == request.time
            )
          );
          allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        }
      }

      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.bidderId == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Conversations and their messages (SIMPLIFIED FOR NOW)
    match /conversations/{conversationId} {
      // Helper functions scoped to this match block
      function isAuthUserParticipant() {
        return resource.data.participants.hasAny([request.auth.uid]);
      }
      // Other helper functions (isGroupOwner, isGroupAdmin) will be added back later

      allow get: if request.auth != null && (resource == null || isAuthUserParticipant());
      allow list: if request.auth != null && request.query.limit <= 100; // Relies on 'get' rule for actual filtering by query

      // SIMPLIFIED CREATE: Only direct chats for now
      allow create: if request.auth != null &&
                    request.resource.data.type == 'direct' &&
                    request.resource.data.participants.size() == 2 &&
                    request.resource.data.participants.hasAll([request.auth.uid]) &&
                    request.resource.data.ownerId == null &&
                    request.resource.data.adminIds.size() == 0 &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.lastMessageTimestamp == request.time;

      // SIMPLIFIED UPDATE: Only last message fields by a participant
      allow update: if request.auth != null && isAuthUserParticipant() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']) &&
                    request.resource.data.lastMessageSenderId == request.auth.uid &&
                    request.resource.data.updatedAt == request.time;
                    // We will add group management OR conditions here later

      match /messages/{messageId} {
        allow read: if request.auth != null &&
                    get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                    get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) &&
                    request.resource.data.senderId == request.auth.uid &&
                    request.resource.data.timestamp == request.time;
        allow update, delete: if false; // Messages are typically immutable
      }
    }

    // Mutual connections (as provided by user)
    match /mutuals/{connectionDocId} {
      allow get: if request.auth != null && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences (as provided by user)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (as provided by user)
    match /whiteboardAnnotations/{naicsDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId; // ensure naicsCode field is set in data
    }

    // Notifications collection (as provided by user)
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null; // Generally, anyone can trigger a notification for someone else if logic allows
      allow update: if request.auth != null && resource.data.userId == request.auth.uid; // User can update their own notifications (e.g., mark as read)
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // User can delete their own notifications
    }

    // User profiles (as provided by user)
    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} { // This allows listing the users collection
        allow list: if request.auth != null;
    }

    // Reviews collection (as provided by user)
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.reviewerId == request.auth.uid;
    }

    // Fallback rule: Deny by default for any other path (as provided by user)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    