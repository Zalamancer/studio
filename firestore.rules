
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- START OF INLINED PLAN RULES ---
    match /plans/{planId} {
      // Inlined canViewPlan(planId) logic:
      // A user can view a plan if:
      // 1. The plan's visibility is 'public'.
      // 2. OR The plan's visibility is 'unlisted' AND the user is authenticated.
      // 3. OR The user is the owner of the plan.
      // 4. OR The user's ID is in the plan's viewUserIds array.
      allow read: if request.auth != null && (
                       (resource.data.visibility == 'public') ||
                       (resource.data.visibility == 'unlisted') ||
                       (request.auth.uid == resource.data.ownerId) ||
                       (request.auth.uid in resource.data.viewUserIds)
                     );

      // SIMPLIFIED LIST RULE:
      // Allows authenticated users to list plans with common query constraints (limit, orderBy).
      // The client query's `where` clause (e.g., on 'visibility') will select candidate documents.
      // The `allow read` rule above will then be applied to each candidate document by Firestore to filter the final result set.
      // This rule CANNOT use get() or resource.data because planId is a wildcard for the collection.
      allow list: if request.auth != null &&
                     request.query.limit <= 50 &&
                     (request.query.orderBy == null || request.query.orderBy.path == 'createdAt' || request.query.orderBy.path == 'updatedAt');

      // Inlined create logic:
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.ownerId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.version == 1 &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                       request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 1000) &&
                       request.resource.data.sector is string &&
                       (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                       (request.resource.data.industry == null || request.resource.data.industry is string) &&
                       (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                       request.resource.data.roadmap is list &&
                       // Inlined isValidPlanVisibility
                       (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public') &&
                       // Inlined isValidPlanEditability
                       (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone') &&
                       // Inlined isValidViewAndEditUserIds
                       (
                         (request.resource.data.viewUserIds is list && (request.resource.data.viewUserIds.size() == 0 || request.resource.data.viewUserIds[0] is string)) && // Check if list of strings or empty
                         (request.resource.data.editUserIds is list && (request.resource.data.editUserIds.size() == 0 || request.resource.data.editUserIds[0] is string)) && // Check if list of strings or empty
                         (request.auth.uid in request.resource.data.viewUserIds || request.resource.data.visibility == 'public') && // Owner must be viewer unless public
                         (request.auth.uid in request.resource.data.editUserIds || request.resource.data.editability == 'everyone') && // Owner must be editor unless everyone
                         (request.resource.data.visibility == 'private' ? request.resource.data.editability == 'owner_only' : true) && // Private plans only editable by owner
                         (request.resource.data.visibility == 'unlisted' ? request.resource.data.editability != 'everyone' : true) && // Unlisted not editable by everyone
                         // Ensure all editors are also viewers if not public
                         (request.resource.data.visibility != 'public' ? request.resource.data.editUserIds.hasAll(request.resource.data.viewUserIds) == false || request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds) : true)
                       ) &&
                       request.resource.data.keys().hasOnly([
                         'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                         'createdAt', 'updatedAt', 'version', 'roadmap',
                         'visibility', 'editability', 'viewUserIds', 'editUserIds'
                       ]);

      // Inlined update logic:
      allow update: if request.auth != null &&
                       // Inlined canEditPlan(planId) logic for existing resource
                       (
                         (resource.data.ownerId == request.auth.uid) ||
                         (resource.data.editability == 'collaborators' && request.auth.uid in resource.data.editUserIds) ||
                         (resource.data.editability == 'everyone' && (resource.data.visibility == 'public' || resource.data.visibility == 'unlisted'))
                       ) &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       (
                         ( // E1: Roadmap update path
                           request.resource.data.keys().hasOnly(['roadmap', 'version', 'updatedAt']) && // Only these keys can change
                           request.resource.data.roadmap is list && // Roadmap must be a list
                           request.resource.data.version == resource.data.version + 1 &&
                           // Ensure other critical fields from settings are not changed in roadmap update
                           request.resource.data.name == resource.data.name &&
                           request.resource.data.description == resource.data.description &&
                           request.resource.data.sector == resource.data.sector &&
                           request.resource.data.subSector == resource.data.subSector &&
                           request.resource.data.industry == resource.data.industry &&
                           request.resource.data.naicsCode == resource.data.naicsCode &&
                           request.resource.data.visibility == resource.data.visibility &&
                           request.resource.data.editability == resource.data.editability &&
                           request.resource.data.viewUserIds == resource.data.viewUserIds &&
                           request.resource.data.editUserIds == resource.data.editUserIds
                         ) ||
                         ( // E2: Settings update path
                           resource.data.ownerId == request.auth.uid && // Only owner can change settings
                           !request.resource.data.keys().hasAny(['roadmap']) && // Roadmap must not be part of settings update
                           request.resource.data.version == resource.data.version && // Version number must remain same for settings
                           // Inlined isValidPlanVisibility for incoming data
                           (request.resource.data.visibility == 'private' || request.resource.data.visibility == 'unlisted' || request.resource.data.visibility == 'public') &&
                           // Inlined isValidPlanEditability for incoming data
                           (request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators' || request.resource.data.editability == 'everyone') &&
                           // Inlined isValidViewAndEditUserIds for incoming data (comparing with existing ownerId from resource.data)
                           (
                             (request.resource.data.viewUserIds is list && (request.resource.data.viewUserIds.size() == 0 || request.resource.data.viewUserIds[0] is string)) &&
                             (request.resource.data.editUserIds is list && (request.resource.data.editUserIds.size() == 0 || request.resource.data.editUserIds[0] is string)) &&
                             (resource.data.ownerId in request.resource.data.viewUserIds || request.resource.data.visibility == 'public') &&
                             (resource.data.ownerId in request.resource.data.editUserIds || request.resource.data.editability == 'everyone') &&
                             (request.resource.data.visibility == 'private' ? request.resource.data.editability == 'owner_only' : true) &&
                             (request.resource.data.visibility == 'unlisted' ? request.resource.data.editability != 'everyone' : true) &&
                             (request.resource.data.visibility != 'public' ? request.resource.data.editUserIds.hasAll(request.resource.data.viewUserIds) == false || request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds) : true)
                           ) &&
                           request.resource.data.keys().hasOnly([
                             'name', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                             'visibility', 'editability', 'viewUserIds', 'editUserIds', 'updatedAt',
                             // Also allow existing fields to be present even if not changed, but ensure no disallowed fields
                             'ownerId', 'createdAt', 'version', 'roadmap' // Check these remain same
                           ]) &&
                           request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                           (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 1000)) &&
                           request.resource.data.sector is string &&
                           (request.resource.data.subSector == null || request.resource.data.subSector is string) &&
                           (request.resource.data.industry == null || request.resource.data.industry is string) &&
                           (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                           // Ensure roadmap isn't being changed in settings update path (it should be same as existing)
                           (request.resource.data.roadmap == resource.data.roadmap)
                         )
                       );

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /versions/{versionId} {
        // Inlined canViewPlan(planId) logic for parent plan:
        allow read, list: if request.auth != null && (
                              (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public') ||
                              (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted') ||
                              (request.auth.uid == get(/databases/$(database)/documents/plans/$(planId)).data.ownerId) ||
                              (request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.viewUserIds)
                            );

        // Inlined canEditPlan(planId) logic for parent plan:
        allow create: if request.auth != null &&
                         (
                           (get(/databases/$(database)/documents/plans/$(planId)).data.ownerId == request.auth.uid) ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'collaborators' && request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.editUserIds) ||
                           (get(/databases/$(database)/documents/plans/$(planId)).data.editability == 'everyone' &&
                             (get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'public' || get(/databases/$(database)/documents/plans/$(planId)).data.visibility == 'unlisted')
                           )
                         ) &&
                         request.resource.data.planId == planId &&
                         request.resource.data.editorUid == request.auth.uid &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.roadmap is list &&
                         request.resource.data.versionNumber is number &&
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']);

        allow update, delete: if false; // Versions are immutable
      }
    }
    // --- END OF INLINED PLAN RULES ---

    // --- Other Collections (Keep as they were, or add your existing rules for them here) ---
    // IMPORTANT: All other collection rules that were previously present must be restored here.
    // I am only providing the /plans and /plans/versions rules as per your explicit request to focus.
    // If you had rules for /users, /mutuals, /posts, etc., they need to be re-inserted below.

    // Example placeholder for other rules:
    // match /users/{userId} {
    //   allow read: if true; // Or your specific rules
    //   allow write: if request.auth.uid == userId;
    // }
    // ... and so on for all other collections ...

    // --- START - Rules for 'users', 'mutuals', 'posts' collections and subcollections
    // Users Collection
    match /users/{userId} {
      allow read: if true; // Publicly readable for basic profile info
      allow create: if request.auth.uid == userId &&
                      request.resource.data.uid == userId &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.lastLoginAt == request.time &&
                      (request.resource.data.email == request.auth.token.email || request.resource.data.email == null) &&
                      // Ensure all required fields for creation are present and no extra fields
                      request.resource.data.keys().hasAll(['uid', 'email', 'mentionName', 'mentionNameLowercase', 'createdAt', 'updatedAt', 'lastLoginAt', 'descriptionVisibility', 'companyName', 'industry', 'avatarUrl', 'sectorName', 'subSectorName', 'industryName', 'naicsCode', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange']) &&
                      request.resource.data.keys().size() == 21;


      allow update: if request.auth.uid == userId &&
                       request.resource.data.uid == userId && // uid cannot change
                       request.resource.data.email == resource.data.email && // email cannot change via this update
                       request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                       request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase && // this too
                       request.resource.data.companyName == resource.data.companyName && // companyName from signup not changeable here
                       request.resource.data.createdAt == resource.data.createdAt && // createdAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       // Allow only specific fields to be updated via this path
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'avatarUrl', 'industry', 'description', 'descriptionVisibility', 'lastLoginAt', 'updatedAt',
                         'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                         'sectorName', 'subSectorName', 'industryName', 'naicsCode'
                       ]);
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      function isUserInConnection() {
        return request.auth.uid in resource.data.userIds;
      }
      function isRequester() {
        return request.auth.uid == request.resource.data.requesterId;
      }
       function isRecipient() {
        return request.auth.uid != resource.data.requesterId && request.auth.uid in resource.data.userIds;
      }

      allow read: if request.auth != null && isUserInConnection();
      allow create: if request.auth != null &&
                       isRequester() &&
                       request.resource.data.userIds.hasAll([request.auth.uid]) &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.requestedAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       // Ensure only expected fields are present on create
                       request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt']);

      allow update: if request.auth != null && isUserInConnection() &&
                       request.resource.data.userIds == resource.data.userIds && // userIds cannot change
                       request.resource.data.requesterId == resource.data.requesterId && // requesterId cannot change
                       request.resource.data.requestedAt == resource.data.requestedAt && // requestedAt cannot change
                       request.resource.data.updatedAt == request.time && // updatedAt must be server time
                       (
                         ( // Accepting a request
                           resource.data.status == 'pending' &&
                           request.resource.data.status == 'connected' &&
                           request.auth.uid != resource.data.requesterId && // Only recipient can accept
                           request.resource.data.connectedAt == request.time &&
                           request.resource.data.keys().hasOnly(['userIds', 'status', 'requesterId', 'requestedAt', 'updatedAt', 'connectedAt'])
                         )
                         // No other status transitions allowed by update, only delete for reject/cancel/remove
                       );
      allow delete: if request.auth != null && isUserInConnection(); // Allows involved users to cancel/reject/remove
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // All posts are public to read
      allow create: if request.auth.uid == request.resource.data.userId &&
                       request.resource.data.createdAt == request.time &&
                       // Ensure all required and optional fields from Post type are covered
                       request.resource.data.keys().hasOnly([
                         'userId', 'tags', 'question', 'requestType',
                         'descriptionDetails', 'descriptionTried', 'descriptionOutcome',
                         'maxBudget', 'deadline',
                         'sector', 'subSector', 'industry', 'ratingScore', 'createdAt', 'naicsCode',
                         'imageUrls', 'mentionedUserIds', 'commentCount'
                         // 'miroBoardEmbedUrl' was removed
                       ]);
      allow update: if request.auth.uid == resource.data.userId && // Only owner can update
                       request.resource.data.userId == resource.data.userId && // Cannot change owner
                       request.resource.data.createdAt == resource.data.createdAt && // Cannot change creation time
                       // Allow updating only specific fields like commentCount or potentially status in future
                       request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount', 'updatedAt']); // 'updatedAt' must be allowed if other fields change
      allow delete: if request.auth.uid == resource.data.userId; // Only owner can delete

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true; // All comments are public
        allow create: if request.auth.uid == request.resource.data.userId &&
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy == [] &&
                         request.resource.data.isShadowBanned == false &&
                         request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'postId', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
        allow update: if request.auth.uid == resource.data.userId && // Only comment owner can update (e.g. text)
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.timestamp == resource.data.timestamp && // Original timestamp cannot change
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) // Only allow text and mentions update by owner
                         ||
                         // Liking/unliking a comment
                         request.auth != null && // Any authenticated user can like/unlike
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.postId == resource.data.postId &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.timestamp == resource.data.timestamp &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']);
        allow delete: if request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Comment owner or post owner

         // SubComments (Replies) Subcollection
        match /subcomments/{subCommentId} {
            allow read: if true;
            allow create: if request.auth.uid == request.resource.data.userId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy == [] &&
                             request.resource.data.isShadowBanned == false &&
                             request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
            allow update: if request.auth.uid == resource.data.userId && // SubComment owner can update text
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds'])
                             ||
                             // Liking/unliking a subcomment
                             request.auth != null && // Any authenticated user
                             request.resource.data.userId == resource.data.userId &&
                             request.resource.data.text == resource.data.text &&
                             request.resource.data.timestamp == resource.data.timestamp &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']);
            allow delete: if request.auth.uid == resource.data.userId || // SubComment owner
                             request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId || // Parent comment owner
                             request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Post owner
        }
      }
      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId || request.auth.uid == resource.data.bidderId; // Post owner or bidder
        allow list: if request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Only post owner can list all bids for their post
        allow create: if request.auth.uid == request.resource.data.bidderId && // Bidder must be the authenticated user
                         request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId && // Cannot bid on own post
                         request.resource.data.postId == postId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.keys().hasOnly(['postId', 'bidderId', 'bidAmount', 'bidMessage', 'timestamp']);
        allow update, delete: if false; // Bids are immutable
      }
    }

    // User Preferences Collection
    match /userPreferences/{userId} {
      allow read, write: if request.auth.uid == userId;
      // Create can be more specific if needed, e.g., checking for required fields on creation
      // Update should verify that userId cannot be changed and createdAt is not changed.
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if request.auth.uid == resource.data.userId; // User can only read their own notifications
      allow list: if request.auth.uid == request.query.filters[0][2] && // Ensure query is for the authenticated user
                     request.query.filters[0][0] == "userId" &&
                     request.query.filters[0][1] == "==" &&
                     (request.query.filters.size() == 1 || (request.query.filters.size() == 2 && request.query.filters[1][0] == "isRead" && request.query.filters[1][1] == "==") ) && // Allow filtering by isRead status
                     request.query.orderBy.path == "timestamp"; // Ordered by timestamp
      allow create: if request.auth.uid == request.resource.data.senderId && // Sender initiates notification
                       request.resource.data.userId != request.resource.data.senderId && // Cannot send to self via this method directly
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.isRead == false &&
                       request.resource.data.keys().hasOnly(['userId', 'type', 'senderId', 'senderName', 'senderAvatar', 'postId', 'postQuestion', 'commentId', 'subCommentId', 'conversationId', 'textSnippet', 'timestamp', 'isRead']);
      allow update: if request.auth.uid == resource.data.userId && // Only recipient can mark as read
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) && // Only isRead and updatedAt can be changed
                       request.resource.data.updatedAt == request.time; // Ensures updatedAt is set by server
      allow delete: if false; // Notifications are not typically deleted by users
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow list: if request.query.filters.size() == 1 &&
                     (request.query.filters[0].field == "targetUserId" || request.query.filters[0].field == "reviewerId") &&
                     request.query.filters[0].operator == "==" &&
                     request.query.orderBy.path == "createdAt"; // Allow listing by target user or by reviewer
      allow create: if request.auth.uid == request.resource.data.reviewerId && // Must be authenticated as reviewer
                       request.resource.data.targetUserId != request.resource.data.reviewerId && // Cannot review self
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.keys().hasOnly(['targetUserId', 'reviewerId', 'reviewerName', 'reviewerAvatar', 'rating', 'comment', 'reviewerHistoricalAvgRating', 'createdAt', 'updatedAt']);
      allow update: if request.auth.uid == resource.data.reviewerId && // Only reviewer can update
                       request.resource.data.targetUserId == resource.data.targetUserId &&
                       request.resource.data.reviewerId == resource.data.reviewerId &&
                       request.resource.data.reviewerHistoricalAvgRating == resource.data.reviewerHistoricalAvgRating && // Historical avg cannot be changed
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if request.auth.uid == resource.data.reviewerId; // Only reviewer can delete
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      function isUserParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function isUserCreatorOrParticipant(conversationData) { // Pass request.resource.data for create
        return request.auth.uid == conversationData.ownerId || request.auth.uid in conversationData.participants;
      }
      function isGroupAdmin() {
        return request.auth.uid in resource.data.adminIds;
      }
      function isValidConversationCreateData(data) {
        return data.participants is list && data.participants.size() >= 2 &&
               (request.auth.uid in data.participants) &&
               data.type is string && (data.type == 'direct' || data.type == 'group') &&
               data.createdAt == request.time && data.updatedAt == request.time &&
               data.lastMessageTimestamp == request.time &&
               (data.type == 'direct' ?
                  data.keys().hasOnly(['participants', 'type', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds']) &&
                  data.groupName == null && data.groupAvatarUrl == null && data.ownerId == null && data.adminIds == [] && data.participants.size() == 2
                : // type == 'group'
                  data.keys().hasOnly(['participants', 'type', 'groupName', 'groupAvatarUrl', 'ownerId', 'adminIds', 'postId', 'createdAt', 'updatedAt', 'lastMessage', 'lastMessageTimestamp']) &&
                  data.groupName is string && data.groupName.size() > 0 &&
                  (data.groupAvatarUrl == null || data.groupAvatarUrl is string) &&
                  data.ownerId == request.auth.uid &&
                  data.adminIds is list && data.adminIds.hasAny([request.auth.uid]) && // Creator must be an admin
                  data.postId == null // Groups are not tied to posts
               );
      }
      function isValidConversationUpdateData(requestData, existingData) {
        return requestData.updatedAt == request.time &&
               requestData.participants.hasAll(existingData.participants) && // Participants can only be added or removed via specific update paths
               requestData.participants.hasAll(existingData.participants) &&
               requestData.type == existingData.type &&
               requestData.postId == existingData.postId &&
               requestData.createdAt == existingData.createdAt &&
               requestData.ownerId == existingData.ownerId && // Owner cannot change via general update
               // Allowed general updates: lastMessage, lastMessageTimestamp, groupName, groupAvatarUrl, adminIds (by owner/admin)
               (
                 ( // General message update
                   requestData.diff(existingData).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'])
                 ) ||
                 ( // Group admin updates (name, avatar)
                   existingData.type == 'group' && (request.auth.uid in existingData.adminIds) &&
                   requestData.diff(existingData).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'updatedAt'])
                 ) ||
                 ( // Group admin updates (adminIds by owner)
                   existingData.type == 'group' && request.auth.uid == existingData.ownerId &&
                   requestData.adminIds is list && // Ensure adminIds is a list
                   requestData.diff(existingData).affectedKeys().hasAny(['adminIds', 'updatedAt'])
                 ) ||
                 ( // Group participant updates (add/remove by admin)
                   existingData.type == 'group' && (request.auth.uid in existingData.adminIds) &&
                   requestData.adminIds == existingData.adminIds && // adminIds not changed here
                   requestData.diff(existingData).affectedKeys().hasAny(['participants', 'updatedAt', 'formerParticipants']) &&
                   // Ensure new participants are not already present and removed are valid
                   (requestData.participants.toSet().difference(existingData.participants.toSet()).size() > 0 ||
                    existingData.participants.toSet().difference(requestData.participants.toSet()).size() > 0)
                 )
               );
      }

      allow read: if request.auth != null && isUserParticipant();
      allow list: if request.auth != null &&
                     request.query.filters.size() == 1 && request.query.filters[0].field == "participants" && request.query.filters[0].operator == "array-contains" && request.query.filters[0].value == request.auth.uid &&
                     request.query.orderBy.path == "lastMessageTimestamp";
      allow create: if request.auth != null && isValidConversationCreateData(request.resource.data);
      allow update: if request.auth != null && isUserParticipant() && isValidConversationUpdateData(request.resource.data, resource.data);
      allow delete: if false; // Conversations are not typically deleted by users

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth.uid == request.resource.data.senderId &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                         request.resource.data.conversationId == conversationId &&
                         request.resource.data.timestamp == request.time &&
                         request.resource.data.read == false &&
                         request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'read', 'isBotMessage', 'conversationId', 'replyToMessageId', 'repliedToTextSnippet']);
        allow update: if request.auth.uid == resource.data.senderId && // Only sender can edit (e.g., text)
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) && // Only allow text update by sender
                         request.resource.data.updatedAt == request.time
                         || // Or allow marking as read by any participant
                         (request.auth.uid in resource.data.participants &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']) &&
                          request.resource.data.read == true &&
                          request.resource.data.updatedAt == request.time);
        allow delete: if request.auth.uid == resource.data.senderId; // Only sender can delete
      }
    }

    // News Articles Collection
    match /newsArticles/{articleId} {
        // Inlined canViewNewsArticle(articleId)
        function isAuthorOrPublicOrPublished(docData) {
            return request.auth.uid == docData.userId ||
                   docData.status == 'published';
        }

        allow read: if request.auth != null && isAuthorOrPublicOrPublished(resource.data);
        allow list: if request.auth != null &&
                       request.query.limit <= 100 &&
                       (
                         ( // Query for published articles
                           request.query.filters.size() == 1 &&
                           request.query.filters[0].field == 'status' &&
                           request.query.filters[0].operator == '==' &&
                           request.query.filters[0].value == 'published' &&
                           request.query.orderBy.path == 'publishedAt'
                         ) ||
                         ( // Query for user's own articles (any status)
                           request.query.filters.size() == 1 &&
                           request.query.filters[0].field == 'userId' &&
                           request.query.filters[0].operator == '==' &&
                           request.query.filters[0].value == request.auth.uid &&
                           request.query.orderBy.path == 'updatedAt'
                         )
                       );

        allow create: if request.auth.uid == request.resource.data.userId &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         (request.resource.data.publishedAt == null || request.resource.data.publishedAt == request.time) &&
                         request.resource.data.likeCount == 0 &&
                         request.resource.data.likedBy == [] &&
                         request.resource.data.commentCount == 0 &&
                         request.resource.data.keys().hasOnly([
                            'userId', 'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl',
                            'createdAt', 'updatedAt', 'publishedAt', 'likeCount', 'likedBy', 'commentCount',
                            'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                            'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                         ]);
        allow update: if request.auth.uid == resource.data.userId && // Only author can update
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time &&
                         // Allow specific fields to be updated
                         (
                            // Path for general content/status updates
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                'title', 'tags', 'content', 'draftContent', 'hasUnpublishedChanges', 'status', 'coverImageUrl', 'publishedAt', 'updatedAt',
                                'descriptionDetails', 'descriptionOutcome', 'descriptionTried', 'imageUrls', 'maxBudget', 'deadline', 'mentionedUserIds',
                                'naicsCode', 'question', 'ratingScore', 'requestType', 'sector', 'subSector', 'industry'
                            ]) ||
                            // Path for like/unlike and comment count updates (can be done by any authenticated user, or server-side)
                            (
                              request.auth != null && // Any authenticated user can trigger like/unlike or comment count update via trusted server code
                              request.resource.data.diff(resource.data).affectedKeys().hasAny(['likedBy', 'likeCount', 'commentCount', 'updatedAt']) &&
                              // Ensure other critical fields are not changed during like/comment count update
                              request.resource.data.title == resource.data.title &&
                              request.resource.data.content == resource.data.content &&
                              request.resource.data.status == resource.data.status
                            )
                         );

        allow delete: if request.auth.uid == resource.data.userId; // Only author can delete

        // News Comments Subcollection
        match /newsComments/{commentId} {
            allow read: if request.auth != null && (resource.data.isShadowBanned == false || resource.data.isShadowBanned == null || request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId); // Visible if not banned, or if viewer is article author
            allow create: if request.auth.uid == request.resource.data.userId &&
                             request.resource.data.timestamp == request.time &&
                             request.resource.data.updatedAt == request.time &&
                             request.resource.data.likeCount == 0 &&
                             request.resource.data.likedBy == [] &&
                             request.resource.data.isShadowBanned == false && // New comments are not banned
                             request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
            allow update: if // Comment owner can update text
                             (request.auth.uid == resource.data.userId &&
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) &&
                              request.resource.data.updatedAt == request.time) ||
                             // Article author can update isShadowBanned status
                             (request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId &&
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                              request.resource.data.updatedAt == request.time) ||
                             // Liking/unliking a comment
                             (request.auth != null &&
                              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                              request.resource.data.updatedAt == request.time);
            allow delete: if request.auth.uid == resource.data.userId || // Comment owner
                             request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId; // Article author

            // News SubComments (Replies) Subcollection
            match /newsSubcomments/{subCommentId} {
                 allow read: if request.auth != null && (resource.data.isShadowBanned == false || resource.data.isShadowBanned == null || request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId);
                 allow create: if request.auth.uid == request.resource.data.userId &&
                                  request.resource.data.timestamp == request.time &&
                                  request.resource.data.updatedAt == request.time &&
                                  request.resource.data.likeCount == 0 &&
                                  request.resource.data.likedBy == [] &&
                                  request.resource.data.isShadowBanned == false &&
                                  request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp', 'updatedAt', 'likeCount', 'likedBy', 'mentionName', 'mentionedUserIds', 'isShadowBanned']);
                 allow update: if // SubComment owner can update text
                                  (request.auth.uid == resource.data.userId &&
                                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'mentionedUserIds']) &&
                                   request.resource.data.updatedAt == request.time) ||
                                  // Article author can update isShadowBanned status
                                  (request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId &&
                                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShadowBanned', 'updatedAt']) &&
                                   request.resource.data.updatedAt == request.time) ||
                                  // Liking/unliking a subcomment
                                  (request.auth != null &&
                                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) &&
                                   request.resource.data.updatedAt == request.time);
                 allow delete: if request.auth.uid == resource.data.userId || // SubComment owner
                                  request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)/newsComments/$(commentId)).data.userId || // Parent comment owner
                                  request.auth.uid == get(/databases/$(database)/documents/newsArticles/$(articleId)).data.userId; // Article author
            }
        }
    }
    // articleTags collection
    match /articleTags/{tagId} {
        allow read: if true; // Tags are public
        allow list: if request.query.limit <= 20; // Allow listing with a limit
        allow create: if request.auth != null && // Authenticated user
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.usageCount >= 0 &&
                       request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.nameLowercase is string && request.resource.data.nameLowercase.size() > 0 &&
                       request.resource.data.name.lower() == request.resource.data.nameLowercase &&
                       request.resource.data.keys().hasOnly(['name', 'nameLowercase', 'usageCount', 'createdAt', 'createdBy']);
        allow update: if request.auth != null && // Any authenticated user can trigger an update (e.g. usageCount) via trusted server code
                       // Only allow usageCount to be updated via increment
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
                       request.resource.data.usageCount == resource.data.usageCount + request.resource.data.diff(resource.data).affectedKeys().get('usageCount', 0) && // Ensure it's an increment/decrement
                       request.resource.data.usageCount >= 0 &&
                       // Ensure other fields are not changed
                       request.resource.data.name == resource.data.name &&
                       request.resource.data.nameLowercase == resource.data.nameLowercase &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false; // Tags are not typically deleted, usageCount goes to 0
    }
      // Collection "collections" - for user-saved posts
    match /collections/{collectionId} {
        function isCollectionOwner() {
            return request.auth.uid == resource.data.ownerId;
        }
        function isSharedWithUser() {
            return request.auth.uid in resource.data.sharedWithUserIds;
        }
        // Ensure user is authenticated for any action
        allow read: if request.auth != null && (isCollectionOwner() || isSharedWithUser());
        allow list: if request.auth != null &&
                       // Allow querying by ownerId OR sharedWithUserIds array-contains current user
                       ((request.query.filters.size() == 1 && request.query.filters[0].field == "ownerId" && request.query.filters[0].operator == "==" && request.query.filters[0].value == request.auth.uid) ||
                        (request.query.filters.size() == 1 && request.query.filters[0].field == "sharedWithUserIds" && request.query.filters[0].operator == "array-contains" && request.query.filters[0].value == request.auth.uid)) &&
                       request.query.orderBy.path == "createdAt" && // Enforce ordering by createdAt
                       request.query.limit <= 100; // Reasonable limit
        allow create: if request.auth != null &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                         (request.resource.data.description is string || request.resource.data.description == null) &&
                         request.resource.data.postIds is list &&
                         request.resource.data.sharedWithUserIds is list &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'postIds', 'sharedWithUserIds', 'createdAt', 'updatedAt']);
        allow update: if request.auth != null && isCollectionOwner() &&
                         request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                         request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                         request.resource.data.updatedAt == request.time &&
                         // Allow only specific fields to be updated
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
        allow delete: if request.auth != null && isCollectionOwner();
    }
  }
}

    