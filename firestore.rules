
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts and their comments
    match /posts/{postId} {
      allow read, write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

        // Rules for subcomments within each comment
        match /subcomments/{subCommentId} {
          allow read: if request.auth != null; 
          allow create: if request.auth != null; 
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
    }

    // Conversations and their messages
    match /conversations/{conversationId} {
      // Allow reading a specific conversation document if authenticated and part of participants, or if doc doesn't exist (for client-side checks)
      allow get: if request.auth != null && (resource == null || (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])));
      // Allow listing conversations if authenticated (queries must be secured by 'array-contains' in app code)
      allow list: if request.auth != null;
      
      allow create: if request.auth != null
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants.hasAll([request.auth.uid]);
      allow update: if request.auth != null
                    && resource.data.participants.hasAll([request.auth.uid])
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null
                    && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; 
      }
    }

    // Mutual connections
    match /mutuals/{connectionDocId} {
      // Allow reading a specific mutuals document if authenticated and part of userIds, or if doc doesn't exist
      allow get: if request.auth != null && (resource == null || (resource.data.userIds != null && resource.data.userIds.hasAny([request.auth.uid])));
      // Allow listing mutuals if authenticated (queries must be secured by 'array-contains' in app code)
      allow list: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.userIds.hasAll([request.auth.uid]);
      allow update: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.userIds.hasAny([request.auth.uid]);
    }

    // User Preferences (for favorite sectors)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Whiteboard Annotations (for shared whiteboards per NAICS code)
    match /whiteboardAnnotations/{naicsDocId} { 
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.naicsCode == naicsDocId;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // User profiles
    match /users/{userId} {
      allow get: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{document=**} { // For getSuggestibleUsers
        allow list: if request.auth != null;
    }

    // Fallback rule: Deny by default for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
