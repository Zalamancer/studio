
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isResourceOwner(resource) { // Check if acting user is owner of the resource
      return request.auth.uid == resource.data.ownerId;
    }
    function resourceIsPlanOwner() { // For create/update where resource.data is new/updated
      return request.auth.uid == request.resource.data.ownerId;
    }
    function planVisibilityValues() { return ['private', 'unlisted', 'public']; }
    function planEditabilityValues() { return ['owner_only', 'collaborators', 'everyone']; }
    function isValidVisibility(visibility) { return visibility is string && visibility in planVisibilityValues(); }
    function isValidEditability(editability) { return editability is string && editability in planEditabilityValues(); }

    function isList(value) { return value is list; }
    function isStringOrNull(value) { return value == null || value is string; }
    function isStringAndNotEmpty(value) { return value is string && value.size() > 0; }
    function isNumber(value) { return value is number; }
    function isTimestamp(value) { return value is timestamp; }
    function isBoolean(value) { return value is bool; }


    // USERS collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId) &&
                    request.resource.data.uid == userId &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.updatedAt == request.time &&
                    request.resource.data.lastLoginAt == request.time &&
                    (request.resource.data.email == request.auth.token.email || request.resource.data.email == null) &&
                    request.resource.data.mentionName is string && request.resource.data.mentionName.size() > 3 &&
                    request.resource.data.mentionNameLowercase is string && request.resource.data.mentionNameLowercase.size() > 3 &&
                    (request.resource.data.companyName == null || request.resource.data.companyName is string) &&
                    (request.resource.data.industry == null || request.resource.data.industry is string) &&
                    (request.resource.data.sectorName == null || request.resource.data.sectorName is string) &&
                    (request.resource.data.subSectorName == null || request.resource.data.subSectorName is string) &&
                    (request.resource.data.industryName == null || request.resource.data.industryName is string) &&
                    (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string) &&
                    (request.resource.data.description == null || request.resource.data.description is string) &&
                    (request.resource.data.descriptionVisibility is string && request.resource.data.descriptionVisibility in ['everyone', 'connected', 'only_me']) &&
                    (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string) &&
                    (request.resource.data.established == null || (request.resource.data.established is string && request.resource.data.established.size() == 4)) &&
                    (request.resource.data.incomeRange == null || request.resource.data.incomeRange is string) &&
                    (request.resource.data.tags == null || request.resource.data.tags is list) &&
                    request.resource.data.verified == false &&
                    request.resource.data.isBotAccount == false &&
                    request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'description', 'descriptionVisibility', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                        'createdAt', 'updatedAt', 'lastLoginAt'
                    ]);
      allow update: if isUser(userId) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email && // email cannot change
                      request.resource.data.mentionName == resource.data.mentionName && // mentionName cannot change
                      request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase &&
                      request.resource.data.companyName == resource.data.companyName && // companyName cannot change via profile update service
                      request.resource.data.isBotAccount == resource.data.isBotAccount &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      (request.resource.data.lastLoginAt == request.time || request.resource.data.lastLoginAt == resource.data.lastLoginAt) && // Allow lastLoginAt to be updated or remain same
                      request.resource.data.keys().hasOnly([
                        'uid', 'email', 'companyName', 'mentionName', 'mentionNameLowercase', 'avatarUrl', 'industry',
                        'sectorName', 'subSectorName', 'industryName', 'naicsCode',
                        'description', 'descriptionVisibility', 'tags', 'established', 'verified', 'isBotAccount', 'incomeRange',
                        'createdAt', 'updatedAt', 'lastLoginAt'
                      ]);
      allow delete: if false;
    }

    // PLANS collection
    match /plans/{planId} {
      function isPlanEditor() {
        let plan = get(/databases/$(database)/documents/plans/$(planId)).data;
        return request.auth.uid == plan.ownerId ||
               (plan.editability == 'collaborators' && request.auth.uid in plan.editUserIds) ||
               (plan.editability == 'everyone' && (plan.visibility == 'public' || (plan.visibility == 'unlisted' && request.auth.uid in plan.viewUserIds) ));
      }
      function canViewPlan(planData) { // Pass planData for create rule context
        return planData.visibility == 'public' ||
               (planData.visibility == 'unlisted' && request.auth.uid in planData.viewUserIds) ||
               (planData.visibility == 'private' && request.auth.uid == planData.ownerId);
      }

      allow read: if isAuthenticated() && canViewPlan(resource.data);

      allow create: if isAuthenticated() &&
                      resourceIsPlanOwner() && // request.auth.uid == request.resource.data.ownerId
                      isStringAndNotEmpty(request.resource.data.name) && request.resource.data.name.size() <= 100 &&
                      isStringOrNull(request.resource.data.description) && (request.resource.data.description == null || request.resource.data.description.size() <= 5000) && // Increased description limit
                      isStringAndNotEmpty(request.resource.data.sector) &&
                      isStringOrNull(request.resource.data.subSector) &&
                      isStringOrNull(request.resource.data.industry) &&
                      isStringOrNull(request.resource.data.naicsCode) &&
                      isList(request.resource.data.roadmap) && request.resource.data.roadmap.size() == 0 &&
                      isNumber(request.resource.data.version) && request.resource.data.version == 1 &&
                      isValidVisibility(request.resource.data.visibility) &&
                      isValidEditability(request.resource.data.editability) &&
                      // Visibility and Editability logic constraints
                      (request.resource.data.visibility != 'private' || request.resource.data.editability == 'owner_only') &&
                      (request.resource.data.visibility != 'unlisted' || request.resource.data.editability != 'everyone') &&
                      isList(request.resource.data.viewUserIds) &&
                      isList(request.resource.data.editUserIds) &&
                      // Owner must be in viewUserIds unless public
                      (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAny([request.auth.uid])) &&
                      // Owner must be in editUserIds if editability is owner_only or collaborators
                      ((request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators') && request.resource.data.editUserIds.hasAny([request.auth.uid]) || request.resource.data.editability == 'everyone') &&
                      // All editors must be viewers (if not public, where viewUserIds might be empty)
                      (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds)) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.keys().hasOnly([
                        'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                        'roadmap', 'version', 'visibility', 'editability', 'viewUserIds', 'editUserIds',
                        'createdAt', 'updatedAt'
                      ]);

      allow update: if isAuthenticated() &&
                      isPlanEditor() && // Ensures only authorized users can update
                      request.resource.data.ownerId == resource.data.ownerId && // Owner cannot change
                      request.resource.data.createdAt == resource.data.createdAt && // Creation time cannot change
                      request.resource.data.updatedAt == request.time && // Update time must be server time
                      // Validate fields being updated
                      isStringAndNotEmpty(request.resource.data.name) && request.resource.data.name.size() <= 100 &&
                      isStringOrNull(request.resource.data.description) && (request.resource.data.description == null || request.resource.data.description.size() <= 5000) &&
                      isStringAndNotEmpty(request.resource.data.sector) &&
                      isStringOrNull(request.resource.data.subSector) &&
                      isStringOrNull(request.resource.data.industry) &&
                      isStringOrNull(request.resource.data.naicsCode) &&
                      isList(request.resource.data.roadmap) && // Allow roadmap updates
                      isNumber(request.resource.data.version) && request.resource.data.version >= resource.data.version && // Version can only increment or stay same
                      isValidVisibility(request.resource.data.visibility) &&
                      isValidEditability(request.resource.data.editability) &&
                      (request.resource.data.visibility != 'private' || request.resource.data.editability == 'owner_only') &&
                      (request.resource.data.visibility != 'unlisted' || request.resource.data.editability != 'everyone') &&
                      isList(request.resource.data.viewUserIds) &&
                      isList(request.resource.data.editUserIds) &&
                      (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAny([resource.data.ownerId])) &&
                      ((request.resource.data.editability == 'owner_only' || request.resource.data.editability == 'collaborators') && request.resource.data.editUserIds.hasAny([resource.data.ownerId]) || request.resource.data.editability == 'everyone') &&
                      (request.resource.data.visibility == 'public' || request.resource.data.viewUserIds.hasAll(request.resource.data.editUserIds)) &&
                      request.resource.data.keys().hasOnly([
                        'name', 'ownerId', 'description', 'sector', 'subSector', 'industry', 'naicsCode',
                        'roadmap', 'version', 'visibility', 'editability', 'viewUserIds', 'editUserIds',
                        'createdAt', 'updatedAt'
                      ]);

      allow delete: if isAuthenticated() && resourceIsPlanOwner(); // Only owner can delete

      // VERSIONS subcollection
      match /versions/{versionId} {
        allow read: if isAuthenticated() && canViewPlan(get(/databases/$(database)/documents/plans/$(planId)).data); // Can read version if can read parent plan
        allow list: if isAuthenticated() && canViewPlan(get(/databases/$(database)/documents/plans/$(planId)).data);
        allow create: if isAuthenticated() && // Logged in
                         isPlanEditor() && // User is an editor of the parent plan
                         request.resource.data.planId == planId && // planId in doc matches path
                         request.resource.data.editorUid == request.auth.uid && // editor is current user
                         request.resource.data.timestamp == request.time && // timestamp is server time
                         request.resource.data.roadmap is list && // roadmap is a list
                         request.resource.data.versionNumber is number && // version number is a number
                         request.resource.data.keys().hasOnly(['planId', 'roadmap', 'editorUid', 'timestamp', 'versionNumber']); // Only specific fields
        allow update, delete: if false; // Versions are immutable
      }
    }
    // ... other collections (userPreferences, articleTags, etc.) ...
  }
}

    