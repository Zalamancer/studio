
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true; // Public profiles can be read by anyone
      allow create: if isAuthenticated(); // Any authenticated user can create their profile doc (e.g. on signup)
                                    // Consider adding validation for request.resource.data fields.
      allow update: if isUser(userId)
                    // Ensure only specific, allowed fields can be updated by the user.
                    && request.resource.data.uid == userId // uid cannot change
                    && request.resource.data.email == resource.data.email // email might be synced from auth, generally not user-editable here
                    && request.resource.data.mentionName == resource.data.mentionName // usually auto-generated
                    && request.resource.data.mentionNameLowercase == resource.data.mentionNameLowercase // auto-generated
                    && request.resource.data.createdAt == resource.data.createdAt; // createdAt immutable
      allow delete: if isUser(userId); // Or make this false if profiles shouldn't be user-deleted
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true; // Posts are public
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId
                      // Validate required fields for a new post
                      && request.resource.data.question is string && request.resource.data.question.size() > 0
                      && request.resource.data.descriptionDetails is string
                      && request.resource.data.tags is list
                      && request.resource.data.sector is string
                      && request.resource.data.requestType is string && (request.resource.data.requestType == 'post' || request.resource.data.requestType == 'help_request')
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.commentCount == 0;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                      // Allow only specific fields to be updated
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'descriptionDetails', 'descriptionTried', 'descriptionOutcome', 'tags', 'sector', 'subSector', 'industry', 'naicsCode', 'imageUrls', 'mentionedUserIds', 'requestType', 'maxBudget', 'deadline', 'commentCount', 'updatedAt'])
                      && request.resource.data.userId == resource.data.userId // Cannot change owner
                      && request.resource.data.createdAt == resource.data.createdAt; // Cannot change creation time
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId
                        && request.resource.data.text is string && request.resource.data.text.size() > 0
                        && request.resource.data.postId == postId
                        && request.resource.data.timestamp == request.time
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.likeCount == 0
                        && request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0;
        allow update: if isAuthenticated() && request.auth.uid == resource.data.userId // User can update their own comment (e.g. text)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'likedBy', 'likeCount'])
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.postId == resource.data.postId
                        && request.resource.data.timestamp == resource.data.timestamp
                        && request.resource.data.updatedAt == request.time;
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId; // User can delete their own comment

         // SubComments Subcollection (nested under comments)
        match /subcomments/{subCommentId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId
                          && request.resource.data.text is string && request.resource.data.text.size() > 0
                          && request.resource.data.timestamp == request.time
                          && request.resource.data.updatedAt == request.time
                          && request.resource.data.likeCount == 0
                          && request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0;
          allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'likedBy', 'likeCount'])
                          && request.resource.data.userId == resource.data.userId
                          && request.resource.data.timestamp == resource.data.timestamp
                          && request.resource.data.updatedAt == request.time;
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
        }
      }
       // Bids Subcollection
      match /bids/{bidId} {
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.bidderId
                        && request.resource.data.postId == postId
                        && request.resource.data.timestamp == request.time
                        // Ensure the bidder is not the post owner (checked on client, good to have here too)
                        && get(/databases/$(database)/documents/posts/$(postId)).data.userId != request.auth.uid;
        allow list, get: if isAuthenticated(); // Allow authenticated users to see bids
        allow update, delete: if false; // Bids are generally immutable
      }
    }

    // Mutuals (Connections) Collection
    match /mutuals/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.requesterId
                    && request.auth.uid in request.resource.data.userIds
                    && request.resource.data.userIds[0] != request.resource.data.userIds[1] // Ensure not self-request
                    && request.resource.data.userIds.size() == 2
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.userIds // User performing update must be one of the involved parties
                    && request.resource.data.userIds == resource.data.userIds // userIds array cannot change
                    && request.resource.data.requesterId == resource.data.requesterId // requesterId cannot change
                    && request.resource.data.requestedAt == resource.data.requestedAt // requestedAt cannot change
                    && request.resource.data.updatedAt == request.time
                    // Allow status change to 'connected' by recipient, or if existing status is 'pending'
                    && ( (request.resource.data.status == 'connected' && resource.data.status == 'pending' && request.auth.uid != resource.data.requesterId && request.resource.data.connectedAt == request.time)
                         || (request.resource.data.status == 'blocked' && (resource.data.status == 'pending' || resource.data.status == 'connected')) // Allow blocking from pending or connected
                       );
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds; // Allow involved users to cancel pending or remove connected
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow create: if isAuthenticated(); // Or better, only by server/trusted functions after validation
      allow read, list: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // User Preferences Collection
    match /userPreferences/{userId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Usually preferences are updated, not deleted
    }

    // Collections
    match /collections/{collectionId} {
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId
                        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                        && (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
                        && request.resource.data.createdAt == request.time
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.postIds is list
                        && request.resource.data.sharedWithUserIds is list;

        allow get: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.sharedWithUserIds);
        allow list: if isAuthenticated(); // To query collections where ownerId == auth.uid OR auth.uid in sharedWithUserIds

        allow update: if isAuthenticated() && request.auth.uid == resource.data.ownerId // Only owner can update
                        && request.resource.data.ownerId == resource.data.ownerId // ownerId immutable
                        && request.resource.data.createdAt == resource.data.createdAt // createdAt immutable
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // Conversations and Messages
    match /conversations/{conversationId} {
      // User must be a participant to read or list conversations they are in.
      allow read, list: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && (
                        ( // Direct chat rules
                          request.resource.data.type == 'direct'
                          && request.resource.data.participants.size() == 2
                          && request.resource.data.groupName == null
                          && request.resource.data.groupAvatarUrl == null
                          && request.resource.data.ownerId == null
                          && request.resource.data.adminIds.size() == 0
                        ) ||
                        ( // Group chat rules
                          request.resource.data.type == 'group'
                          && request.resource.data.participants.size() >= 2 // Creator + at least one member
                          && request.resource.data.ownerId == request.auth.uid
                          && request.auth.uid in request.resource.data.adminIds
                          && request.resource.data.adminIds.size() >=1 // At least owner is admin
                          && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 && request.resource.data.groupName.size() <= 50
                          && (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string) // Optional
                          && request.resource.data.postId == null // Group chats are not tied to posts
                        )
                    );

      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.createdAt == resource.data.createdAt // Cannot change creation time
                    && request.resource.data.type == resource.data.type // Cannot change conversation type
                    && (
                        // For last message update by any participant
                        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt', 'participants'])
                          && request.resource.data.participants.hasAll(resource.data.participants) // Can only add participants, not remove (for last message context)
                        ) ||
                        // For group detail updates by admin/owner
                        ( resource.data.type == 'group' && request.auth.uid in resource.data.adminIds
                          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupName', 'groupAvatarUrl', 'participants', 'adminIds', 'ownerId', 'updatedAt'])
                          // Additional specific checks for group updates if needed
                          && (request.resource.data.ownerId == null || request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.adminIds) // Owner can transfer, admin can add/remove members
                          && (request.resource.data.ownerId == null || request.resource.data.participants.hasAll([request.resource.data.ownerId])) // New owner must be a participant
                        )
                    );

      match /messages/{messageId} {
        allow read, list: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.text is string && request.resource.data.text.size() > 0
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.conversationId == conversationId;
        allow update, delete: if false; // Messages are immutable by users
      }
    }

    // Plans and Plan Versions
    match /plans/{planId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && request.resource.data.sector is string && request.resource.data.sector.size() > 0
                    && (request.resource.data.subSector == null || request.resource.data.subSector is string)
                    && (request.resource.data.industry == null || request.resource.data.industry is string)
                    && (request.resource.data.naicsCode == null || request.resource.data.naicsCode is string)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.version == 1
                    && request.resource.data.roadmap is list;

      allow get: if isAuthenticated(); // Any authenticated user can read any plan

      allow update: if isAuthenticated() // Any authenticated user can update specific fields
                     && request.resource.data.ownerId == resource.data.ownerId // OwnerId cannot be changed
                     && request.resource.data.createdAt == resource.data.createdAt // CreatedAt cannot be changed
                     && request.resource.data.name == resource.data.name // Name cannot be changed by this rule
                     && request.resource.data.sector == resource.data.sector // Sector cannot be changed
                     && request.resource.data.subSector == resource.data.subSector
                     && request.resource.data.industry == resource.data.industry
                     && request.resource.data.naicsCode == resource.data.naicsCode
                     && request.resource.data.updatedAt == request.time
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'version', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;

      match /versions/{versionId} {
        allow create: if isAuthenticated() && request.resource.data.editorUid == request.auth.uid
                       && request.resource.data.planId == planId
                       && request.resource.data.timestamp == request.time
                       && request.resource.data.roadmap is list
                       && request.resource.data.versionNumber is number;
        allow list, get: if isAuthenticated();
        allow update, delete: if false;
      }
    }
  }
}

    