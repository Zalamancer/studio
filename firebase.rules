
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    // Users can read their own profile and public profiles.
    // Users can create their own profile document.
    // Users can only update their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null; // Allow any authenticated user to read profiles (adjust if needed for privacy)
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Typically, users don't delete their own user doc directly.
    }

    // --- User Preferences Collection ---
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Mutuals (Connections) Collection ---
    // Users can manage connections where they are one of the participants.
    match /mutuals/{connectionId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid in resource.data.userIds || request.auth.uid in request.resource.data.userIds;
      // Add more specific rules for create/update if needed (e.g., ensuring userIds are correct format, status transitions are valid)
    }

    // --- Posts Collection ---
    // Users can create posts.
    // All authenticated users can read posts.
    // Users can only update/delete their own posts.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId; // Only comment owner can update/delete

        // SubComments Subcollection (Replies)
        match /subcomments/{subCommentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId; // Only subcomment owner
        }
      }

      // Bids Subcollection
      match /bids/{bidId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.bidderId
                       && request.auth.uid != get(/databases/$(database)/documents/posts/$(postId)).data.userId; // Cannot bid on own post
        allow update, delete: if false; // Bids typically are not updatable/deletable by users directly
      }
    }

    // --- Reviews Collection ---
    // Users can create reviews for other users.
    // Authenticated users can read reviews for a profile.
    // Users can only update/delete their own reviews.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId
                       && request.auth.uid != request.resource.data.targetUserId; // Cannot review self
      allow update: if request.auth != null && request.auth.uid == resource.data.reviewerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.reviewerId;
    }

    // --- Notifications Collection ---
    // Users can only read their own notifications.
    // Server (or trusted functions) create notifications.
    // Users can update (e.g., mark as read) their own notifications.
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null; // Or more restricted, e.g., specific service roles
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId; // Allow users to delete their notifications
    }

    // --- Plans Collection ---
    match /plans/{planId} {
      // ANY authenticated user can create a plan IF they are the owner set in the document
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.sector is string
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.version == 1
                    && request.resource.data.roadmap is list;
                    // Ensure all fields present in your NewPlanData (after sanitization in planService) are covered.
                    // Example: request.resource.data.naicsCode is string || request.resource.data.naicsCode == null

      // ANY authenticated user can read any plan
      allow get: if request.auth != null;
      allow list: if request.auth != null; // Added for Discover page

      // ANY authenticated user can update specific fields of a plan
      // Ensure ownerId and createdAt cannot be changed after creation.
      // Ensure other core fields like name, sector are also immutable by general editors.
      allow update: if request.auth != null
                     && request.resource.data.ownerId == resource.data.ownerId
                     && request.resource.data.createdAt == resource.data.createdAt
                     && request.resource.data.name == resource.data.name
                     && request.resource.data.sector == resource.data.sector
                     // Allow changes only to roadmap, updatedAt, and version by any authenticated user.
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roadmap', 'updatedAt', 'version']);

      // Only the OWNER can delete a plan
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // Versions Subcollection
      match /versions/{versionId} {
        // ANY authenticated user who is editing the plan can create a version history entry
        allow create: if request.auth != null && request.resource.data.editorUid == request.auth.uid
                       && request.resource.data.planId == planId
                       && request.resource.data.timestamp == request.time
                       && request.resource.data.roadmap is list
                       && request.resource.data.versionNumber is number;

        // ANY authenticated user can read the version history of any plan
        allow list, get: if request.auth != null;

        // Versions should generally be immutable by client
        allow update, delete: if false;
      }
    }

    // --- Conversations Collection ---
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants
                      && request.resource.data.participants.size() >= 2
                      // For direct chats:
                      && (request.resource.data.type == 'direct'
                          && request.resource.data.participants.size() == 2
                          && request.resource.data.ownerId == null
                          && request.resource.data.adminIds.size() == 0
                          && request.resource.data.groupName == null
                          && request.resource.data.groupAvatarUrl == null
                      )
                      // For group chats:
                      || (request.resource.data.type == 'group'
                          && request.resource.data.ownerId == request.auth.uid
                          && request.resource.data.adminIds.hasAny([request.auth.uid])
                          && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0
                          && (request.resource.data.groupAvatarUrl == null || request.resource.data.groupAvatarUrl is string)
                          // postId can be null for groups not tied to a post
                          && (request.resource.data.postId == null || request.resource.data.postId is string)
                      );
      // Deleting conversations might be complex, handle with Cloud Functions if needed or restrict to owner for groups
      allow delete: if request.auth != null && resource.data.type == 'group' && request.auth.uid == resource.data.ownerId;


      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Messages are typically immutable
        allow update, delete: if false;
      }
    }

     // Collections (for saved posts)
    match /collections/{collectionId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.sharedWithUserIds);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId
                      && request.resource.data.name is string && request.resource.data.name.size() > 0
                      && request.resource.data.postIds is list
                      && request.resource.data.sharedWithUserIds is list
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId
                      && request.resource.data.ownerId == resource.data.ownerId // Cannot change owner
                      && request.resource.data.createdAt == resource.data.createdAt // Cannot change creation time
                      && request.resource.data.updatedAt == request.time // Update time must be server time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'postIds', 'sharedWithUserIds', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}

    