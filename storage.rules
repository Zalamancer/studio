
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default: Deny all reads and writes if no other rules match.
    // Consider your app's specific needs if you want a global deny.
    // match /{allPaths=**} {
    //  allow read, write: if false;
    // }

    // User profile avatars
    // Path: users/{userId}/avatar/{fileName}
    match /users/{userId}/avatar/{fileName} {
      allow read: if true; // Publicly readable for display
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Images for general posts
    // Path: posts/{userId}/{postId_or_fileName}/{fileName} (flexible for single or multiple images per post)
    match /posts/{userId}/{pathSegment}/{fileName} {
      allow read: if true; // Publicly readable
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Cover images for news articles
    // Path: newsCovers/{userId}/{articleIdOrPlaceholder}/{fileName}
    // Here, {articleIdOrPlaceholder} can be an actual article ID or a temporary one like 'new'.
    match /newsCovers/{userId}/{articleIdOrPlaceholder}/{fileName} {
      allow read: if true; // Publicly readable for display
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
